<Window x:Class="XenomOptimizer.Views.SplashScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xenom Optimizer"
        Icon="pack://application:,,,/Assets/xenom.ico"
        Height="360" Width="360"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        Cursor="Hand"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Grid x:Name="SplashRootGrid" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="SplashScaleTransform" ScaleX="0.9" ScaleY="0.9"/>
        </Grid.RenderTransform>

        <!-- Pure Transparent Floating Animated Cyber-X Logo (Zero blue outline, zero blue fade, pure transparent background) -->
        <Image x:Name="LogoImage" Width="260" Height="260"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
    </Grid>
</Window>
