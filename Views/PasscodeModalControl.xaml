<UserControl x:Class="XenomOptimizer.Views.PasscodeModalControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Focusable="True"
             IsVisibleChanged="OnIsVisibleChanged"
             PreviewKeyDown="UserControl_PreviewKeyDown">

    <UserControl.Resources>
        <!-- Numpad Button Style -->
        <Style x:Key="NumpadBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#131722"/>
            <Setter Property="BorderBrush" Value="#222B3D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1E2536"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#2A344A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Numpad Cancel Style -->
        <Style x:Key="NumpadCancelBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#131722"/>
            <Setter Property="BorderBrush" Value="#222B3D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#2D1518"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#EF4444"/>
                                <Setter Property="Foreground" Value="#F87171"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootPasscodeGrid">
        <!-- 1. Deep Dark Translucent Backdrop (Dismiss on click outside) -->
        <Border x:Name="BackdropBorder" Background="#D5000000" Opacity="1"
                MouseLeftButtonDown="Backdrop_MouseLeftButtonDown"/>

        <!-- 2. Centered Floating Passcode Card (Designed to match Image 3) -->
        <Border x:Name="ModalCard"
                Width="420"
                CornerRadius="28" Padding="32,28,32,24"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                BorderThickness="1.5" BorderBrush="#252F44"
                RenderTransformOrigin="0.5,0.5">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#141824" Offset="0.0"/>
                    <GradientStop Color="#0C0F17" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>

            <Border.Effect>
                <DropShadowEffect BlurRadius="45" ShadowDepth="12" Direction="270" Color="#000000" Opacity="0.95"/>
            </Border.Effect>

            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
                    <TranslateTransform x:Name="CardTranslate" X="0" Y="0"/>
                </TransformGroup>
            </Border.RenderTransform>

            <StackPanel HorizontalAlignment="Center">

                <!-- ── 3D METALLIC PADLOCK GRAPHIC (Matching Photo 3) ── -->
                <Grid Width="96" Height="90" HorizontalAlignment="Center" Margin="0,0,0,8">
                    <!-- Soft Radial Blue Glow Behind Padlock -->
                    <Ellipse Width="96" Height="90" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#30205599" Offset="0.0"/>
                                <GradientStop Color="#15204488" Offset="0.5"/>
                                <GradientStop Color="#00000000" Offset="1.0"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <!-- Shackle (Top Arch) -->
                    <Border x:Name="PadlockShackle" Width="40" Height="40" CornerRadius="20,20,0,0"
                            BorderBrush="#4B5A77" BorderThickness="6" Background="Transparent"
                            HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,4,0,0"/>

                    <!-- Lock Body (Bottom Solid Block) -->
                    <Border x:Name="PadlockBody" Width="66" Height="54" CornerRadius="14"
                            BorderBrush="#2D3B54" BorderThickness="1.5"
                            HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#1C2333" Offset="0.0"/>
                                <GradientStop Color="#0F1420" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <!-- Center Security Icon -->
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="LockIconText" Text="&#xE72E;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="22" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ── TITLE & SUBTITLE ── -->
                <TextBlock Text="5-Digit Passcode" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"
                           FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                           HorizontalAlignment="Center" Margin="0,4,0,3"/>
                <TextBlock Text="Enter the 5-digit verification passcode to unlock restricted features."
                           FontSize="11.5" Foreground="#7E8BA0" TextWrapping="Wrap"
                           TextAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,18" MaxWidth="320"/>

                <!-- ── 5 DIGIT INPUT CELLS (Matching Photo 3) ── -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                    <!-- Digit 0 -->
                    <Border x:Name="Cell0" Width="48" Height="56" CornerRadius="14" Margin="4,0"
                            Background="#121622" BorderBrush="#232C3E" BorderThickness="1.5">
                        <TextBlock x:Name="Txt0" Text="" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <!-- Digit 1 -->
                    <Border x:Name="Cell1" Width="48" Height="56" CornerRadius="14" Margin="4,0"
                            Background="#121622" BorderBrush="#232C3E" BorderThickness="1.5">
                        <TextBlock x:Name="Txt1" Text="" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <!-- Digit 2 -->
                    <Border x:Name="Cell2" Width="48" Height="56" CornerRadius="14" Margin="4,0"
                            Background="#121622" BorderBrush="#232C3E" BorderThickness="1.5">
                        <TextBlock x:Name="Txt2" Text="" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <!-- Digit 3 -->
                    <Border x:Name="Cell3" Width="48" Height="56" CornerRadius="14" Margin="4,0"
                            Background="#121622" BorderBrush="#232C3E" BorderThickness="1.5">
                        <TextBlock x:Name="Txt3" Text="" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <!-- Digit 4 -->
                    <Border x:Name="Cell4" Width="48" Height="56" CornerRadius="14" Margin="4,0"
                            Background="#121622" BorderBrush="#232C3E" BorderThickness="1.5">
                        <TextBlock x:Name="Txt4" Text="" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <!-- ── STATUS / ERROR TEXT ── -->
                <TextBlock x:Name="StatusMessage" Text="" FontSize="11.5" FontWeight="SemiBold"
                           Foreground="#EF4444" HorizontalAlignment="Center" Height="18" Margin="0,0,0,12"/>

                <!-- ── NUMERIC KEYPAD (FOR EASY 1-CLICK OR PHYSICAL KEYBOARD INPUT) ── -->
                <Grid Width="230" HorizontalAlignment="Center" Margin="0,0,0,6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="42"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="42"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="42"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="42"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Row 1: 1, 2, 3 -->
                    <Button Grid.Row="0" Grid.Column="0" Content="1" Click="Numpad_Click" Style="{StaticResource NumpadBtnStyle}"/>
                    <Button Grid.Row="0" Grid.Column="2" Content="2" Click="Numpad_Click" Style="{StaticResource NumpadBtnStyle}"/>
                    <Button Grid.Row="0" Grid.Column="4" Content="3" Click="Numpad_Click" Style="{StaticResource NumpadBtnStyle}"/>

                    <!-- Row 2: 4, 5, 6 -->
                    <Button Grid.Row="2" Grid.Column="0" Content="4" Click="Numpad_Click" Style="{StaticResource NumpadBtnStyle}"/>
                    <Button Grid.Row="2" Grid.Column="2" Content="5" Click="Numpad_Click" Style="{StaticResource NumpadBtnStyle}"/>
                    <Button Grid.Row="2" Grid.Column="4" Content="6" Click="Numpad_Click" Style="{StaticResource NumpadBtnStyle}"/>

                    <!-- Row 3: 7, 8, 9 -->
                    <Button Grid.Row="4" Grid.Column="0" Content="7" Click="Numpad_Click" Style="{StaticResource NumpadBtnStyle}"/>
                    <Button Grid.Row="4" Grid.Column="2" Content="8" Click="Numpad_Click" Style="{StaticResource NumpadBtnStyle}"/>
                    <Button Grid.Row="4" Grid.Column="4" Content="9" Click="Numpad_Click" Style="{StaticResource NumpadBtnStyle}"/>

                    <!-- Row 4: Cancel, 0, Backspace -->
                    <Button Grid.Row="6" Grid.Column="0" Content="Cancel" Click="Cancel_Click" Style="{StaticResource NumpadCancelBtnStyle}"/>
                    <Button Grid.Row="6" Grid.Column="2" Content="0" Click="Numpad_Click" Style="{StaticResource NumpadBtnStyle}"/>
                    <Button Grid.Row="6" Grid.Column="4" Content="⌫" Click="Backspace_Click" Style="{StaticResource NumpadBtnStyle}"/>
                </Grid>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
