<UserControl x:Class="XenomOptimizer.Views.PubgOptimizationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,24">
        <StackPanel MaxWidth="1100">
            <TextBlock Text="PUBG Mobile Optimization" FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
            <TextBlock Text="Performance optimizations for PUBG Mobile on GameLoop. Does NOT modify anti-cheat or gameplay."
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,24"/>

            <TextBlock Text="⏳ Detecting PUBG Mobile..." Foreground="{StaticResource TextMutedBrush}"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>

            <Border Style="{StaticResource CardBorder}"
                    Visibility="{Binding IsLoading, Converter={StaticResource InvBoolToVis}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="PUBG Mobile Status: " FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock FontSize="14" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="✗ Not Detected"/>
                                    <Setter Property="Foreground" Value="{StaticResource AccentRedBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDetected}" Value="True">
                                            <Setter Property="Text" Value="✓ Detected"/>
                                            <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Config Path" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                        <TextBlock Grid.Column="1" Text="{Binding ConfigPath}" FontSize="12"
                                   Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                    </Grid>

                    <TextBlock Text="{Binding StatusMessage}" FontSize="12"
                               Foreground="{StaticResource AccentOrangeBrush}"
                               TextWrapping="Wrap" Margin="0,8,0,0"
                               Visibility="{Binding StatusMessage, Converter={StaticResource StringToVis}}"/>
                </StackPanel>
            </Border>

            <!-- Safety notice -->
            <Border CornerRadius="5" Padding="16" Margin="0,16,0,0"
                    BorderThickness="1" BorderBrush="{StaticResource AccentCyanDimBrush}">
                <Border.Background><SolidColorBrush Color="#0A00D4FF"/></Border.Background>
                <StackPanel>
                    <TextBlock Text="ℹ Safety Notice" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,0,6"/>
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}">
                        This section only modifies performance-related settings such as graphics quality, resolution, and cache.
                        It does NOT modify anti-cheat mechanisms, inject DLLs, manipulate game memory, or alter gameplay in any way.
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
