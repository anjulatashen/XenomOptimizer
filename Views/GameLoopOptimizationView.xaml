<UserControl x:Class="XenomOptimizer.Views.GameLoopOptimizationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:XenomOptimizer.Converters"
             xmlns:System="clr-namespace:System;assembly=mscorlib">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,0,24,32">
        <StackPanel MaxWidth="1200">

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- HEADER SECTION WITH STATUS BADGE                            -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <Grid Height="64" Margin="0,26,0,26">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="GameLoop Optimization" FontSize="28" FontWeight="Bold"
                               Foreground="#FFFFFF" FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif" Margin="0,0,0,4"/>
                    <TextBlock Text="Engine tuning, safe 120 FPS unlocker, iPad view presets &amp; low-latency latency booster"
                               Foreground="#9E9EA4" FontSize="13" FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"/>
                </StackPanel>

                <!-- Status Pill on Right -->
                <Border Grid.Column="1" Background="#11141E" BorderBrush="#202738" BorderThickness="1" CornerRadius="16" Padding="14,8" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Margin="0,0,8,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#EF4444"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                            <Setter Property="Fill" Value="#10B981"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock FontSize="12" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="GameLoop Not Found"/>
                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                            <Setter Property="Text" Value="GameLoop Detected"/>
                                            <Setter Property="Foreground" Value="#F8FAFC"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- MODERN SEGMENTED PILL TAB NAVIGATION BAR                    -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <Border Background="#0C0E14" BorderBrush="#1E2333" BorderThickness="1" CornerRadius="22" Padding="5" Margin="0,0,0,24">
                <UniformGrid Rows="1" Columns="6">
                    <!-- Tab 0: Graphics & 120 FPS -->
                    <Button Command="{Binding SwitchTabCommand}" CommandParameter="0" Height="40" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="TabBorder" Background="{TemplateBinding Background}" CornerRadius="18" Padding="12,0">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="🎮" FontSize="13" Margin="0,0,6,0"/>
                                                    <TextBlock Text="Graphics &amp; 120 FPS" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" x:Name="TabText"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding SelectedSubTab}" Value="0">
                                                    <Setter TargetName="TabBorder" Property="Background" Value="#1C2335"/>
                                                    <Setter TargetName="TabBorder" Property="BorderBrush" Value="#2D3A56"/>
                                                    <Setter TargetName="TabBorder" Property="BorderThickness" Value="1"/>
                                                    <Setter TargetName="TabText" Property="Foreground" Value="#38BDF8"/>
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Tab 1: Engine & Hardware -->
                    <Button Command="{Binding SwitchTabCommand}" CommandParameter="1" Height="40" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="TabBorder" Background="{TemplateBinding Background}" CornerRadius="18" Padding="12,0">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="⚙️" FontSize="13" Margin="0,0,6,0"/>
                                                    <TextBlock Text="Engine &amp; Cores" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" x:Name="TabText"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding SelectedSubTab}" Value="1">
                                                    <Setter TargetName="TabBorder" Property="Background" Value="#1C2335"/>
                                                    <Setter TargetName="TabBorder" Property="BorderBrush" Value="#2D3A56"/>
                                                    <Setter TargetName="TabBorder" Property="BorderThickness" Value="1"/>
                                                    <Setter TargetName="TabText" Property="Foreground" Value="#38BDF8"/>
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Tab 2: KeyMapping Suite -->
                    <Button Command="{Binding SwitchTabCommand}" CommandParameter="2" Height="40" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="TabBorder" Background="{TemplateBinding Background}" CornerRadius="18" Padding="12,0">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="⌨️" FontSize="13" Margin="0,0,6,0"/>
                                                    <TextBlock Text="KeyMapping" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" x:Name="TabText"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding SelectedSubTab}" Value="2">
                                                    <Setter TargetName="TabBorder" Property="Background" Value="#1C2335"/>
                                                    <Setter TargetName="TabBorder" Property="BorderBrush" Value="#2D3A56"/>
                                                    <Setter TargetName="TabBorder" Property="BorderThickness" Value="1"/>
                                                    <Setter TargetName="TabText" Property="Foreground" Value="#38BDF8"/>
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Tab 3: Device Spoofing -->
                    <Button Command="{Binding SwitchTabCommand}" CommandParameter="3" Height="40" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="TabBorder" Background="{TemplateBinding Background}" CornerRadius="18" Padding="12,0">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="📱" FontSize="13" Margin="0,0,6,0"/>
                                                    <TextBlock Text="Device Spoofing" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" x:Name="TabText"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding SelectedSubTab}" Value="3">
                                                    <Setter TargetName="TabBorder" Property="Background" Value="#1C2335"/>
                                                    <Setter TargetName="TabBorder" Property="BorderBrush" Value="#2D3A56"/>
                                                    <Setter TargetName="TabBorder" Property="BorderThickness" Value="1"/>
                                                    <Setter TargetName="TabText" Property="Foreground" Value="#38BDF8"/>
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Tab 4: PC Doctor & Tweaks -->
                    <Button Command="{Binding SwitchTabCommand}" CommandParameter="4" Height="40" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="TabBorder" Background="{TemplateBinding Background}" CornerRadius="18" Padding="12,0">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="🩺" FontSize="13" Margin="0,0,6,0"/>
                                                    <TextBlock Text="GameLoop Doctor" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" x:Name="TabText"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding SelectedSubTab}" Value="4">
                                                    <Setter TargetName="TabBorder" Property="Background" Value="#1C2335"/>
                                                    <Setter TargetName="TabBorder" Property="BorderBrush" Value="#2D3A56"/>
                                                    <Setter TargetName="TabBorder" Property="BorderThickness" Value="1"/>
                                                    <Setter TargetName="TabText" Property="Foreground" Value="#38BDF8"/>
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Tab 5: Storage & Safe Close -->
                    <Button Command="{Binding SwitchTabCommand}" CommandParameter="5" Height="40" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="TabBorder" Background="{TemplateBinding Background}" CornerRadius="18" Padding="12,0">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="🧹" FontSize="13" Margin="0,0,6,0"/>
                                                    <TextBlock Text="Safe Close &amp; Cache" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" x:Name="TabText"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding SelectedSubTab}" Value="5">
                                                    <Setter TargetName="TabBorder" Property="Background" Value="#1C2335"/>
                                                    <Setter TargetName="TabBorder" Property="BorderBrush" Value="#2D3A56"/>
                                                    <Setter TargetName="TabBorder" Property="BorderThickness" Value="1"/>
                                                    <Setter TargetName="TabText" Property="Foreground" Value="#38BDF8"/>
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </UniformGrid>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- TAB 0: GRAPHICS & 120 FPS UNLOCKER                          -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <StackPanel Visibility="{Binding SelectedSubTab, Converter={StaticResource IntEqualsToVis}, ConverterParameter=0}">

                <!-- 120 FPS Ultra Unlock Banner Card -->
                <Border Background="#121520" BorderBrush="#252B3E" BorderThickness="1.2" CornerRadius="18" Padding="24,20" Margin="0,0,0,20">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="⚡ 120 FPS Safe Unlocker" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC"/>
                                    <!-- Status Badge -->
                                    <Border CornerRadius="8" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#1C212E"/>
                                                <Setter Property="BorderBrush" Value="#2D354A"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Is120FpsUnlocked}" Value="True">
                                                        <Setter Property="Background" Value="#122B22"/>
                                                        <Setter Property="BorderBrush" Value="#1A4A38"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Fps120StatusText}" FontSize="11" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Is120FpsUnlocked}" Value="True">
                                                            <Setter Property="Foreground" Value="#10B981"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Safe device spoofing &amp; emulator high-refresh unlock. 100% Anti-Cheat Ban-Safe." Foreground="#94A3B8" FontSize="12.5"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Command="{Binding Toggle120FpsCommand}" Height="38" Padding="18,0" Margin="0,0,10,0" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                            <Setter Property="Content" Value="⚡ Unlock 120 FPS Mode"/>
                                            <Setter Property="Background" Value="#10B981"/>
                                            <Setter Property="BorderBrush" Value="#059669"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Is120FpsUnlocked}" Value="True">
                                                    <Setter Property="Content" Value="✓ 120 FPS Active (Revert)"/>
                                                    <Setter Property="Background" Value="#1C2638"/>
                                                    <Setter Property="BorderBrush" Value="#2F3E5C"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button Style="{StaticResource SecondaryButton}" Content="🚀 Launch 120 FPS" Command="{Binding LaunchGameLoop120FpsCommand}" Height="38" Padding="14,0" Cursor="Hand"/>
                            </StackPanel>
                        </Grid>

                        <Border Background="#161A28" BorderBrush="#252C3E" BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Fps120DetailText}" FontSize="12" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="#1E2436" CornerRadius="6" Padding="8,4" Margin="0,0,8,0">
                                            <TextBlock Text="📱 Samsung SM-X920" FontSize="11" Foreground="#38BDF8"/>
                                        </Border>
                                        <Border Background="#1E2436" CornerRadius="6" Padding="8,4" Margin="0,0,8,0">
                                            <TextBlock Text="⚡ Engine -vm 100" FontSize="11" Foreground="#34D399"/>
                                        </Border>
                                        <Border Background="#1E2436" CornerRadius="6" Padding="8,4">
                                            <TextBlock Text="🛡️ 100% Ban-Safe (Zero Memory Injection)" FontSize="11" Foreground="#A78BFA"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="📌 Desktop Shortcut" Command="{Binding Create120FpsShortcutCommand}" VerticalAlignment="Center" Height="34" Padding="12,0" Margin="16,0,0,0" Cursor="Hand"/>
                            </Grid>
                        </Border>
                        <TextBlock Text="{Binding Fps120ActionMessage}" FontSize="11.5" Foreground="{StaticResource AccentGreenBrush}" Visibility="{Binding Fps120ActionMessage, Converter={StaticResource StringToVis}}"/>
                    </StackPanel>
                </Border>

                <!-- Resolution & Aspect Ratio Presets Card -->
                <Border Background="#121520" BorderBrush="#252B3E" BorderThickness="1.2" CornerRadius="18" Padding="24,20" Margin="0,0,0,20">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Aspect Ratio &amp; Resolution Presets" FontSize="17" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,4"/>
                                <TextBlock Text="Quickly switch between competitive iPad 4:3 FOV and sharp 2K/4K display resolutions" Foreground="#94A3B8" FontSize="12"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#161B29" BorderBrush="#26314A" BorderThickness="1" CornerRadius="12" Padding="12,6" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Current: " Foreground="#64748B" FontSize="11.5"/>
                                    <TextBlock Text="{Binding CurrentResolutionDisplay}" Foreground="#38BDF8" FontSize="11.5" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <TextBlock Text="{Binding ResolutionStatusMessage}" FontSize="11.5" Foreground="{StaticResource AccentGreenBrush}" Margin="0,0,0,10" Visibility="{Binding ResolutionStatusMessage, Converter={StaticResource StringToVis}}"/>

                        <!-- 6 Presets Grid -->
                        <UniformGrid Columns="2" Rows="3">
                            <!-- Preset 0: 1080p FHD -->
                            <Border Background="#161924" BorderBrush="#23283A" BorderThickness="1" CornerRadius="14" Padding="14,12" Margin="0,0,8,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Left Indicator Pill -->
                                    <Border Grid.Column="0" Width="3.5" Height="28" CornerRadius="2" Margin="0,0,12,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedResolutionIndex}" Value="0">
                                                        <Setter Property="Background" Value="#38BDF8"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="1080p FHD (Standard)" FontSize="13.5" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                                            <Border Background="#1E273A" CornerRadius="4" Padding="6,1.5" Margin="8,0,0,0">
                                                <TextBlock Text="16:9" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="1920 x 1080 • 240 DPI (Smooth Frame Pacing)" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Apply" Command="{Binding ApplyResolutionPresetCommand}" CommandParameter="0" Height="30" Padding="14,0" VerticalAlignment="Center" Cursor="Hand"/>
                                </Grid>
                            </Border>

                            <!-- Preset 3: iPad View 4:3 Wide (Highlighted!) -->
                            <Border Background="#141B26" BorderBrush="#25354F" BorderThickness="1.2" CornerRadius="14" Padding="14,12" Margin="8,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Left Indicator Pill -->
                                    <Border Grid.Column="0" Width="3.5" Height="28" CornerRadius="2" Margin="0,0,12,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedResolutionIndex}" Value="3">
                                                        <Setter Property="Background" Value="#10B981"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="iPad View 4:3 Wide" FontSize="13.5" FontWeight="Bold" Foreground="#34D399"/>
                                            <Border Background="#132B22" BorderBrush="#1B4D3B" BorderThickness="1" CornerRadius="4" Padding="6,1.5" Margin="8,0,0,0">
                                                <TextBlock Text="4:3 FOV" FontSize="10" FontWeight="Bold" Foreground="#34D399"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="1440 x 1080 • 240 DPI (Extra Wide Vision in PUBG)" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="Apply" Command="{Binding ApplyResolutionPresetCommand}" CommandParameter="3" Height="30" Padding="14,0" VerticalAlignment="Center" Cursor="Hand"/>
                                </Grid>
                            </Border>

                            <!-- Preset 1: 2K QHD -->
                            <Border Background="#161924" BorderBrush="#23283A" BorderThickness="1" CornerRadius="14" Padding="14,12" Margin="0,0,8,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="3.5" Height="28" CornerRadius="2" Margin="0,0,12,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedResolutionIndex}" Value="1">
                                                        <Setter Property="Background" Value="#38BDF8"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="2K QHD (High Fidelity)" FontSize="13.5" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                                            <Border Background="#1E273A" CornerRadius="4" Padding="6,1.5" Margin="8,0,0,0">
                                                <TextBlock Text="16:9" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="2560 x 1440 • 320 DPI (Crisp Textures &amp; Distant Enemies)" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Apply" Command="{Binding ApplyResolutionPresetCommand}" CommandParameter="1" Height="30" Padding="14,0" VerticalAlignment="Center" Cursor="Hand"/>
                                </Grid>
                            </Border>

                            <!-- Preset 4: iPad Pro 4:3 -->
                            <Border Background="#161924" BorderBrush="#23283A" BorderThickness="1" CornerRadius="14" Padding="14,12" Margin="8,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="3.5" Height="28" CornerRadius="2" Margin="0,0,12,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedResolutionIndex}" Value="4">
                                                        <Setter Property="Background" Value="#38BDF8"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="iPad Pro 4:3 Ultra" FontSize="13.5" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                                            <Border Background="#1E273A" CornerRadius="4" Padding="6,1.5" Margin="8,0,0,0">
                                                <TextBlock Text="4:3 HD" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="2300 x 1920 • 320 DPI (Maximum Vertical Field)" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                    </StackPanel>
