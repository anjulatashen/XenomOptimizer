<UserControl x:Class="XenomOptimizer.Views.GameLoopOptimizationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,24">
        <StackPanel MaxWidth="1100">
            <!-- Page Title -->
            <TextBlock Text="GameLoop Optimization" FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
            <TextBlock Text="Optimize Tencent GameLoop emulator engine and Windows integration for maximum PUBG performance"
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,24"/>

            <!-- Loading Indicator -->
            <TextBlock Text="⏳ Detecting GameLoop..."
                       Foreground="{StaticResource TextMutedBrush}" FontSize="13"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>

            <!-- GameLoop Status Card -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,20"
                    Visibility="{Binding IsLoading, Converter={StaticResource InvBoolToVis}}">
                <StackPanel>
                    <TextBlock Text="GameLoop Status" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Installation" Foreground="{StaticResource TextMutedBrush}" FontSize="13"/>
                        <TextBlock Grid.Column="1" FontSize="13" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="✗ Not Installed"/>
                                    <Setter Property="Foreground" Value="{StaticResource AccentRedBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                            <Setter Property="Text" Value="✓ Installed"/>
                                            <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Version" Foreground="{StaticResource TextMutedBrush}" FontSize="13"/>
                        <TextBlock Grid.Column="1" Text="{Binding Version}" FontSize="13"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Installation Path" Foreground="{StaticResource TextMutedBrush}" FontSize="13"/>
                        <TextBlock Grid.Column="1" Text="{Binding InstallPath}" FontSize="12"
                                   Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Status Message -->
            <TextBlock Text="{Binding StatusMessage}" FontSize="12"
                       Foreground="{StaticResource AccentOrangeBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,16"
                       Visibility="{Binding StatusMessage, Converter={StaticResource StringToVis}}"/>

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- 120 FPS SAFE UNLOCK CARD (PUBG MOBILE ULTRA PERFORMANCE)    -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <Border Background="#121520" BorderBrush="#252B3E" BorderThickness="1.2"
                    CornerRadius="16" Padding="24,20" Margin="0,0,0,20"
                    Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Title & Badge -->
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="⚡ 120 FPS Safe Unlocker" FontSize="18" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}" FontFamily="pack://application:,,,/Fonts/#Poppins, Segoe UI, sans-serif"/>
                                <!-- Status Badge -->
                                <Border CornerRadius="8" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#1C212E"/>
                                            <Setter Property="BorderBrush" Value="#2D354A"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Is120FpsUnlocked}" Value="True">
                                                    <Setter Property="Background" Value="#122B22"/>
                                                    <Setter Property="BorderBrush" Value="#1A4A38"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Fps120StatusText}" FontSize="11" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#94A3B8"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Is120FpsUnlocked}" Value="True">
                                                        <Setter Property="Foreground" Value="#10B981"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Official device model spoofing &amp; emulator high-refresh unlock. 100% Anti-Cheat Ban-Safe."
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5"/>
                        </StackPanel>

                        <!-- Quick Action Button -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Command="{Binding Toggle120FpsCommand}"
                                    IsEnabled="{Binding IsApplying120Fps, Converter={StaticResource InvBoolToVis}}"
                                    Height="38" Padding="18,0" Margin="0,0,10,0" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                        <Setter Property="Content" Value="⚡ Unlock 120 FPS Mode"/>
                                        <Setter Property="Background" Value="#10B981"/>
                                        <Setter Property="BorderBrush" Value="#059669"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Is120FpsUnlocked}" Value="True">
                                                <Setter Property="Content" Value="✓ 120 FPS Active (Revert)"/>
                                                <Setter Property="Background" Value="#1C2638"/>
                                                <Setter Property="BorderBrush" Value="#2F3E5C"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Style="{StaticResource SecondaryButton}"
                                    Content="🚀 Launch 120 FPS"
                                    Command="{Binding LaunchGameLoop120FpsCommand}"
                                    Height="38" Padding="14,0" Cursor="Hand" ToolTip="Launch GameLoop with -vm 100 engine boost"/>
                        </StackPanel>
                    </Grid>

                    <!-- Detail Box with Features -->
                    <Border Background="#161A28" BorderBrush="#252C3E" BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Fps120DetailText}" FontSize="12" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                
                                <!-- 3 Feature Chips -->
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <Border Background="#1E2436" CornerRadius="6" Padding="8,4" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📱 Samsung SM-X910" FontSize="11" Foreground="#38BDF8"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#1E2436" CornerRadius="6" Padding="8,4" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⚡ Engine -vm 100" FontSize="11" Foreground="#34D399"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#1E2436" CornerRadius="6" Padding="8,4">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🛡️ 100% Ban-Safe (Zero Memory Injection)" FontSize="11" Foreground="#A78BFA"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <!-- Create Desktop Shortcut Button -->
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                                    Content="📌 Desktop Shortcut"
                                    Command="{Binding Create120FpsShortcutCommand}"
                                    VerticalAlignment="Center" Height="34" Padding="12,0" Margin="16,0,0,0" Cursor="Hand"
                                    ToolTip="Create a 120 FPS high-performance shortcut on your Desktop"/>
                        </Grid>
                    </Border>

                    <!-- Action Status Message -->
                    <TextBlock Text="{Binding Fps120ActionMessage}" FontSize="11.5"
                               Foreground="{StaticResource AccentGreenBrush}"
                               Visibility="{Binding Fps120ActionMessage, Converter={StaticResource StringToVis}}"/>
                </StackPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- GAMELOOP REGISTRY EDITS (BOTTOM SECTION AS REQUESTED)       -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,20">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="GameLoop Registry Edits" FontSize="17" FontWeight="Bold"
                                       Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="Windows &amp; emulator registry tweaks tailored strictly for GameLoop processes"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                        </StackPanel>

                        <!-- Batch Apply Button -->
                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}"
                                Content="⚡ Apply All GameLoop Edits"
                                Command="{Binding ApplyAllRegistryEditsCommand}"
                                IsEnabled="{Binding IsOneTapBusy, Converter={StaticResource InvBoolToVis}}"
                                Padding="16,8" VerticalAlignment="Center"/>
                    </Grid>

                    <TextBlock Text="{Binding OneTapStatus}" Foreground="{StaticResource AccentGreenBrush}" FontSize="12"
                               Margin="0,0,0,10" Visibility="{Binding OneTapStatus, Converter={StaticResource StringToVis}}"/>

                    <!-- Registry Tweaks List -->
                    <ItemsControl ItemsSource="{Binding RegistryEdits}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#121319" BorderBrush="#20222B" BorderThickness="1"
                                        CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <Border Background="#1E293B" CornerRadius="4" Padding="6,2" Margin="8,0,0,0"
                                                        Visibility="{Binding RequiresAdmin, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="ADMIN" FontSize="9" FontWeight="Bold" Foreground="#38BDF8"/>
                                                </Border>
                                            </StackPanel>

                                            <TextBlock Text="{Binding Description}" FontSize="12"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap" Margin="0,0,0,8"/>

                                            <!-- Registry Target Box -->
                                            <Border Background="#0B0C10" CornerRadius="4" Padding="8,5" Margin="0,0,0,6">
                                                <TextBlock Text="{Binding RegistryTarget}" FontSize="10"
                                                           Foreground="#64748B" FontFamily="{StaticResource MonoFont}"/>
                                            </Border>

                                            <!-- Status Message -->
                                            <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                                                       Foreground="{StaticResource AccentGreenBrush}"
                                                       Visibility="{Binding StatusMessage, Converter={StaticResource StringToVis}}"/>
                                        </StackPanel>

                                        <!-- Toggle Button / Action -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                                            <Button Style="{StaticResource PrimaryButton}"
                                                    Content="Apply"
                                                    Command="{Binding ToggleCommand}"
                                                    CommandParameter="{x:Static System:Boolean.TrueString}"
                                                    MinWidth="90" Margin="0,0,0,6"
                                                    xmlns:System="clr-namespace:System;assembly=mscorlib"/>
                                            <TextBlock HorizontalAlignment="Center" FontSize="11" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Disabled"/>
                                                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                                <Setter Property="Text" Value="Active ✓"/>
                                                                <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Detected Configuration Items -->
            <Border Style="{StaticResource CardBorder}"
                    Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Detected Configuration" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>

                    <ItemsControl ItemsSource="{Binding ConfigItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="250"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Key}" FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               FontFamily="{StaticResource MonoFont}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="11"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="No configuration entries found." FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ConfigItems.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
