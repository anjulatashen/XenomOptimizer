                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Samsung Galaxy Tab S10+ (SM-X920)" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC"/>
                                            <Border Background="#16293D" BorderBrush="#1D4363" BorderThickness="1" CornerRadius="4" Padding="6,1.5" Margin="8,0,0,0">
                                                <TextBlock Text="120 FPS &amp; HDR 90" FontSize="9.5" FontWeight="Bold" Foreground="#38BDF8"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Official 120Hz high-refresh tablet model • Certified PUBG Ultra Extreme &amp; HDR 90 FPS profile" FontSize="11.5" Foreground="#64748B" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Apply Profile" Command="{Binding ApplyDeviceProfileCommand}" CommandParameter="1" Height="32" Padding="14,0" Cursor="Hand"/>
                                </Grid>
                            </Border>

                            <!-- Device 2: ASUS ROG Phone 5 -->
                            <Border Background="#151926" BorderBrush="#252E46" BorderThickness="1" CornerRadius="14" Padding="16,14" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="3.5" Height="32" CornerRadius="2" Margin="0,0,14,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedDeviceIndex}" Value="2">
                                                        <Setter Property="Background" Value="#38BDF8"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="ASUS ROG Phone 5 (ASUS_I005D)" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC"/>
                                            <Border Background="#1E273A" CornerRadius="4" Padding="6,1.5" Margin="8,0,0,0">
                                                <TextBlock Text="90 FPS ROCK SOLID" FontSize="9.5" FontWeight="Bold" Foreground="#94A3B8"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Rock-solid 90 FPS configuration for mid-range systems with zero thermal/framerate jitter" FontSize="11.5" Foreground="#64748B" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Apply Profile" Command="{Binding ApplyDeviceProfileCommand}" CommandParameter="2" Height="32" Padding="14,0" Cursor="Hand"/>
                                </Grid>
                            </Border>

                            <!-- Device 3: Xiaomi 13 Pro -->
                            <Border Background="#151926" BorderBrush="#252E46" BorderThickness="1" CornerRadius="14" Padding="16,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="3.5" Height="32" CornerRadius="2" Margin="0,0,14,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedDeviceIndex}" Value="3">
                                                        <Setter Property="Background" Value="#38BDF8"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Xiaomi 13 Pro (2210132C)" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC"/>
                                            <Border Background="#16293D" BorderBrush="#1D4363" BorderThickness="1" CornerRadius="4" Padding="6,1.5" Margin="8,0,0,0">
                                                <TextBlock Text="120 FPS HDR" FontSize="9.5" FontWeight="Bold" Foreground="#38BDF8"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Snapdragon 8 Gen 2 profile with high color gamut and 120 FPS support" FontSize="11.5" Foreground="#64748B" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Apply Profile" Command="{Binding ApplyDeviceProfileCommand}" CommandParameter="3" Height="32" Padding="14,0" Cursor="Hand"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- TAB 4: GAMELOOP DOCTOR & REGISTRY TWEAKS                    -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <StackPanel Visibility="{Binding SelectedSubTab, Converter={StaticResource IntEqualsToVis}, ConverterParameter=4}">

                <!-- System Micro-stutter Fixes (HVCI & AppMarket) -->
                <Border Background="#121520" BorderBrush="#252B3E" BorderThickness="1.2" CornerRadius="18" Padding="24,20" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="GameLoop Doctor • Latency &amp; Micro-Stutter Fixes" FontSize="17" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,4"/>
                        <TextBlock Text="Deep Windows sub-system patches that eliminate virtualization lag and stuttering" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,16"/>

                        <TextBlock Text="{Binding DoctorStatusMessage}" FontSize="11.5" Foreground="{StaticResource AccentGreenBrush}" Margin="0,0,0,12" Visibility="{Binding DoctorStatusMessage, Converter={StaticResource StringToVis}}"/>

                        <!-- Item 1: Core Isolation (HVCI) Bypass -->
                        <Border Background="#161924" BorderBrush="#262D42" BorderThickness="1" CornerRadius="14" Padding="16,14" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="Disable Core Isolation (HVCI) for VT-x Acceleration" FontSize="14" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                                        <Border Background="#16293D" CornerRadius="4" Padding="6,1.5" Margin="8,0,0,0">
                                            <TextBlock Text="MAX FPS FIX" FontSize="9.5" FontWeight="Bold" Foreground="#38BDF8"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Hypervisor-Protected Code Integrity (HVCI) causes severe 15-30% CPU latency in Android emulators. Disabling it gives silky smooth frame pacing." FontSize="11.5" Foreground="#64748B" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1" Command="{Binding ToggleCoreIsolationHvciCommand}" Height="34" Padding="14,0" VerticalAlignment="Center" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                            <Setter Property="Content" Value="Disable HVCI (Boost FPS)"/>
                                            <Setter Property="Background" Value="#10B981"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCoreIsolationHvciDisabled}" Value="True">
                                                    <Setter Property="Content" Value="✓ HVCI Disabled (Optimized)"/>
                                                    <Setter Property="Background" Value="#1C2638"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Item 2: AppMarket Auto-Close -->
                        <Border Background="#161924" BorderBrush="#262D42" BorderThickness="1" CornerRadius="14" Padding="16,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="AppMarket Background Process Auto-Close" FontSize="14" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                                        <Border Background="#1E273A" CornerRadius="4" Padding="6,1.5" Margin="8,0,0,0">
                                            <TextBlock Text="SAVES 400MB RAM" FontSize="9.5" FontWeight="Bold" Foreground="#94A3B8"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Automatically closes the Tencent AppMarket UI once the game launches, freeing up 300MB-500MB of background RAM and eliminating background telemetry." FontSize="11.5" Foreground="#64748B" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1" Command="{Binding ToggleAppMarketAutoCloseCommand}" Height="34" Padding="14,0" VerticalAlignment="Center" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                            <Setter Property="Content" Value="Enable Auto-Close"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAppMarketAutoCloseActive}" Value="True">
                                                    <Setter Property="Content" Value="✓ Active"/>
                                                    <Setter Property="Foreground" Value="#10B981"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- GameLoop Registry Edits List -->
                <Border Background="#121520" BorderBrush="#252B3E" BorderThickness="1.2" CornerRadius="18" Padding="24,20">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="GameLoop Registry Tweaks" FontSize="17" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,4"/>
                                <TextBlock Text="Dedicated GPU preference, process priority &amp; network responsiveness keys" Foreground="#94A3B8" FontSize="12"/>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="⚡ Apply All GameLoop Edits" Command="{Binding ApplyAllRegistryEditsCommand}" IsEnabled="{Binding IsOneTapBusy, Converter={StaticResource InvBoolToVis}}" Height="34" Padding="16,0" VerticalAlignment="Center"/>
                        </Grid>

                        <TextBlock Text="{Binding OneTapStatus}" Foreground="{StaticResource AccentGreenBrush}" FontSize="12" Margin="0,0,0,10" Visibility="{Binding OneTapStatus, Converter={StaticResource StringToVis}}"/>

                        <ItemsControl ItemsSource="{Binding RegistryEdits}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#161924" BorderBrush="#23283A" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                                                    <Border Background="#1E293B" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" Visibility="{Binding RequiresAdmin, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="ADMIN" FontSize="9" FontWeight="Bold" Foreground="#38BDF8"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Description}" FontSize="11.5" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                                <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="{StaticResource AccentGreenBrush}" Visibility="{Binding StatusMessage, Converter={StaticResource StringToVis}}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                                                <Button Style="{StaticResource SecondaryButton}" Content="Apply" Command="{Binding ToggleCommand}" CommandParameter="{x:Static System:Boolean.TrueString}" MinWidth="80" Height="30" Margin="0,0,0,4"/>
                                                <TextBlock HorizontalAlignment="Center" FontSize="10.5" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="Disabled"/>
                                                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                                    <Setter Property="Text" Value="Active ✓"/>
                                                                    <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- TAB 5: STORAGE & SAFE CLOSE                                 -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <StackPanel Visibility="{Binding SelectedSubTab, Converter={StaticResource IntEqualsToVis}, ConverterParameter=5}">
                <Border Background="#121520" BorderBrush="#252B3E" BorderThickness="1.2" CornerRadius="18" Padding="24,20" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Safe Close &amp; Cache Maintenance" FontSize="17" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,4"/>
                        <TextBlock Text="Prevent keymap corruption, flush disk buffers gracefully, and clean compiled shader caches" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,16"/>

                        <TextBlock Text="{Binding StorageStatusMessage}" FontSize="11.5" Foreground="{StaticResource AccentGreenBrush}" Margin="0,0,0,12" Visibility="{Binding StorageStatusMessage, Converter={StaticResource StringToVis}}"/>

                        <UniformGrid Columns="2" Rows="1">
                            <!-- 1-Click Safe Close Card -->
                            <Border Background="#161924" BorderBrush="#262D42" BorderThickness="1" CornerRadius="14" Padding="18,16" Margin="0,0,10,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                        <TextBlock Text="🛡️ Graceful Safe Close" FontSize="15" FontWeight="Bold" Foreground="#F8FAFC"/>
                                        <TextBlock Text="Flush buffers &amp; protect keymaps" FontSize="11.5" Foreground="#64748B" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Text="Closes AndroidProcess, aow_exe, and AppMarket in safe sequence, waiting for virtual disk buffers to flush. Completely prevents PUBG corrupted layout resets." FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,16"/>
                                    <Button Grid.Row="2" Style="{StaticResource PrimaryButton}" Content="🛑 Safe Close GameLoop" Command="{Binding SafeCloseGameLoopActionCommand}" Height="36" Cursor="Hand"/>
                                </Grid>
                            </Border>

                            <!-- Clean Shader & Temp Cache Card -->
                            <Border Background="#161924" BorderBrush="#262D42" BorderThickness="1" CornerRadius="14" Padding="18,16" Margin="10,0,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                        <TextBlock Text="🧹 Purge DirectX Shader Cache" FontSize="15" FontWeight="Bold" Foreground="#F8FAFC"/>
                                        <TextBlock Text="Fix stutter caused by corrupted cache" FontSize="11.5" Foreground="#64748B" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Text="Removes stale compiled shaders, Tencent AppMarket temp logs, and emulator junk files. Forces GameLoop to rebuild a fresh, stutter-free shader pipeline." FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,16"/>
                                    <Button Grid.Row="2" Style="{StaticResource SecondaryButton}" Content="🗑️ Clean Shader Cache" Command="{Binding CleanShaderCacheActionCommand}" Height="36" Cursor="Hand"/>
                                </Grid>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- GameLoop Complete Uninstaller & Nuclear System Wiper Card -->
                <Border Background="#121520" BorderBrush="#252B3E" BorderThickness="1.2" CornerRadius="18" Padding="24,20" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="🗑️ GameLoop Uninstaller &amp; Nuclear Cache Wiper" FontSize="17" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,4"/>
                        <TextBlock Text="Launch the official GameLoop uninstaller or run a comprehensive 7-step nuclear wipe to purge all residual registry hives, temp caches, drivers and directories across all drives." Foreground="#94A3B8" FontSize="12" Margin="0,0,0,16"/>

                        <!-- Action Buttons -->
                        <UniformGrid Columns="2" Rows="1" Margin="0,0,0,14">
                            <!-- Button 1: Official Uninstaller -->
                            <Border Background="#161924" BorderBrush="#3B1C22" BorderThickness="1" CornerRadius="14" Padding="16,14" Margin="0,0,8,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Margin="0,0,0,6">
                                        <TextBlock Text="🗑️ Official GameLoop Uninstaller" FontSize="14" FontWeight="Bold" Foreground="#EF4444"/>
                                        <TextBlock Text="Runs official TUninstall.exe setup" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Text="Launches the certified Tencent uninstaller wizard to cleanly remove the emulator components and game packages." FontSize="11.5" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,14"/>
                                    <Button Grid.Row="2" Command="{Binding UninstallGameLoopCommand}" Cursor="Hand" Height="36">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="BtnBox" Background="#2A1215" BorderBrush="#DC2626" BorderThickness="1" CornerRadius="8">
                                                    <TextBlock Text="🗑️ Uninstall GameLoop" FontSize="12" FontWeight="Bold" Foreground="#EF4444" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="BtnBox" Property="Background" Value="#3B171D"/>
                                                        <Setter TargetName="BtnBox" Property="BorderBrush" Value="#EF4444"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Button 2: Nuclear Clean -->
                            <Border Background="#161924" BorderBrush="#2F1C4A" BorderThickness="1" CornerRadius="14" Padding="16,14" Margin="8,0,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Margin="0,0,0,6">
                                        <TextBlock Text="🧹 Nuclear Deep Wiper (All Drives)" FontSize="14" FontWeight="Bold" Foreground="#A78BFA"/>
                                        <TextBlock Text="Deletes registry, drivers, temp &amp; caches" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Text="Terminates all Tencent daemons, deletes QMEmulatorService/aow_drv drivers, unloads QMConfig, deletes all HKCU/HKLM registry keys, wipes TxGameAssistant and TxGameDownload temp caches across all fixed drives." FontSize="11.5" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,14"/>
                                    <Button Grid.Row="2" Command="{Binding NuclearCleanGameLoopCommand}" Cursor="Hand" Height="36">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="BtnBox2" Background="#231536" BorderBrush="#7C3AED" BorderThickness="1" CornerRadius="8">
                                                    <TextBlock Text="🧹 Nuclear Clean (Registry &amp; Temp)" FontSize="12" FontWeight="Bold" Foreground="#A78BFA" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="BtnBox2" Property="Background" Value="#321B4F"/>
                                                        <Setter TargetName="BtnBox2" Property="BorderBrush" Value="#8B5CF6"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>
                        </UniformGrid>

                        <!-- Status Message -->
                        <TextBlock Text="{Binding CleanerStatusMessage}" FontSize="11.5" Foreground="#38BDF8" TextWrapping="Wrap" Visibility="{Binding CleanerStatusMessage, Converter={StaticResource StringToVis}}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>