<UserControl x:Class="XenomOptimizer.Views.NetworkOptimizationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,24">
        <StackPanel MaxWidth="1100">
            <TextBlock Text="Network Optimization" FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
            <TextBlock Text="Network utilities and DNS configuration"
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,24"/>

            <!-- DNS Notice -->
            <Border CornerRadius="8" Padding="16" Margin="0,0,0,20"
                    BorderThickness="1" BorderBrush="{StaticResource AccentCyanDimBrush}">
                <Border.Background><SolidColorBrush Color="#0A00D4FF"/></Border.Background>
                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}">
                    <Run Text="ℹ Note:" FontWeight="SemiBold" Foreground="{StaticResource AccentCyanBrush}"/>
                    DNS changes affect domain name resolution speed, not direct game server latency.
                    In-game ping is determined by your physical distance to game servers and ISP routing.
                    DNS changes may improve connection time but do not guarantee lower in-game ping.
                </TextBlock>
            </Border>

            <!-- Status message -->
            <TextBlock Text="{Binding StatusMessage}" FontSize="12"
                       Foreground="{StaticResource AccentGreenBrush}" Margin="0,0,0,12"
                       Visibility="{Binding StatusMessage, Converter={StaticResource StringToVis}}"
                       TextWrapping="Wrap"/>

            <!-- Network Adapters -->
            <TextBlock Text="NETWORK ADAPTERS" FontSize="11" FontWeight="SemiBold"
                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12"/>

            <TextBlock Text="⏳ Detecting..." Foreground="{StaticResource TextMutedBrush}"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>

            <ItemsControl ItemsSource="{Binding Adapters}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/><RowDefinition/><RowDefinition/>
                                    <RowDefinition/><RowDefinition/><RowDefinition/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Adapter" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>

                                <TextBlock Grid.Row="1" Text="Type" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ConnectionType}" FontSize="12"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>

                                <TextBlock Grid.Row="2" Text="IPv4" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding IPv4Address}" FontSize="12"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>

                                <TextBlock Grid.Row="3" Text="DNS" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DnsServers}" FontSize="12"
                                           Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>

                                <TextBlock Grid.Row="4" Text="Speed" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Speed}" FontSize="12"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>

                                <TextBlock Grid.Row="5" Text="Status" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Status}" FontSize="12"
                                           Foreground="{StaticResource AccentGreenBrush}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Network Utilities -->
            <TextBlock Text="NETWORK UTILITIES" FontSize="11" FontWeight="SemiBold"
                       Foreground="{StaticResource TextMutedBrush}" Margin="0,16,0,12"/>

            <Border Style="{StaticResource CardBorder}">
                <WrapPanel>
                    <StackPanel Margin="0,0,16,8" Width="200">
                        <TextBlock Text="Flush DNS Cache" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="Clears the DNS resolver cache. Safe operation." FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="Flush DNS"
                                Command="{Binding FlushDnsCommand}" Padding="16,8"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,16,8" Width="200">
                        <TextBlock Text="Renew IP Address" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="Releases and renews DHCP lease. May briefly disconnect." FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="Renew IP"
                                Command="{Binding RenewIpCommand}" Padding="16,8"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,16,8" Width="200">
                        <TextBlock Text="Reset Winsock" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="Resets Winsock catalog. Requires system restart." FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                        <Button Style="{StaticResource SecondaryButton}" Content="Reset Winsock"
                                Command="{Binding ResetWinsockCommand}" Padding="16,8"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,16,8" Width="200">
                        <TextBlock Text="Reset TCP/IP" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="Resets TCP/IP stack. Requires system restart." FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                        <Button Style="{StaticResource DangerButton}" Content="Reset TCP/IP"
                                Command="{Binding ResetTcpIpCommand}" Padding="16,8"/>
                    </StackPanel>
                </WrapPanel>
            </Border>

            <!-- DNS Presets -->
            <TextBlock Text="DNS PRESETS" FontSize="11" FontWeight="SemiBold"
                       Foreground="{StaticResource TextMutedBrush}" Margin="0,16,0,12"/>

            <ItemsControl ItemsSource="{Binding DnsPresets}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0">
                                        <Run Text="Primary: "/><Run Text="{Binding Primary}" Foreground="{StaticResource AccentCyanBrush}"/>
                                        <Run Text="  Secondary: "/><Run Text="{Binding Secondary}" Foreground="{StaticResource AccentCyanBrush}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Description}" FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
