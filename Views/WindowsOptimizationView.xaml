                                                </Border>

                                                <!-- Line 3: Description line 1 -->
                                                <Border x:Name="ShimPill3" Height="10" Width="340" CornerRadius="5" HorizontalAlignment="Left" Margin="0,0,0,6">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5" MappingMode="RelativeToBoundingBox">
                                                            <LinearGradientBrush.RelativeTransform>
                                                                <TranslateTransform X="-1.0"/>
                                                            </LinearGradientBrush.RelativeTransform>
                                                            <GradientStop Color="#202228" Offset="0.0"/>
                                                            <GradientStop Color="#202228" Offset="0.25"/>
                                                            <GradientStop Color="#3E4452" Offset="0.50"/>
                                                            <GradientStop Color="#202228" Offset="0.75"/>
                                                            <GradientStop Color="#202228" Offset="1.0"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>

                                                <!-- Line 4: Description line 2 -->
                                                <Border x:Name="ShimPill4" Height="10" Width="290" CornerRadius="5" HorizontalAlignment="Left" Margin="0,0,0,6">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5" MappingMode="RelativeToBoundingBox">
                                                            <LinearGradientBrush.RelativeTransform>
                                                                <TranslateTransform X="-1.0"/>
                                                            </LinearGradientBrush.RelativeTransform>
                                                            <GradientStop Color="#202228" Offset="0.0"/>
                                                            <GradientStop Color="#202228" Offset="0.25"/>
                                                            <GradientStop Color="#3E4452" Offset="0.50"/>
                                                            <GradientStop Color="#202228" Offset="0.75"/>
                                                            <GradientStop Color="#202228" Offset="1.0"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>

                                                <!-- Line 5: Description line 3 -->
                                                <Border x:Name="ShimPill5" Height="10" Width="170" CornerRadius="5" HorizontalAlignment="Left">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5" MappingMode="RelativeToBoundingBox">
                                                            <LinearGradientBrush.RelativeTransform>
                                                                <TranslateTransform X="-1.0"/>
                                                            </LinearGradientBrush.RelativeTransform>
                                                            <GradientStop Color="#202228" Offset="0.0"/>
                                                            <GradientStop Color="#202228" Offset="0.25"/>
                                                            <GradientStop Color="#3E4452" Offset="0.50"/>
                                                            <GradientStop Color="#202228" Offset="0.75"/>
                                                            <GradientStop Color="#202228" Offset="1.0"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                            </StackPanel>

                                            <!-- Skeleton Right: 2 Action Button placeholders with Internal Shimmer -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                                <!-- Button 1 Placeholder -->
                                                <Border x:Name="ShimBtn1" Width="90" Height="36" CornerRadius="10" Margin="0,0,8,0">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5" MappingMode="RelativeToBoundingBox">
                                                            <LinearGradientBrush.RelativeTransform>
                                                                <TranslateTransform X="-1.0"/>
                                                            </LinearGradientBrush.RelativeTransform>
                                                            <GradientStop Color="#202228" Offset="0.0"/>
                                                            <GradientStop Color="#202228" Offset="0.25"/>
                                                            <GradientStop Color="#3E4452" Offset="0.50"/>
                                                            <GradientStop Color="#202228" Offset="0.75"/>
                                                            <GradientStop Color="#202228" Offset="1.0"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>

                                                <!-- Button 2 Placeholder -->
                                                <Border x:Name="ShimBtn2" Width="158" Height="36" CornerRadius="10">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5" MappingMode="RelativeToBoundingBox">
                                                            <LinearGradientBrush.RelativeTransform>
                                                                <TranslateTransform X="-1.0"/>
                                                            </LinearGradientBrush.RelativeTransform>
                                                            <GradientStop Color="#202228" Offset="0.0"/>
                                                            <GradientStop Color="#202228" Offset="0.25"/>
                                                            <GradientStop Color="#3E4452" Offset="0.50"/>
                                                            <GradientStop Color="#202228" Offset="0.75"/>
                                                            <GradientStop Color="#202228" Offset="1.0"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
