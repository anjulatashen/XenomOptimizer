                                                                                <Setter TargetName="DriverBtnBorder" Property="BorderBrush" Value="#25262C"/>
                                                                                <Setter TargetName="DriverBtnBorder" Property="BorderThickness" Value="1"/>
                                                                                <Setter TargetName="DriverBtnText" Property="Foreground" Value="#71717A"/>
                                                                                <Setter Property="IsEnabled" Value="False"/>
                                                                            </DataTrigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>

                                            </StackPanel>

                                        </Grid>

                                        <!-- 2. Skeleton Driver Content (Loading Shimmer Placeholder matching Photo 3) -->
                                        <Grid x:Name="SkeletonDriverContent" Visibility="Collapsed" IsHitTestVisible="False">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Skeleton Left: 5 Rounded Capsule Pills with Internal Shimmer -->
                                            <StackPanel VerticalAlignment="Center">
                                                <!-- Line 1: Title capsule -->
                                                <Border x:Name="ShimPill1" Height="16" Width="210" CornerRadius="8" HorizontalAlignment="Left" Margin="0,0,0,8">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5" MappingMode="RelativeToBoundingBox">
                                                            <LinearGradientBrush.RelativeTransform>
                                                                <TranslateTransform X="-1.0"/>
                                                            </LinearGradientBrush.RelativeTransform>
                                                            <GradientStop Color="#262932" Offset="0.0"/>
                                                            <GradientStop Color="#262932" Offset="0.25"/>
                                                            <GradientStop Color="#4A5266" Offset="0.50"/>
                                                            <GradientStop Color="#262932" Offset="0.75"/>
                                                            <GradientStop Color="#262932" Offset="1.0"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>

                                                <!-- Line 2: Spec capsule -->
                                                <Border x:Name="ShimPill2" Height="14" Width="140" CornerRadius="7" HorizontalAlignment="Left" Margin="0,0,0,10">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5" MappingMode="RelativeToBoundingBox">
                                                            <LinearGradientBrush.RelativeTransform>
                                                                <TranslateTransform X="-1.0"/>
                                                            </LinearGradientBrush.RelativeTransform>
                                                            <GradientStop Color="#262932" Offset="0.0"/>
                                                            <GradientStop Color="#262932" Offset="0.25"/>
                                                            <GradientStop Color="#4A5266" Offset="0.50"/>
                                                            <GradientStop Color="#262932" Offset="0.75"/>
                                                            <GradientStop Color="#262932" Offset="1.0"/>
                                                        </LinearGradientBrush>
