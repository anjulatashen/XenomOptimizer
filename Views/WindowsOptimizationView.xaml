                                </Grid>

                            </Grid>

                        </Grid>

                    </Grid>

                </StackPanel>



                <!-- ═══════════════════════════════════════════════════════════ -->

                <!-- SLIDE 1: DISABLE UNUSED FEATURES & SERVICES                 -->

                <!-- ═══════════════════════════════════════════════════════════ -->

                <Grid x:Name="ServicesSlideHost" Visibility="{Binding IsServicesSlideActive, Converter={StaticResource BoolToVis}}" Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <!-- Left Column (Services & Features from Photo 1: top to bottom) -->
                        <ColumnDefinition Width="1.25*"/>
                        <ColumnDefinition Width="20"/>
                        <!-- Right Column (Milestones & Defaults / Presets Manager) -->
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ═══════════════════════════════════════════════════════════ -->
                    <!-- LEFT COLUMN: SERVICES & FEATURES (Photo 1 - Top to Bottom)  -->
                    <!-- ═══════════════════════════════════════════════════════════ -->
                    <Grid Grid.Column="0">

                        <!-- CARD 1 (LEFT SIDE): SERVICES & FEATURES TOGGLES (Height 660) -->
                        <Border Background="#121216" BorderBrush="#202128" BorderThickness="1" CornerRadius="22"
                                Padding="24,20,0,0" Height="660" VerticalAlignment="Top">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.35" Color="#000000"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Header: Title + Subtitle and Disable All Button (24px right margin) -->
                                <Grid Grid.Row="0" Margin="0,0,24,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Services &amp; Features" FontSize="17" FontWeight="Bold" Foreground="#FFFFFF"
                                                   FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"/>
                                        <TextBlock Text="{Binding ServicesHeaderSubtitle}" FontSize="12" Foreground="#8E95A5" Margin="0,3,0,0"
                                                   FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"/>
                                    </StackPanel>

                                    <!-- Normal Mode: Disable All Button -->
                                    <Button Grid.Column="1" Command="{Binding DisableAllServicesCommand}" VerticalAlignment="Center" Cursor="Hand" Background="Transparent" BorderThickness="0"
                                            ToolTip="Disable all background services and telemetry for maximum gaming performance"
                                            Visibility="{Binding IsCustomPresetEditActive, Converter={StaticResource InvBoolToVis}}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="b" Background="#181A22" BorderBrush="#252733" BorderThickness="1" CornerRadius="12" Padding="14,6">
                                                    <TextBlock Text="Disable All" FontSize="11.5" FontWeight="SemiBold" Foreground="#E2E8F0"
                                                               FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="b" Property="Background" Value="#252733"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <!-- Custom Preset Edit Mode: Save (White/Black) / Cancel Dynamic Capsule Button (No stroke, no glow) -->
                                    <Button Grid.Column="1" Command="{Binding HandleCustomPresetTopButtonCommand}" VerticalAlignment="Center" Cursor="Hand" Background="Transparent" BorderThickness="0"
                                            ToolTip="{Binding CustomPresetTopButtonToolTip}"
                                            Visibility="{Binding IsCustomPresetEditActive, Converter={StaticResource BoolToVis}}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="b" Background="{Binding CustomPresetTopButtonBackground}" BorderThickness="0" CornerRadius="12" Padding="16,6">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding CustomPresetTopButtonIcon}" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{Binding CustomPresetTopButtonForeground}" Margin="0,1,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding CustomPresetTopButtonText}" FontSize="12" FontWeight="Bold" Foreground="{Binding CustomPresetTopButtonForeground}"
                                                                   FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="b" Property="Opacity" Value="0.88"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>

                                <!-- Divider Line (24px right margin) -->
                                <Border Grid.Row="1" Height="1" Background="#1C1E26" Margin="0,0,24,14"/>

                                <!-- Scrollable Items Area with Bottom Fade Effect: Scrollbar sits towards right edge with balanced gutter -->
                                <Grid Grid.Row="2" ClipToBounds="True">
                                    <ScrollViewer x:Name="ServicesItemsScrollViewer"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  Focusable="False"
                                                  Padding="0,0,28,44"
                                                  PreviewMouseWheel="ServicesItemsScrollViewer_PreviewMouseWheel">
                                        <ScrollViewer.Resources>
                                            <!-- Slim Sleek Thumb matching Driver Hub width & 3x height -->
                                            <Style x:Key="ServicesVerticalScrollBarThumbStyle" TargetType="Thumb">
                                                <Setter Property="OverridesDefaultStyle" Value="True"/>
                                                <Setter Property="IsTabStop" Value="False"/>
                                                <Setter Property="MinHeight" Value="40"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border x:Name="ThumbVisual"
                                                                    HorizontalAlignment="Center"
                                                                    Margin="0, 4, 0, 4"
                                                                    SnapsToDevicePixels="True">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Width" Value="5.0"/>
                                                                        <Setter Property="CornerRadius" Value="2.5"/>
                                                                        <Setter Property="Background" Value="#656E80"/>
                                                                        <Setter Property="Opacity" Value="0.75"/>
                                                                        <Style.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter Property="Width" Value="6.5"/>
                                                                                <Setter Property="CornerRadius" Value="3.25"/>
                                                                                <Setter Property="Background" Value="#94A3B8"/>
                                                                                <Setter Property="Opacity" Value="0.95"/>
                                                                            </Trigger>
                                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ScrollBar}, Path=IsMouseOver}" Value="True">
                                                                                <Setter Property="Width" Value="6.5"/>
                                                                                <Setter Property="CornerRadius" Value="3.25"/>
                                                                                <Setter Property="Background" Value="#94A3B8"/>
                                                                                <Setter Property="Opacity" Value="0.95"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsDragging}" Value="True">
                                                                                <Setter Property="Width" Value="6.5"/>
                                                                                <Setter Property="CornerRadius" Value="3.25"/>
                                                                                <Setter Property="Background" Value="#CBD5E1"/>
                                                                                <Setter Property="Opacity" Value="1.0"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>

                                            <!-- ScrollBar with AutoHide & 6px edge margin, 42px bottom cutoff so it never reaches bottom corner curve -->
                                            <Style TargetType="ScrollBar">
                                                <Setter Property="conv:ScrollBarAutoHideHelper.AutoHide" Value="True"/>
                                                <Setter Property="SnapsToDevicePixels" Value="True"/>
                                                <Setter Property="OverridesDefaultStyle" Value="True"/>
                                                <Setter Property="Orientation" Value="Vertical"/>
                                                <Setter Property="Width" Value="10"/>
                                                <Setter Property="Margin" Value="0,0,6,42"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ScrollBar">
                                                            <Grid Background="Transparent">
                                                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                                                    <Track.DecreaseRepeatButton>
                                                                        <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                                                      Focusable="False" IsTabStop="False"
                                                                                      Opacity="0" Background="Transparent" BorderThickness="0"/>
                                                                    </Track.DecreaseRepeatButton>
                                                                    <Track.Thumb>
                                                                        <Thumb Style="{StaticResource ServicesVerticalScrollBarThumbStyle}"/>
                                                                    </Track.Thumb>
                                                                    <Track.IncreaseRepeatButton>
                                                                        <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                                                      Focusable="False" IsTabStop="False"
                                                                                      Opacity="0" Background="Transparent" BorderThickness="0"/>
                                                                    </Track.IncreaseRepeatButton>
                                                                </Track>
                                                            </Grid>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ScrollViewer.Resources>

                                        <!-- ItemsControl with All Services (Xbox Game Bar, Game DVR, Background Apps, etc.) -->
                                        <ItemsControl ItemsSource="{Binding FilteredServicesOptimizations}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,12" Opacity="{Binding CategoryOpacity}">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid Grid.Row="0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- CheckBox for Custom Preset Selection (Visible only in Custom Edit Mode) -->
                                                            <Border Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0"
                                                                    Visibility="{Binding IsInCustomEditMode, Converter={StaticResource BoolToVis}}"
                                                                    Cursor="Hand">
                                                                <Border.InputBindings>
                                                                    <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleCustomSelectionCommand}"/>
                                                                </Border.InputBindings>
                                                                <Border Width="20" Height="20" CornerRadius="6" BorderThickness="1.5">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Background" Value="#181A22"/>
                                                                            <Setter Property="BorderBrush" Value="#353A48"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsCustomSelected}" Value="True">
                                                                                    <Setter Property="Background" Value="#D1FE29"/>
                                                                                    <Setter Property="BorderBrush" Value="#D1FE29"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="11" FontWeight="Bold"
                                                                               Foreground="#0A0B0E" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                               Visibility="{Binding IsCustomSelected, Converter={StaticResource BoolToVis}}"/>
                                                                </Border>
                                                            </Border>

                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0" Cursor="{Binding RowCursor}">
                                                                <StackPanel.InputBindings>
                                                                    <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleCustomSelectionCommand}"/>
                                                                </StackPanel.InputBindings>
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" Foreground="#FFFFFF"
                                                                               FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"/>
                                                                    <Border Margin="8,0,0,0" Padding="5,1,6,1" Background="#242832" CornerRadius="4"
                                                                            VerticalAlignment="Center"
                                                                            Visibility="{Binding IsLockedBadgeVisible, Converter={StaticResource BoolToVis}}">
                                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                            <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="9" Foreground="#8E95A5" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                                                            <TextBlock Text="Locked" FontSize="10" FontWeight="SemiBold" Foreground="#8E95A5" VerticalAlignment="Center"/>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding Description}" FontSize="11.5" Foreground="#7E8695"
                                                                           TextTrimming="CharacterEllipsis" HorizontalAlignment="Left" Margin="0,2,0,0"
                                                                           ToolTip="{Binding Description}"
                                                                           FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"/>
                                                            </StackPanel>

                                                            <!-- Modern Capsule Toggle Switch (Normal Mode) -->
                                                            <ToggleButton Grid.Column="2" VerticalAlignment="Center"
                                                                          Style="{StaticResource ModernCapsuleToggleSwitch}"
                                                                          IsChecked="{Binding IsToggled, Mode=TwoWay}"
                                                                          IsEnabled="{Binding CanToggleSwitch}"
                                                                          ToolTip="{Binding ToggleToolTip}"
                                                                          Visibility="{Binding IsInCustomEditMode, Converter={StaticResource InvBoolToVis}}"/>

                                                            <!-- Selected Badge in Custom Edit Mode: Black box, green text, no stroke, no glow -->
                                                            <Border Grid.Column="2" VerticalAlignment="Center" Padding="8,4" CornerRadius="8"
                                                                    Visibility="{Binding IsInCustomEditMode, Converter={StaticResource BoolToVis}}"
                                                                    Cursor="Hand">
                                                                <Border.InputBindings>
                                                                    <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleCustomSelectionCommand}"/>
                                                                </Border.InputBindings>
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="#0A0B0E"/>
                                                                        <Setter Property="BorderThickness" Value="0"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsCustomSelected}" Value="True">
                                                                                <Setter Property="Background" Value="#0A0B0E"/>
                                                                                <Setter Property="BorderThickness" Value="0"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Text" Value="Excluded"/>
                                                                            <Setter Property="Foreground" Value="#4B5565"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsCustomSelected}" Value="True">
                                                                                    <Setter Property="Text" Value="Included"/>
                                                                                    <Setter Property="Foreground" Value="#D1FE29"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Border>
                                                        </Grid>
                                                        <!-- Row separator -->
                                                        <Border Grid.Row="1" Height="1" Background="#161820" Margin="0,12,0,0"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <!-- Bottom Fade Effect (Driver Hub Scan Style: #00121216 to #FF121216) -->
                                    <Border VerticalAlignment="Bottom" Height="50" IsHitTestVisible="False" Panel.ZIndex="10" Margin="0,0,20,0">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#00121216" Offset="0.0"/>
                                                <GradientStop Color="#15121216" Offset="0.15"/>
                                                <GradientStop Color="#50121216" Offset="0.40"/>
                                                <GradientStop Color="#A0121216" Offset="0.65"/>
                                                <GradientStop Color="#E6121216" Offset="0.85"/>
                                                <GradientStop Color="#FF121216" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>

                    </Grid>

                    <!-- ═══════════════════════════════════════════════════════════ -->
                    <!-- RIGHT COLUMN: Milestones & Defaults / Presets Manager       -->
                    <!-- ═══════════════════════════════════════════════════════════ -->
                    <Grid Grid.Column="2" Height="660" VerticalAlignment="Top">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="0.85*"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="1.15*"/>
                        </Grid.RowDefinitions>

                        <!-- CARD 2 (TOP RIGHT): MILESTONES & PEAK PERFORMANCE -->
                        <Border Grid.Row="0" Background="#121216" BorderBrush="#202128" BorderThickness="1" CornerRadius="22"
                                Padding="24,20">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.35" Color="#000000"/>
                            </Border.Effect>
                            <Grid VerticalAlignment="Top">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Top row: 120+ Peak FPS ⓘ + + Add -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="120+" FontSize="28" FontWeight="Bold" Foreground="#FFFFFF"
                                                   FontFamily="pack://application:,,,/Fonts/#Poppins, Montserrat, Segoe UI Variable Display, sans-serif"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <TextBlock Text="Peak FPS Target" FontSize="11.5" Foreground="#8E95A5"
                                                       FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"/>
                                            <TextBlock Text=" &#xEF15;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="#6E7687"
                                                       VerticalAlignment="Center" Margin="4,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <Button Grid.Column="1" Command="{Binding ToggleManageSlotsCommand}"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center"
                                            ToolTip="Delete or customize the last two presets">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="b" Background="{Binding ManageSlotsButtonBackground}" BorderThickness="0" CornerRadius="12"
                                                        Padding="14,6">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ManageSlotsButtonIcon}" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{Binding ManageSlotsButtonForeground}" Margin="0,1,5,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding ManageSlotsButtonText}" FontSize="11" FontWeight="Bold" Foreground="{Binding ManageSlotsButtonForeground}"
                                                                   FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="b" Property="Opacity" Value="0.85"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="b" Property="Opacity" Value="0.65"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>

                                <!-- Divider Line centered between top header and bottom category badges (Equal 26px top and bottom margin) -->
                                <Border Grid.Row="1" Height="1" Background="#1C1E26" Margin="0,26,0,26"/>

                                <!-- 5 Category Badges (All Services, Ultra Gaming, Normal Gaming, Office & Work, Privacy Focus) -->
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Mode 1: All Services -->
                                    <Button Grid.Column="0" Command="{Binding SelectCategoryCommand}" CommandParameter="All"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Center"
                                            ToolTip="Show all available background services and features">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <Border x:Name="sq" Width="48" Height="48" CornerRadius="15" Background="#191B24" BorderBrush="#262A38" BorderThickness="1">
                                                        <TextBlock x:Name="ic" Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="#D1FE29"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock x:Name="lbl" Text="All&#x0a;Services" FontSize="10.5" Foreground="#8E95A5" HorizontalAlignment="Center" Margin="0,7,0,0" TextAlignment="Center" LineHeight="13"
                                                               FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"/>
                                                </StackPanel>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="sq" Property="Background" Value="#252733"/>
                                                        <Setter TargetName="sq" Property="BorderBrush" Value="#383D4E"/>
                                                        <Setter TargetName="lbl" Property="Foreground" Value="#E2E8F0"/>
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsAllCategorySelected}" Value="True">
                                                        <Setter TargetName="sq" Property="Background" Value="#C8FF00"/>
                                                        <Setter TargetName="sq" Property="BorderThickness" Value="0"/>
                                                        <Setter TargetName="ic" Property="Foreground" Value="#000000"/>
                                                        <Setter TargetName="lbl" Property="Foreground" Value="#FFFFFF"/>
                                                        <Setter TargetName="lbl" Property="FontWeight" Value="SemiBold"/>
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <!-- Mode 2: Ultra Gaming -->
                                    <Button Grid.Column="1" Command="{Binding SelectCategoryCommand}" CommandParameter="UltraGaming"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Center"
                                            ToolTip="Maximum FPS mode: turns off every non-essential background service">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <Border x:Name="sq" Width="48" Height="48" CornerRadius="15" Background="#191B24" BorderBrush="#262A38" BorderThickness="1">
                                                        <TextBlock x:Name="ic" Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="#D1FE29"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock x:Name="lbl" Text="Ultra&#x0a;Gaming" FontSize="10.5" Foreground="#8E95A5" HorizontalAlignment="Center" Margin="0,7,0,0" TextAlignment="Center" LineHeight="13"
                                                               FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"/>
                                                </StackPanel>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="sq" Property="Background" Value="#252733"/>
                                                        <Setter TargetName="sq" Property="BorderBrush" Value="#383D4E"/>
                                                        <Setter TargetName="lbl" Property="Foreground" Value="#E2E8F0"/>
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsUltraGamingCategorySelected}" Value="True">
                                                        <Setter TargetName="sq" Property="Background" Value="#C8FF00"/>
                                                        <Setter TargetName="sq" Property="BorderThickness" Value="0"/>
                                                        <Setter TargetName="ic" Property="Foreground" Value="#000000"/>
                                                        <Setter TargetName="lbl" Property="Foreground" Value="#FFFFFF"/>
                                                        <Setter TargetName="lbl" Property="FontWeight" Value="SemiBold"/>
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <!-- Mode 3: Normal Gaming -->
                                    <Button Grid.Column="2" Command="{Binding SelectCategoryCommand}" CommandParameter="NormalGaming"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Center"
                                            ToolTip="Safe gaming mode: keeps Bluetooth and Printer services for daily gaming">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <Border x:Name="sq" Width="48" Height="48" CornerRadius="15" Background="#191B24" BorderBrush="#262A38" BorderThickness="1">
                                                        <TextBlock x:Name="ic" Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="#D1FE29"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock x:Name="lbl" Text="Normal&#x0a;Gaming" FontSize="10.5" Foreground="#8E95A5" HorizontalAlignment="Center" Margin="0,7,0,0" TextAlignment="Center" LineHeight="13"
                                                               FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"/>
                                                </StackPanel>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="sq" Property="Background" Value="#252733"/>
                                                        <Setter TargetName="sq" Property="BorderBrush" Value="#383D4E"/>
                                                        <Setter TargetName="lbl" Property="Foreground" Value="#E2E8F0"/>
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsNormalGamingCategorySelected}" Value="True">
                                                        <Setter TargetName="sq" Property="Background" Value="#C8FF00"/>
                                                        <Setter TargetName="sq" Property="BorderThickness" Value="0"/>
                                                        <Setter TargetName="ic" Property="Foreground" Value="#000000"/>
                                                        <Setter TargetName="lbl" Property="Foreground" Value="#FFFFFF"/>
                                                        <Setter TargetName="lbl" Property="FontWeight" Value="SemiBold"/>
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <!-- Mode 4: Office & Work / Custom Mode 1 -->
                                    <Grid Grid.Column="3" HorizontalAlignment="Center">
                                        <Button Command="{Binding SelectCategoryCommand}" CommandParameter="OfficeWork"
                                                Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Center"
                                                ToolTip="Slot 4: Custom or Office &amp; Work preset">
                                            <Button.RenderTransform>
                                                <TranslateTransform x:Name="Slot4Translate" X="0"/>
                                            </Button.RenderTransform>
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ShouldShakeSlot4}" Value="True">
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                                                       Duration="0:0:0.35">
                                                                            <LinearDoubleKeyFrame Value="0" KeyTime="0:0:0.00"/>
                                                                            <LinearDoubleKeyFrame Value="-8" KeyTime="0:0:0.05"/>
                                                                            <LinearDoubleKeyFrame Value="8" KeyTime="0:0:0.10"/>
                                                                            <LinearDoubleKeyFrame Value="-6" KeyTime="0:0:0.15"/>
                                                                            <LinearDoubleKeyFrame Value="6" KeyTime="0:0:0.20"/>
                                                                            <LinearDoubleKeyFrame Value="-3" KeyTime="0:0:0.25"/>
                                                                            <LinearDoubleKeyFrame Value="3" KeyTime="0:0:0.30"/>
                                                                            <LinearDoubleKeyFrame Value="0" KeyTime="0:0:0.35"/>
                                                                        </DoubleAnimationUsingKeyFrames>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <Border x:Name="sq" Width="48" Height="48" CornerRadius="15" Background="#191B24" BorderBrush="#262A38" BorderThickness="1">
                                                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <Grid.Style>
                                                                    <Style TargetType="Grid">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding CanDeleteSlot4}" Value="True">
                                                                                <Setter Property="Opacity" Value="0"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Grid.Style>
                                                                <!-- 4-Dot Custom Preset Icon (Image 8: 2x2 round dots) -->
                                                                <UniformGrid Rows="2" Columns="2" Width="17" Height="17"
                                                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                             Visibility="{Binding IsSlot4CustomPresetIconVisible, Converter={StaticResource BoolToVis}}">
                                                                    <Ellipse Width="5" Height="5" Fill="{Binding ElementName=ic, Path=Foreground}" Margin="1.5"/>
                                                                    <Ellipse Width="5" Height="5" Fill="{Binding ElementName=ic, Path=Foreground}" Margin="1.5"/>
                                                                    <Ellipse Width="5" Height="5" Fill="{Binding ElementName=ic, Path=Foreground}" Margin="1.5"/>
                                                                    <Ellipse Width="5" Height="5" Fill="{Binding ElementName=ic, Path=Foreground}" Margin="1.5"/>
                                                                </UniformGrid>
                                                                <!-- Standard Glyph Icon -->
                                                                <TextBlock x:Name="ic" Text="{Binding Slot4Icon, FallbackValue='&#xE821;'}" FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="#D1FE29"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                                                           Visibility="{Binding IsSlot4GlyphIconVisible, Converter={StaticResource BoolToVis}}"/>
                                                            </Grid>
                                                        </Border>
                                                        <TextBlock x:Name="lbl" Text="{Binding Slot4Label, FallbackValue='Office &amp;&#x0a;Work'}" FontSize="10.5" Foreground="#8E95A5" HorizontalAlignment="Center" Margin="0,7,0,0" TextAlignment="Center" LineHeight="13"
                                                                   FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"/>
                                                    </StackPanel>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="sq" Property="Background" Value="#252733"/>
                                                            <Setter TargetName="sq" Property="BorderBrush" Value="#383D4E"/>
                                                            <Setter TargetName="lbl" Property="Foreground" Value="#E2E8F0"/>
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsOfficeWorkCategorySelected}" Value="True">
                                                            <Setter TargetName="sq" Property="Background" Value="#C8FF00"/>
                                                            <Setter TargetName="sq" Property="BorderThickness" Value="0"/>
                                                            <Setter TargetName="ic" Property="Foreground" Value="#000000"/>
                                                            <Setter TargetName="lbl" Property="Foreground" Value="#FFFFFF"/>
                                                            <Setter TargetName="lbl" Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <!-- Delete Slot 4 Button: Red trash bin icon without background (bg ekak nethuwa red bin icon) -->
                                        <Button Command="{Binding DeleteSlotCommand}" CommandParameter="4"
                                                HorizontalAlignment="Center" VerticalAlignment="Top"
                                                Margin="0,0,0,0"
                                                Width="48" Height="48" Cursor="Hand"
                                                Background="Transparent" BorderThickness="0"
                                                Visibility="{Binding CanDeleteSlot4, Converter={StaticResource BoolToVis}}"
                                                ToolTip="Delete this preset slot">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="Transparent" BorderThickness="0">
                                                        <TextBlock x:Name="BinIcon4" Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                                                   Foreground="#EF4444" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="BinIcon4" Property="Foreground" Value="#FF6B6B"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="BinIcon4" Property="Opacity" Value="0.7"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>

                                    <!-- Mode 5: Privacy Focus / Custom Mode 2 -->
                                    <Grid Grid.Column="4" HorizontalAlignment="Center">
                                        <Button Command="{Binding SelectCategoryCommand}" CommandParameter="PrivacyFocus"
                                                Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Center"
                                                ToolTip="Slot 5: Custom or Privacy Focus preset">
                                            <Button.RenderTransform>
                                                <TranslateTransform x:Name="Slot5Translate" X="0"/>
                                            </Button.RenderTransform>
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ShouldShakeSlot5}" Value="True">
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                                                       Duration="0:0:0.35">
                                                                            <LinearDoubleKeyFrame Value="0" KeyTime="0:0:0.00"/>
                                                                            <LinearDoubleKeyFrame Value="-8" KeyTime="0:0:0.05"/>
                                                                            <LinearDoubleKeyFrame Value="8" KeyTime="0:0:0.10"/>
                                                                            <LinearDoubleKeyFrame Value="-6" KeyTime="0:0:0.15"/>
                                                                            <LinearDoubleKeyFrame Value="6" KeyTime="0:0:0.20"/>
                                                                            <LinearDoubleKeyFrame Value="-3" KeyTime="0:0:0.25"/>
                                                                            <LinearDoubleKeyFrame Value="3" KeyTime="0:0:0.30"/>
                                                                            <LinearDoubleKeyFrame Value="0" KeyTime="0:0:0.35"/>
                                                                        </DoubleAnimationUsingKeyFrames>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <Border x:Name="sq" Width="48" Height="48" CornerRadius="15" Background="#191B24" BorderBrush="#262A38" BorderThickness="1">
                                                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <Grid.Style>
                                                                    <Style TargetType="Grid">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding CanDeleteSlot5}" Value="True">
                                                                                <Setter Property="Opacity" Value="0"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Grid.Style>
                                                                <!-- 4-Dot Custom Preset Icon (Image 8: 2x2 round dots) -->
                                                                <UniformGrid Rows="2" Columns="2" Width="17" Height="17"
                                                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                             Visibility="{Binding IsSlot5CustomPresetIconVisible, Converter={StaticResource BoolToVis}}">
                                                                    <Ellipse Width="5" Height="5" Fill="{Binding ElementName=ic, Path=Foreground}" Margin="1.5"/>
                                                                    <Ellipse Width="5" Height="5" Fill="{Binding ElementName=ic, Path=Foreground}" Margin="1.5"/>
                                                                    <Ellipse Width="5" Height="5" Fill="{Binding ElementName=ic, Path=Foreground}" Margin="1.5"/>
                                                                    <Ellipse Width="5" Height="5" Fill="{Binding ElementName=ic, Path=Foreground}" Margin="1.5"/>
                                                                </UniformGrid>
                                                                <!-- Standard Glyph Icon -->
                                                                <TextBlock x:Name="ic" Text="{Binding Slot5Icon, FallbackValue='&#xE72E;'}" FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="#D1FE29"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                                                           Visibility="{Binding IsSlot5GlyphIconVisible, Converter={StaticResource BoolToVis}}"/>
                                                            </Grid>
                                                        </Border>
                                                        <TextBlock x:Name="lbl" Text="{Binding Slot5Label, FallbackValue='Privacy&#x0a;Focus'}" FontSize="10.5" Foreground="#8E95A5" HorizontalAlignment="Center" Margin="0,7,0,0" TextAlignment="Center" LineHeight="13"
                                                                   FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"/>
                                                    </StackPanel>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="sq" Property="Background" Value="#252733"/>
                                                            <Setter TargetName="sq" Property="BorderBrush" Value="#383D4E"/>
                                                            <Setter TargetName="lbl" Property="Foreground" Value="#E2E8F0"/>
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsPrivacyFocusCategorySelected}" Value="True">
                                                            <Setter TargetName="sq" Property="Background" Value="#C8FF00"/>
                                                            <Setter TargetName="sq" Property="BorderThickness" Value="0"/>
                                                            <Setter TargetName="ic" Property="Foreground" Value="#000000"/>
                                                            <Setter TargetName="lbl" Property="Foreground" Value="#FFFFFF"/>
                                                            <Setter TargetName="lbl" Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <!-- Delete Slot 5 Button: Red trash bin icon without background (bg ekak nethuwa red bin icon) -->
                                        <Button Command="{Binding DeleteSlotCommand}" CommandParameter="5"
                                                HorizontalAlignment="Center" VerticalAlignment="Top"
                                                Margin="0,0,0,0"
                                                Width="48" Height="48" Cursor="Hand"
                                                Background="Transparent" BorderThickness="0"
                                                Visibility="{Binding CanDeleteSlot5, Converter={StaticResource BoolToVis}}"
                                                ToolTip="Delete this preset slot">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="Transparent" BorderThickness="0">
                                                        <TextBlock x:Name="BinIcon5" Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                                                   Foreground="#EF4444" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="BinIcon5" Property="Foreground" Value="#FF6B6B"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="BinIcon5" Property="Opacity" Value="0.7"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- CARD 3 (BOTTOM RIGHT): DEFAULTS & PRESETS (Dimmed & Disabled in Custom Preset Creation) -->
                        <Border Grid.Row="2" Background="#121216" BorderBrush="#202128" BorderThickness="1" CornerRadius="22"
                                Padding="24,20"
                                Opacity="{Binding Card3Opacity}"
                                IsEnabled="{Binding IsCard3Enabled}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.35" Color="#000000"/>
                            </Border.Effect>
                            <Grid VerticalAlignment="Stretch">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Header: Title & Subtitle + Undo button -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Defaults &amp; Restore Presets" FontSize="16.5" FontWeight="Bold" Foreground="#FFFFFF"
                                                   FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"/>
                                        <TextBlock Text="Restore previous settings or fresh Windows state" FontSize="11.5" Foreground="#8E95A5" Margin="0,3,0,0"
                                                   FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"/>
                                    </StackPanel>

                                    <!-- Undo Button -->
                                    <Button Grid.Column="1" Command="{Binding UndoLastActionCommand}"
                                            IsEnabled="{Binding CanUndo}"
                                            VerticalAlignment="Center" Cursor="Hand" Background="Transparent" BorderThickness="0"
                                            ToolTip="Undo the last setting or preset changed in this tab">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="b" Background="#181A22" BorderBrush="#252733" BorderThickness="1" CornerRadius="12"
                                                        Padding="12,6">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="&#xE7A7;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="#94A3B8" Margin="0,1,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Undo" FontSize="11.5" FontWeight="SemiBold" Foreground="#E2E8F0"
                                                                   FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="b" Property="Background" Value="#252733"/>
                                                        <Setter TargetName="b" Property="BorderBrush" Value="#383D4E"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="b" Property="Background" Value="#101116"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="b" Property="Opacity" Value="0.35"/>
                                                        <Setter Property="Cursor" Value="Arrow"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>

                                <!-- Divider Line under Bottom Header -->
                                <Border Grid.Row="1" Height="1" Background="#1C1E26" Margin="0,16,0,0"/>

                                <!-- Option 1: App Recommended -->
                                <Grid Grid.Row="2" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                            <TextBlock Text="Xenom Recommended" FontSize="13.5" FontWeight="SemiBold" Foreground="#FFFFFF"
                                                       FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"/>
                                            <TextBlock Text="Performance Tweak" FontSize="11" FontWeight="SemiBold" Foreground="#D1FE29"
                                                       Margin="8,0,0,0" VerticalAlignment="Center"
                                                       FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"/>
                                        </StackPanel>
                                        <TextBlock Text="Turns off background telemetry, Game DVR, P2P and unused services for max FPS."
                                                   FontSize="11.5" Foreground="#7E8695" TextWrapping="Wrap"
                                                   FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" VerticalAlignment="Center"
                                                  Style="{StaticResource ModernCapsuleToggleSwitch}"
                                                  IsChecked="{Binding IsAppRecommendedActive, Mode=TwoWay}"
                                                  ToolTip="Toggle ON to optimize all recommended / OFF to restore previous values"/>
                                </Grid>

                                <!-- Divider Line 1 -->
                                <Border Grid.Row="3" Height="1" Background="#1C1E26"/>

                                <!-- Option 2: Restore User PC State -->
                                <Grid Grid.Row="4" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="Restore User PC State" FontSize="13.5" FontWeight="SemiBold" Foreground="#FFFFFF"
                                                   FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"/>
                                        <TextBlock Text="Reverts all services to your PC's original pre-optimization configuration."
                                                   FontSize="11.5" Foreground="#7E8695" TextWrapping="Wrap" Margin="0,3,0,0"
                                                   FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" VerticalAlignment="Center"
                                                  Style="{StaticResource ModernCapsuleToggleSwitch}"
                                                  IsChecked="{Binding IsRestoreUserPcActive, Mode=TwoWay}"
                                                  ToolTip="Toggle ON to restore your pre-optimization PC state"/>
                                </Grid>

                                <!-- Divider Line 2 -->
                                <Border Grid.Row="5" Height="1" Background="#1C1E26"/>

                                <!-- Option 3: Windows Stock Defaults -->
                                <Grid Grid.Row="6" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="Windows Stock Defaults" FontSize="13.5" FontWeight="SemiBold" Foreground="#FFFFFF"
                                                   FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"/>
                                        <TextBlock Text="Resets all services to clean install Windows factory defaults."
                                                   FontSize="11.5" Foreground="#7E8695" TextWrapping="Wrap" Margin="0,3,0,0"
                                                   FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" VerticalAlignment="Center"
                                                  Style="{StaticResource ModernCapsuleToggleSwitch}"
                                                  IsChecked="{Binding IsWindowsDefaultsActive, Mode=TwoWay}"
                                                  ToolTip="Toggle ON to reset all services to fresh Windows defaults"/>
                                </Grid>
                            </Grid>
                        </Border>

                    </Grid>

                </Grid>



                <!-- ═══════════════════════════════════════════════════════════ -->

                <!-- SLIDE 2: ADVANCE WINDOWS & LOW-END PC OPTIMIZATION          -->

                <!-- ═══════════════════════════════════════════════════════════ -->

                <Grid x:Name="AdvanceSlideHost" Visibility="{Binding IsAdvanceSlideActive, Converter={StaticResource BoolToVis}}" Margin="0,0,0,24"
                      PreviewMouseWheel="AdvanceSlideHost_PreviewMouseWheel">
                    <Grid.ColumnDefinitions>
                        <!-- Left Column (Advance & Low-End Tweaks List matching Slide 1 layout) -->
                        <ColumnDefinition Width="1.25*"/>
                        <ColumnDefinition Width="20"/>
                        <!-- Right Column (Standby RAM Purge & Presets / Defaults Manager) -->
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ═══════════════════════════════════════════════════════════ -->
                    <!-- LEFT COLUMN: ADVANCE & LOW-END SPOTIFY NOTCH BOX (Height 660)-->
                    <!-- ═══════════════════════════════════════════════════════════ -->
                    <Grid Grid.Column="0" Height="660" VerticalAlignment="Top">
                        <Grid.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.35" Color="#000000"/>
                        </Grid.Effect>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Notch Header: Height 46 (The actual top contour of the box) -->
                            <RowDefinition Height="*"/>    <!-- Main Card Body: Seamlessly connected below -->
                        </Grid.RowDefinitions>

                        <!-- ========================================================= -->
                        <!-- ROW 0: DUAL-STATE ANIMATED FOLDER NOTCH                   -->
                        <!-- ========================================================= -->
                        <Grid Grid.Row="0" Height="54">
                            <!-- APPLY ALL BUTTON (Far right, Disable All rounded shape with White background & Black text) -->
                            <Button HorizontalAlignment="Right" Command="{Binding ApplyAllSlide2Command}" VerticalAlignment="Center" Margin="0,0,16,0" Cursor="Hand" Background="Transparent" BorderThickness="0"
                                    Panel.ZIndex="30" ToolTip="Apply all recommended tweaks for active configuration">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="ApplyBtnBrd" Background="#FFFFFF" CornerRadius="12" Padding="14,6" VerticalAlignment="Center">
                                            <TextBlock Text="Apply All" FontSize="11.5" FontWeight="Bold" Foreground="#0A0B0E"
                                                       FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ApplyBtnBrd" Property="Background" Value="#F1F5F9"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="ApplyBtnBrd" Property="Background" Value="#E2E8F0"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- ========================================================= -->
                            <!-- STATE A: ADVANCE TWEAKS ACTIVE LAYER (Left Elevated Notch)-->
                            <!-- ========================================================= -->
                            <Grid x:Name="AdvanceTabActiveContainer" Panel.ZIndex="20" Height="54" Opacity="1.0" IsHitTestVisible="True" RenderTransformOrigin="0.2, 0.5">
                                <Grid.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform x:Name="AdvanceTabActiveScale" ScaleX="1" ScaleY="1"/>
                                        <TranslateTransform x:Name="AdvanceTabActiveTranslate" X="0" Y="0"/>
                                    </TransformGroup>
                                </Grid.RenderTransform>

                                <!-- Inactive Low-End PC Tab (Tucked behind at X=270, Height 40) -->
                                <Canvas Height="54">
                                    <Button Canvas.Left="270" Canvas.Top="14" Height="40" Command="{Binding SwitchAdvanceSubTabCommand}" CommandParameter="1"
                                            Cursor="Hand" BorderThickness="0" Background="Transparent" Padding="0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="LowTabBrdA" Height="40" CornerRadius="0, 36, 0, 0" Padding="52,0,22,0"
                                                        Background="#262626" BorderBrush="#383838" BorderThickness="1, 1, 1, 0" VerticalAlignment="Bottom">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="Low-End PC" FontSize="12.5" FontWeight="Bold" Foreground="#FFFFFF"
                                                                   FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif" VerticalAlignment="Center"/>
                                                        <Border Background="#181818" CornerRadius="6" Padding="6,1.5" Margin="8,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="Potato Boost" FontSize="8.5" FontWeight="SemiBold" Foreground="#CBD5E1"/>
                                                        </Border>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="LowTabBrdA" Property="Background" Value="#333333"/>
                                                        <Setter TargetName="LowTabBrdA" Property="BorderBrush" Value="#4D4D4D"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Canvas>

                                <!-- Elevated Advance Tweaks Tab (X=0..260, Height 55) + Right Scoop (X=260..324) -->
                                <Canvas Height="54">
                                    <Button Canvas.Left="0" Canvas.Top="0" Width="260" Height="55" Command="{Binding SwitchAdvanceSubTabCommand}" CommandParameter="0"
                                            Cursor="Hand" BorderThickness="0" Background="Transparent" Padding="0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Height="55" VerticalAlignment="Top" Background="#121216"
                                                        BorderBrush="#202128" BorderThickness="1, 1, 0, 0"
                                                        CornerRadius="22, 0, 0, 0" Padding="0">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="27, 6, 0, 0">
                                                        <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#C8FF00" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Advance Tweaks" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF"
                                                                   FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif" VerticalAlignment="Center"/>
                                                        <Border Background="#253012" CornerRadius="7" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="Kernel &amp; Latency" FontSize="8.5" FontWeight="SemiBold" Foreground="#C8FF00"/>
                                                        </Border>
                                                    </StackPanel>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <!-- S-Curve Scoop (Left-to-Right Downwards) -->
                                    <Grid Canvas.Left="260" Canvas.Top="0" Width="64" Height="55">
                                        <Path Fill="#121216" Data="M 0,0 C 34,0 30,54 64,54 L 64,55 L 0,55 Z"/>
                                        <Path Stroke="#202128" StrokeThickness="1" Data="M 0,0 C 34,0 30,54 64,54"/>
                                    </Grid>
                                </Canvas>
                            </Grid>

                            <!-- ========================================================= -->
                            <!-- STATE B: LOW-END PC ACTIVE LAYER (Right Elevated Notch)  -->
                            <!-- ========================================================= -->
                            <Grid x:Name="LowEndTabActiveContainer" Panel.ZIndex="20" Height="54" Opacity="0.0" IsHitTestVisible="False" RenderTransformOrigin="0.5, 0.5">
                                <Grid.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform x:Name="LowEndTabActiveScale" ScaleX="1" ScaleY="1"/>
                                        <TranslateTransform x:Name="LowEndTabActiveTranslate" X="0" Y="0"/>
                                    </TransformGroup>
                                </Grid.RenderTransform>

                                <!-- Inactive Advance Tweaks Tab (Tucked behind at X=46, Height 40, 30px smooth curved corner) -->
                                <Canvas Height="54">
                                    <Button Canvas.Left="46" Canvas.Top="14" Height="40" Command="{Binding SwitchAdvanceSubTabCommand}" CommandParameter="0"
                                            Cursor="Hand" BorderThickness="0" Background="Transparent" Padding="0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="AdvTabBrdB" Width="260" Height="40" CornerRadius="30, 0, 0, 0" Padding="0"
                                                        Background="#262626" BorderBrush="#383838" BorderThickness="1, 1, 0, 0" VerticalAlignment="Bottom">
                                                    <!-- Centered within the visible region, shifted right to balance against corner curve -->
                                                    <Grid Width="220" HorizontalAlignment="Left">
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="18,0,0,0">
                                                            <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="12.5" Foreground="#808A9D" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="Advance Tweaks" FontSize="12" FontWeight="Bold" Foreground="#808A9D"
                                                                       FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif" VerticalAlignment="Center"/>
                                                            <Border Background="#1A1D24" CornerRadius="5" Padding="5,1.5" Margin="6,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock Text="Kernel &amp; Latency" FontSize="8" FontWeight="SemiBold" Foreground="#556075"/>
                                                            </Border>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="AdvTabBrdB" Property="Background" Value="#333333"/>
                                                        <Setter TargetName="AdvTabBrdB" Property="BorderBrush" Value="#4D4D4D"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Canvas>

                                <!-- Elevated Low-End PC Tab (Left Scoop UP + Center + Right Scoop DOWN) -->
                                <Canvas Height="54">
                                    <!-- Left Scoop (curves UP from Y=54 at X=255 to Y=0 at X=305) -->
                                    <Grid Canvas.Left="255" Canvas.Top="0" Width="50" Height="55">
                                        <Path Fill="#121216" Data="M 0,54 C 26,54 24,0 50,0 L 50,55 L 0,55 Z"/>
                                        <Path Stroke="#202128" StrokeThickness="1" Data="M 0,54 C 26,54 24,0 50,0"/>
                                    </Grid>

                                    <!-- Center Low-End Tab (X=305..487, Width 182, Perfectly Centered) -->
                                    <Button Canvas.Left="305" Canvas.Top="0" Width="182" Height="55" Command="{Binding SwitchAdvanceSubTabCommand}" CommandParameter="1"
                                            Cursor="Hand" BorderThickness="0" Background="Transparent" Padding="0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Height="55" VerticalAlignment="Top" Background="#121216"
                                                        BorderBrush="#202128" BorderThickness="0, 1, 0, 0">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0, 6, 0, 0">
                                                        <TextBlock Text="Low-End PC" FontSize="16.5" FontWeight="Bold" Foreground="#FFFFFF"
                                                                   FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif" VerticalAlignment="Center"/>
                                                        <Border Background="#3D2010" CornerRadius="7" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="Potato Boost" FontSize="8.5" FontWeight="SemiBold" Foreground="#FB923C"/>
                                                        </Border>
                                                    </StackPanel>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <!-- Right Scoop (curves DOWN from Y=0 at X=487 to Y=54 at X=535, matching user reference image) -->
                                    <Grid Canvas.Left="487" Canvas.Top="0" Width="48" Height="55">
                                        <Path Fill="#121216" Data="M 0,0 C 28,0 12,54 48,54 L 48,55 L 0,55 Z"/>
                                        <Path Stroke="#202128" StrokeThickness="1" Data="M 0,0 C 28,0 12,54 48,54"/>
                                    </Grid>
                                </Canvas>
                            </Grid>
                        </Grid>

                        <!-- ========================================================= -->
                        <!-- ROW 1: MAIN CARD BODY (THE BOX ITSELF!)                   -->
                        <!-- ========================================================= -->
                        <Grid Grid.Row="1">
                            <Border x:Name="AdvanceSubTabContentContainer" Background="#121216" BorderBrush="#202128" BorderThickness="1, 1, 1, 1"
                                    CornerRadius="0, 22, 22, 22" Padding="24, 12, 0, 15">
                                <Grid ClipToBounds="True">
                                    <ScrollViewer x:Name="AdvanceSubTabScrollViewer"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  Focusable="False"
                                                  Padding="0,0,28,0"
                                                  PreviewMouseWheel="AdvanceSubTabScrollViewer_PreviewMouseWheel">
                                        <ScrollViewer.Style>
                                            <Style TargetType="ScrollViewer">
                                                <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                                                <Style.Triggers>
                                                    <!-- LOW-END PC: SCROLLING & SCROLLBAR COMPLETELY DISABLED (FEW ITEMS, FITS NATURALLY) -->
                                                    <DataTrigger Binding="{Binding IsLowEndSubTabActive}" Value="True">
                                                        <Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ScrollViewer.Style>
                                        <ScrollViewer.Resources>
                                            <!-- Slim Sleek Thumb matching Slide 1 Services &amp; Features (Both ends curved, taller height) -->
                                            <Style x:Key="AdvanceVerticalScrollBarThumbStyle" TargetType="Thumb">
                                                <Setter Property="OverridesDefaultStyle" Value="True"/>
                                                <Setter Property="IsTabStop" Value="False"/>
                                                <Setter Property="MinHeight" Value="40"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border x:Name="ThumbVisual"
                                                                    HorizontalAlignment="Center"
                                                                    Margin="0, 4, 0, 4"
                                                                    SnapsToDevicePixels="True">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Width" Value="5.0"/>
                                                                        <Setter Property="CornerRadius" Value="2.5"/>
                                                                        <Setter Property="Background" Value="#656E80"/>
                                                                        <Setter Property="Opacity" Value="0.75"/>
                                                                        <Style.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter Property="Width" Value="6.5"/>
                                                                                <Setter Property="CornerRadius" Value="3.25"/>
                                                                                <Setter Property="Background" Value="#94A3B8"/>
                                                                                <Setter Property="Opacity" Value="0.95"/>
                                                                            </Trigger>
                                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ScrollBar}, Path=IsMouseOver}" Value="True">
                                                                                <Setter Property="Width" Value="6.5"/>
                                                                                <Setter Property="CornerRadius" Value="3.25"/>
                                                                                <Setter Property="Background" Value="#94A3B8"/>
                                                                                <Setter Property="Opacity" Value="0.95"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsDragging}" Value="True">
                                                                                <Setter Property="Width" Value="6.5"/>
                                                                                <Setter Property="CornerRadius" Value="3.25"/>
                                                                                <Setter Property="Background" Value="#CBD5E1"/>
                                                                                <Setter Property="Opacity" Value="1.0"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>

                                            <!-- ScrollBar with AutoHide &amp; 6px edge margin, 28px bottom cutoff for rounded capsule visibility -->
                                            <Style TargetType="ScrollBar">
                                                <Setter Property="conv:ScrollBarAutoHideHelper.AutoHide" Value="True"/>
                                                <Setter Property="SnapsToDevicePixels" Value="True"/>
                                                <Setter Property="OverridesDefaultStyle" Value="True"/>
                                                <Setter Property="Orientation" Value="Vertical"/>
                                                <Setter Property="Width" Value="10"/>
                                                <Setter Property="Margin" Value="0,6,6,28"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ScrollBar">
                                                            <Grid Background="Transparent">
                                                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                                                    <Track.DecreaseRepeatButton>
                                                                        <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                                                      Focusable="False" IsTabStop="False"
                                                                                      Opacity="0" Background="Transparent" BorderThickness="0"/>
                                                                    </Track.DecreaseRepeatButton>
                                                                    <Track.Thumb>
                                                                        <Thumb Style="{StaticResource AdvanceVerticalScrollBarThumbStyle}"/>
                                                                    </Track.Thumb>
                                                                    <Track.IncreaseRepeatButton>
                                                                        <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                                                      Focusable="False" IsTabStop="False"
                                                                                      Opacity="0" Background="Transparent" BorderThickness="0"/>
                                                                    </Track.IncreaseRepeatButton>
                                                                </Track>
                                                            </Grid>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ScrollViewer.Resources>

                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <!-- Divider Line (Scrolls with items) -->
                                            <Border Grid.Row="0" Height="1" Background="#161820" Margin="0, 0, 0, 10"/>

                                            <Grid Grid.Row="1">
                                                <!-- Panel 1: Advance Tweaks (Kernel & Latency) -->
                                                <StackPanel x:Name="AdvanceTweaksPanel" Opacity="1.0" RenderTransformOrigin="0.5, 0.2">
                                                    <StackPanel.RenderTransform>
                                                        <TransformGroup>
                                                            <ScaleTransform x:Name="AdvanceTweaksScale" ScaleX="1" ScaleY="1"/>
                                                            <TranslateTransform x:Name="AdvanceTweaksTranslate" X="0" Y="0"/>
                                                        </TransformGroup>
                                                    </StackPanel.RenderTransform>

                                                <ItemsControl ItemsSource="{Binding AdvanceOptimizations}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,0,10">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>
                                                                <Grid Grid.Row="0" MinHeight="48">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <!-- Icon Squircle -->
                                                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="11" Background="#181A22" BorderBrush="#252733" BorderThickness="1"
                                                                            Margin="0,0,14,0" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding IconGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#C8FF00"
                                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>

                                                                    <!-- Name & Description -->
                                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                                                        <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="Bold" Foreground="#FFFFFF"
                                                                                   FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"/>
                                                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#8E95A5" Margin="0,3,0,0"
                                                                                   LineHeight="15" TextWrapping="Wrap" FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"/>
                                                                    </StackPanel>

                                                                    <!-- Capsule ToggleSwitch -->
                                                                    <ToggleButton Grid.Column="2" VerticalAlignment="Center"
                                                                                  Style="{StaticResource ModernCapsuleToggleSwitch}"
                                                                                  IsChecked="{Binding IsToggled, Mode=TwoWay}"
                                                                                  IsEnabled="{Binding CanToggleSwitch}"
                                                                                  ToolTip="{Binding ToggleToolTip}"/>
                                                                </Grid>
                                                                <!-- Row separator -->
                                                                <Border Grid.Row="1" Height="1" Background="#161820" Margin="0,10,0,0"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <!-- Panel 2: Low-End PC (Potato Boost) -->
                                            <StackPanel x:Name="LowEndTweaksPanel" Opacity="0.0" Visibility="Collapsed" RenderTransformOrigin="0.5, 0.2">
                                                <StackPanel.RenderTransform>
                                                    <TransformGroup>
                                                        <ScaleTransform x:Name="LowEndTweaksScale" ScaleX="1" ScaleY="1"/>
                                                        <TranslateTransform x:Name="LowEndTweaksTranslate" X="0" Y="0"/>
                                                    </TransformGroup>
                                                </StackPanel.RenderTransform>

                                                <ItemsControl ItemsSource="{Binding LowEndOptimizations}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,0,10">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>
                                                                <Grid Grid.Row="0" MinHeight="50">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <!-- Icon Squircle -->
                                                                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="12" Background="#181A22" BorderBrush="#252733" BorderThickness="1"
                                                                            Margin="0,0,14,0" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding IconGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="15.5" Foreground="#FB923C"
                                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>

                                                                    <!-- Name & Description -->
                                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                                                        <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="Bold" Foreground="#FFFFFF"
                                                                                   FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"/>
                                                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#8E95A5" Margin="0,3,0,0"
                                                                                   LineHeight="15" TextWrapping="Wrap" FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"/>
                                                                    </StackPanel>

                                                                    <!-- Capsule ToggleSwitch (Low-End Orange) -->
                                                                    <ToggleButton Grid.Column="2" VerticalAlignment="Center"
                                                                                  Style="{StaticResource LowEndCapsuleToggleSwitch}"
                                                                                  IsChecked="{Binding IsToggled, Mode=TwoWay}"
                                                                                  IsEnabled="{Binding CanToggleSwitch}"
                                                                                  ToolTip="{Binding ToggleToolTip}"/>
                                                                </Grid>
                                                                <!-- Row separator -->
                                                                <Border Grid.Row="1" Height="1" Background="#161820" Margin="0,10,0,0"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </ScrollViewer>

                                    <!-- Bottom Fade Effect (Deep dark inside box, rounded corners, visible on Advance Tweaks only) -->
                                    <Border x:Name="AdvanceBottomFadeBrd" VerticalAlignment="Bottom" Height="20" CornerRadius="0, 0, 21, 21" IsHitTestVisible="False" Panel.ZIndex="10" Margin="0,0,24,0"
                                            Opacity="1.0">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#00121216" Offset="0.0"/>
                                                <GradientStop Color="#60121216" Offset="0.4"/>
                                                <GradientStop Color="#FF121216" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                </Grid>
                            </Border>

                        <!-- Sliding Mask to hide top border under active tab & S-Curve scoop -->
                        <Border x:Name="AdvanceSubTabCardMask" HorizontalAlignment="Left" Width="323" Height="2" VerticalAlignment="Top" Background="#121216" Margin="1,0,0,0"/>
                    </Grid>
                </Grid>
<!-- ═══════════════════════════════════════════════════════════ -->
                    <!-- RIGHT COLUMN: STANDBY RAM PURGE & PRESETS MANAGER (Height 660)-->
                    <!-- ═══════════════════════════════════════════════════════════ -->
                    <Grid Grid.Column="2" Height="660" VerticalAlignment="Top">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- CARD 2 (TOP RIGHT): STANDBY RAM PURGE ENGINE & WIDGET -->
                        <StackPanel Grid.Row="0">
                            <!-- Standby RAM Purge Title Text above the box -->
                            <TextBlock Text="Standby RAM Purge" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"
                                       FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif" Margin="4,0,0,10"/>

                            <!-- Widget Box (Deep Rounded Corners, Proportional 2:1 Ratio) -->
                            <Border Background="#121216" BorderBrush="#202128" BorderThickness="1" CornerRadius="32"
                                    Padding="24,18" Height="216">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.4" Color="#000000"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Top Row: Left (Lightning + 'RAM Usage' + Big %) | Right ('...' + Free RAM + Total RAM) -->
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left Side: Lightning + RAM Usage + Percent -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                                                       VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#D1FE29"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsLowEndSubTabActive}" Value="True">
                                                                <Setter Property="Foreground" Value="#FB923C"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="RAM Usage" FontSize="12.5" FontWeight="SemiBold" Foreground="#8E95A5"
                                                           FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"/>
                                                <TextBlock Text="{Binding RamUsagePercentText}" FontSize="32" FontWeight="Bold" Foreground="#FFFFFF"
                                                           FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif" Margin="0,1,0,0"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Right Side: '...' + Free Memory + Total Memory -->
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#64748B"
                                                       HorizontalAlignment="Right" Margin="0,0,0,2"/>
                                            <TextBlock Text="{Binding RamAvailableText}" FontSize="24" FontWeight="SemiBold" Foreground="#FFFFFF"
                                                       HorizontalAlignment="Right" FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"/>
                                            <TextBlock Text="{Binding RamTotalText, StringFormat={}{0} Total RAM}" FontSize="10" Foreground="#64748B"
                                                       HorizontalAlignment="Right" FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Scale Markers: 0 (Left), 50 (Center), 100 (Right) -->
                                    <Grid Grid.Row="1" Margin="2,12,2,5">
                                        <TextBlock Text="0" FontSize="11.5" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Left" Margin="4,0,0,0"/>
                                        <TextBlock Text="50" FontSize="11.5" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center"/>
                                        <TextBlock Text="100" FontSize="11.5" FontWeight="SemiBold" Foreground="#94A3B8" HorizontalAlignment="Right" Margin="0,0,4,0"/>
                                    </Grid>

                                    <!-- Big Interactive Progress Bar Button (Gray by default, solid full-height Green block sweeps across without text, shows Done on complete) -->
                                    <Button Grid.Row="2" Command="{Binding CleanStandbyRamCommand}"
                                            IsEnabled="{Binding CanCleanRam}"
                                            Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                            HorizontalAlignment="Stretch" Height="72">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="PurgeBarContainer" Height="72" CornerRadius="10" Background="#CED2D9" ClipToBounds="True">
                                                    <Grid Height="72" VerticalAlignment="Stretch">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="{Binding PurgeFillGridWidth}"/>
                                                            <ColumnDefinition Width="{Binding PurgeEmptyGridWidth}"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Solid Full-Height Green Fill Block -->
                                                        <Border Grid.Column="0" Background="#D1FE29" CornerRadius="9, 0, 0, 9" VerticalAlignment="Stretch"/>

                                                        <!-- Text Overlay (Hidden while purging, visible when Idle or Done) -->
                                                        <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#0A0B0E" FontWeight="Bold" Margin="0,0,8,0"
                                                                       VerticalAlignment="Center"
                                                                       Visibility="{Binding IsRamPurgeDone, Converter={StaticResource BoolToVis}}"/>
                                                            <TextBlock Text="{Binding RamPurgeButtonText}" FontSize="15" FontWeight="Bold" Foreground="#0A0B0E"
                                                                       FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif" VerticalAlignment="Center"
                                                                       Visibility="{Binding IsPurgeTextVisible, Converter={StaticResource BoolToVis}}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsRamPurgeDone}" Value="True">
                                                        <Setter TargetName="PurgeBarContainer" Property="Background" Value="#D1FE29"/>
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="PurgeBarContainer" Property="Opacity" Value="0.92"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="PurgeBarContainer" Property="Opacity" Value="0.82"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="PurgeBarContainer" Property="Cursor" Value="Wait"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- CARD 3 (BOTTOM RIGHT): ADVANCE & POTATO PRESETS / RESTORE -->
                        <Border Grid.Row="2" Background="#121216" BorderBrush="#202128" BorderThickness="1" CornerRadius="32"
                                Padding="20,18" VerticalAlignment="Stretch">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.4" Color="#000000"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Header: Title & Subtitle + Undo -->
                                <Grid Grid.Row="0" Margin="4,0,4,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Advance Presets &amp; Defaults" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"
                                                   FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"/>
                                        <TextBlock Text="Restore previous settings or fresh Windows state" FontSize="11" Foreground="#8E95A5" Margin="0,2,0,0"
                                                   FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"/>
                                    </StackPanel>

                                    <Button Grid.Column="1" Command="{Binding UndoLastActionCommand}"
                                            IsEnabled="{Binding CanUndo}"
                                            VerticalAlignment="Center" Cursor="Hand" Background="Transparent" BorderThickness="0"
                                            ToolTip="Undo the last setting or preset changed in this tab">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="b" Background="#20222A" BorderBrush="#2D303C" BorderThickness="1" CornerRadius="12" Padding="12,6">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="&#xE7A7;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="#94A3B8" Margin="0,1,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Undo" FontSize="11" FontWeight="SemiBold" Foreground="#E2E8F0"
                                                                   FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="b" Property="Background" Value="#2D303C"/>
                                                        <Setter TargetName="b" Property="BorderBrush" Value="#434758"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="b" Property="Opacity" Value="0.35"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>

                                <!-- 3 Overlapping Stacked Cards (Back-to-Front Cascade: Top Black -> Middle Signature Green -> Bottom Light Gray | Exactly matched visual heights, fully uncropped rounded capsule edges) -->
                                <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,6,0,0">

                                    <!-- CARD 1 (TOP / BLACK - BACK LAYER): Restore User PC State | Height = 108px -->
                                    <Border Panel.ZIndex="1" Height="108"
                                            Background="#0B0C10" BorderBrush="#242733" BorderThickness="1" CornerRadius="28"
                                            Padding="20,0,20,18">
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- White Circle Avatar with Black Restore Icon -->
                                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="#FFFFFF"
                                                    Margin="0,0,14,0" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                    RenderTransformOrigin="0.5,0.5">
                                                <Border.RenderTransform>
                                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                </Border.RenderTransform>
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRestoreUserPcActive}" Value="True">
                                                                <DataTrigger.EnterActions>
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                                             From="1.0" To="1.14" Duration="0:0:0.18" AutoReverse="True">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                                             From="1.0" To="1.14" Duration="0:0:0.18" AutoReverse="True">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </DataTrigger.EnterActions>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="#0A0B0E"
                                                           FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           RenderTransformOrigin="0.5,0.5">
                                                    <TextBlock.RenderTransform>
                                                        <RotateTransform Angle="0"/>
                                                    </TextBlock.RenderTransform>
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRestoreUserPcActive}" Value="True">
                                                                    <DataTrigger.EnterActions>
                                                                        <BeginStoryboard>
                                                                            <Storyboard>
                                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                                                 From="0" To="-360" Duration="0:0:0.55">
                                                                                    <DoubleAnimation.EasingFunction>
                                                                                        <CubicEase EasingMode="EaseOut"/>
                                                                                    </DoubleAnimation.EasingFunction>
                                                                                </DoubleAnimation>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </DataTrigger.EnterActions>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <!-- Card Info -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="Restore User PC State" FontSize="13.5" FontWeight="Bold" Foreground="#FFFFFF"
                                                           FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"/>
                                                <TextBlock Text="Reverts all settings to original PC state" FontSize="10.5" Foreground="#8E95A5"
                                                           Margin="0,3,0,0" FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <!-- Toggle Switch (ModernCapsuleToggleSwitch with dynamic gray in Low-End PC) -->
                                            <ToggleButton Grid.Column="2" IsChecked="{Binding IsRestoreUserPcActive, Mode=TwoWay}"
                                                          VerticalAlignment="Center" Cursor="Hand" Background="Transparent" BorderThickness="0"
                                                          ToolTip="Toggle ON to restore pre-optimization PC configuration">
                                                <ToggleButton.Template>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Grid Width="46" Height="24" Background="Transparent">
                                                            <!-- Track Background: OFF State -->
                                                            <Border x:Name="TrackOff" Width="46" Height="24" CornerRadius="12"
                                                                    Background="#1E2026" BorderBrush="#313540" BorderThickness="1.5"/>
                                                            <!-- Track Background: ON State -->
                                                            <Border x:Name="TrackOn" Width="46" Height="24" CornerRadius="12"
                                                                    BorderThickness="1.5" Opacity="0">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="#D1FE29"/>
                                                                        <Setter Property="BorderBrush" Value="#D1FE29"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsLowEndSubTabActive}" Value="True">
                                                                                <Setter Property="Background" Value="#94A3B8"/>
                                                                                <Setter Property="BorderBrush" Value="#94A3B8"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                            </Border>
                                                            <!-- Sliding Thumb Container -->
                                                            <Grid x:Name="ThumbContainer" Width="16" Height="16" HorizontalAlignment="Left" Margin="4,0,0,0" VerticalAlignment="Center">
                                                                <Grid.RenderTransform>
                                                                    <TranslateTransform x:Name="ThumbTransform" X="0" Y="0"/>
                                                                </Grid.RenderTransform>
                                                                <!-- Thumb OFF (Grey) -->
                                                                <Ellipse x:Name="ThumbOff" Width="16" Height="16" Fill="#71717A"/>
                                                                <!-- Thumb ON (Black) -->
                                                                <Ellipse x:Name="ThumbOn" Width="16" Height="16" Fill="#0A0B0E" Opacity="0"/>
                                                            </Grid>
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Trigger.EnterActions>
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetName="ThumbTransform" Storyboard.TargetProperty="X" To="22" Duration="0:0:0.18">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                            <DoubleAnimation Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                                                                            <DoubleAnimation Storyboard.TargetName="ThumbOn" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                                                                            <DoubleAnimation Storyboard.TargetName="ThumbOff" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </Trigger.EnterActions>
                                                                <Trigger.ExitActions>
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetName="ThumbTransform" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.18">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                            <DoubleAnimation Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                                                                            <DoubleAnimation Storyboard.TargetName="ThumbOn" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                                                                            <DoubleAnimation Storyboard.TargetName="ThumbOff" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </Trigger.ExitActions>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </ToggleButton.Template>
                                            </ToggleButton>
                                        </Grid>
                                    </Border>

                                    <!-- CARD 2 (MIDDLE / DYNAMIC GREEN or ORANGE - OVERLAPPING LAYER): Xenom Recommended | Full Card Height = 102px -->
                                    <Border Panel.ZIndex="2" Height="102" Margin="0,-18,0,0"
                                            BorderThickness="1" CornerRadius="28"
                                            Padding="20,0,20,18">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#D1FE29"/>
                                                <Setter Property="BorderBrush" Value="#BEE81C"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLowEndSubTabActive}" Value="True">
                                                        <Setter Property="Background" Value="#FB923C"/>
                                                        <Setter Property="BorderBrush" Value="#EA580C"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="90" Opacity="0.45" Color="#000000"/>
                                        </Border.Effect>
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Black Circle Avatar with Green Lightning Icon -->
                                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="#0A0B0E"
                                                    Margin="0,0,14,0" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                    RenderTransformOrigin="0.5,0.5">
                                                <Border.RenderTransform>
                                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                </Border.RenderTransform>
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAppRecommendedActive}" Value="True">
                                                                <DataTrigger.EnterActions>
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                                             From="1.0" To="1.18" Duration="0:0:0.18" AutoReverse="True">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                                             From="1.0" To="1.18" Duration="0:0:0.18" AutoReverse="True">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </DataTrigger.EnterActions>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                                           FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           RenderTransformOrigin="0.5,0.5">
                                                    <TextBlock.RenderTransform>
                                                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                    </TextBlock.RenderTransform>
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#D1FE29"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsLowEndSubTabActive}" Value="True">
                                                                    <Setter Property="Foreground" Value="#FB923C"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsAppRecommendedActive}" Value="True">
                                                                    <DataTrigger.EnterActions>
                                                                        <BeginStoryboard>
                                                                            <Storyboard>
                                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                                                 From="1.0" To="1.45" Duration="0:0:0.18" AutoReverse="True">
                                                                                    <DoubleAnimation.EasingFunction>
                                                                                        <CubicEase EasingMode="EaseOut"/>
                                                                                    </DoubleAnimation.EasingFunction>
                                                                                </DoubleAnimation>
                                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                                                 From="1.0" To="1.45" Duration="0:0:0.18" AutoReverse="True">
                                                                                    <DoubleAnimation.EasingFunction>
                                                                                        <CubicEase EasingMode="EaseOut"/>
                                                                                    </DoubleAnimation.EasingFunction>
                                                                                </DoubleAnimation>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </DataTrigger.EnterActions>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <!-- Card Info -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="Xenom Recommended" FontSize="13.5" FontWeight="Bold" Foreground="#0A0B0E"
                                                           FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"/>
                                                <TextBlock FontSize="10.5" FontWeight="SemiBold"
                                                           Margin="0,3,0,0" FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif" TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#243306"/>
                                                            <Setter Property="Text" Value="Disables telemetry, Game DVR &amp; unused services"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsLowEndSubTabActive}" Value="True">
                                                                    <Setter Property="Foreground" Value="#3B1504"/>
                                                                    <Setter Property="Text" Value="Disables visual effects &amp; animations for max FPS"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>

                                            <!-- Toggle Switch (High-contrast Black Pill with Glowing Green Thumb) -->
                                            <ToggleButton Grid.Column="2" IsChecked="{Binding IsAppRecommendedActive, Mode=TwoWay}"
                                                          VerticalAlignment="Center" Cursor="Hand" Background="Transparent" BorderThickness="0"
                                                          ToolTip="Toggle ON for Xenom Recommended optimizations / OFF to revert">
                                                <ToggleButton.Template>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Grid Width="46" Height="24" Background="Transparent">
                                                            <Border x:Name="track" Width="46" Height="24" CornerRadius="12"
                                                                    Background="#0A0B0E" BorderBrush="#0A0B0E" BorderThickness="1.5"/>
                                                            <Grid x:Name="thumbGrid" Width="16" Height="16" HorizontalAlignment="Left" Margin="4,0,0,0" VerticalAlignment="Center">
                                                                <Grid.RenderTransform>
                                                                    <TranslateTransform x:Name="thumbTrans" X="0" Y="0"/>
                                                                </Grid.RenderTransform>
                                                                <Ellipse x:Name="thumbOff" Width="16" Height="16">
                                                                    <Ellipse.Style>
                                                                        <Style TargetType="Ellipse">
                                                                            <Setter Property="Fill" Value="#3D4F0B"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsLowEndSubTabActive}" Value="True">
                                                                                    <Setter Property="Fill" Value="#4A2408"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Ellipse.Style>
                                                                </Ellipse>
                                                                <Ellipse x:Name="thumbOn" Width="16" Height="16" Opacity="0">
                                                                    <Ellipse.Style>
                                                                        <Style TargetType="Ellipse">
                                                                            <Setter Property="Fill" Value="#D1FE29"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsLowEndSubTabActive}" Value="True">
                                                                                    <Setter Property="Fill" Value="#FB923C"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Ellipse.Style>
                                                                </Ellipse>
                                                            </Grid>
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Trigger.EnterActions>
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetName="thumbTrans" Storyboard.TargetProperty="X" To="22" Duration="0:0:0.18">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                            <DoubleAnimation Storyboard.TargetName="thumbOn" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                                                                            <DoubleAnimation Storyboard.TargetName="thumbOff" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </Trigger.EnterActions>
                                                                <Trigger.ExitActions>
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetName="thumbTrans" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.18">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                            <DoubleAnimation Storyboard.TargetName="thumbOn" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                                                                            <DoubleAnimation Storyboard.TargetName="thumbOff" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </Trigger.ExitActions>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </ToggleButton.Template>
                                            </ToggleButton>
                                        </Grid>
                                    </Border>

                                    <!-- CARD 3 (BOTTOM / GRAY - FRONTMOST LAYER): Windows Stock Defaults | Full Card Height = 102px -->
                                    <Border Panel.ZIndex="3" Height="102" Margin="0,-18,0,0"
                                            Background="#CED2D9" BorderBrush="#B8BDC7" BorderThickness="1" CornerRadius="28"
                                            Padding="20,0,20,0">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="90" Opacity="0.4" Color="#000000"/>
                                        </Border.Effect>
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Black Circle Avatar with Gray/White Reset Icon -->
                                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="#0A0B0E"
                                                    Margin="0,0,14,0" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                    RenderTransformOrigin="0.5,0.5">
                                                <Border.RenderTransform>
                                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                </Border.RenderTransform>
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsWindowsDefaultsActive}" Value="True">
                                                                <DataTrigger.EnterActions>
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                                             From="1.0" To="1.14" Duration="0:0:0.18" AutoReverse="True">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                                             From="1.0" To="1.14" Duration="0:0:0.18" AutoReverse="True">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </DataTrigger.EnterActions>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="#CED2D9"
                                                           FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           RenderTransformOrigin="0.5,0.5">
                                                    <TextBlock.RenderTransform>
                                                        <RotateTransform Angle="0"/>
                                                    </TextBlock.RenderTransform>
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsWindowsDefaultsActive}" Value="True">
                                                                    <DataTrigger.EnterActions>
                                                                        <BeginStoryboard>
                                                                            <Storyboard>
                                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                                                 From="0" To="360" Duration="0:0:0.55">
                                                                                    <DoubleAnimation.EasingFunction>
                                                                                        <CubicEase EasingMode="EaseOut"/>
                                                                                    </DoubleAnimation.EasingFunction>
                                                                                </DoubleAnimation>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </DataTrigger.EnterActions>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <!-- Card Info -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="Windows Stock Defaults" FontSize="13.5" FontWeight="Bold" Foreground="#0A0B0E"
                                                           FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"/>
                                                <TextBlock Text="Resets all tweaks to Windows factory defaults" FontSize="10.5" FontWeight="SemiBold"
                                                           Foreground="#475569" Margin="0,3,0,0" FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <!-- Toggle Switch (High-contrast Black Pill with Alert Red Thumb) -->
                                            <ToggleButton Grid.Column="2" IsChecked="{Binding IsWindowsDefaultsActive, Mode=TwoWay}"
                                                          VerticalAlignment="Center" Cursor="Hand" Background="Transparent" BorderThickness="0"
                                                          ToolTip="Toggle ON to reset Windows to fresh stock defaults">
                                                <ToggleButton.Template>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Grid Width="46" Height="24" Background="Transparent">
                                                            <Border x:Name="track" Width="46" Height="24" CornerRadius="12"
                                                                    Background="#0A0B0E" BorderBrush="#0A0B0E" BorderThickness="1.5"/>
                                                            <Grid x:Name="thumbGrid" Width="16" Height="16" HorizontalAlignment="Left" Margin="4,0,0,0" VerticalAlignment="Center">
                                                                <Grid.RenderTransform>
                                                                    <TranslateTransform x:Name="thumbTrans" X="0" Y="0"/>
                                                                </Grid.RenderTransform>
                                                                <Ellipse x:Name="thumbOff" Width="16" Height="16" Fill="#64748B"/>
                                                                <Ellipse x:Name="thumbOn" Width="16" Height="16" Fill="#EF4444" Opacity="0"/>
                                                            </Grid>
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Trigger.EnterActions>
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetName="thumbTrans" Storyboard.TargetProperty="X" To="22" Duration="0:0:0.18">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                            <DoubleAnimation Storyboard.TargetName="thumbOn" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                                                                            <DoubleAnimation Storyboard.TargetName="thumbOff" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </Trigger.EnterActions>
                                                                <Trigger.ExitActions>
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetName="thumbTrans" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.18">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                            <DoubleAnimation Storyboard.TargetName="thumbOn" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                                                                            <DoubleAnimation Storyboard.TargetName="thumbOff" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </Trigger.ExitActions>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </ToggleButton.Template>
                                            </ToggleButton>
                                        </Grid>
                                    </Border>

                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </StackPanel>

        </ScrollViewer>



        <!-- ── BOTTOM FADE GRADIENT (ACTIVE ON SLIDES 1 & 2 AND DRIVER INSTALLATION; COLLAPSED ON DRIVER HUB DASHBOARD) ── -->

        <Border Grid.RowSpan="2" VerticalAlignment="Bottom" Height="90" IsHitTestVisible="False" Panel.ZIndex="5">

            <Border.Style>

                <Style TargetType="Border">

                    <Setter Property="Visibility" Value="Visible"/>

                    <Style.Triggers>

                        <!-- Drivers Hub Dashboard (Expanded): Collapsed (no fade) -->

                        <MultiDataTrigger>

                            <MultiDataTrigger.Conditions>

                                <Condition Binding="{Binding IsDriversSlideActive}" Value="True"/>

                                <Condition Binding="{Binding IsDriverInstallationViewActive}" Value="False"/>

                            </MultiDataTrigger.Conditions>

                            <Setter Property="Visibility" Value="Collapsed"/>

                        </MultiDataTrigger>

                    </Style.Triggers>

                </Style>

            </Border.Style>

            <Border.Background>

                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">

                    <GradientStop Color="#000B0C0E" Offset="0.0"/>

                    <GradientStop Color="#200B0C0E" Offset="0.25"/>

                    <GradientStop Color="#650B0C0E" Offset="0.5"/>

                    <GradientStop Color="#B50B0C0E" Offset="0.75"/>

                    <GradientStop Color="#FF0B0C0E" Offset="1.0"/>

                </LinearGradientBrush>

            </Border.Background>

        </Border>



        <!-- ═══════════════════════════════════════════════════════════════ -->

        <!-- ROW 1: FLUID LIQUID EXPANDING DOT PAGINATION (NO BOX / NO OUTLINE) -->

        <!-- ═══════════════════════════════════════════════════════════════ -->

        <Border x:Name="BottomPaginationDotsBorder" Grid.RowSpan="2" Panel.ZIndex="100" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Width="320" Height="46" Margin="0,0,90,0" Background="Transparent" BorderThickness="0"
                PreviewMouseWheel="PaginationBar_PreviewMouseWheel"
                FocusVisualStyle="{x:Null}" ClipToBounds="False">

            <Grid x:Name="PaginationRootGrid" ClipToBounds="False" HorizontalAlignment="Center" VerticalAlignment="Center">

                <!-- 1. DOTS CONTAINER (Normal resting state: 3 pagination dots) -->
                <StackPanel x:Name="PaginationDotsHost" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                            RenderTransformOrigin="0.5,0.5">
                    <StackPanel.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="PaginationDotsScale" ScaleX="1" ScaleY="1"/>
                            <TranslateTransform x:Name="PaginationDotsShake" X="0" Y="0"/>
                        </TransformGroup>
                    </StackPanel.RenderTransform>



                <!-- ── DOT 0: DRIVERS HUB ── -->

                <Button Command="{Binding SelectSlideCommand}" CommandParameter="0"

                        Visibility="{Binding IsDriversIncludedMode, Converter={StaticResource BoolToVis}}"

                        Cursor="Hand" Background="Transparent" BorderThickness="0"

                        FocusVisualStyle="{x:Null}" IsTabStop="False"

                        Padding="4,8" Margin="0,0,6,0">

                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="ToolTip" Value="Drivers Hub (Click or scroll to switch)"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CanNavigateToNextSlide}" Value="False">
                                    <Setter Property="ToolTip" Value="Drivers Hub (Scan drivers or skip to unlock)"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>

                    <Button.Template>

                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent" Cursor="Hand" FocusVisualStyle="{x:Null}">
                                <Border x:Name="DotPill" Height="10" Width="10" CornerRadius="5"
                                        Background="#4A5568" SnapsToDevicePixels="True" UseLayoutRounding="True"/>
                            </Grid>

                            <ControlTemplate.Triggers>

                                <!-- ACTIVE STATE: Stretches into Crisp White Pill (Zero outline) -->

                                <DataTrigger Binding="{Binding IsDriversSlideActive}" Value="True">

                                    <Setter TargetName="DotPill" Property="Background" Value="#CBD5E1"/>

                                    <DataTrigger.EnterActions>

                                        <BeginStoryboard>

                                            <Storyboard>

                                                <DoubleAnimation Storyboard.TargetName="DotPill"

                                                                 Storyboard.TargetProperty="Width"

                                                                 To="42" Duration="0:0:0.32">

                                                    <DoubleAnimation.EasingFunction>

                                                        <CubicEase EasingMode="EaseOut"/>

                                                    </DoubleAnimation.EasingFunction>

                                                </DoubleAnimation>

                                            </Storyboard>

                                        </BeginStoryboard>

                                    </DataTrigger.EnterActions>

                                    <DataTrigger.ExitActions>

                                        <BeginStoryboard>

                                            <Storyboard>

                                                <DoubleAnimation Storyboard.TargetName="DotPill"

                                                                 Storyboard.TargetProperty="Width"

                                                                 To="10" Duration="0:0:0.32">

                                                    <DoubleAnimation.EasingFunction>

                                                        <CubicEase EasingMode="EaseOut"/>

                                                    </DoubleAnimation.EasingFunction>

                                                </DoubleAnimation>

                                            </Storyboard>

                                        </BeginStoryboard>

                                    </DataTrigger.ExitActions>

                                </DataTrigger>



                                <!-- INACTIVE HOVER STATE -->

                                <MultiDataTrigger>

                                    <MultiDataTrigger.Conditions>

                                        <Condition Binding="{Binding IsDriversSlideActive}" Value="False"/>

                                        <Condition Binding="{Binding Path=IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>

                                    </MultiDataTrigger.Conditions>

                                    <Setter TargetName="DotPill" Property="Background" Value="#94A3B8"/>

                                </MultiDataTrigger>

                            </ControlTemplate.Triggers>

                        </ControlTemplate>

                    </Button.Template>

                </Button>



                <!-- ── DOT 1: SYSTEM SERVICES ── -->

                <Button x:Name="PaginationDotBtn1" Tag="1"
                        Command="{Binding SelectSlideCommand}" CommandParameter="1"
                        PreviewMouseLeftButtonDown="LockedPaginationDot_PreviewMouseLeftButtonDown"
                        Cursor="Hand" Background="Transparent" BorderThickness="0"
                        FocusVisualStyle="{x:Null}" IsTabStop="False"
                        Padding="4,8" Margin="0,0,6,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="ToolTip" Value="System Services (Click or scroll to switch)"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CanNavigateToNextSlide}" Value="False">
                                    <Setter Property="ToolTip" Value="System Services (Scan drivers or skip to unlock)"/>
                                    <Setter Property="Cursor" Value="No"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>

                    <Button.Template>

                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent" FocusVisualStyle="{x:Null}">
                                <Border x:Name="DotPill" Height="10" Width="10" CornerRadius="5"
                                        Background="#4A5568" SnapsToDevicePixels="True" UseLayoutRounding="True"/>
                            </Grid>

                            <ControlTemplate.Triggers>

                                <DataTrigger Binding="{Binding CanNavigateToNextSlide}" Value="False">
                                    <Setter TargetName="DotPill" Property="Opacity" Value="0.35"/>
                                </DataTrigger>

                                <!-- ACTIVE STATE: Stretches into Crisp White Pill (Zero outline) -->

                                <DataTrigger Binding="{Binding IsServicesSlideActive}" Value="True">

                                    <Setter TargetName="DotPill" Property="Background" Value="#CBD5E1"/>

                                    <DataTrigger.EnterActions>

                                        <BeginStoryboard>

                                            <Storyboard>

                                                <DoubleAnimation Storyboard.TargetName="DotPill"

                                                                 Storyboard.TargetProperty="Width"

                                                                 To="42" Duration="0:0:0.32">

                                                    <DoubleAnimation.EasingFunction>

                                                        <CubicEase EasingMode="EaseOut"/>

                                                    </DoubleAnimation.EasingFunction>

                                                </DoubleAnimation>

                                            </Storyboard>

                                        </BeginStoryboard>

                                    </DataTrigger.EnterActions>

                                    <DataTrigger.ExitActions>

                                        <BeginStoryboard>

                                            <Storyboard>

                                                <DoubleAnimation Storyboard.TargetName="DotPill"

                                                                 Storyboard.TargetProperty="Width"

                                                                 To="10" Duration="0:0:0.32">

                                                    <DoubleAnimation.EasingFunction>

                                                        <CubicEase EasingMode="EaseOut"/>

                                                    </DoubleAnimation.EasingFunction>

                                                </DoubleAnimation>

                                            </Storyboard>

                                        </BeginStoryboard>

                                    </DataTrigger.ExitActions>

                                </DataTrigger>



                                <!-- INACTIVE HOVER STATE -->

                                <MultiDataTrigger>

                                    <MultiDataTrigger.Conditions>

                                        <Condition Binding="{Binding IsServicesSlideActive}" Value="False"/>

                                        <Condition Binding="{Binding CanNavigateToNextSlide}" Value="True"/>

                                        <Condition Binding="{Binding Path=IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>

                                    </MultiDataTrigger.Conditions>

                                    <Setter TargetName="DotPill" Property="Background" Value="#94A3B8"/>

                                </MultiDataTrigger>

                            </ControlTemplate.Triggers>

                        </ControlTemplate>

                    </Button.Template>

                </Button>



                <!-- ── DOT 2: ADVANCE OPTIMIZATION ── -->

                <Button x:Name="PaginationDotBtn2" Tag="2"
                        Command="{Binding SelectSlideCommand}" CommandParameter="2"
                        PreviewMouseLeftButtonDown="LockedPaginationDot_PreviewMouseLeftButtonDown"
                        Cursor="Hand" Background="Transparent" BorderThickness="0"
                        FocusVisualStyle="{x:Null}" IsTabStop="False"
                        Padding="4,8" Margin="0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="ToolTip" Value="Advance Optimization (Click or scroll to switch)"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CanNavigateToNextSlide}" Value="False">
                                    <Setter Property="ToolTip" Value="Advance Optimization (Scan drivers or skip to unlock)"/>
                                    <Setter Property="Cursor" Value="No"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>

                    <Button.Template>

                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent" FocusVisualStyle="{x:Null}">
                                <Border x:Name="DotPill" Height="10" Width="10" CornerRadius="5"
                                        Background="#4A5568" SnapsToDevicePixels="True" UseLayoutRounding="True"/>
                            </Grid>

                            <ControlTemplate.Triggers>

                                <DataTrigger Binding="{Binding CanNavigateToNextSlide}" Value="False">
                                    <Setter TargetName="DotPill" Property="Opacity" Value="0.35"/>
                                </DataTrigger>

                                <!-- ACTIVE STATE: Stretches into Crisp White Pill (Zero outline) -->

                                <DataTrigger Binding="{Binding IsAdvanceSlideActive}" Value="True">

                                    <Setter TargetName="DotPill" Property="Background" Value="#CBD5E1"/>

                                    <DataTrigger.EnterActions>

                                        <BeginStoryboard>

                                            <Storyboard>

                                                <DoubleAnimation Storyboard.TargetName="DotPill"

                                                                 Storyboard.TargetProperty="Width"

                                                                 To="42" Duration="0:0:0.32">

                                                    <DoubleAnimation.EasingFunction>

                                                        <CubicEase EasingMode="EaseOut"/>

                                                    </DoubleAnimation.EasingFunction>

                                                </DoubleAnimation>

                                            </Storyboard>

                                        </BeginStoryboard>

                                    </DataTrigger.EnterActions>

                                    <DataTrigger.ExitActions>

                                        <BeginStoryboard>

                                            <Storyboard>

                                                <DoubleAnimation Storyboard.TargetName="DotPill"

                                                                 Storyboard.TargetProperty="Width"

                                                                 To="10" Duration="0:0:0.32">

                                                    <DoubleAnimation.EasingFunction>

                                                        <CubicEase EasingMode="EaseOut"/>

                                                    </DoubleAnimation.EasingFunction>

                                                </DoubleAnimation>

                                            </Storyboard>

                                        </BeginStoryboard>

                                    </DataTrigger.ExitActions>

                                </DataTrigger>



                                <!-- INACTIVE HOVER STATE -->

                                <MultiDataTrigger>

                                    <MultiDataTrigger.Conditions>

                                        <Condition Binding="{Binding IsAdvanceSlideActive}" Value="False"/>

                                        <Condition Binding="{Binding CanNavigateToNextSlide}" Value="True"/>

                                        <Condition Binding="{Binding Path=IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>

                                    </MultiDataTrigger.Conditions>

                                    <Setter TargetName="DotPill" Property="Background" Value="#94A3B8"/>

                                </MultiDataTrigger>

                            </ControlTemplate.Triggers>

                        </ControlTemplate>

                    </Button.Template>

                </Button>



            </StackPanel>

                <!-- 2. LOCKED INDICATOR (Replaces dots when locked dot is clicked/scrolled; Lock only, no circle, no glow, no text) -->
                <Grid x:Name="PaginationLockHost" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Opacity="0" Visibility="Collapsed" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="PaginationLockScale" ScaleX="0.6" ScaleY="0.6"/>
                            <TranslateTransform x:Name="PaginationLockShake" X="0" Y="0"/>
                        </TransformGroup>
                    </Grid.RenderTransform>

                    <!-- Pure Lock Icon Only (No circle, no glow) -->
                    <TextBlock x:Name="PaginationLockGlyph" Text="&#xE72E;" FontFamily="Segoe MDL2 Assets"
                               FontSize="16" FontWeight="SemiBold" Foreground="#EF4444"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <!-- 3. SMALL FLOATING HINT MESSAGE (Pure text only - appears in the exact spot of the lock after lock fades out, then fades away before dots return) -->
                <Border x:Name="PaginationHintBadge" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Margin="0" Background="Transparent" BorderThickness="0"
                        Opacity="0" Visibility="Collapsed" IsHitTestVisible="False">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="PaginationHintTrans" Y="0"/>
                    </Border.RenderTransform>
                    <TextBlock x:Name="PaginationHintText"
                               Text="Scan to unlock Windows optimizations"
                               FontSize="11.5" FontWeight="SemiBold" Foreground="#CBD5E1"
                               FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.6" Color="#000000"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </Border>

            </Grid>

        </Border>











        <!-- ═══════════════════════════════════════════════════════════════ -->

        <!-- STEP-BY-STEP ONBOARDING TASK GUIDE MODAL (IMAGE 3 SLEEK STYLE)   -->

        <!-- ═══════════════════════════════════════════════════════════════ -->




        <!-- ═══════════════════════════════════════════════════════════════ -->

        <!-- CONFIRMATION MODAL POPUP DIALOG OVERLAY (APPLY / RESTORE)       -->

        <!-- ═══════════════════════════════════════════════════════════════ -->

        <Grid Grid.RowSpan="2" Background="#B0000000"

              Visibility="{Binding IsConfirmDialogVisible, Converter={StaticResource BoolToVis}}">

            <Border Background="#13151F" BorderBrush="#2A2E42" BorderThickness="1.5"

                    CornerRadius="16" Padding="28,24" MaxWidth="480"

                    HorizontalAlignment="Center" VerticalAlignment="Center">

                <Border.Effect>

                    <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.7" Color="Black"/>

                </Border.Effect>



                <StackPanel>

                    <!-- Modal Header Icon & Title -->

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">

                        <Border Background="#251820" CornerRadius="10" Width="38" Height="38" Margin="0,0,12,0">

                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="18"

                                       Foreground="{StaticResource AccentOrangeBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        </Border>

                        <TextBlock Text="{Binding ConfirmDialogTitle}" FontSize="17" FontWeight="Bold"

                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>

                    </StackPanel>



                    <!-- Message Body -->

                    <TextBlock Text="{Binding ConfirmDialogMessage}" FontSize="13"

                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"

                               LineHeight="20" Margin="0,0,0,22"/>



                    <!-- Action Buttons: Cancel vs Yes Confirm -->

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="12"/>

                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>



                        <!-- Cancel Button -->

                        <Button Grid.Column="0" Style="{StaticResource SecondaryButton}"

                                Content="Cancel" Command="{Binding CancelActionCommand}"

                                Padding="0,10" FontSize="12" FontWeight="SemiBold"/>



                        <!-- Yes, Confirm Button -->

                        <Button Grid.Column="2" Style="{StaticResource PrimaryButton}"

                                Content="{Binding ConfirmDialogButtonText}" Command="{Binding ConfirmActionCommand}"

                                Padding="0,10" FontSize="12" FontWeight="Bold"/>

                    </Grid>

                </StackPanel>

            </Border>

        </Grid>



        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- CUSTOM CATEGORY MODE MANAGER MODAL (+ ADD BUTTON)               -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Grid Grid.RowSpan="2" Background="#C0000000"
              Visibility="{Binding IsCustomCategoryModalOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="#12141D" BorderBrush="#262A38" BorderThickness="1.5"
                    CornerRadius="18" Padding="28,22" Width="520" MaxHeight="600"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="35" ShadowDepth="6" Opacity="0.8" Color="#000000"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0: Header with Close X -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#1E2A1E" CornerRadius="8" Padding="8,6" Margin="0,0,10,0">
                                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#D1FE29" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Customize Category Modes" FontSize="17" FontWeight="Bold" Foreground="#FFFFFF"
                                           FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Only the last two modes can be modified with your preferred services. Modes 1, 2, and 3 remain locked."
                                       FontSize="11.5" Foreground="#8E95A5" Margin="0,6,0,0" TextWrapping="Wrap"
                                       FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"/>
                        </StackPanel>
                        <Button Grid.Column="1" Command="{Binding CloseCustomCategoryModalCommand}"
                                Background="Transparent" BorderThickness="0" Cursor="Hand" VerticalAlignment="Top" Padding="6">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#8E95A5"/>
                        </Button>
                    </Grid>

                    <!-- Row 1: Mode Slot Selector (Slot 4 vs Slot 5) -->
                    <Border Grid.Row="1" Background="#181A24" CornerRadius="12" Padding="4" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Command="{Binding SelectCustomSlotCommand}" CommandParameter="4"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="tabBrd" CornerRadius="9" Padding="0,8" Background="Transparent">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="&#xE821;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#8E95A5" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Mode 4 (Slot 4)" FontSize="12" FontWeight="SemiBold" Foreground="#8E95A5" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding SelectedCustomSlot}" Value="4">
                                                <Setter TargetName="tabBrd" Property="Background" Value="#252A3A"/>
                                                <Setter TargetName="tabBrd" Property="TextBlock.Foreground" Value="#FFFFFF"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Grid.Column="1" Command="{Binding SelectCustomSlotCommand}" CommandParameter="5"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="tabBrd" CornerRadius="9" Padding="0,8" Background="Transparent">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#8E95A5" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Mode 5 (Slot 5)" FontSize="12" FontWeight="SemiBold" Foreground="#8E95A5" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding SelectedCustomSlot}" Value="5">
                                                <Setter TargetName="tabBrd" Property="Background" Value="#252A3A"/>
                                                <Setter TargetName="tabBrd" Property="TextBlock.Foreground" Value="#FFFFFF"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Row 2: Mode Label Text Input -->
                    <Grid Grid.Row="2" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Mode Name:" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Border Grid.Column="1" Background="#181A24" BorderBrush="#262A38" BorderThickness="1" CornerRadius="8" Padding="10,6">
                            <TextBox Text="{Binding CustomModeNameInput, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" FontSize="12"
                                     CaretBrush="#D1FE29"/>
                        </Border>
                    </Grid>

                    <!-- Row 3: Quick Filter Actions (Select All, Clear All, Reset Default) -->
                    <Grid Grid.Row="3" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button Command="{Binding CustomModalSelectAllCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0">
                                <TextBlock Text="Select All" FontSize="11" Foreground="#4ADE80" TextDecorations="Underline"/>
                            </Button>
                            <Button Command="{Binding CustomModalClearAllCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                <TextBlock Text="Clear All" FontSize="11" Foreground="#94A3B8" TextDecorations="Underline"/>
                            </Button>
                        </StackPanel>
                        <Button Grid.Column="1" Command="{Binding ResetCustomModeToDefaultCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand">
                            <TextBlock Text="Reset Default Services" FontSize="11" Foreground="#F59E0B" TextDecorations="Underline"/>
                        </Button>
                    </Grid>

                    <!-- Row 4: Services Checklist in ScrollViewer -->
                    <Border Grid.Row="4" Background="#161822" BorderBrush="#222532" BorderThickness="1" CornerRadius="10"
                            Padding="8,4" Height="220" Margin="0,0,0,18">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding CustomModalServiceItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#1C1E2A" BorderThickness="0,0,0,1" Padding="8,7">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                                    <TextBlock Text="{Binding Description}" FontSize="10.5" Foreground="#7E8695" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!-- Row 5: Footer Save & Cancel -->
                    <Grid Grid.Row="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancel" Command="{Binding CloseCustomCategoryModalCommand}"
                                Style="{StaticResource SecondaryButton}" Padding="0,9" FontSize="12" FontWeight="SemiBold"/>
                        <Button Grid.Column="2" Command="{Binding SaveCustomModeCommand}"
                                Cursor="Hand" Background="Transparent" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="b" Background="#C8FF00" CornerRadius="10" Padding="0,9">
                                        <TextBlock Text="Save &amp; Apply" Foreground="#000000" FontWeight="Bold" FontSize="12"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="#D6FF33"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="#A8DE00"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

    </Grid>

</UserControl>

