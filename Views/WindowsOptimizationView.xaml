                                        </Grid>
                                    </Grid>

                                    </Border>

                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.IsRescanningDrivers, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                                            <Setter TargetName="RealDriverContent" Property="Visibility" Value="Collapsed"/>
                                            <Setter TargetName="SkeletonDriverContent" Property="Visibility" Value="Visible"/>
                                            <DataTrigger.EnterActions>
                                                <StopStoryboard BeginStoryboardName="RealContentRevealStoryboard"/>
                                                <BeginStoryboard x:Name="SkeletonShimmerStoryboard">
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation Storyboard.TargetName="ShimPill1" Storyboard.TargetProperty="Background.(LinearGradientBrush.RelativeTransform).(TranslateTransform.X)" From="-1.0" To="1.0" Duration="0:0:1.3"/>
                                                        <DoubleAnimation Storyboard.TargetName="ShimPill2" Storyboard.TargetProperty="Background.(LinearGradientBrush.RelativeTransform).(TranslateTransform.X)" From="-1.0" To="1.0" Duration="0:0:1.3"/>
                                                        <DoubleAnimation Storyboard.TargetName="ShimPill3" Storyboard.TargetProperty="Background.(LinearGradientBrush.RelativeTransform).(TranslateTransform.X)" From="-1.0" To="1.0" Duration="0:0:1.3"/>
                                                        <DoubleAnimation Storyboard.TargetName="ShimPill4" Storyboard.TargetProperty="Background.(LinearGradientBrush.RelativeTransform).(TranslateTransform.X)" From="-1.0" To="1.0" Duration="0:0:1.3"/>
                                                        <DoubleAnimation Storyboard.TargetName="ShimPill5" Storyboard.TargetProperty="Background.(LinearGradientBrush.RelativeTransform).(TranslateTransform.X)" From="-1.0" To="1.0" Duration="0:0:1.3"/>
                                                        <DoubleAnimation Storyboard.TargetName="ShimBtn1" Storyboard.TargetProperty="Background.(LinearGradientBrush.RelativeTransform).(TranslateTransform.X)" From="-1.0" To="1.0" Duration="0:0:1.3"/>
                                                        <DoubleAnimation Storyboard.TargetName="ShimBtn2" Storyboard.TargetProperty="Background.(LinearGradientBrush.RelativeTransform).(TranslateTransform.X)" From="-1.0" To="1.0" Duration="0:0:1.3"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="SkeletonShimmerStoryboard"/>
                                                <BeginStoryboard x:Name="RealContentRevealStoryboard">
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="RealDriverContent"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         From="0.0" To="1.0"
                                                                         Duration="0:0:0.38">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetName="RealContentTrans"
                                                                         Storyboard.TargetProperty="X"
                                                                         From="-26" To="0"
                                                                         Duration="0:0:0.42">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <ColorAnimation Storyboard.TargetName="CardBorder"
                                                                        Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                                        From="#383D4C" To="#272930"
                                                                        Duration="0:0:0.55">
                                                            <ColorAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </ColorAnimation.EasingFunction>
                                                        </ColorAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                                        </StackPanel>

                                    </ScrollViewer>

                                    <!-- Smooth Top Fade Gradient over top of Driver List when scrolling -->
                                    <Border x:Name="TopDriverFadeBorder" VerticalAlignment="Top" Height="75" Margin="0,0,24,0" IsHitTestVisible="False" Panel.ZIndex="10" Opacity="0">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#FF0B0C0E" Offset="0.0"/>
                                                <GradientStop Color="#E60B0C0E" Offset="0.18"/>
                                                <GradientStop Color="#A00B0C0E" Offset="0.40"/>
                                                <GradientStop Color="#500B0C0E" Offset="0.65"/>
                                                <GradientStop Color="#150B0C0E" Offset="0.85"/>
                                                <GradientStop Color="#000B0C0E" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>

                                    <!-- Smooth Bottom Fade Gradient over bottom of Driver List -->
                                    <Border x:Name="BottomDriverFadeBorder" VerticalAlignment="Bottom" Height="80" Margin="0,0,24,0" IsHitTestVisible="False" Panel.ZIndex="10" Opacity="1">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#000B0C0E" Offset="0.0"/>
                                                <GradientStop Color="#150B0C0E" Offset="0.15"/>
                                                <GradientStop Color="#500B0C0E" Offset="0.40"/>
                                                <GradientStop Color="#A00B0C0E" Offset="0.65"/>
                                                <GradientStop Color="#E60B0C0E" Offset="0.85"/>
                                                <GradientStop Color="#FF0B0C0E" Offset="1.0"/>
                                            </LinearGradientBrush>
