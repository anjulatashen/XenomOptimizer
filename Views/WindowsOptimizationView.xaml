                    <!-- Slide Header Info -->

                    <Border Background="#181216" BorderBrush="#2D1D28" BorderThickness="1" CornerRadius="10"

                            Padding="16,12" Margin="0,0,0,16">

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="Auto"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>

                            <Border Background="#3D1D2E" CornerRadius="8" Width="36" Height="36" Margin="0,0,14,0">

                                <TextBlock Text="&#xE71A;" FontFamily="Segoe MDL2 Assets" FontSize="18"

                                           Foreground="#F43F5E" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">

                                <TextBlock Text="Disable Unused Windows Features &amp; Services" FontSize="15" FontWeight="Bold"

                                           Foreground="{StaticResource TextPrimaryBrush}"/>

                                <TextBlock Text="Turn off background Xbox telemetry, Game DVR recording, P2P update seeding, and UWP background polling."

                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>

                            </StackPanel>

                        </Grid>

                    </Border>



                    <!-- Services Optimization Cards -->

                    <ItemsControl ItemsSource="{Binding ServicesOptimizations}">

                        <ItemsControl.ItemTemplate>

                            <DataTemplate>

                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">

                                    <Grid>

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="*"/>

                                            <ColumnDefinition Width="Auto"/>

                                        </Grid.ColumnDefinitions>



                                        <StackPanel>

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">

                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"

                                                           Foreground="{StaticResource TextPrimaryBrush}"/>

                                                <Border Background="#1E293B" CornerRadius="4" Padding="6,2" Margin="8,0,0,0"

                                                        Visibility="{Binding RequiresAdmin, Converter={StaticResource BoolToVis}}">

                                                    <TextBlock Text="ADMIN" FontSize="9" FontWeight="Bold" Foreground="#38BDF8"/>

                                                </Border>

                                            </StackPanel>



                                            <TextBlock Text="{Binding Description}" FontSize="12"

                                                       Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>



