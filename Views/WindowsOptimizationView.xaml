                                        <!-- Apply / Restore Buttons -->

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">

                                            <Button Style="{StaticResource PrimaryButton}" Content="Apply"

                                                    Command="{Binding ApplyCommand}" Margin="0,0,0,6" MinWidth="90"/>

                                            <Button Style="{StaticResource SecondaryButton}" Content="Restore"

                                                    Command="{Binding RestoreCommand}" MinWidth="90"/>

                                        </StackPanel>

                                    </Grid>

                                </Border>

                            </DataTemplate>

                        </ItemsControl.ItemTemplate>

                    </ItemsControl>



                    <!-- ── LOW-END PC OPTIMIZATIONS SUBSECTION (AS REQUESTED) ── -->

                    <Border Style="{StaticResource CardBorder}" Margin="0,16,0,16" Background="#0F111A" BorderBrush="#252A3D">

                        <StackPanel>

                            <!-- Subsection Header -->

                            <Grid Margin="0,0,0,12">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="Auto"/>

                                </Grid.ColumnDefinitions>



                                <StackPanel>

                                    <StackPanel Orientation="Horizontal">

                                        <TextBlock Text="Low-End PC Optimizations" FontSize="16" FontWeight="Bold"

                                                   Foreground="{StaticResource AccentOrangeBrush}"/>

                                        <Border Background="#2E1B10" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">

                                            <TextBlock Text="POTATO PC BOOST" FontSize="9" FontWeight="Bold" Foreground="#FB923C"/>

                                        </Border>

                                    </StackPanel>

                                    <TextBlock Text="Specific performance mitigations for systems with low RAM, integrated graphics, or older CPUs."

                                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,0"/>

                                </StackPanel>



                                <!-- Instant RAM Flush Action Button -->

                                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"

                                        Command="{Binding CleanStandbyRamCommand}"

                                        Padding="14,8" VerticalAlignment="Center">

                                    <StackPanel Orientation="Horizontal">

                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" Foreground="{StaticResource AccentCyanBrush}"/>

                                        <TextBlock Text="Flush Standby RAM Now" FontSize="11" FontWeight="SemiBold"/>

                                    </StackPanel>

                                </Button>

                            </Grid>



                            <!-- Low-End Optimization Items -->

                            <ItemsControl ItemsSource="{Binding LowEndOptimizations}">

                                <ItemsControl.ItemTemplate>

                                    <DataTemplate>

                                        <Border Background="#141724" BorderBrush="#20263A" BorderThickness="1"

                                                CornerRadius="8" Padding="12,10" Margin="0,0,0,8">

                                            <Grid>

                                                <Grid.ColumnDefinitions>

                                                    <ColumnDefinition Width="*"/>

                                                    <ColumnDefinition Width="Auto"/>

                                                </Grid.ColumnDefinitions>



                                                <StackPanel>

                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">

                                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"

                                                                   Foreground="{StaticResource TextPrimaryBrush}"/>

                                                        <Border Background="#1E293B" CornerRadius="4" Padding="5,1" Margin="8,0,0,0"

                                                                Visibility="{Binding RequiresAdmin, Converter={StaticResource BoolToVis}}">

                                                            <TextBlock Text="ADMIN" FontSize="8" FontWeight="Bold" Foreground="#38BDF8"/>

                                                        </Border>

                                                    </StackPanel>

                                                    <TextBlock Text="{Binding Description}" FontSize="11"

                                                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,4"/>

                                                    <TextBlock Text="{Binding StatusMessage}" FontSize="11"

                                                               Foreground="{StaticResource AccentGreenBrush}"

                                                               Visibility="{Binding StatusMessage, Converter={StaticResource StringToVis}}"/>

                                                </StackPanel>



                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">

                                                    <Button Style="{StaticResource PrimaryButton}" Content="Apply"

                                                            Command="{Binding ApplyCommand}" Padding="12,5" MinWidth="75" Margin="0,0,6,0"/>

                                                    <Button Style="{StaticResource SecondaryButton}" Content="Restore"

                                                            Command="{Binding RestoreCommand}" Padding="12,5" MinWidth="75"/>

                                                </StackPanel>

                                            </Grid>

                                        </Border>

                                    </DataTemplate>

                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                        </StackPanel>

                    </Border>

                </StackPanel>



            </StackPanel>

        </ScrollViewer>



        <!-- ── BOTTOM FADE GRADIENT (ACTIVE ON SLIDES 1 & 2 AND DRIVER INSTALLATION; COLLAPSED ON DRIVER HUB DASHBOARD) ── -->

        <Border Grid.RowSpan="2" VerticalAlignment="Bottom" Height="90" IsHitTestVisible="False" Panel.ZIndex="5">

            <Border.Style>

                <Style TargetType="Border">

                    <Setter Property="Visibility" Value="Visible"/>

                    <Style.Triggers>

                        <!-- Drivers Hub Dashboard (Expanded): Collapsed (no fade) -->

                        <MultiDataTrigger>

                            <MultiDataTrigger.Conditions>

                                <Condition Binding="{Binding IsDriversSlideActive}" Value="True"/>

                                <Condition Binding="{Binding IsDriverInstallationViewActive}" Value="False"/>

                            </MultiDataTrigger.Conditions>

                            <Setter Property="Visibility" Value="Collapsed"/>

                        </MultiDataTrigger>

                    </Style.Triggers>

                </Style>

            </Border.Style>

            <Border.Background>

                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">

                    <GradientStop Color="#000B0C0E" Offset="0.0"/>

                    <GradientStop Color="#200B0C0E" Offset="0.25"/>

                    <GradientStop Color="#650B0C0E" Offset="0.5"/>

                    <GradientStop Color="#B50B0C0E" Offset="0.75"/>

                    <GradientStop Color="#FF0B0C0E" Offset="1.0"/>

                </LinearGradientBrush>

            </Border.Background>

        </Border>



        <!-- ═══════════════════════════════════════════════════════════════ -->

        <!-- ROW 1: FLUID LIQUID EXPANDING DOT PAGINATION (NO BOX / NO OUTLINE) -->

        <!-- ═══════════════════════════════════════════════════════════════ -->

        <Border x:Name="BottomPaginationDotsBorder" Grid.RowSpan="2" Panel.ZIndex="100" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Width="320" Height="46" Margin="0,0,90,0" Background="Transparent" BorderThickness="0"
                PreviewMouseWheel="PaginationBar_PreviewMouseWheel"
                FocusVisualStyle="{x:Null}" ClipToBounds="False">

            <Grid x:Name="PaginationRootGrid" ClipToBounds="False" HorizontalAlignment="Center" VerticalAlignment="Center">

                <!-- 1. DOTS CONTAINER (Normal resting state: 3 pagination dots) -->
                <StackPanel x:Name="PaginationDotsHost" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                            RenderTransformOrigin="0.5,0.5">
                    <StackPanel.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="PaginationDotsScale" ScaleX="1" ScaleY="1"/>
                            <TranslateTransform x:Name="PaginationDotsShake" X="0" Y="0"/>
                        </TransformGroup>
                    </StackPanel.RenderTransform>



                <!-- ── DOT 0: DRIVERS HUB ── -->

                <Button Command="{Binding SelectSlideCommand}" CommandParameter="0"

                        Visibility="{Binding IsDriversIncludedMode, Converter={StaticResource BoolToVis}}"

                        Cursor="Hand" Background="Transparent" BorderThickness="0"

                        FocusVisualStyle="{x:Null}" IsTabStop="False"

                        Padding="4,8" Margin="0,0,6,0">

                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="ToolTip" Value="Drivers Hub (Click or scroll to switch)"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CanNavigateToNextSlide}" Value="False">
                                    <Setter Property="ToolTip" Value="Drivers Hub (Scan drivers or skip to unlock)"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>

                    <Button.Template>

                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent" Cursor="Hand" FocusVisualStyle="{x:Null}">
                                <Border x:Name="DotPill" Height="10" Width="10" CornerRadius="5"
                                        Background="#4A5568" SnapsToDevicePixels="True" UseLayoutRounding="True"/>
                            </Grid>

                            <ControlTemplate.Triggers>

                                <!-- ACTIVE STATE: Stretches into Crisp White Pill (Zero outline) -->

                                <DataTrigger Binding="{Binding IsDriversSlideActive}" Value="True">

                                    <Setter TargetName="DotPill" Property="Background" Value="#CBD5E1"/>

                                    <DataTrigger.EnterActions>

                                        <BeginStoryboard>

                                            <Storyboard>

                                                <DoubleAnimation Storyboard.TargetName="DotPill"

                                                                 Storyboard.TargetProperty="Width"

                                                                 To="42" Duration="0:0:0.32">

                                                    <DoubleAnimation.EasingFunction>

                                                        <CubicEase EasingMode="EaseOut"/>

                                                    </DoubleAnimation.EasingFunction>

                                                </DoubleAnimation>

                                            </Storyboard>

                                        </BeginStoryboard>

                                    </DataTrigger.EnterActions>

                                    <DataTrigger.ExitActions>

                                        <BeginStoryboard>

                                            <Storyboard>

                                                <DoubleAnimation Storyboard.TargetName="DotPill"

                                                                 Storyboard.TargetProperty="Width"

                                                                 To="10" Duration="0:0:0.32">

                                                    <DoubleAnimation.EasingFunction>

                                                        <CubicEase EasingMode="EaseOut"/>

                                                    </DoubleAnimation.EasingFunction>

                                                </DoubleAnimation>

                                            </Storyboard>

                                        </BeginStoryboard>

                                    </DataTrigger.ExitActions>

                                </DataTrigger>



                                <!-- INACTIVE HOVER STATE -->

                                <MultiDataTrigger>

                                    <MultiDataTrigger.Conditions>

                                        <Condition Binding="{Binding IsDriversSlideActive}" Value="False"/>

                                        <Condition Binding="{Binding Path=IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>

                                    </MultiDataTrigger.Conditions>

                                    <Setter TargetName="DotPill" Property="Background" Value="#94A3B8"/>

                                </MultiDataTrigger>

                            </ControlTemplate.Triggers>

                        </ControlTemplate>

                    </Button.Template>

                </Button>



                <!-- ── DOT 1: SYSTEM SERVICES ── -->

                <Button x:Name="PaginationDotBtn1" Tag="1"
                        Command="{Binding SelectSlideCommand}" CommandParameter="1"
                        PreviewMouseLeftButtonDown="LockedPaginationDot_PreviewMouseLeftButtonDown"
                        Cursor="Hand" Background="Transparent" BorderThickness="0"
                        FocusVisualStyle="{x:Null}" IsTabStop="False"
                        Padding="4,8" Margin="0,0,6,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="ToolTip" Value="System Services (Click or scroll to switch)"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CanNavigateToNextSlide}" Value="False">
                                    <Setter Property="ToolTip" Value="System Services (Scan drivers or skip to unlock)"/>
                                    <Setter Property="Cursor" Value="No"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>

                    <Button.Template>

                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent" FocusVisualStyle="{x:Null}">
                                <Border x:Name="DotPill" Height="10" Width="10" CornerRadius="5"
                                        Background="#4A5568" SnapsToDevicePixels="True" UseLayoutRounding="True"/>
                            </Grid>

                            <ControlTemplate.Triggers>

                                <DataTrigger Binding="{Binding CanNavigateToNextSlide}" Value="False">
                                    <Setter TargetName="DotPill" Property="Opacity" Value="0.35"/>
                                </DataTrigger>

                                <!-- ACTIVE STATE: Stretches into Crisp White Pill (Zero outline) -->

                                <DataTrigger Binding="{Binding IsServicesSlideActive}" Value="True">

                                    <Setter TargetName="DotPill" Property="Background" Value="#CBD5E1"/>

                                    <DataTrigger.EnterActions>

                                        <BeginStoryboard>

                                            <Storyboard>

                                                <DoubleAnimation Storyboard.TargetName="DotPill"

                                                                 Storyboard.TargetProperty="Width"

                                                                 To="42" Duration="0:0:0.32">

                                                    <DoubleAnimation.EasingFunction>

                                                        <CubicEase EasingMode="EaseOut"/>

                                                    </DoubleAnimation.EasingFunction>

                                                </DoubleAnimation>

                                            </Storyboard>

                                        </BeginStoryboard>

                                    </DataTrigger.EnterActions>

                                    <DataTrigger.ExitActions>

                                        <BeginStoryboard>

                                            <Storyboard>

                                                <DoubleAnimation Storyboard.TargetName="DotPill"

                                                                 Storyboard.TargetProperty="Width"

                                                                 To="10" Duration="0:0:0.32">

                                                    <DoubleAnimation.EasingFunction>

                                                        <CubicEase EasingMode="EaseOut"/>

                                                    </DoubleAnimation.EasingFunction>

                                                </DoubleAnimation>

                                            </Storyboard>

                                        </BeginStoryboard>

                                    </DataTrigger.ExitActions>

                                </DataTrigger>



                                <!-- INACTIVE HOVER STATE -->

                                <MultiDataTrigger>

                                    <MultiDataTrigger.Conditions>

                                        <Condition Binding="{Binding IsServicesSlideActive}" Value="False"/>

                                        <Condition Binding="{Binding CanNavigateToNextSlide}" Value="True"/>

                                        <Condition Binding="{Binding Path=IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>

                                    </MultiDataTrigger.Conditions>

                                    <Setter TargetName="DotPill" Property="Background" Value="#94A3B8"/>

                                </MultiDataTrigger>

                            </ControlTemplate.Triggers>

                        </ControlTemplate>

                    </Button.Template>

                </Button>



                <!-- ── DOT 2: ADVANCE OPTIMIZATION ── -->

                <Button x:Name="PaginationDotBtn2" Tag="2"
                        Command="{Binding SelectSlideCommand}" CommandParameter="2"
                        PreviewMouseLeftButtonDown="LockedPaginationDot_PreviewMouseLeftButtonDown"
                        Cursor="Hand" Background="Transparent" BorderThickness="0"
                        FocusVisualStyle="{x:Null}" IsTabStop="False"
                        Padding="4,8" Margin="0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="ToolTip" Value="Advance Optimization (Click or scroll to switch)"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CanNavigateToNextSlide}" Value="False">
                                    <Setter Property="ToolTip" Value="Advance Optimization (Scan drivers or skip to unlock)"/>
                                    <Setter Property="Cursor" Value="No"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>

                    <Button.Template>

                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent" FocusVisualStyle="{x:Null}">
                                <Border x:Name="DotPill" Height="10" Width="10" CornerRadius="5"
                                        Background="#4A5568" SnapsToDevicePixels="True" UseLayoutRounding="True"/>
                            </Grid>

                            <ControlTemplate.Triggers>

                                <DataTrigger Binding="{Binding CanNavigateToNextSlide}" Value="False">
                                    <Setter TargetName="DotPill" Property="Opacity" Value="0.35"/>
                                </DataTrigger>

                                <!-- ACTIVE STATE: Stretches into Crisp White Pill (Zero outline) -->

                                <DataTrigger Binding="{Binding IsAdvanceSlideActive}" Value="True">

                                    <Setter TargetName="DotPill" Property="Background" Value="#CBD5E1"/>

                                    <DataTrigger.EnterActions>

                                        <BeginStoryboard>

                                            <Storyboard>

                                                <DoubleAnimation Storyboard.TargetName="DotPill"

                                                                 Storyboard.TargetProperty="Width"

                                                                 To="42" Duration="0:0:0.32">

                                                    <DoubleAnimation.EasingFunction>

                                                        <CubicEase EasingMode="EaseOut"/>

                                                    </DoubleAnimation.EasingFunction>

                                                </DoubleAnimation>

                                            </Storyboard>

                                        </BeginStoryboard>

                                    </DataTrigger.EnterActions>

                                    <DataTrigger.ExitActions>

                                        <BeginStoryboard>

                                            <Storyboard>

                                                <DoubleAnimation Storyboard.TargetName="DotPill"

                                                                 Storyboard.TargetProperty="Width"

                                                                 To="10" Duration="0:0:0.32">

                                                    <DoubleAnimation.EasingFunction>

                                                        <CubicEase EasingMode="EaseOut"/>

                                                    </DoubleAnimation.EasingFunction>

                                                </DoubleAnimation>

                                            </Storyboard>

                                        </BeginStoryboard>

                                    </DataTrigger.ExitActions>

                                </DataTrigger>



                                <!-- INACTIVE HOVER STATE -->

                                <MultiDataTrigger>

                                    <MultiDataTrigger.Conditions>

                                        <Condition Binding="{Binding IsAdvanceSlideActive}" Value="False"/>

                                        <Condition Binding="{Binding CanNavigateToNextSlide}" Value="True"/>

                                        <Condition Binding="{Binding Path=IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>

                                    </MultiDataTrigger.Conditions>

                                    <Setter TargetName="DotPill" Property="Background" Value="#94A3B8"/>

                                </MultiDataTrigger>

                            </ControlTemplate.Triggers>

                        </ControlTemplate>

                    </Button.Template>

                </Button>



            </StackPanel>

                <!-- 2. LOCKED INDICATOR (Replaces dots when locked dot is clicked/scrolled; Lock only, no circle, no glow, no text) -->
                <Grid x:Name="PaginationLockHost" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Opacity="0" Visibility="Collapsed" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="PaginationLockScale" ScaleX="0.6" ScaleY="0.6"/>
                            <TranslateTransform x:Name="PaginationLockShake" X="0" Y="0"/>
                        </TransformGroup>
                    </Grid.RenderTransform>

                    <!-- Pure Lock Icon Only (No circle, no glow) -->
                    <TextBlock x:Name="PaginationLockGlyph" Text="&#xE72E;" FontFamily="Segoe MDL2 Assets"
                               FontSize="16" FontWeight="SemiBold" Foreground="#EF4444"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <!-- 3. SMALL FLOATING HINT MESSAGE (Pure text only - appears in the exact spot of the lock after lock fades out, then fades away before dots return) -->
                <Border x:Name="PaginationHintBadge" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Margin="0" Background="Transparent" BorderThickness="0"
                        Opacity="0" Visibility="Collapsed" IsHitTestVisible="False">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="PaginationHintTrans" Y="0"/>
                    </Border.RenderTransform>
                    <TextBlock x:Name="PaginationHintText"
                               Text="Scan to unlock Windows optimizations"
                               FontSize="11.5" FontWeight="SemiBold" Foreground="#CBD5E1"
                               FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.6" Color="#000000"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </Border>

            </Grid>

        </Border>











        <!-- ═══════════════════════════════════════════════════════════════ -->

        <!-- STEP-BY-STEP ONBOARDING TASK GUIDE MODAL (IMAGE 3 SLEEK STYLE)   -->

        <!-- ═══════════════════════════════════════════════════════════════ -->




        <!-- ═══════════════════════════════════════════════════════════════ -->

        <!-- CONFIRMATION MODAL POPUP DIALOG OVERLAY (APPLY / RESTORE)       -->

        <!-- ═══════════════════════════════════════════════════════════════ -->

        <Grid Grid.RowSpan="2" Background="#B0000000"

              Visibility="{Binding IsConfirmDialogVisible, Converter={StaticResource BoolToVis}}">

            <Border Background="#13151F" BorderBrush="#2A2E42" BorderThickness="1.5"

                    CornerRadius="16" Padding="28,24" MaxWidth="480"

                    HorizontalAlignment="Center" VerticalAlignment="Center">

                <Border.Effect>

                    <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.7" Color="Black"/>

                </Border.Effect>



                <StackPanel>

                    <!-- Modal Header Icon & Title -->

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">

                        <Border Background="#251820" CornerRadius="10" Width="38" Height="38" Margin="0,0,12,0">

                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="18"

                                       Foreground="{StaticResource AccentOrangeBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        </Border>

                        <TextBlock Text="{Binding ConfirmDialogTitle}" FontSize="17" FontWeight="Bold"

                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>

                    </StackPanel>



                    <!-- Message Body -->

                    <TextBlock Text="{Binding ConfirmDialogMessage}" FontSize="13"

                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"

                               LineHeight="20" Margin="0,0,0,22"/>



                    <!-- Action Buttons: Cancel vs Yes Confirm -->

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="12"/>

                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>



                        <!-- Cancel Button -->

                        <Button Grid.Column="0" Style="{StaticResource SecondaryButton}"

                                Content="Cancel" Command="{Binding CancelActionCommand}"

                                Padding="0,10" FontSize="12" FontWeight="SemiBold"/>



                        <!-- Yes, Confirm Button -->

                        <Button Grid.Column="2" Style="{StaticResource PrimaryButton}"

                                Content="{Binding ConfirmDialogButtonText}" Command="{Binding ConfirmActionCommand}"

                                Padding="0,10" FontSize="12" FontWeight="Bold"/>

                    </Grid>

                </StackPanel>

            </Border>

        </Grid>



    </Grid>

</UserControl>

