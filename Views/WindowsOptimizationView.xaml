                                                <Grid.ColumnDefinitions>

                                                    <ColumnDefinition Width="Auto"/>

                                                    <ColumnDefinition Width="20"/>

                                                    <ColumnDefinition Width="Auto"/>

                                                </Grid.ColumnDefinitions>

                                                <StackPanel>

                                                    <TextBlock Text="Current" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>

                                                    <TextBlock Text="{Binding CurrentValue}" FontSize="12"

