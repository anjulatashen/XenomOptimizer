<UserControl x:Class="XenomOptimizer.Views.WindowsOptimizationView"

             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

             xmlns:views="clr-namespace:XenomOptimizer.Views"

             xmlns:gif="http://wpfanimatedgif.codeplex.com">



    <Grid>

        <!-- Background Grid Layout: Row 0 = Scrollable Content, Row 1 = Bottom Floating Stepper Bar -->

        <Grid.RowDefinitions>

            <RowDefinition Height="*"/>

            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>



        <!-- ═══════════════════════════════════════════════════════════════ -->

        <!-- ROW 0: MAIN CONTENT (WITH BOTTOM FADE EFFECT)                   -->

        <!-- ═══════════════════════════════════════════════════════════════ -->

        <ScrollViewer x:Name="MainContentScrollViewer" Grid.RowSpan="2" Padding="24,0,24,0">
            <ScrollViewer.Effect>
                <BlurEffect x:Name="MainContentBlur" Radius="0" RenderingBias="Performance"/>
            </ScrollViewer.Effect>

            <ScrollViewer.Style>

                <Style TargetType="ScrollViewer">

                    <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>

                    <Style.Triggers>

                        <!-- DRIVER HUB: SCROLLING COMPLETELY DISABLED ON SLIDE 0 (DRIVERS) -->

                        <DataTrigger Binding="{Binding IsDriversSlideActive}" Value="True">

                            <Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>

                        </DataTrigger>

                    </Style.Triggers>

                </Style>

            </ScrollViewer.Style>

            <ScrollViewer.OpacityMask>

                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">

                    <GradientStop Color="#FFFFFFFF" Offset="0.0"/>

                    <GradientStop Color="#FFFFFFFF" Offset="0.88"/>

                    <GradientStop Color="#D5FFFFFF" Offset="0.92"/>

                    <GradientStop Color="#80FFFFFF" Offset="0.955"/>

                    <GradientStop Color="#25FFFFFF" Offset="0.98"/>

                    <GradientStop Color="#00FFFFFF" Offset="1.0"/>

                </LinearGradientBrush>

            </ScrollViewer.OpacityMask>

            <!-- Content StackPanel matching Home Dashboard width (1200px) -->

            <StackPanel MaxWidth="1200" Margin="0">



                <!-- ── HEADER ROW (Aligned horizontally with sidebar logo) ── -->

                <Grid x:Name="PageHeaderGrid" Height="64" Margin="0,26,0,26">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="Auto"/>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>



                    <!-- Title & Subtitle (Modern Dashboard Font Style matching Photo 2) -->

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">

                        <TextBlock Text="{Binding CurrentPageTitle}" FontSize="28" FontWeight="Bold"

                                   FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"

                                   Foreground="#FFFFFF" Margin="0,0,0,4"/>

                        <TextBlock Text="{Binding CurrentPageSubtitle}"

                                   FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"

                                   Foreground="#9E9EA4" FontSize="13"/>

                    </StackPanel>



                    <!-- Right-Aligned Header Actions -->

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">



                        <!-- PHOTO 2 HEADER STATS (Visible on Drivers Hub ONLY after Driver Scan completes, styled exactly like Reference Photo 2) -->
                        <StackPanel x:Name="HeaderStatsPanel" Orientation="Horizontal" Height="64" VerticalAlignment="Center" Margin="0,0,16,0"
                                    Visibility="Collapsed">

                            <!-- Stat 1: Drivers Verified -->
                            <StackPanel x:Name="HeaderStatItem1" Margin="0,0,48,0" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <StackPanel.RenderTransform>
                                    <TranslateTransform x:Name="Stat1Trans" Y="0"/>
                                </StackPanel.RenderTransform>
                                <TextBlock Text="Drivers Verified" FontSize="12" Foreground="#8E95A5"
                                           FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                           TextAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding VerifiedDriversRatioText, FallbackValue='0/0'}" FontSize="29" FontWeight="Bold" Foreground="#D1FE29"
                                           FontFamily="pack://application:,,,/Fonts/#Poppins, Montserrat, Segoe UI Variable Display, sans-serif"
                                           TextAlignment="Center" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- Stat 2: Driver Progress (Dynamic Percentage based on installed drivers) -->
                            <StackPanel x:Name="HeaderStatItem2" Margin="0,0,48,0" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <StackPanel.RenderTransform>
                                    <TranslateTransform x:Name="Stat2Trans" Y="0"/>
                                </StackPanel.RenderTransform>
                                <TextBlock Text="Driver Progress" FontSize="12" Foreground="#8E95A5"
                                           FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                           TextAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding DriverProgressPercentText, FallbackValue='100%'}" FontSize="29" FontWeight="Bold" Foreground="#D1FE29"
                                           FontFamily="pack://application:,,,/Fonts/#Poppins, Montserrat, Segoe UI Variable Display, sans-serif"
                                           TextAlignment="Center" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- Stat 3: Active Drivers (Pure count metric matching Photo 2) -->
                            <StackPanel x:Name="HeaderStatItem3" Margin="0,0,24,0" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <StackPanel.RenderTransform>
                                    <TranslateTransform x:Name="Stat3Trans" Y="0"/>
                                </StackPanel.RenderTransform>
                                <TextBlock Text="Active Drivers" FontSize="12" Foreground="#8E95A5"
                                           FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                           TextAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding ActiveDriversCountText, FallbackValue='5'}" FontSize="29" FontWeight="Bold" Foreground="#D1FE29"
                                           FontFamily="pack://application:,,,/Fonts/#Poppins, Montserrat, Segoe UI Variable Display, sans-serif"
                                           TextAlignment="Center" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>



                        <!-- Guide Button on Drivers Hub (Green icon, Black on hover with subtle dark gray outline) -->
                        <Button x:Name="HeaderGuideBtn" Command="{Binding ShowInstructionModalCommand}"
                                Cursor="Hand" Background="Transparent" BorderThickness="0"
                                Height="36" VerticalAlignment="Center"
                                Margin="0,0,10,0"
                                Visibility="{Binding IsDriversSlideActive, Converter={StaticResource BoolToVis}}"
                                ToolTip="Setup &amp; Optimization Guide">
                            <Button.RenderTransform>
                                <TranslateTransform x:Name="GuideBtnTrans" X="0" Y="0"/>
                            </Button.RenderTransform>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="GuideBtnBorder" Height="36"
                                            Background="#1C1E22" BorderBrush="#282B33" BorderThickness="1"
                                            CornerRadius="8" Padding="12,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <!-- Green icon next to Guide (as requested: blue wenuwata green) -->
                                            <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="11.5"
                                                       Foreground="#D1FE29" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Guide" FontSize="11.5" FontWeight="SemiBold" Foreground="#FFFFFF"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <!-- Hover state: Solid Black, NO outline -->
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="GuideBtnBorder" Property="Background" Value="#000000"/>
                                            <Setter TargetName="GuideBtnBorder" Property="BorderBrush" Value="Transparent"/>
                                            <Setter TargetName="GuideBtnBorder" Property="BorderThickness" Value="1"/>
                                        </Trigger>
                                        <!-- Clicked state: Outline appears ONLY when clicked -->
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="GuideBtnBorder" Property="Background" Value="#08080A"/>
                                            <Setter TargetName="GuideBtnBorder" Property="BorderBrush" Value="#383D48"/>
                                            <Setter TargetName="GuideBtnBorder" Property="BorderThickness" Value="1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>



                        <!-- UNIFIED FLOATING NAVIGATION BAR (Hidden on Slide 0 Drivers, visible on Slide 1 & 2) -->

                        <Border Background="#0E111B" BorderBrush="#1C2235" BorderThickness="1.2"

                                CornerRadius="9" Padding="3" Margin="0,0,10,0" VerticalAlignment="Center"

                                Visibility="{Binding IsDriversSlideActive, Converter={StaticResource InvBoolToVis}}">

                            <Border.Effect>

                                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.4" Color="#000000"/>

                            </Border.Effect>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">



                                <!-- 1. New User Button -->

                                <Button Command="{Binding SetSetupModeCommand}" CommandParameter="NewUser"

                                        Cursor="Hand" Background="Transparent" BorderThickness="0">

                                    <Button.Template>

                                        <ControlTemplate TargetType="Button">

                                            <Border CornerRadius="7" Padding="12,5">

                                                <Border.Style>

                                                    <Style TargetType="Border">

                                                        <Setter Property="Background" Value="Transparent"/>

                                                        <Style.Triggers>

                                                            <DataTrigger Binding="{Binding IsDriversIncludedMode}" Value="True">

                                                                <Setter Property="Background" Value="#172338"/>

                                                                <Setter Property="BorderBrush" Value="#0284C7"/>

                                                                <Setter Property="BorderThickness" Value="1"/>

                                                            </DataTrigger>

                                                        </Style.Triggers>

                                                    </Style>

                                                </Border.Style>

                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                                    <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center">

                                                        <TextBlock.Style>

                                                            <Style TargetType="TextBlock">

                                                                <Setter Property="Foreground" Value="#64748B"/>

                                                                <Style.Triggers>

                                                                    <DataTrigger Binding="{Binding IsDriversIncludedMode}" Value="True">

                                                                        <Setter Property="Foreground" Value="#38BDF8"/>

                                                                    </DataTrigger>

                                                                </Style.Triggers>

                                                            </Style>

                                                        </TextBlock.Style>

                                                    </TextBlock>

                                                    <TextBlock Text="New User" FontSize="11.5" FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif">

                                                        <TextBlock.Style>

                                                            <Style TargetType="TextBlock">

                                                                <Setter Property="Foreground" Value="#71717A"/>

                                                                <Setter Property="FontWeight" Value="SemiBold"/>

                                                                <Style.Triggers>

                                                                    <DataTrigger Binding="{Binding IsDriversIncludedMode}" Value="True">

                                                                        <Setter Property="Foreground" Value="#FFFFFF"/>

                                                                        <Setter Property="FontWeight" Value="Bold"/>

                                                                    </DataTrigger>

                                                                </Style.Triggers>

                                                            </Style>

                                                        </TextBlock.Style>

                                                    </TextBlock>

                                                </StackPanel>

                                            </Border>

                                        </ControlTemplate>

                                    </Button.Template>

                                </Button>



                                <!-- 2. Experienced Button -->

                                <Button Command="{Binding SetSetupModeCommand}" CommandParameter="Experienced"

                                        Cursor="Hand" Background="Transparent" BorderThickness="0" Margin="2,0,0,0">

                                    <Button.Template>

                                        <ControlTemplate TargetType="Button">

                                            <Border CornerRadius="7" Padding="12,5">

                                                <Border.Style>

                                                    <Style TargetType="Border">

                                                        <Setter Property="Background" Value="Transparent"/>

                                                        <Style.Triggers>

                                                            <DataTrigger Binding="{Binding IsDriversIncludedMode}" Value="False">

                                                                <Setter Property="Background" Value="#241636"/>

                                                                <Setter Property="BorderBrush" Value="#9333EA"/>

                                                                <Setter Property="BorderThickness" Value="1"/>

                                                            </DataTrigger>

                                                        </Style.Triggers>

                                                    </Style>

                                                </Border.Style>

                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                                    <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center">

                                                        <TextBlock.Style>

                                                            <Style TargetType="TextBlock">

                                                                <Setter Property="Foreground" Value="#64748B"/>

                                                                <Style.Triggers>

                                                                    <DataTrigger Binding="{Binding IsDriversIncludedMode}" Value="False">

                                                                        <Setter Property="Foreground" Value="#C084FC"/>

                                                                    </DataTrigger>

                                                                </Style.Triggers>

                                                            </Style>

                                                        </TextBlock.Style>

                                                    </TextBlock>

                                                    <TextBlock Text="Experienced" FontSize="11.5" FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif">

                                                        <TextBlock.Style>

                                                            <Style TargetType="TextBlock">

                                                                <Setter Property="Foreground" Value="#71717A"/>

                                                                <Setter Property="FontWeight" Value="SemiBold"/>

                                                                <Style.Triggers>

                                                                    <DataTrigger Binding="{Binding IsDriversIncludedMode}" Value="False">

                                                                        <Setter Property="Foreground" Value="#FFFFFF"/>

                                                                        <Setter Property="FontWeight" Value="Bold"/>

                                                                    </DataTrigger>

                                                                </Style.Triggers>

                                                            </Style>

                                                        </TextBlock.Style>

                                                    </TextBlock>

                                                </StackPanel>

                                            </Border>

                                        </ControlTemplate>

                                    </Button.Template>

                                </Button>



                                <!-- Thin Vertical Divider Line -->

                                <Rectangle Width="1" Height="16" Fill="#1E2436" Margin="4,0"/>



                                <!-- 3. Guide Button -->

                                <Button x:Name="NavGuideBtn" Command="{Binding ShowInstructionModalCommand}"

                                        Cursor="Hand" Background="Transparent" BorderThickness="0"

                                        ToolTip="Open Setup Guide">

                                    <Button.Template>

                                        <ControlTemplate TargetType="Button">

                                            <Border CornerRadius="7" Padding="11,5">

                                                <Border.Style>

                                                    <Style TargetType="Border">

                                                        <Setter Property="Background" Value="Transparent"/>

                                                        <Style.Triggers>

                                                            <DataTrigger Binding="{Binding IsInstructionModalVisible}" Value="True">

                                                                <Setter Property="Background" Value="#17243E"/>

                                                                <Setter Property="BorderBrush" Value="#0284C7"/>

                                                                <Setter Property="BorderThickness" Value="1"/>

                                                            </DataTrigger>

                                                        </Style.Triggers>

                                                    </Style>

                                                </Border.Style>

                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                                    <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="11"

                                                               Foreground="#D1FE29" Margin="0,0,5,0" VerticalAlignment="Center"/>

                                                    <TextBlock Text="Guide" FontSize="11.5" FontWeight="SemiBold"

                                                               Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif" VerticalAlignment="Center"/>

                                                </StackPanel>

                                            </Border>

                                        </ControlTemplate>

                                    </Button.Template>

                                </Button>



                            </StackPanel>

                        </Border>



                        <!-- STANDALONE DOWNLOAD BUTTON (Square look matching Guide: CornerRadius=8, Liquid lime green #D1FE29 fill animation, wipe transition & morphing shrink animation) -->
                        <Button x:Name="StandaloneDownloadBtn" Command="{Binding ToggleDownloadFlyoutCommand}"
                                Cursor="Hand" Background="Transparent" BorderThickness="0"
                                Margin="0,0,10,0" ToolTip="Downloads &amp; Gaming Runtimes Manager">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="DownloadBtnBorder" Height="36" Width="98" Padding="12,0,14,0"
                                            Background="#1C1E22" BorderBrush="#282B33" BorderThickness="1"
                                            CornerRadius="8" ClipToBounds="True">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDownloadFlyoutOpen}" Value="True">
                                                        <Setter Property="Background" Value="#16233B"/>
                                                        <Setter Property="BorderBrush" Value="#0284C7"/>
                                                    </DataTrigger>
                                                    <!-- Hover: Solid Black, No outline, BorderThickness stays 1 so NO layout shift -->
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#000000"/>
                                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                                            <!-- Liquid Lime Green Progress Fill rising from bottom to top (#D1FE29 matching Xenom brand) -->
                                            <Border x:Name="DownloadLiquidFill" Background="#D1FE29"
                                                    VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                                                    CornerRadius="0,0,8,8"
                                                    Height="{Binding DownloadProgressPercent, Converter={StaticResource DownloadPercentToHeight}}"
                                                    Visibility="{Binding IsDownloadingDriverBooster, Converter={StaticResource BoolToVis}}">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#D1FE29" Opacity="0.6"/>
                                                </Border.Effect>
                                            </Border>

                                            <!-- Normal Arrow Icon & Text -->
                                            <StackPanel x:Name="DownloadNormalIconStack" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <!-- Center Download / Tool Tray Icon -->
                                                <TextBlock x:Name="DownloadArrowIcon" Text="&#xE118;" FontFamily="Segoe MDL2 Assets" FontSize="12.5"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDownloadCompleted}" Value="True">
                                                                    <Setter Property="Foreground" Value="#D1FE29"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                    <TextBlock.RenderTransform>
                                                        <TranslateTransform x:Name="DownloadArrowTranslate" Y="0"/>
                                                    </TextBlock.RenderTransform>
                                                </TextBlock>

                                                <!-- Animatable Container for "Download" Text (Smoothly collapses width & opacity) -->
                                                <Border x:Name="DownloadTextClip" ClipToBounds="True" VerticalAlignment="Center">
                                                    <TextBlock x:Name="DownloadBtnText" Text="Download" FontSize="11.5" FontWeight="SemiBold"
                                                               Foreground="#FFFFFF" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                </Border>
                                            </StackPanel>

                                            <!-- Download Completed Success State: Solid Lime Green #D1FE29 + Dark Checkmark #121410 -->
                                            <Border x:Name="DownloadSuccessLayer"
                                                    Background="#D1FE29"
                                                    CornerRadius="8"
                                                    Visibility="Collapsed"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch">
                                                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="14.5" FontWeight="Bold"
                                                           Foreground="#121410" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Black Wipe Overlay (Sweeps from left to right like RescanDrivers wipe, revealing download icon) -->
                                            <Border x:Name="DownloadBlackWipeOverlay"
                                                    HorizontalAlignment="Left"
                                                    Width="0"
                                                    Background="#1C1E22"
                                                    BorderBrush="#282B33"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    ClipToBounds="True"
                                                    Visibility="Collapsed">
                                                <Grid Width="36" Height="36" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE118;" FontFamily="Segoe MDL2 Assets" FontSize="12.5"
                                                               Foreground="#D1FE29"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <!-- Clicked state: Outline appears ONLY when clicked -->
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="DownloadBtnBorder" Property="Background" Value="#08080A"/>
                                            <Setter TargetName="DownloadBtnBorder" Property="BorderBrush" Value="#383D48"/>
                                            <Setter TargetName="DownloadBtnBorder" Property="BorderThickness" Value="1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Restore Defaults Button (Hidden on Slide 0 Drivers, visible on Slide 1 & 2) -->

                        <Button Style="{StaticResource SecondaryButton}"

                                Command="{Binding RequestRestoreDefaultsCommand}"

                                Margin="0,0,8,0" Padding="12,6"

                                Visibility="{Binding IsDriversSlideActive, Converter={StaticResource InvBoolToVis}}"

                                ToolTip="Reset this tab's settings to stock fresh-install defaults">

                            <StackPanel Orientation="Horizontal">

                                <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets" FontSize="11.5"

                                           VerticalAlignment="Center" Margin="0,0,5,0" Foreground="{StaticResource AccentRedBrush}"/>

                                <TextBlock Text="Restore Defaults" FontSize="11.5" FontWeight="SemiBold"

                                           FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"/>

                            </StackPanel>

                        </Button>



                        <!-- Apply All Recommended Button (Hidden on Slide 0 Drivers, visible on Slide 1 & 2) -->

                        <Button Style="{StaticResource PrimaryButton}"

                                Command="{Binding RequestApplyAllCommand}"

                                Padding="14,6"

                                Visibility="{Binding IsDriversSlideActive, Converter={StaticResource InvBoolToVis}}"

                                ToolTip="Apply all recommended tweaks for this tab">

                            <StackPanel Orientation="Horizontal">

                                <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="12"

                                           VerticalAlignment="Center" Margin="0,0,6,0" Foreground="White"/>

                                <TextBlock Text="Apply Recommended" FontSize="11.5" FontWeight="Bold"

                                           FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"/>

                            </StackPanel>

                        </Button>

                    </StackPanel>

                </Grid>









                <!-- ═══════════════════════════════════════════════════════════ -->

                <!-- SLIDE 0: DRIVERS INSTALLATION                               -->

                <!-- ═══════════════════════════════════════════════════════════ -->

                <StackPanel Visibility="{Binding IsDriversSlideActive, Converter={StaticResource BoolToVis}}">



                    <Grid Margin="0,0,0,24">

                        <Grid.ColumnDefinitions>

                            <!-- Tab 1 (Left): Profile Card (Calibrated 430px to fit screen with Zero Scrolling) -->

                            <ColumnDefinition Width="430"/>

                            <ColumnDefinition Width="20"/>

                            <!-- Tab 2 (Right): Driver Scanner & Actions -->

                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>



                            <!-- ═════════════════════════════════════════════════════════════ -->

                            <!-- TAB 1 (LEFT): HARDWARE PROFILE CARD (PC HARDWARE SPECIFICATIONS) -->

                            <!-- ═════════════════════════════════════════════════════════════ -->

                            <Grid Grid.Column="0">

                                <Border x:Name="ProfileCardBorder" Background="#1C1E22" BorderBrush="#282B33" BorderThickness="1" CornerRadius="24"

                                        Width="430" Height="660" Padding="18,16" VerticalAlignment="Top">

                                    <Border.Effect>

                                        <DropShadowEffect BlurRadius="25" ShadowDepth="4" Opacity="0.45" Color="#000000"/>

                                    </Border.Effect>

                                    <Grid>

                                        <Grid.RowDefinitions>

                                            <!-- Row 0: Header Profile (Avatar + PC Name + Badge + Windows Version) -->

                                            <RowDefinition Height="Auto"/>

                                            <!-- Row 1: Top Inner Card (Hardware Specifications: OS, CPU, GPU, RAM, DirectX, Power Plan) -->

                                            <RowDefinition Height="Auto"/>

                                            <!-- Row 2: Bottom Inner Card (6 Stat Tiles) -->

                                            <RowDefinition Height="*"/>

                                        </Grid.RowDefinitions>



                                        <!-- Header Profile Row (Avatar Initial Letter / Custom Photo + Name + Badge + Windows Version) -->

                                        <Grid x:Name="ProfileHeaderGrid" Grid.Row="0" Margin="0,0,0,12">

                                            <Grid.ColumnDefinitions>

                                                <ColumnDefinition Width="Auto"/>

                                                <ColumnDefinition Width="*"/>

                                            </Grid.ColumnDefinitions>



                                            <!-- Circular Avatar (Default Initial Letter or Custom Photo, Click to Change) -->

                                            <Grid Width="50" Height="50" Margin="0,0,14,0" VerticalAlignment="Center"

                                                  Cursor="Hand" ToolTip="Click to choose a custom profile photo (Right-click to reset)">

                                                <Grid.InputBindings>

                                                    <MouseBinding MouseAction="LeftClick" Command="{Binding ChangeAvatarCommand}"/>

                                                    <MouseBinding MouseAction="RightClick" Command="{Binding ResetAvatarCommand}"/>

                                                </Grid.InputBindings>



                                                <!-- 1. Default Gray Initial Letter (shown when no custom avatar) -->

                                                <Border Width="50" Height="50" CornerRadius="25"

                                                        Background="#25272E" BorderBrush="#3B404D" BorderThickness="1.5"

                                                        Visibility="{Binding HasCustomAvatar, Converter={StaticResource InvBoolToVis}}">

                                                    <TextBlock Text="{Binding PcInitialLetter}" FontSize="22" FontWeight="Bold"

                                                               Foreground="#E2E8F0" FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"

                                                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>

                                                </Border>



                                                <!-- 2. Custom Photo (guaranteed true circular shape with antialiased rendering) -->

                                                <Ellipse Width="50" Height="50"

                                                         Stroke="#3B404D" StrokeThickness="1.5"

                                                         Visibility="{Binding HasCustomAvatar, Converter={StaticResource BoolToVis}}">

                                                    <Ellipse.Fill>

                                                        <ImageBrush ImageSource="{Binding AvatarImage}" Stretch="UniformToFill"

                                                                    RenderOptions.BitmapScalingMode="HighQuality"/>

                                                    </Ellipse.Fill>

                                                </Ellipse>

                                            </Grid>



                                            <!-- Name & Subtitle -->

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">

                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                                    <TextBlock Text="{Binding PcNameText}" FontSize="18.5" FontWeight="SemiBold" Foreground="#FFFFFF"

                                                               FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"

                                                               TextTrimming="CharacterEllipsis" MaxWidth="310"/>

                                                    <!-- Verified Lime Badge with Checkmark (Scaled to match text size) -->

                                                    <Border Width="14" Height="14" CornerRadius="7" Background="#D1FE29" Margin="7,0,0,0" VerticalAlignment="Center">

                                                        <TextBlock Text="✓" FontSize="8.5" FontWeight="Bold" Foreground="#15161A"

                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-0.5,0,0"/>

                                                    </Border>

                                                </StackPanel>

                                                <TextBlock Text="{Binding WindowsShortVersionText}" FontSize="12.5" Foreground="#94A3B8" Margin="0,3,0,0"

                                                           FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"

                                                           TextTrimming="CharacterEllipsis"/>

                                            </StackPanel>

                                        </Grid>



                                        <!-- Top Inner Card (Hardware Specifications: OS, CPU, GPU, RAM, DirectX, Power Plan) -->

                                        <Border x:Name="SpecsCardBorder" Grid.Row="1" Background="#15171B" BorderBrush="#25272D" BorderThickness="1" CornerRadius="16"

                                                Padding="16,12" Margin="0,0,0,11">

                                            <StackPanel x:Name="SpecsListStack">

                                                <!-- 1. Operating System -->

                                                <TextBlock Text="Operating System" FontSize="10" Foreground="#7E8695" Margin="0,0,0,2"/>

                                                <TextBlock Text="{Binding WindowsVersionText}" FontSize="12.5" FontWeight="SemiBold" Foreground="#FFFFFF"

                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding WindowsVersionText}" Margin="0,0,0,7"/>



                                                <!-- 2. Processor ( CPU ) -->

                                                <TextBlock Text="Processor ( CPU )" FontSize="10" Foreground="#7E8695" Margin="0,0,0,2"/>

                                                <TextBlock Text="{Binding CpuModelText}" FontSize="12.5" FontWeight="SemiBold" Foreground="#FFFFFF"

                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding CpuModelText}" Margin="0,0,0,7"/>



                                                <!-- 3. Graphics ( GPU ) -->

                                                <TextBlock Text="Graphics ( GPU )" FontSize="10" Foreground="#7E8695" Margin="0,0,0,2"/>

                                                <TextBlock Text="{Binding GpuModelText}" FontSize="12.5" FontWeight="SemiBold" Foreground="#FFFFFF"

                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding GpuModelText}" Margin="0,0,0,7"/>



                                                <!-- 4. Installed RAM -->

                                                <TextBlock Text="Installed RAM" FontSize="10" Foreground="#7E8695" Margin="0,0,0,2"/>

                                                <TextBlock Text="{Binding RamSpecText}" FontSize="12.5" FontWeight="SemiBold" Foreground="#FFFFFF"

                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding RamSpecText}" Margin="0,0,0,7"/>



                                                <!-- 5. DirectX Pipeline -->

                                                <TextBlock Text="DirectX Pipeline" FontSize="10" Foreground="#7E8695" Margin="0,0,0,2"/>

                                                <TextBlock Text="{Binding DirectXVersionText}" FontSize="12.5" FontWeight="SemiBold" Foreground="#FFFFFF"

                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding DirectXVersionText}" Margin="0,0,0,7"/>



                                                <!-- 6. Power Scheme -->

                                                <TextBlock Text="Power Scheme" FontSize="10" Foreground="#7E8695" Margin="0,0,0,2"/>

                                                <TextBlock Text="{Binding PowerPlanText}" FontSize="12.5" FontWeight="SemiBold" Foreground="#FFFFFF"

                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding PowerPlanText}"/>

                                            </StackPanel>

                                        </Border>



                                        <!-- Bottom Inner Card: 6 Stat Cards Container -->
                                        <Border x:Name="StatsTilesOuterCard" Grid.Row="2" Background="Transparent" BorderThickness="0"
                                                Padding="0">

                                            <Grid>

                                                <Grid.ColumnDefinitions>

                                                    <ColumnDefinition Width="*"/>

                                                    <ColumnDefinition Width="8"/>

                                                    <ColumnDefinition Width="*"/>

                                                </Grid.ColumnDefinitions>

                                                <Grid.RowDefinitions>

                                                    <RowDefinition Height="*"/>

                                                    <RowDefinition Height="8"/>

                                                    <RowDefinition Height="*"/>

                                                    <RowDefinition Height="8"/>

                                                    <RowDefinition Height="*"/>

                                                </Grid.RowDefinitions>



                                                <!-- Stat 1: Windows Activation Status (replaces 500 days) -->

                                                <Border x:Name="StatTile1" Grid.Row="0" Grid.Column="0" Background="#111216" BorderBrush="#1F2229" BorderThickness="1"

                                                        CornerRadius="13" Padding="14,8">

                                                    <StackPanel VerticalAlignment="Center">

                                                        <TextBlock Text="{Binding StatWindowsActivation}" FontSize="17.5" FontWeight="Medium" Foreground="#CDE25D"

                                                                   FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif" VerticalAlignment="Center"/>

                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0" VerticalAlignment="Center">

                                                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="10.5" Foreground="#8F94A0"

                                                                       Margin="0,0,5,0" VerticalAlignment="Center"/>

                                                            <TextBlock Text="Windows License" FontSize="11" Foreground="#8F94A0" VerticalAlignment="Center"

                                                                       FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"/>

                                                        </StackPanel>

                                                    </StackPanel>

                                                </Border>



                                                <!-- Stat 2: Windows Version (replaces 41 project, e.g. 26H2) -->

                                                <Border x:Name="StatTile2" Grid.Row="0" Grid.Column="2" Background="#111216" BorderBrush="#1F2229" BorderThickness="1"

                                                        CornerRadius="13" Padding="14,8">

                                                    <StackPanel VerticalAlignment="Center">

                                                        <TextBlock Text="{Binding StatWindowsVersion}" FontSize="17.5" FontWeight="Medium" Foreground="#CDE25D"

                                                                   FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif" VerticalAlignment="Center"/>

                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0" VerticalAlignment="Center">

                                                            <TextBlock Text="&#xE782;" FontFamily="Segoe MDL2 Assets" FontSize="10.5" Foreground="#8F94A0"

                                                                       Margin="0,0,5,0" VerticalAlignment="Center"/>

                                                            <TextBlock Text="OS Version" FontSize="11" Foreground="#8F94A0" VerticalAlignment="Center"

                                                                       FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"/>

                                                        </StackPanel>

                                                    </StackPanel>

                                                </Border>



                                                <!-- Stat 3: CPU Cores (replaces 3 Project) -->

                                                <Border x:Name="StatTile3" Grid.Row="2" Grid.Column="0" Background="#111216" BorderBrush="#1F2229" BorderThickness="1"

                                                        CornerRadius="13" Padding="14,8">

                                                    <StackPanel VerticalAlignment="Center">

                                                        <TextBlock Text="{Binding StatCpuCores}" FontSize="17.5" FontWeight="Medium" Foreground="#CDE25D"

                                                                   FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif" VerticalAlignment="Center"/>

                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0" VerticalAlignment="Center">

                                                            <TextBlock Text="&#xE950;" FontFamily="Segoe MDL2 Assets" FontSize="10.5" Foreground="#8F94A0"

                                                                       Margin="0,0,5,0" VerticalAlignment="Center"/>

                                                            <TextBlock Text="Processor Cores" FontSize="11" Foreground="#8F94A0" VerticalAlignment="Center"

                                                                       FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"/>

                                                        </StackPanel>

                                                    </StackPanel>

                                                </Border>



                                                <!-- Stat 4: RAM Speed MHz (replaces 10,950$) -->

                                                <Border x:Name="StatTile4" Grid.Row="2" Grid.Column="2" Background="#111216" BorderBrush="#1F2229" BorderThickness="1"

                                                        CornerRadius="13" Padding="14,8">

                                                    <StackPanel VerticalAlignment="Center">

                                                        <TextBlock Text="{Binding StatRamSpeed}" FontSize="17.5" FontWeight="Medium" Foreground="#CDE25D"

                                                                   FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif" VerticalAlignment="Center"/>

                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0" VerticalAlignment="Center">

                                                            <TextBlock Text="&#xE7F8;" FontFamily="Segoe MDL2 Assets" FontSize="10.5" Foreground="#8F94A0"

                                                                       Margin="0,0,5,0" VerticalAlignment="Center"/>

                                                            <TextBlock Text="RAM Frequency" FontSize="11" Foreground="#8F94A0" VerticalAlignment="Center"

                                                                       FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"/>

                                                        </StackPanel>

                                                    </StackPanel>

                                                </Border>



                                                <!-- Stat 5: GPU VRAM (replaces 23 hrs) -->

                                                <Border x:Name="StatTile5" Grid.Row="4" Grid.Column="0" Background="#111216" BorderBrush="#1F2229" BorderThickness="1"

                                                        CornerRadius="13" Padding="14,8">

                                                    <StackPanel VerticalAlignment="Center">

                                                        <TextBlock Text="{Binding StatGpuVram}" FontSize="17.5" FontWeight="Medium" Foreground="#CDE25D"

                                                                   FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif" VerticalAlignment="Center"/>

                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0" VerticalAlignment="Center">

                                                            <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="10.5" Foreground="#8F94A0"

                                                                       Margin="0,0,5,0" VerticalAlignment="Center"/>

                                                            <TextBlock Text="GPU VRAM" FontSize="11" Foreground="#8F94A0" VerticalAlignment="Center"

                                                                       FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"/>

                                                        </StackPanel>

                                                    </StackPanel>

                                                </Border>



                                                <!-- Stat 6: Windows Partition Drive Type NVMe / SSD / HDD (replaces 18%) -->

                                                <Border x:Name="StatTile6" Grid.Row="4" Grid.Column="2" Background="#111216" BorderBrush="#1F2229" BorderThickness="1"

                                                        CornerRadius="13" Padding="14,8">

                                                    <StackPanel VerticalAlignment="Center">

                                                        <TextBlock Text="{Binding StatDriveType}" FontSize="17.5" FontWeight="Medium" Foreground="#CDE25D"

                                                                   FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif" VerticalAlignment="Center"/>

                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0" VerticalAlignment="Center">

                                                            <TextBlock Text="&#xEDA2;" FontFamily="Segoe MDL2 Assets" FontSize="10.5" Foreground="#8F94A0"

                                                                       Margin="0,0,5,0" VerticalAlignment="Center"/>

                                                            <TextBlock Text="OS Partition Type" FontSize="11" Foreground="#8F94A0" VerticalAlignment="Center"

                                                                       FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"/>

                                                        </StackPanel>

                                                    </StackPanel>

                                                </Border>

                                            </Grid>

                                        </Border>

                                    </Grid>

                                </Border>

                            </Grid>



                            <!-- ═════════════════════════════════════════════════════════════ -->

                            <!-- TAB 2 (RIGHT): COLLAPSIBLE DRIVER SCANNER & DRIVER ACTIONS -->

                            <!-- ═════════════════════════════════════════════════════════════ -->

                            <Grid Grid.Column="2" Height="660" VerticalAlignment="Top">



                                <!-- 2A: EXPANDED SCANNER HOST (Driver Scanner Card + Extra Drivers Card) -->

                                <StackPanel x:Name="ExpandedScannerHost" Height="660" VerticalAlignment="Top">

                                    <!-- 2A-1: Driver Scanner Card with Custom Photo 3 Notched Geometry (Height 582) -->

                                    <Grid x:Name="DriverScannerCardGrid" Height="582">

                                    <!-- Vector Notched Background Shape (Photo 3 shape with smooth fillets) -->

                                    <views:NotchedCardShape x:Name="CardBackgroundShape"

                                                           Fill="#000000" Stroke="{x:Null}" StrokeThickness="0"

                                                           NotchWidth="238" NotchHeight="106" CornerRadius="24" InnerCornerRadius="16">

                                        <views:NotchedCardShape.Effect>

                                            <DropShadowEffect BlurRadius="25" ShadowDepth="4" Opacity="0.45" Color="#000000"/>

                                        </views:NotchedCardShape.Effect>

                                    </views:NotchedCardShape>



                                    <!-- SCANNER ANIMATION (Metaball fluid particles & smooth swallow finale) -->

                                    <Grid x:Name="GifHostGrid" ClipToBounds="True"

                                          Visibility="{Binding IsScanningDrivers, Converter={StaticResource BoolToVis}}">

                                        <Image x:Name="DriverScannerGifImage"

                                               Stretch="Uniform"

                                               MaxWidth="390" MaxHeight="390"

                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                    </Grid>



                                    <!-- PRE-SCAN CENTER TEXT (Subtle, clean directly on background with text effect matching text effect.mp4) -->
                                    <StackPanel x:Name="PreScanCenterText" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                RenderTransformOrigin="0.5,0.5">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasCompletedDriverScan}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding HasStartedScan}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsScanningDrivers}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <StackPanel.RenderTransform>
                                            <TranslateTransform x:Name="PreScanTextTrans" X="0" Y="0"/>
                                        </StackPanel.RenderTransform>
                                        <TextBlock x:Name="HeadlineShimmerText"
                                                   Text="Heal your PC. Eliminate stutters &amp; lag."
                                                   FontSize="14.5" FontWeight="SemiBold"
                                                   TextAlignment="Center" Margin="0,0,0,6"
                                                   FontFamily="Montserrat, Segoe UI Variable Display, Segoe UI, sans-serif">
                                            <TextBlock.Foreground>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0" MappingMode="RelativeToBoundingBox">
                                                    <LinearGradientBrush.RelativeTransform>
                                                        <TranslateTransform x:Name="ShimmerTransform" X="-1.2"/>
                                                    </LinearGradientBrush.RelativeTransform>
                                                    <GradientStop Color="#6E7688" Offset="0.0"/>
                                                    <GradientStop Color="#6E7688" Offset="0.28"/>
                                                    <GradientStop Color="#B8C0D4" Offset="0.42"/>
                                                    <GradientStop Color="#FFFFFF" Offset="0.50"/>
                                                    <GradientStop Color="#B8C0D4" Offset="0.58"/>
                                                    <GradientStop Color="#6E7688" Offset="0.72"/>
                                                    <GradientStop Color="#6E7688" Offset="1.0"/>
                                                </LinearGradientBrush>
                                            </TextBlock.Foreground>
                                        </TextBlock>
                                        <TextBlock x:Name="PreScanSubText"
                                                   Text="Scan and install drivers"
                                                   FontSize="12" FontWeight="Normal" Foreground="#A6ADB8"
                                                   TextAlignment="Center"
                                                   FontFamily="Montserrat, Segoe UI Variable Text, Segoe UI, sans-serif"/>
                                    </StackPanel>

                                    <!-- POST-SCAN CENTER TEXT (Shows after scan completes, with text effect matching text effect.mp4) -->
                                    <StackPanel x:Name="PostScanCenterText" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Opacity="0"
                                                RenderTransformOrigin="0.5,0.5">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasCompletedDriverScan}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <StackPanel.RenderTransform>
                                            <TranslateTransform x:Name="PostScanTextTrans" X="0" Y="20"/>
                                        </StackPanel.RenderTransform>
                                        <TextBlock x:Name="PostScanHeadlineShimmerText"
                                                   Text="{Binding PostScanHeadlineText}"
                                                   FontSize="15" FontWeight="SemiBold"
                                                   TextAlignment="Center" Margin="0,0,0,6"
                                                   FontFamily="Montserrat, Segoe UI Variable Display, Segoe UI, sans-serif">
                                            <TextBlock.Foreground>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0" MappingMode="RelativeToBoundingBox">
                                                    <LinearGradientBrush.RelativeTransform>
                                                        <TranslateTransform x:Name="PostScanShimmerTransform" X="-1.2"/>
                                                    </LinearGradientBrush.RelativeTransform>
                                                    <GradientStop Color="#6E7688" Offset="0.0"/>
                                                    <GradientStop Color="#6E7688" Offset="0.28"/>
                                                    <GradientStop Color="#B8C0D4" Offset="0.42"/>
                                                    <GradientStop Color="#FFFFFF" Offset="0.50"/>
                                                    <GradientStop Color="#B8C0D4" Offset="0.58"/>
                                                    <GradientStop Color="#6E7688" Offset="0.72"/>
                                                    <GradientStop Color="#6E7688" Offset="1.0"/>
                                                </LinearGradientBrush>
                                            </TextBlock.Foreground>
                                        </TextBlock>
                                        <TextBlock x:Name="PostScanSubText"
                                                   Text="{Binding PostScanSubtitleText}"
                                                   FontSize="12" FontWeight="Normal" Foreground="#A6ADB8"
                                                   TextAlignment="Center"
                                                   FontFamily="Montserrat, Segoe UI Variable Text, Segoe UI, sans-serif"/>
                                    </StackPanel>



                                    <!-- Header & Skip Button (Floats cleanly in front of GIF) -->

                                    <Grid x:Name="ScannerHeaderGrid" Margin="22,18,22,18">

                                        <!-- Header & Skip Button -->

                                        <Grid VerticalAlignment="Top">

                                            <Grid.ColumnDefinitions>

                                                <ColumnDefinition Width="*"/>

                                                <ColumnDefinition Width="Auto"/>

                                            </Grid.ColumnDefinitions>



                                            <!-- Dynamic Header with Smooth Slide & Cross-Fade Transition (matching Scan to Unlock) -->

                                            <ContentControl Grid.Column="0" Content="{Binding}" VerticalAlignment="Center" Focusable="False" IsTabStop="False">

                                                <ContentControl.Template>

                                                    <ControlTemplate TargetType="ContentControl">

                                                        <Grid ClipToBounds="True" Height="26">

                                                            <!-- 1. "Driver Scanner" Header Text -->

                                                            <TextBlock x:Name="DriverScannerHeaderText" Text="Driver Scanner" FontSize="17.5" FontWeight="Bold"

                                                                       Foreground="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Left"

                                                                       FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"

                                                                       Opacity="1">

                                                                <TextBlock.RenderTransform>

                                                                    <TranslateTransform x:Name="DriverScannerHeaderTrans" Y="0"/>

                                                                </TextBlock.RenderTransform>

                                                            </TextBlock>



                                                            <!-- 2. "Scanning... {pct}%" Header Text (Fixed % position, only dots animate) -->
                                                            <StackPanel x:Name="ScanningProgressHeaderText" Orientation="Horizontal"
                                                                        VerticalAlignment="Center" HorizontalAlignment="Left"
                                                                        Opacity="0">
                                                                <StackPanel.RenderTransform>
                                                                    <TranslateTransform x:Name="ScanningProgressHeaderTrans" Y="10"/>
                                                                </StackPanel.RenderTransform>

                                                                <TextBlock Text="Scanning" FontSize="17.5" FontWeight="Bold"
                                                                           Foreground="#FFFFFF" FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                                                                           VerticalAlignment="Center"/>

                                                                <TextBlock Text="{Binding ScanningDotsText, FallbackValue='...'}" Width="16"
                                                                           FontSize="17.5" FontWeight="Bold"
                                                                           Foreground="#FFFFFF" FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                                                                           HorizontalAlignment="Left" TextAlignment="Left" VerticalAlignment="Center"/>

                                                                <TextBlock Text="{Binding ScanProgressPercent, StringFormat='{}{0:0}%'}"
                                                                           FontSize="17.5" FontWeight="Bold" Margin="4,0,0,0"
                                                                           Foreground="#D1FE29" FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                                                                           VerticalAlignment="Center"/>
                                                            </StackPanel>

                                                        </Grid>



                                                        <ControlTemplate.Triggers>

                                                            <!-- While Scanning: Slide & Cross-Fade to "Scanning... {pct}%" -->

                                                            <DataTrigger Binding="{Binding IsScanningDrivers}" Value="True">

                                                                <DataTrigger.EnterActions>

                                                                    <BeginStoryboard>

                                                                        <Storyboard>

                                                                            <!-- "Driver Scanner" fades out & slides up -->

                                                                            <DoubleAnimation Storyboard.TargetName="DriverScannerHeaderText" Storyboard.TargetProperty="Opacity"

                                                                                             To="0" Duration="0:0:0.25">

                                                                                <DoubleAnimation.EasingFunction>

                                                                                    <CubicEase EasingMode="EaseOut"/>

                                                                                </DoubleAnimation.EasingFunction>

                                                                            </DoubleAnimation>

                                                                            <DoubleAnimation Storyboard.TargetName="DriverScannerHeaderTrans" Storyboard.TargetProperty="Y"

                                                                                             To="-10" Duration="0:0:0.25">

                                                                                <DoubleAnimation.EasingFunction>

                                                                                    <CubicEase EasingMode="EaseOut"/>

                                                                                </DoubleAnimation.EasingFunction>

                                                                            </DoubleAnimation>



                                                                            <!-- "Scanning... {pct}%" fades in & slides up into place from below -->

                                                                            <DoubleAnimation Storyboard.TargetName="ScanningProgressHeaderText" Storyboard.TargetProperty="Opacity"

                                                                                             To="1" Duration="0:0:0.32" BeginTime="0:0:0.06">

                                                                                <DoubleAnimation.EasingFunction>

                                                                                    <CubicEase EasingMode="EaseOut"/>

                                                                                </DoubleAnimation.EasingFunction>

                                                                            </DoubleAnimation>

                                                                            <DoubleAnimation Storyboard.TargetName="ScanningProgressHeaderTrans" Storyboard.TargetProperty="Y"

                                                                                             To="0" Duration="0:0:0.32" BeginTime="0:0:0.06">

                                                                                <DoubleAnimation.EasingFunction>

                                                                                    <CubicEase EasingMode="EaseOut"/>

                                                                                </DoubleAnimation.EasingFunction>

                                                                            </DoubleAnimation>

                                                                        </Storyboard>

                                                                    </BeginStoryboard>

                                                                </DataTrigger.EnterActions>

                                                                <DataTrigger.ExitActions>

                                                                    <BeginStoryboard>

                                                                        <Storyboard>

                                                                            <!-- Scan finished: "Scanning... 100%" fades out & slides up -->

                                                                            <DoubleAnimation Storyboard.TargetName="ScanningProgressHeaderText" Storyboard.TargetProperty="Opacity"

                                                                                             To="0" Duration="0:0:0.25">

                                                                                <DoubleAnimation.EasingFunction>

                                                                                    <CubicEase EasingMode="EaseOut"/>

                                                                                </DoubleAnimation.EasingFunction>

                                                                            </DoubleAnimation>

                                                                            <DoubleAnimation Storyboard.TargetName="ScanningProgressHeaderTrans" Storyboard.TargetProperty="Y"

                                                                                             To="-10" Duration="0:0:0.25">

                                                                                <DoubleAnimation.EasingFunction>

                                                                                    <CubicEase EasingMode="EaseOut"/>

                                                                                </DoubleAnimation.EasingFunction>

                                                                            </DoubleAnimation>



                                                                            <!-- "Driver Scanner" fades in & slides up into place from below -->

                                                                            <DoubleAnimation Storyboard.TargetName="DriverScannerHeaderText" Storyboard.TargetProperty="Opacity"

                                                                                             To="1" Duration="0:0:0.32" BeginTime="0:0:0.06">

                                                                                <DoubleAnimation.EasingFunction>

                                                                                    <CubicEase EasingMode="EaseOut"/>

                                                                                </DoubleAnimation.EasingFunction>

                                                                            </DoubleAnimation>

                                                                            <DoubleAnimation Storyboard.TargetName="DriverScannerHeaderTrans" Storyboard.TargetProperty="Y"

                                                                                             To="0" Duration="0:0:0.32" BeginTime="0:0:0.06">

                                                                                <DoubleAnimation.EasingFunction>

                                                                                    <CubicEase EasingMode="EaseOut"/>

                                                                                </DoubleAnimation.EasingFunction>

                                                                            </DoubleAnimation>

                                                                        </Storyboard>

                                                                    </BeginStoryboard>

                                                                </DataTrigger.ExitActions>

                                                            </DataTrigger>

                                                        </ControlTemplate.Triggers>

                                                    </ControlTemplate>

                                                </ContentControl.Template>

                                            </ContentControl>



                                            <Button Grid.Column="1" Command="{Binding SkipToUnusedServicesCommand}"
                                                    Cursor="Hand" Background="Transparent" BorderThickness="0"
                                                    VerticalAlignment="Center" ToolTip="{Binding SkipButtonToolTip}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="SkipBtnBorder" Height="28" Width="176"
                                                                Background="#1C1E22" BorderBrush="#282B33" BorderThickness="1"
                                                                CornerRadius="8" ClipToBounds="True">
                                                            <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <!-- Text host that slides to the right and shrinks to 0 during scan -->
                                                                <Grid x:Name="SkipTextHost" Grid.Column="0" MaxWidth="144" ClipToBounds="True" Margin="10,0,0,0">
                                                                    <TextBlock x:Name="SkipText" Text="Skip to Driver Installation"
                                                                               FontSize="11" FontWeight="SemiBold" Foreground="#E2E2E5"
                                                                               VerticalAlignment="Center" Margin="0,0,6,0">
                                                                        <TextBlock.RenderTransform>
                                                                            <TranslateTransform x:Name="SkipTextTrans" X="0"/>
                                                                        </TextBlock.RenderTransform>
                                                                    </TextBlock>
                                                                </Grid>

                                                                <!-- Arrow icon that remains visible -->
                                                                <TextBlock x:Name="SkipArrow" Grid.Column="1" Text="&#xE76C;"
                                                                           FontFamily="Segoe MDL2 Assets" FontSize="9"
                                                                           VerticalAlignment="Center" Foreground="#8E95A5"
                                                                           HorizontalAlignment="Center" Margin="0,0,10,0">
                                                                    <TextBlock.RenderTransform>
                                                                        <TranslateTransform x:Name="SkipArrowTrans" X="0" Y="0"/>
                                                                    </TextBlock.RenderTransform>
                                                                </TextBlock>
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <!-- When Scan is Running OR has Completed: Smooth pill-to-square morph, leaving ONLY the arrow -->
                                                            <DataTrigger Binding="{Binding IsSkipArrowOnlyMode}" Value="True">
                                                                <DataTrigger.EnterActions>
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetName="SkipBtnBorder" Storyboard.TargetProperty="Width"
                                                                                             From="176" To="28" Duration="0:0:0.32">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <CubicEase EasingMode="EaseInOut"/>
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                            <DoubleAnimation Storyboard.TargetName="SkipTextHost" Storyboard.TargetProperty="MaxWidth"
                                                                                             From="144" To="0" Duration="0:0:0.28">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <CubicEase EasingMode="EaseInOut"/>
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                            <DoubleAnimation Storyboard.TargetName="SkipTextTrans" Storyboard.TargetProperty="X"
                                                                                             From="0" To="18" Duration="0:0:0.22">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <QuadraticEase EasingMode="EaseIn"/>
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                            <DoubleAnimation Storyboard.TargetName="SkipText" Storyboard.TargetProperty="Opacity"
                                                                                             From="1" To="0" Duration="0:0:0.18"/>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </DataTrigger.EnterActions>
                                                                <Setter TargetName="SkipBtnBorder" Property="Width" Value="28"/>
                                                                <Setter TargetName="SkipTextHost" Property="MaxWidth" Value="0"/>
                                                                <Setter TargetName="SkipTextHost" Property="Margin" Value="0"/>
                                                                <Setter TargetName="SkipText" Property="Opacity" Value="0"/>
                                                                <Setter TargetName="SkipArrow" Property="Margin" Value="0"/>
                                                            </DataTrigger>

                                                            <!-- During Scan: Solid visible button, normal arrow, click blocked (not hidden!) -->
                                                            <DataTrigger Binding="{Binding IsScanningDrivers}" Value="True">
                                                                <Setter TargetName="SkipArrow" Property="Foreground" Value="#8E95A5"/>
                                                                <Setter Property="Cursor" Value="Arrow"/>
                                                            </DataTrigger>

                                                            <!-- When Scan Completes: Arrow icon ONLY turns vibrant GREEN and does a horizontal bump (left-to-right tactile hop) pointing forward -->
                                                            <DataTrigger Binding="{Binding HasCompletedDriverScan}" Value="True">
                                                                <Setter TargetName="SkipArrow" Property="Foreground" Value="#D1FE29"/>
                                                                <Setter Property="Cursor" Value="Hand"/>
                                                                <DataTrigger.EnterActions>
                                                                    <BeginStoryboard x:Name="SkipArrowBumpStory">
                                                                        <Storyboard RepeatBehavior="Forever">
                                                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SkipArrowTrans" Storyboard.TargetProperty="X" Duration="0:0:1.6">
                                                                                <!-- 0ms: Base position (0px) -->
                                                                                <LinearDoubleKeyFrame KeyTime="0:0:0.00" Value="0"/>
                                                                                <!-- 240ms: Snappy forward bump (+3.5px to the right) -->
                                                                                <SplineDoubleKeyFrame KeyTime="0:0:0.24" Value="3.5" KeySpline="0.2,0.8,0.4,1.0"/>
                                                                                <!-- 480ms: Return to base (0px) -->
                                                                                <SplineDoubleKeyFrame KeyTime="0:0:0.48" Value="0" KeySpline="0.4,0.0,0.6,1.0"/>
                                                                                <!-- 680ms: Soft secondary hop (+1.8px to the right) -->
                                                                                <SplineDoubleKeyFrame KeyTime="0:0:0.68" Value="1.8" KeySpline="0.2,0.8,0.4,1.0"/>
                                                                                <!-- 880ms: Settle back to base (0px) -->
                                                                                <SplineDoubleKeyFrame KeyTime="0:0:0.88" Value="0" KeySpline="0.4,0.0,0.6,1.0"/>
                                                                                <!-- 880ms - 1600ms: Gentle pause before repeating -->
                                                                                <DiscreteDoubleKeyFrame KeyTime="0:0:1.60" Value="0"/>
                                                                            </DoubleAnimationUsingKeyFrames>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </DataTrigger.EnterActions>
                                                                <DataTrigger.ExitActions>
                                                                    <StopStoryboard BeginStoryboardName="SkipArrowBumpStory"/>
                                                                </DataTrigger.ExitActions>
                                                            </DataTrigger>

                                                            <!-- Hover when NOT scanning: Solid Black background, NO outline, vibrant green arrow -->
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding RelativeSource={RelativeSource Mode=Self}, Path=IsMouseOver}" Value="True"/>
                                                                    <Condition Binding="{Binding IsScanningDrivers}" Value="False"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter TargetName="SkipBtnBorder" Property="Background" Value="#000000"/>
                                                                <Setter TargetName="SkipBtnBorder" Property="BorderBrush" Value="Transparent"/>
                                                                <Setter TargetName="SkipBtnBorder" Property="BorderThickness" Value="1"/>
                                                                <Setter TargetName="SkipText" Property="Foreground" Value="#FFFFFF"/>
                                                                <Setter TargetName="SkipArrow" Property="Foreground" Value="#D1FE29"/>
                                                            </MultiDataTrigger>

                                                            <!-- Clicked when NOT scanning: Subtle dark press -->
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding RelativeSource={RelativeSource Mode=Self}, Path=IsPressed}" Value="True"/>
                                                                    <Condition Binding="{Binding IsScanningDrivers}" Value="False"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter TargetName="SkipBtnBorder" Property="Background" Value="#08080A"/>
                                                                <Setter TargetName="SkipBtnBorder" Property="BorderBrush" Value="#383D48"/>
                                                                <Setter TargetName="SkipBtnBorder" Property="BorderThickness" Value="1"/>
                                                            </MultiDataTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                        </Grid>

                                    </Grid>



                                                                        <!-- THE DRIVER SCAN BUTTON IN THE NOTCH (Exact level with bottom of Driver Scanner card: Y = 582) -->

                                    <Button x:Name="DriverNotchBtn"

                                            Command="{Binding DriverNotchActionCommand}"

                                            HorizontalAlignment="Left" VerticalAlignment="Bottom"

                                            Width="220" Height="92"

                                            MouseEnter="DriverNotchBtn_MouseEnter"

                                            MouseLeave="DriverNotchBtn_MouseLeave"

                                            MouseMove="DriverNotchBtn_MouseMove"

                                            PreviewMouseMove="DriverNotchBtn_PreviewMouseMove"

                                            PreviewMouseDown="DriverNotchBtn_PreviewMouseDown"

                                            Cursor="Hand" FocusVisualStyle="{x:Null}">

                                        <Button.Template>

                                            <ControlTemplate TargetType="Button">

                                                <Grid x:Name="RootContainer" ClipToBounds="True">

                                                    <!-- BASE LIME BORDER (#D1FE29): Holds Idle, DotsLoader, and SuccessContent -->

                                                    <Border x:Name="BaseBorder"

                                                            Background="#D1FE29"

                                                            BorderThickness="0"

                                                            CornerRadius="16, 16, 16, 24"

                                                            ClipToBounds="True">

                                                        <Border.Effect>

                                                            <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.3" Color="#000000"/>

                                                        </Border.Effect>

                                                        <Grid VerticalAlignment="Center" Height="92">

                                                            <!-- 1. IDLE CONTENT (Submit/Scan state from Scan.mp4) -->

                                                            <Grid x:Name="IdleContent" VerticalAlignment="Center" Margin="16,0">

                                                                <Grid.ColumnDefinitions>

                                                                    <ColumnDefinition Width="Auto"/>

                                                                    <ColumnDefinition Width="*"/>

                                                                </Grid.ColumnDefinitions>



                                                                <!-- Left Dark Icon Capsule -->

                                                                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="13"

                                                                        Background="#14170E" VerticalAlignment="Center" Margin="0,0,13,0">

                                                                    <TextBlock x:Name="ScanIcon" Text="&#xE721;" FontFamily="Segoe MDL2 Assets"

                                                                               FontSize="18" FontWeight="Bold" Foreground="#D1FE29"

                                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                                                </Border>



                                                                <!-- Labels -->

                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">

                                                                    <TextBlock x:Name="BtnTitle" Text="Driver Scan"

                                                                               FontSize="14" FontWeight="Bold" Foreground="#121410"

                                                                               FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"/>

                                                                    <TextBlock x:Name="BtnSubtitle" Text="Hardware &amp; driver audit"

                                                                               FontSize="10.5" FontWeight="SemiBold" Foreground="#2E3314" Margin="0,2,0,0"

                                                                               FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"

                                                                               TextTrimming="CharacterEllipsis"/>

                                                                </StackPanel>

                                                            </Grid>



                                                            <!-- 2. LOADING STATE: 3 BOUNCING DOTS (From Scan.mp4) -->

                                                            <StackPanel x:Name="DotsLoader" Orientation="Horizontal"

                                                                        HorizontalAlignment="Center" VerticalAlignment="Center"

                                                                        Visibility="Collapsed">

                                                                <Border Width="9" Height="9" CornerRadius="4.5" Background="#14170E" Margin="4,0">

                                                                    <Border.RenderTransform>

                                                                        <TranslateTransform x:Name="Dot1Trans" Y="0"/>

                                                                    </Border.RenderTransform>

                                                                </Border>

                                                                <Border Width="9" Height="9" CornerRadius="4.5" Background="#14170E" Margin="4,0">

                                                                    <Border.RenderTransform>

                                                                        <TranslateTransform x:Name="Dot2Trans" Y="0"/>

                                                                    </Border.RenderTransform>

                                                                </Border>

                                                                <Border Width="9" Height="9" CornerRadius="4.5" Background="#14170E" Margin="4,0">

                                                                    <Border.RenderTransform>

                                                                        <TranslateTransform x:Name="Dot3Trans" Y="0"/>

                                                                    </Border.RenderTransform>

                                                                </Border>

                                                            </StackPanel>



                                                            <!-- 3. SUCCESS CONTENT (Vibrant Lime with ✓ Success) -->

                                                            <StackPanel x:Name="SuccessContent" Orientation="Horizontal"

                                                                        HorizontalAlignment="Center" VerticalAlignment="Center"

                                                                        Visibility="Collapsed">

                                                                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"

                                                                           FontSize="18" FontWeight="Bold" Foreground="#121410"

                                                                           Margin="0,0,8,0" VerticalAlignment="Center"/>

                                                                <TextBlock Text="Success" FontSize="15" FontWeight="Bold" Foreground="#121410"

                                                                           FontFamily="Montserrat, Segoe UI Variable Display, Segoe UI, sans-serif"

                                                                           VerticalAlignment="Center"/>

                                                            </StackPanel>

                                                        </Grid>

                                                    </Border>



                                                    <!-- 4. BLACK OVERLAY FILL (Animates Width: 0 -> 225 from left to right) -->

                                                    <!-- Overlaps 3px left and 2px top/bottom to completely eliminate any green fringe during wipe & in resting state -->

                                                    <Border x:Name="BlackFillOverlay"

                                                            HorizontalAlignment="Left"

                                                            Width="0"

                                                            Margin="-3, -2, 0, -2"

                                                            Background="#000000"

                                                            BorderThickness="0"

                                                            CornerRadius="18, 16, 16, 26"

                                                            ClipToBounds="True">

                                                        <Border.Effect>

                                                            <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.3" Color="#000000"/>

                                                        </Border.Effect>

                                                        <!-- Fixed width grid so text is revealed progressively by expanding clip/border -->

                                                        <Grid x:Name="InstallContentGrid" Width="220" Height="92" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3, 2, 0, 2">

                                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

                                                                <TextBlock x:Name="InstallTitleText" Text="{Binding Path=DataContext.DriverNotchButtonTitle, RelativeSource={RelativeSource AncestorType=Button}, FallbackValue='Install Drivers'}"

                                                                           FontSize="15.5" FontWeight="Bold" Foreground="#FFFFFF"

                                                                           FontFamily="Montserrat, Segoe UI Variable Display, Segoe UI, sans-serif"

                                                                           HorizontalAlignment="Center" TextAlignment="Center"/>

                                                                <TextBlock x:Name="InstallSubtitleText" Text="{Binding Path=DataContext.DriverNotchButtonSubtitle, RelativeSource={RelativeSource AncestorType=Button}, FallbackValue='Click to review &amp; install'}"

                                                                           FontSize="10.5" FontWeight="SemiBold" Foreground="#8E95A5" Margin="0,3,0,0"

                                                                           FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"

                                                                           HorizontalAlignment="Center" TextAlignment="Center"/>

                                                            </StackPanel>

                                                        </Grid>

                                                    </Border>

                                                </Grid>



                                                <!-- Visual State Triggers -->

                                                <ControlTemplate.Triggers>

                                                    <!-- 1. Mouse Hover in Idle state (Lime brighten) ONLY before scan completed -->

                                                    <MultiDataTrigger>

                                                        <MultiDataTrigger.Conditions>

                                                            <Condition Binding="{Binding HasCompletedDriverScan}" Value="False"/>

                                                            <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>

                                                        </MultiDataTrigger.Conditions>

                                                        <Setter TargetName="BaseBorder" Property="Background" Value="#E0FF54"/>

                                                    </MultiDataTrigger>



                                                    <!-- 2. Pressed in Idle state ONLY before scan completed -->

                                                    <MultiDataTrigger>

                                                        <MultiDataTrigger.Conditions>

                                                            <Condition Binding="{Binding HasCompletedDriverScan}" Value="False"/>

                                                            <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsPressed}" Value="True"/>

                                                        </MultiDataTrigger.Conditions>

                                                        <Setter TargetName="BaseBorder" Property="Background" Value="#B4DE16"/>

                                                    </MultiDataTrigger>



                                                    <!-- 3. Scanning in progress (Show 3 Bouncing Dots wave) -->

                                                    <DataTrigger Binding="{Binding IsScanningDrivers}" Value="True">

                                                        <Setter TargetName="IdleContent" Property="Visibility" Value="Collapsed"/>

                                                        <Setter TargetName="SuccessContent" Property="Visibility" Value="Collapsed"/>

                                                        <Setter TargetName="BlackFillOverlay" Property="Visibility" Value="Collapsed"/>

                                                        <Setter TargetName="DotsLoader" Property="Visibility" Value="Visible"/>

                                                        <DataTrigger.EnterActions>

                                                            <BeginStoryboard x:Name="WaveStoryboard">

                                                                <Storyboard RepeatBehavior="Forever">

                                                                    <!-- Dot 1 -->

                                                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Dot1Trans" Storyboard.TargetProperty="Y" Duration="0:0:0.7">

                                                                        <SplineDoubleKeyFrame KeyTime="0:0:0.00" Value="0"/>

                                                                        <SplineDoubleKeyFrame KeyTime="0:0:0.18" Value="-9" KeySpline="0.25,0.1,0.25,1.0"/>

                                                                        <SplineDoubleKeyFrame KeyTime="0:0:0.36" Value="0" KeySpline="0.25,0.1,0.25,1.0"/>

                                                                        <SplineDoubleKeyFrame KeyTime="0:0:0.70" Value="0"/>

                                                                    </DoubleAnimationUsingKeyFrames>

                                                                    <!-- Dot 2 -->

                                                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Dot2Trans" Storyboard.TargetProperty="Y" Duration="0:0:0.7">

                                                                        <SplineDoubleKeyFrame KeyTime="0:0:0.00" Value="0"/>

                                                                        <SplineDoubleKeyFrame KeyTime="0:0:0.12" Value="0"/>

                                                                        <SplineDoubleKeyFrame KeyTime="0:0:0.30" Value="-9" KeySpline="0.25,0.1,0.25,1.0"/>

                                                                        <SplineDoubleKeyFrame KeyTime="0:0:0.48" Value="0" KeySpline="0.25,0.1,0.25,1.0"/>

                                                                        <SplineDoubleKeyFrame KeyTime="0:0:0.70" Value="0"/>

                                                                    </DoubleAnimationUsingKeyFrames>

                                                                    <!-- Dot 3 -->

                                                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Dot3Trans" Storyboard.TargetProperty="Y" Duration="0:0:0.7">

                                                                        <SplineDoubleKeyFrame KeyTime="0:0:0.00" Value="0"/>

                                                                        <SplineDoubleKeyFrame KeyTime="0:0:0.24" Value="0"/>

                                                                        <SplineDoubleKeyFrame KeyTime="0:0:0.42" Value="-9" KeySpline="0.25,0.1,0.25,1.0"/>

                                                                        <SplineDoubleKeyFrame KeyTime="0:0:0.60" Value="0" KeySpline="0.25,0.1,0.25,1.0"/>

                                                                        <SplineDoubleKeyFrame KeyTime="0:0:0.70" Value="0"/>

                                                                    </DoubleAnimationUsingKeyFrames>

                                                                </Storyboard>

                                                            </BeginStoryboard>

                                                        </DataTrigger.EnterActions>

                                                        <DataTrigger.ExitActions>

                                                            <StopStoryboard BeginStoryboardName="WaveStoryboard"/>

                                                        </DataTrigger.ExitActions>

                                                    </DataTrigger>



                                                    <!-- 4. Scan completed: Solid Lime Success FIRST (ONLY while wipe animation has not finished) -->

                                                    <MultiDataTrigger>

                                                        <MultiDataTrigger.Conditions>

                                                            <Condition Binding="{Binding HasCompletedDriverScan}" Value="True"/>

                                                            <Condition Binding="{Binding IsHoverGreenEnabled}" Value="False"/>

                                                        </MultiDataTrigger.Conditions>

                                                        <Setter TargetName="IdleContent" Property="Visibility" Value="Collapsed"/>

                                                        <Setter TargetName="DotsLoader" Property="Visibility" Value="Collapsed"/>

                                                        <Setter TargetName="SuccessContent" Property="Visibility" Value="Visible"/>

                                                        <Setter TargetName="BlackFillOverlay" Property="Visibility" Value="Visible"/>

                                                        <Setter TargetName="BaseBorder" Property="Visibility" Value="Visible"/>

                                                        <Setter TargetName="BaseBorder" Property="Opacity" Value="1"/>

                                                        <Setter TargetName="BaseBorder" Property="Background" Value="#D1FE29"/>

                                                        <Setter TargetName="BaseBorder" Property="BorderThickness" Value="0"/>

                                                    </MultiDataTrigger>



                                                    <!-- 5. Resting state after wipe completed: Pure solid black button blending seamlessly into card notch -->

                                                    <MultiDataTrigger>

                                                        <MultiDataTrigger.Conditions>

                                                            <Condition Binding="{Binding HasCompletedDriverScan}" Value="True"/>

                                                            <Condition Binding="{Binding IsHoverGreenEnabled}" Value="True"/>

                                                            <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="False"/>

                                                        </MultiDataTrigger.Conditions>

                                                        <Setter TargetName="IdleContent" Property="Visibility" Value="Collapsed"/>

                                                        <Setter TargetName="DotsLoader" Property="Visibility" Value="Collapsed"/>

                                                        <Setter TargetName="SuccessContent" Property="Visibility" Value="Collapsed"/>

                                                        <Setter TargetName="BaseBorder" Property="Visibility" Value="Collapsed"/>

                                                        <Setter TargetName="BaseBorder" Property="Opacity" Value="0"/>

                                                        <Setter TargetName="BaseBorder" Property="Background" Value="#000000"/>

                                                        <Setter TargetName="BlackFillOverlay" Property="Visibility" Value="Visible"/>

                                                        <Setter TargetName="BlackFillOverlay" Property="Width" Value="220"/>

                                                        <Setter TargetName="BlackFillOverlay" Property="Margin" Value="0"/>

                                                        <Setter TargetName="BlackFillOverlay" Property="CornerRadius" Value="16, 16, 16, 24"/>

                                                        <Setter TargetName="BlackFillOverlay" Property="Background" Value="#000000"/>

                                                        <Setter TargetName="BlackFillOverlay" Property="BorderThickness" Value="0"/>
                                                        <Setter TargetName="BlackFillOverlay" Property="BorderBrush" Value="{x:Null}"/>

                                                        <Setter TargetName="InstallContentGrid" Property="Margin" Value="0"/>

                                                        <Setter TargetName="InstallTitleText" Property="Foreground" Value="#FFFFFF"/>

                                                        <Setter TargetName="InstallSubtitleText" Property="Foreground" Value="#8E95A5"/>

                                                    </MultiDataTrigger>



                                                    <!-- 6. Hover in Completed state: Smooth signature Lime Green (#D1FE29) with crisp dark text! -->

                                                    <MultiDataTrigger>

                                                        <MultiDataTrigger.Conditions>

                                                            <Condition Binding="{Binding HasCompletedDriverScan}" Value="True"/>

                                                            <Condition Binding="{Binding IsHoverGreenEnabled}" Value="True"/>

                                                            <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>

                                                            <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsPressed}" Value="False"/>

                                                        </MultiDataTrigger.Conditions>

                                                        <Setter TargetName="IdleContent" Property="Visibility" Value="Collapsed"/>

                                                        <Setter TargetName="DotsLoader" Property="Visibility" Value="Collapsed"/>

                                                        <Setter TargetName="SuccessContent" Property="Visibility" Value="Collapsed"/>

                                                        <Setter TargetName="BaseBorder" Property="Visibility" Value="Collapsed"/>

                                                        <Setter TargetName="BaseBorder" Property="Opacity" Value="0"/>

                                                        <Setter TargetName="BaseBorder" Property="Background" Value="#000000"/>

                                                        <Setter TargetName="BlackFillOverlay" Property="Visibility" Value="Visible"/>

                                                        <Setter TargetName="BlackFillOverlay" Property="Margin" Value="0"/>

                                                        <Setter TargetName="BlackFillOverlay" Property="Width" Value="220"/>

                                                        <Setter TargetName="BlackFillOverlay" Property="CornerRadius" Value="16, 16, 16, 24"/>

                                                        <Setter TargetName="InstallContentGrid" Property="Margin" Value="0"/>

                                                        <Setter TargetName="BlackFillOverlay" Property="Background" Value="#D1FE29"/>

                                                        <Setter TargetName="BlackFillOverlay" Property="BorderThickness" Value="0"/>

                                                        <Setter TargetName="InstallTitleText" Property="Foreground" Value="#121410"/>

                                                        <Setter TargetName="InstallSubtitleText" Property="Foreground" Value="#2E3314"/>

                                                    </MultiDataTrigger>



                                                    <!-- 7. Pressed in Completed state: Slightly darker lime (#B4DE16) -->

                                                    <MultiDataTrigger>

                                                        <MultiDataTrigger.Conditions>

                                                            <Condition Binding="{Binding HasCompletedDriverScan}" Value="True"/>

                                                            <Condition Binding="{Binding IsHoverGreenEnabled}" Value="True"/>

                                                            <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsPressed}" Value="True"/>

                                                        </MultiDataTrigger.Conditions>

                                                        <Setter TargetName="IdleContent" Property="Visibility" Value="Collapsed"/>

                                                        <Setter TargetName="DotsLoader" Property="Visibility" Value="Collapsed"/>

                                                        <Setter TargetName="SuccessContent" Property="Visibility" Value="Collapsed"/>

                                                        <Setter TargetName="BaseBorder" Property="Visibility" Value="Collapsed"/>

                                                        <Setter TargetName="BaseBorder" Property="Opacity" Value="0"/>

                                                        <Setter TargetName="BaseBorder" Property="Background" Value="#000000"/>

                                                        <Setter TargetName="BlackFillOverlay" Property="Visibility" Value="Visible"/>

                                                        <Setter TargetName="BlackFillOverlay" Property="Margin" Value="0"/>

                                                        <Setter TargetName="BlackFillOverlay" Property="Width" Value="220"/>

                                                        <Setter TargetName="BlackFillOverlay" Property="CornerRadius" Value="16, 16, 16, 24"/>

                                                        <Setter TargetName="InstallContentGrid" Property="Margin" Value="0"/>

                                                        <Setter TargetName="BlackFillOverlay" Property="Background" Value="#B4DE16"/>

                                                        <Setter TargetName="BlackFillOverlay" Property="BorderThickness" Value="0"/>

                                                        <Setter TargetName="InstallTitleText" Property="Foreground" Value="#121410"/>

                                                        <Setter TargetName="InstallSubtitleText" Property="Foreground" Value="#2E3314"/>

                                                    </MultiDataTrigger>

                                                </ControlTemplate.Triggers>

                                            </ControlTemplate>

                                        </Button.Template>

                                    </Button>

                                </Grid>



                                <!-- 2A-2: Driver Booster 1-Click Batch Card (ALIGNED TO EXACT BOTTOM OF LEFT TAB: 582 + 14 + 64 = 660) -->

                                <Border x:Name="DriverBoosterBottomCard" Background="#1C1E22" BorderBrush="#282B33" BorderThickness="1" CornerRadius="18"

                                        Padding="18,13" Margin="0,14,0,0" Height="64">

                                    <Border.Effect>

                                        <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.4" Color="#000000"/>

                                    </Border.Effect>

                                    <Grid VerticalAlignment="Center" ClipToBounds="False">

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="*"/>

                                            <ColumnDefinition Width="Auto"/>

                                        </Grid.ColumnDefinitions>

                                        <StackPanel VerticalAlignment="Center">

                                            <TextBlock Text="Extra &amp; Advanced Drivers" FontSize="13.5" FontWeight="Bold" Foreground="#FFFFFF"

                                                       FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"/>

                                            <TextBlock Text="Get extra &amp; advanced drivers needed for your PC" FontSize="11" Foreground="#8E95A5" Margin="0,2,0,0"

                                                       FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"/>

                                        </StackPanel>

                                        <Button x:Name="DriverBoosterBottomBtn" Grid.Column="1" Command="{Binding GetDriverBoosterBottomActionCommand}"

                                                Cursor="Hand" VerticalAlignment="Center" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0"

                                                Height="40" Width="176" SnapsToDevicePixels="True" UseLayoutRounding="True" ClipToBounds="False">

                                            <Button.Template>

                                                <ControlTemplate TargetType="Button">

                                                    <Grid x:Name="RootButtonGrid" Background="Transparent" SnapsToDevicePixels="True" UseLayoutRounding="True"

                                                          ClipToBounds="False" RenderTransformOrigin="0.5,0.5">

                                                        <Grid.RenderTransform>

                                                            <TranslateTransform x:Name="ButtonShakeTrans" X="0" Y="0"/>

                                                        </Grid.RenderTransform>



                                                        <!-- Expanding Pill Background Capsule (Margin 10,0,10,0 gives 10px buffer so shaking by +/-5px never clips) -->

                                                        <Border x:Name="Capsule" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,10,0"

                                                                Width="36" Height="36" CornerRadius="18"

                                                                Background="#0A0B0E" BorderBrush="Transparent" BorderThickness="1.2"

                                                                SnapsToDevicePixels="True" UseLayoutRounding="True"/>



                                                        <!-- Foreground Elements (Margin 10,0,10,0 perfectly matches Capsule position) -->

                                                        <Grid Margin="10,0,10,0" SnapsToDevicePixels="True" UseLayoutRounding="True" ClipToBounds="False">

                                                            <!-- Left Circle Icon Holder -->

                                                            <Grid Width="36" Height="36" HorizontalAlignment="Left" VerticalAlignment="Center">

                                                                <!-- Chevron (unhovered) -->

                                                                <TextBlock x:Name="ChevronGlyph" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets"

                                                                           FontSize="10.5" Foreground="#A4ABB8"

                                                                           HorizontalAlignment="Center" VerticalAlignment="Center">

                                                                    <TextBlock.RenderTransform>

                                                                        <TranslateTransform x:Name="ChevronTrans" X="0"/>

                                                                    </TextBlock.RenderTransform>

                                                                </TextBlock>



                                                                <!-- Arrow (hovered) -->

                                                                <TextBlock x:Name="ArrowGlyph" Text="&#xE72A;" FontFamily="Segoe MDL2 Assets"

                                                                           FontSize="11.5" Foreground="#FFFFFF"

                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"

                                                                           Opacity="0">

                                                                    <TextBlock.RenderTransform>

                                                                        <TranslateTransform x:Name="ArrowTrans" X="-4"/>

                                                                    </TextBlock.RenderTransform>

                                                                </TextBlock>



                                                                <!-- Vector Lock Container (for locked click animation like lock button.gif) -->

                                                                <Grid x:Name="LockIconContainer" Width="36" Height="36" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">

                                                                    <!-- Radiating Click Sparks (like frame 55 in lock button.gif) -->

                                                                    <Canvas x:Name="ClickSparks" Width="36" Height="36" Opacity="0" RenderTransformOrigin="0.36,0.47">

                                                                        <Canvas.RenderTransform>

                                                                            <ScaleTransform x:Name="SparksScale" ScaleX="0.5" ScaleY="0.5"/>

                                                                        </Canvas.RenderTransform>

                                                                        <Line X1="11" Y1="13" X2="7" Y2="9" Stroke="#FFFFFF" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

                                                                        <Line X1="9" Y1="17" X2="4" Y2="17" Stroke="#FFFFFF" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

                                                                        <Line X1="11" Y1="21" X2="7" Y2="25" Stroke="#FFFFFF" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

                                                                    </Canvas>



                                                                    <!-- Lock Shackle (Precisely Centered Vertically & Horizontally in 36x36 Circle) -->

                                                                    <Border x:Name="LockShackle" Width="10" Height="9" Margin="0,9,0,0"

                                                                            BorderThickness="2,2,2,0" BorderBrush="#FFFFFF" CornerRadius="5,5,0,0"

                                                                            HorizontalAlignment="Center" VerticalAlignment="Top"

                                                                            RenderTransformOrigin="0.2,0.9">

                                                                        <Border.RenderTransform>

                                                                            <TransformGroup>

                                                                                <RotateTransform x:Name="ShackleRot" Angle="0"/>

                                                                                <TranslateTransform x:Name="ShackleTrans" Y="0"/>

                                                                            </TransformGroup>

                                                                        </Border.RenderTransform>

                                                                    </Border>



                                                                    <!-- Lock Body (Precisely Centered: Top=16, Height=11, Bottom=27 -> Center=18) -->

                                                                    <Border x:Name="LockBody" Width="14" Height="11" Margin="0,16,0,0"

                                                                            Background="#FFFFFF" CornerRadius="2.5"

                                                                            HorizontalAlignment="Center" VerticalAlignment="Top"/>

                                                                </Grid>

                                                            </Grid>



                                                            <!-- Smooth Slide & Cross-Fade Text Container -->

                                                            <Grid HorizontalAlignment="Left" VerticalAlignment="Center" Margin="42,0,14,0" ClipToBounds="True" Height="22">

                                                                <!-- 1. "Scan to Unlock" (Initial locked state) -->

                                                                <TextBlock x:Name="ScanToUnlockText" Text="Scan to Unlock" FontSize="11.5" FontWeight="SemiBold"

                                                                           Foreground="#8E95A5" VerticalAlignment="Center" HorizontalAlignment="Left"

                                                                           FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"

                                                                           Opacity="1">

                                                                    <TextBlock.RenderTransform>

                                                                        <TranslateTransform x:Name="ScanToUnlockTrans" Y="0"/>

                                                                    </TextBlock.RenderTransform>

                                                                </TextBlock>



                                                                <!-- 2. "Get Driver Booster" (Unlocked state) -->

                                                                <TextBlock x:Name="GetDriverBoosterText" Text="Get Driver Booster" FontSize="11.5" FontWeight="SemiBold"

                                                                           Foreground="#8E95A5" VerticalAlignment="Center" HorizontalAlignment="Left"

                                                                           FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"

                                                                           Opacity="0">

                                                                    <TextBlock.RenderTransform>

                                                                        <TranslateTransform x:Name="GetDriverBoosterTrans" Y="10"/>

                                                                    </TextBlock.RenderTransform>

                                                                </TextBlock>

                                                            </Grid>

                                                        </Grid>

                                                    </Grid>



                                                    <ControlTemplate.Triggers>

                                                        <!-- After scan completes: Smooth Slide & Cross-Fade to "Get Driver Booster" -->

                                                        <DataTrigger Binding="{Binding HasCompletedDriverScan}" Value="True">

                                                            <DataTrigger.EnterActions>

                                                                <BeginStoryboard x:Name="UnlockTextTransitionStoryboard">

                                                                    <Storyboard>

                                                                        <!-- Old "Scan to Unlock" fades out & slides up -->

                                                                        <DoubleAnimation Storyboard.TargetName="ScanToUnlockText" Storyboard.TargetProperty="Opacity"

                                                                                         To="0" Duration="0:0:0.25">

                                                                            <DoubleAnimation.EasingFunction>

                                                                                <CubicEase EasingMode="EaseOut"/>

                                                                            </DoubleAnimation.EasingFunction>

                                                                        </DoubleAnimation>

                                                                        <DoubleAnimation Storyboard.TargetName="ScanToUnlockTrans" Storyboard.TargetProperty="Y"

                                                                                         To="-10" Duration="0:0:0.25">

                                                                            <DoubleAnimation.EasingFunction>

                                                                                <CubicEase EasingMode="EaseOut"/>

                                                                            </DoubleAnimation.EasingFunction>

                                                                        </DoubleAnimation>



                                                                        <!-- New "Get Driver Booster" fades in & slides up into place from below -->

                                                                        <DoubleAnimation Storyboard.TargetName="GetDriverBoosterText" Storyboard.TargetProperty="Opacity"

                                                                                         To="1" Duration="0:0:0.32" BeginTime="0:0:0.06">

                                                                            <DoubleAnimation.EasingFunction>

                                                                                <CubicEase EasingMode="EaseOut"/>

                                                                            </DoubleAnimation.EasingFunction>

                                                                        </DoubleAnimation>

                                                                        <DoubleAnimation Storyboard.TargetName="GetDriverBoosterTrans" Storyboard.TargetProperty="Y"

                                                                                         To="0" Duration="0:0:0.32" BeginTime="0:0:0.06">

                                                                            <DoubleAnimation.EasingFunction>

                                                                                <CubicEase EasingMode="EaseOut"/>

                                                                            </DoubleAnimation.EasingFunction>

                                                                        </DoubleAnimation>

                                                                    </Storyboard>

                                                                </BeginStoryboard>

                                                            </DataTrigger.EnterActions>

                                                            <DataTrigger.ExitActions>

                                                                <BeginStoryboard>

                                                                    <Storyboard>

                                                                        <!-- Reset back to "Scan to Unlock" on re-scan -->

                                                                        <DoubleAnimation Storyboard.TargetName="ScanToUnlockText" Storyboard.TargetProperty="Opacity"

                                                                                         To="1" Duration="0:0:0.2"/>

                                                                        <DoubleAnimation Storyboard.TargetName="ScanToUnlockTrans" Storyboard.TargetProperty="Y"

                                                                                         To="0" Duration="0:0:0.2"/>

                                                                        <DoubleAnimation Storyboard.TargetName="GetDriverBoosterText" Storyboard.TargetProperty="Opacity"

                                                                                         To="0" Duration="0:0:0.2"/>

                                                                        <DoubleAnimation Storyboard.TargetName="GetDriverBoosterTrans" Storyboard.TargetProperty="Y"

                                                                                         To="10" Duration="0:0:0.2"/>

                                                                    </Storyboard>

                                                                </BeginStoryboard>

                                                            </DataTrigger.ExitActions>

                                                        </DataTrigger>



                                                        <!-- Mouse Over: Expand capsule, switch chevron to arrow, highlight text -->

                                                        <Trigger Property="IsMouseOver" Value="True">

                                                            <Setter TargetName="Capsule" Property="Background" Value="#12141A"/>

                                                            <Setter TargetName="ScanToUnlockText" Property="Foreground" Value="#FFFFFF"/>

                                                            <Setter TargetName="GetDriverBoosterText" Property="Foreground" Value="#FFFFFF"/>

                                                            <Trigger.EnterActions>

                                                                <BeginStoryboard>

                                                                    <Storyboard>

                                                                        <!-- Expand Capsule Width from 36 to 156 -->

                                                                        <DoubleAnimation Storyboard.TargetName="Capsule" Storyboard.TargetProperty="Width"

                                                                                         To="156" Duration="0:0:0.25">

                                                                            <DoubleAnimation.EasingFunction>

                                                                                <CubicEase EasingMode="EaseOut"/>

                                                                            </DoubleAnimation.EasingFunction>

                                                                        </DoubleAnimation>

                                                                        <!-- Fade out Chevron -->

                                                                        <DoubleAnimation Storyboard.TargetName="ChevronGlyph" Storyboard.TargetProperty="Opacity"

                                                                                         To="0" Duration="0:0:0.12"/>

                                                                        <!-- Fade in Arrow and slide from -4 to 0 -->

                                                                        <DoubleAnimation Storyboard.TargetName="ArrowGlyph" Storyboard.TargetProperty="Opacity"

                                                                                         To="1" Duration="0:0:0.2" BeginTime="0:0:0.04"/>

                                                                        <DoubleAnimation Storyboard.TargetName="ArrowTrans" Storyboard.TargetProperty="X"

                                                                                         To="0" Duration="0:0:0.2">

                                                                            <DoubleAnimation.EasingFunction>

                                                                                <CubicEase EasingMode="EaseOut"/>

                                                                            </DoubleAnimation.EasingFunction>

                                                                        </DoubleAnimation>

                                                                    </Storyboard>

                                                                </BeginStoryboard>

                                                            </Trigger.EnterActions>

                                                            <Trigger.ExitActions>

                                                                <BeginStoryboard>

                                                                    <Storyboard>

                                                                        <!-- Collapse Capsule Width from 156 back to 36 -->

                                                                        <DoubleAnimation Storyboard.TargetName="Capsule" Storyboard.TargetProperty="Width"

                                                                                         To="36" Duration="0:0:0.22">

                                                                            <DoubleAnimation.EasingFunction>

                                                                                <CubicEase EasingMode="EaseOut"/>

                                                                            </DoubleAnimation.EasingFunction>

                                                                        </DoubleAnimation>

                                                                        <!-- Fade in Chevron -->

                                                                        <DoubleAnimation Storyboard.TargetName="ChevronGlyph" Storyboard.TargetProperty="Opacity"

                                                                                         To="1" Duration="0:0:0.18" BeginTime="0:0:0.04"/>

                                                                        <!-- Fade out Arrow and slide back -->

                                                                        <DoubleAnimation Storyboard.TargetName="ArrowGlyph" Storyboard.TargetProperty="Opacity"

                                                                                         To="0" Duration="0:0:0.1"/>

                                                                        <DoubleAnimation Storyboard.TargetName="ArrowTrans" Storyboard.TargetProperty="X"

                                                                                         To="-4" Duration="0:0:0.15"/>

                                                                    </Storyboard>

                                                                </BeginStoryboard>

                                                            </Trigger.ExitActions>

                                                        </Trigger>



                                                        <!-- Pressed state -->

                                                        <Trigger Property="IsPressed" Value="True">

                                                            <Setter TargetName="Capsule" Property="Background" Value="#060709"/>

                                                        </Trigger>

                                                    </ControlTemplate.Triggers>

                                                </ControlTemplate>

                                            </Button.Template>

                                        </Button>

                                    </Grid>

                                </Border>

                            </StackPanel>



                            <!-- 2B: COLLAPSED SCANNER HOST (Sleek 52px Header Bar + Driver Installation List) -->

                            <Grid x:Name="CollapsedScannerHost" Opacity="0" Visibility="Collapsed">

                                <Grid.RowDefinitions>

                                    <RowDefinition Height="Auto"/>

                                    <RowDefinition Height="*"/>

                                </Grid.RowDefinitions>



                                <!-- B-1. COLLAPSED SLEEK HEADER BAR (Visible when collapsed into compact bar) -->

                                <Border x:Name="DashboardCollapsedBar" Grid.Row="0" Height="58" Margin="0,0,24,20" VerticalAlignment="Top"

                                        Background="#16181D" BorderBrush="#282B33" BorderThickness="1" CornerRadius="16">

                                    <Border.Effect>

                                        <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.4" Color="#000000"/>

                                    </Border.Effect>

                                    <Grid Margin="20,0">

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="Auto"/>

                                            <ColumnDefinition Width="*"/>

                                            <ColumnDefinition Width="Auto"/>

                                        </Grid.ColumnDefinitions>



                                        <!-- Left: Driver Scanner Title + 5/5 Installed Normal Text (Vertically Centered) -->

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">

                                            <TextBlock Text="Driver Scanner" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"

                                                       FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif" VerticalAlignment="Center"/>

                                            <TextBlock Text="{Binding InstalledDriversBadgeText, FallbackValue='6 Drivers Found'}"

                                                       FontSize="13.5" FontWeight="SemiBold" Foreground="#D1FE29" Margin="12,0,0,0"

                                                       FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif" VerticalAlignment="Center"/>

                                        </StackPanel>



                                        <!-- Right: Action Buttons (Rescan Drivers & Install All Drivers) -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- 1. Rescan Drivers Button (Placed where user marked in green) -->
                                            <Button x:Name="CollapsedRescanBtn"
                                                    Command="{Binding RescanDriversCommand}"
                                                    Visibility="{Binding IsRescanButtonVisible, Converter={StaticResource BoolToVis}}"
                                                    Cursor="Hand" VerticalAlignment="Center"
                                                    Width="134" Height="36" Margin="0,0,10,0" FocusVisualStyle="{x:Null}">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="RootBorder" CornerRadius="10" ClipToBounds="True" Width="134" Height="36">
                                                                        <Grid Width="134" Height="36">
                                                                            <Grid.OpacityMask>
                                                                                <VisualBrush>
                                                                                    <VisualBrush.Visual>
                                                                                        <Border Width="134" Height="36" CornerRadius="10" Background="Black"/>
                                                                                    </VisualBrush.Visual>
                                                                                </VisualBrush>
                                                                            </Grid.OpacityMask>

                                                                            <!-- 1. BASE IDLE LAYER (Dark resting state) -->
                                                                            <Border x:Name="BaseBorder"
                                                                                    Width="134" Height="36"
                                                                                    Background="#202227"
                                                                                    BorderBrush="#2C2F38"
                                                                                    BorderThickness="1"
                                                                                    CornerRadius="10">
                                                                                <StackPanel x:Name="IdleContent" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="11.5" Foreground="#D1FE29" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                                                                    <TextBlock Text="Rescan Drivers" FontSize="12" FontWeight="SemiBold" FontFamily="pack://application:,,,/Fonts/#Poppins, Segoe UI Variable Display, Segoe UI, sans-serif" Foreground="#D4D4D8" VerticalAlignment="Center"/>
                                                                                </StackPanel>
                                                                            </Border>

                                                                            <!-- 2. LIME OVERLAY LAYER (Vibrant Lime Green Scanning & Done Layer) -->
                                                                            <Border x:Name="RescanLimeOverlay"
                                                                                    HorizontalAlignment="Left"
                                                                                    Width="0"
                                                                                    Height="36"
                                                                                    Background="#D1FE29"
                                                                                    BorderThickness="0"
                                                                                    CornerRadius="10"
                                                                                    ClipToBounds="True">
                                                                                <Grid Width="134" Height="36" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                                    <!-- 2A: 3 Bouncing Dots Loader (Dark dots #121410 on Lime Green) -->
                                                                                    <StackPanel x:Name="RescanDotsLoader" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Visible">
                                                                                        <Border Width="6.5" Height="6.5" CornerRadius="3.25" Background="#121410" Margin="3,0">
                                                                                            <Border.RenderTransform>
                                                                                                <TranslateTransform x:Name="RescanDot1" Y="0"/>
                                                                                            </Border.RenderTransform>
                                                                                        </Border>
                                                                                        <Border Width="6.5" Height="6.5" CornerRadius="3.25" Background="#121410" Margin="3,0">
                                                                                            <Border.RenderTransform>
                                                                                                <TranslateTransform x:Name="RescanDot2" Y="0"/>
                                                                                            </Border.RenderTransform>
                                                                                        </Border>
                                                                                        <Border Width="6.5" Height="6.5" CornerRadius="3.25" Background="#121410" Margin="3,0">
                                                                                            <Border.RenderTransform>
                                                                                                <TranslateTransform x:Name="RescanDot3" Y="0"/>
                                                                                            </Border.RenderTransform>
                                                                                        </Border>
                                                                                    </StackPanel>

                                                                                    <!-- 2B: Done State (Dark ✓ Done on Lime Green) -->
                                                                                    <StackPanel x:Name="RescanDoneContent" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                                                                                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="12.5" FontWeight="SemiBold" Foreground="#121410" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                                                        <TextBlock Text="Done" FontSize="12" FontWeight="SemiBold" FontFamily="pack://application:,,,/Fonts/#Poppins, Segoe UI Variable Display, Segoe UI, sans-serif" Foreground="#121410" VerticalAlignment="Center"/>
                                                                                    </StackPanel>
                                                                                </Grid>
                                                                            </Border>
                                                                        </Grid>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <!-- Mouse Hover in Idle state -->
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="BaseBorder" Property="Background" Value="#323640"/>
                                                                            <Setter TargetName="BaseBorder" Property="BorderBrush" Value="#4A4E5C"/>
                                                                        </Trigger>
                                                                        <Trigger Property="IsPressed" Value="True">
                                                                            <Setter TargetName="BaseBorder" Property="Background" Value="#1C1E24"/>
                                                                        </Trigger>

                                                                        <!-- Scanning State Wave Animation Trigger -->
                                                                        <DataTrigger Binding="{Binding IsRescanningDrivers}" Value="True">
                                                                            <Setter TargetName="RescanLimeOverlay" Property="Width" Value="134"/>
                                                                            <Setter TargetName="RescanDotsLoader" Property="Visibility" Value="Visible"/>
                                                                            <Setter TargetName="RescanDoneContent" Property="Visibility" Value="Collapsed"/>
                                                                            <Setter Property="IsEnabled" Value="False"/>
                                                                            <DataTrigger.EnterActions>
                                                                                <BeginStoryboard x:Name="RescanWaveStoryboard">
                                                                                    <Storyboard RepeatBehavior="Forever">
                                                                                        <!-- Dot 1 -->
                                                                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RescanDot1" Storyboard.TargetProperty="Y" Duration="0:0:0.7">
                                                                                            <SplineDoubleKeyFrame KeyTime="0:0:0.00" Value="0"/>
                                                                                            <SplineDoubleKeyFrame KeyTime="0:0:0.18" Value="-6" KeySpline="0.25,0.1,0.25,1.0"/>
                                                                                            <SplineDoubleKeyFrame KeyTime="0:0:0.36" Value="0" KeySpline="0.25,0.1,0.25,1.0"/>
                                                                                            <SplineDoubleKeyFrame KeyTime="0:0:0.70" Value="0"/>
                                                                                        </DoubleAnimationUsingKeyFrames>
                                                                                        <!-- Dot 2 -->
                                                                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RescanDot2" Storyboard.TargetProperty="Y" Duration="0:0:0.7">
                                                                                            <SplineDoubleKeyFrame KeyTime="0:0:0.00" Value="0"/>
                                                                                            <SplineDoubleKeyFrame KeyTime="0:0:0.12" Value="0"/>
                                                                                            <SplineDoubleKeyFrame KeyTime="0:0:0.30" Value="-6" KeySpline="0.25,0.1,0.25,1.0"/>
                                                                                            <SplineDoubleKeyFrame KeyTime="0:0:0.48" Value="0" KeySpline="0.25,0.1,0.25,1.0"/>
                                                                                            <SplineDoubleKeyFrame KeyTime="0:0:0.70" Value="0"/>
                                                                                        </DoubleAnimationUsingKeyFrames>
                                                                                        <!-- Dot 3 -->
                                                                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RescanDot3" Storyboard.TargetProperty="Y" Duration="0:0:0.7">
                                                                                            <SplineDoubleKeyFrame KeyTime="0:0:0.00" Value="0"/>
                                                                                            <SplineDoubleKeyFrame KeyTime="0:0:0.24" Value="0"/>
                                                                                            <SplineDoubleKeyFrame KeyTime="0:0:0.42" Value="-6" KeySpline="0.25,0.1,0.25,1.0"/>
                                                                                            <SplineDoubleKeyFrame KeyTime="0:0:0.60" Value="0" KeySpline="0.25,0.1,0.25,1.0"/>
                                                                                            <SplineDoubleKeyFrame KeyTime="0:0:0.70" Value="0"/>
                                                                                        </DoubleAnimationUsingKeyFrames>
                                                                                    </Storyboard>
                                                                                </BeginStoryboard>
                                                                            </DataTrigger.EnterActions>
                                                                            <DataTrigger.ExitActions>
                                                                                <StopStoryboard BeginStoryboardName="RescanWaveStoryboard"/>
                                                                            </DataTrigger.ExitActions>
                                                                        </DataTrigger>

                                                                        <!-- Rescan Completed Trigger: Displays Done checkmark -->
                                                                        <DataTrigger Binding="{Binding IsRescanCompleted}" Value="True">
                                                                            <Setter TargetName="RescanLimeOverlay" Property="Width" Value="134"/>
                                                                            <Setter TargetName="RescanDotsLoader" Property="Visibility" Value="Collapsed"/>
                                                                            <Setter TargetName="RescanDoneContent" Property="Visibility" Value="Visible"/>
                                                                            <Setter Property="IsEnabled" Value="False"/>
                                                                        </DataTrigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <!-- 2. Install All Drivers Button (On far right where Rescan used to be) -->
                                            <Button x:Name="HeaderInstallAllDriversBtn"
                                                    Command="{Binding InstallAllDriversCommand}"
                                                    Cursor="Hand" VerticalAlignment="Center"
                                                    Width="158" Height="36" FocusVisualStyle="{x:Null}">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="InstallBtnBorder"
                                                                            Background="#D1FE29"
                                                                            BorderBrush="Transparent"
                                                                            BorderThickness="0"
                                                                            CornerRadius="10"
                                                                            ClipToBounds="True"
                                                                            Width="158"
                                                                            Height="36">
                                                                        <Grid>
                                                                            <!-- 1. Normal Text -->
                                                                            <TextBlock x:Name="InstallBtnText"
                                                                                       Text="{Binding InstallAllDriversButtonText, FallbackValue='Download All Drivers'}"
                                                                                       FontSize="12.5"
                                                                                       FontWeight="SemiBold"
                                                                                       FontFamily="pack://application:,,,/Fonts/#Poppins, Segoe UI Variable Display, Segoe UI, sans-serif"
                                                                                       Foreground="#121410"
                                                                                       HorizontalAlignment="Center"
                                                                                       VerticalAlignment="Center"/>

                                                                            <!-- 2. Installing Host (Text + 3 Green Bouncing Dots) -->
                                                                            <StackPanel x:Name="HeaderInstallingHost"
                                                                                        Orientation="Horizontal"
                                                                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                        Visibility="Collapsed">
                                                                                <TextBlock Text="Installing" FontSize="12" FontWeight="SemiBold"
                                                                                           FontFamily="pack://application:,,,/Fonts/#Poppins, Segoe UI Variable Display, Segoe UI, sans-serif"
                                                                                           Foreground="#D1FE29" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                                                <Border Width="5" Height="5" CornerRadius="2.5" Background="#D1FE29" Margin="0,0,4,0">
                                                                                    <Border.RenderTransform>
                                                                                        <TranslateTransform x:Name="HInstDot1" Y="0"/>
                                                                                    </Border.RenderTransform>
                                                                                </Border>
                                                                                <Border Width="5" Height="5" CornerRadius="2.5" Background="#D1FE29" Margin="0,0,4,0">
                                                                                    <Border.RenderTransform>
                                                                                        <TranslateTransform x:Name="HInstDot2" Y="0"/>
                                                                                    </Border.RenderTransform>
                                                                                </Border>
                                                                                <Border Width="5" Height="5" CornerRadius="2.5" Background="#D1FE29">
                                                                                    <Border.RenderTransform>
                                                                                        <TranslateTransform x:Name="HInstDot3" Y="0"/>
                                                                                    </Border.RenderTransform>
                                                                                </Border>
                                                                            </StackPanel>
                                                                        </Grid>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="InstallBtnBorder" Property="Background" Value="#E2FF4A"/>
                                                                        </Trigger>
                                                                        <Trigger Property="IsPressed" Value="True">
                                                                            <Setter TargetName="InstallBtnBorder" Property="Background" Value="#B8E619"/>
                                                                        </Trigger>

                                                                        <!-- When all downloaded -> Solid White #FFFFFF with Black text -->
                                                                        <DataTrigger Binding="{Binding AreAllDriversDownloaded}" Value="True">
                                                                            <Setter TargetName="InstallBtnBorder" Property="Background" Value="#FFFFFF"/>
                                                                            <Setter TargetName="InstallBtnBorder" Property="BorderThickness" Value="0"/>
                                                                            <Setter TargetName="InstallBtnText" Property="Foreground" Value="#000000"/>
                                                                        </DataTrigger>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding AreAllDriversDownloaded}" Value="True"/>
                                                                                <Condition Binding="{Binding Path=IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter TargetName="InstallBtnBorder" Property="Background" Value="#E5E5E5"/>
                                                                        </MultiDataTrigger>

                                                                        <!-- When Installing All Drivers -->
                                                                        <DataTrigger Binding="{Binding IsInstallingAllDrivers}" Value="True">
                                                                            <Setter TargetName="InstallBtnBorder" Property="Background" Value="#202227"/>
                                                                            <Setter TargetName="InstallBtnBorder" Property="BorderBrush" Value="#2C2F38"/>
                                                                            <Setter TargetName="InstallBtnBorder" Property="BorderThickness" Value="1"/>
                                                                            <Setter TargetName="InstallBtnText" Property="Visibility" Value="Collapsed"/>
                                                                            <Setter TargetName="HeaderInstallingHost" Property="Visibility" Value="Visible"/>
                                                                            <Setter Property="IsEnabled" Value="False"/>
                                                                            <DataTrigger.EnterActions>
                                                                                <BeginStoryboard x:Name="HInstDotsStoryboard">
                                                                                    <Storyboard RepeatBehavior="Forever">
                                                                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HInstDot1" Storyboard.TargetProperty="Y" Duration="0:0:0.7">
                                                                                            <SplineDoubleKeyFrame KeyTime="0:0:0.00" Value="0"/>
                                                                                            <SplineDoubleKeyFrame KeyTime="0:0:0.18" Value="-5" KeySpline="0.25,0.1,0.25,1.0"/>
                                                                                            <SplineDoubleKeyFrame KeyTime="0:0:0.36" Value="0" KeySpline="0.25,0.1,0.25,1.0"/>
                                                                                            <SplineDoubleKeyFrame KeyTime="0:0:0.70" Value="0"/>
                                                                                        </DoubleAnimationUsingKeyFrames>
                                                                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HInstDot2" Storyboard.TargetProperty="Y" Duration="0:0:0.7">
                                                                                            <SplineDoubleKeyFrame KeyTime="0:0:0.00" Value="0"/>
                                                                                            <SplineDoubleKeyFrame KeyTime="0:0:0.12" Value="0"/>
                                                                                            <SplineDoubleKeyFrame KeyTime="0:0:0.30" Value="-5" KeySpline="0.25,0.1,0.25,1.0"/>
                                                                                            <SplineDoubleKeyFrame KeyTime="0:0:0.48" Value="0" KeySpline="0.25,0.1,0.25,1.0"/>
                                                                                            <SplineDoubleKeyFrame KeyTime="0:0:0.70" Value="0"/>
                                                                                        </DoubleAnimationUsingKeyFrames>
                                                                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HInstDot3" Storyboard.TargetProperty="Y" Duration="0:0:0.7">
                                                                                            <SplineDoubleKeyFrame KeyTime="0:0:0.00" Value="0"/>
                                                                                            <SplineDoubleKeyFrame KeyTime="0:0:0.24" Value="0"/>
                                                                                            <SplineDoubleKeyFrame KeyTime="0:0:0.42" Value="-5" KeySpline="0.25,0.1,0.25,1.0"/>
                                                                                            <SplineDoubleKeyFrame KeyTime="0:0:0.60" Value="0" KeySpline="0.25,0.1,0.25,1.0"/>
                                                                                            <SplineDoubleKeyFrame KeyTime="0:0:0.70" Value="0"/>
                                                                                        </DoubleAnimationUsingKeyFrames>
                                                                                    </Storyboard>
                                                                                </BeginStoryboard>
                                                                            </DataTrigger.EnterActions>
                                                                            <DataTrigger.ExitActions>
                                                                                <StopStoryboard BeginStoryboardName="HInstDotsStoryboard"/>
                                                                            </DataTrigger.ExitActions>
                                                                        </DataTrigger>

                                                                        <!-- When All Installed -> "Done" in gray -->
                                                                        <DataTrigger Binding="{Binding AreAllDriversInstalled}" Value="True">
                                                                            <Setter TargetName="InstallBtnBorder" Property="Background" Value="#18191D"/>
                                                                            <Setter TargetName="InstallBtnBorder" Property="BorderBrush" Value="#25262C"/>
                                                                            <Setter TargetName="InstallBtnBorder" Property="BorderThickness" Value="1"/>
                                                                            <Setter TargetName="InstallBtnText" Property="Foreground" Value="#71717A"/>
                                                                            <Setter TargetName="InstallBtnText" Property="Visibility" Value="Visible"/>
                                                                            <Setter TargetName="HeaderInstallingHost" Property="Visibility" Value="Collapsed"/>
                                                                            <Setter Property="IsEnabled" Value="False"/>
                                                                        </DataTrigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>

                                    </Grid>

                                </Border>



                                <!-- B-2. DRIVER INSTALLATION VIEW (Full Driver Actions in Right Column with Bottom Fade) -->

                                <Grid Grid.Row="1" Margin="0,0,0,0" Height="582" SnapsToDevicePixels="True" UseLayoutRounding="True" ClipToBounds="True">

                                    <ScrollViewer x:Name="DriverInstallationScrollViewer"
                                                  Margin="0" Padding="0,0,24,0"
                                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                  SnapsToDevicePixels="True" UseLayoutRounding="True"
                                                  ScrollChanged="DriverInstallationScrollViewer_ScrollChanged"
                                                  PreviewMouseWheel="DriverInstallationScrollViewer_PreviewMouseWheel">

                                        <ScrollViewer.Resources>
                                            <Style TargetType="ScrollBar" BasedOn="{StaticResource {x:Type ScrollBar}}">
                                                <Setter Property="Margin" Value="0,0,-6,0"/>
                                            </Style>
                                        </ScrollViewer.Resources>

                                        <StackPanel x:Name="DriverInstallationHost" Margin="0,0,0,100">

                                        <StackPanel.RenderTransform>

                                            <TranslateTransform x:Name="DriverInstallationHostTranslate" Y="0"/>

                                        </StackPanel.RenderTransform>



                        <!-- PROMINENT DRIVERS HEADER BANNER (DOWNLOAD OTHER ALL DRIVERS) -->
                        <Border Background="#17181C" BorderBrush="#272930" BorderThickness="1" CornerRadius="16"
                                Padding="20,16" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Background="#202227" BorderBrush="#2C2F38" BorderThickness="1"
                                        CornerRadius="12" Width="44" Height="44" Margin="0,0,16,0">
                                    <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                               Foreground="#D4D4D8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="Download Other All Drivers" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="#F4F4F5" FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"/>
                                        <Border Background="#202227" BorderBrush="#2C2F38" BorderThickness="1"
                                                CornerRadius="6" Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="DRIVER BOOSTER" FontSize="9" FontWeight="SemiBold" Foreground="#A1A1AA"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Download IObit Driver Booster to automatically detect and update 9,500,000+ peripheral, audio, and device drivers."
                                               Foreground="#8E8E93" FontSize="12" LineHeight="16" TextWrapping="Wrap"/>
                                </StackPanel>

                                <!-- Driver Booster Action Button -->
                                <Button x:Name="DriverBoosterBannerBtn"
                                        Grid.Column="2"
                                        Command="{Binding RequestDriverBoosterDownloadCommand}"
                                        Cursor="Hand" VerticalAlignment="Center"
                                        Width="158" Height="36" FocusVisualStyle="{x:Null}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="BoosterBtnBorder"
                                                                Background="#202227"
                                                                BorderBrush="#353842"
                                                                BorderThickness="1"
                                                                CornerRadius="10"
                                                                Width="158" Height="36"
                                                                RenderTransformOrigin="0.5,0.5">
                                                            <Border.RenderTransform>
                                                                <ScaleTransform x:Name="BoosterBtnScale" ScaleX="1.0" ScaleY="1.0"/>
                                                            </Border.RenderTransform>
                                                            <TextBlock x:Name="BoosterBtnText"
                                                                       Text="{Binding DriverBoosterBannerButtonText, FallbackValue='Get Driver Booster'}"
                                                                       FontSize="12.5" FontWeight="SemiBold"
                                                                       FontFamily="pack://application:,,,/Fonts/#Poppins, Segoe UI Variable Display, Segoe UI, sans-serif"
                                                                       Foreground="#FFFFFF"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="BoosterBtnBorder" Property="Background" Value="#2A2D35"/>
                                                                <Setter TargetName="BoosterBtnBorder" Property="BorderBrush" Value="#4A5060"/>
                                                            </Trigger>
                                                            <Trigger Property="IsPressed" Value="True">
                                                                <Setter TargetName="BoosterBtnBorder" Property="Background" Value="#17181D"/>
                                                            </Trigger>

                                                            <!-- WHEN ALL DRIVERS ARE INSTALLED: TURN GREEN & BUMP! -->
                                                            <DataTrigger Binding="{Binding AreAllDriversInstalled}" Value="True">
                                                                <Setter TargetName="BoosterBtnBorder" Property="Background" Value="#D1FE29"/>
                                                                <Setter TargetName="BoosterBtnBorder" Property="BorderBrush" Value="Transparent"/>
                                                                <Setter TargetName="BoosterBtnBorder" Property="BorderThickness" Value="0"/>
                                                                <Setter TargetName="BoosterBtnText" Property="Foreground" Value="#08080A"/>
                                                                <Setter TargetName="BoosterBtnText" Property="FontWeight" Value="Bold"/>
                                                                <DataTrigger.EnterActions>
                                                                    <BeginStoryboard x:Name="BoosterBumpStoryboard">
                                                                        <Storyboard RepeatBehavior="Forever">
                                                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BoosterBtnScale"
                                                                                                           Storyboard.TargetProperty="ScaleX"
                                                                                                           Duration="0:0:1.8">
                                                                                <LinearDoubleKeyFrame KeyTime="0:0:0.0" Value="1.0"/>
                                                                                <SplineDoubleKeyFrame KeyTime="0:0:0.25" Value="1.06" KeySpline="0.2,0.8,0.4,1.0"/>
                                                                                <SplineDoubleKeyFrame KeyTime="0:0:0.50" Value="1.0" KeySpline="0.6,0.0,0.8,0.2"/>
                                                                                <SplineDoubleKeyFrame KeyTime="0:0:0.70" Value="1.03" KeySpline="0.2,0.8,0.4,1.0"/>
                                                                                <SplineDoubleKeyFrame KeyTime="0:0:0.90" Value="1.0" KeySpline="0.6,0.0,0.8,0.2"/>
                                                                                <LinearDoubleKeyFrame KeyTime="0:0:1.8" Value="1.0"/>
                                                                            </DoubleAnimationUsingKeyFrames>
                                                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BoosterBtnScale"
                                                                                                           Storyboard.TargetProperty="ScaleY"
                                                                                                           Duration="0:0:1.8">
                                                                                <LinearDoubleKeyFrame KeyTime="0:0:0.0" Value="1.0"/>
                                                                                <SplineDoubleKeyFrame KeyTime="0:0:0.25" Value="1.06" KeySpline="0.2,0.8,0.4,1.0"/>
                                                                                <SplineDoubleKeyFrame KeyTime="0:0:0.50" Value="1.0" KeySpline="0.6,0.0,0.8,0.2"/>
                                                                                <SplineDoubleKeyFrame KeyTime="0:0:0.70" Value="1.03" KeySpline="0.2,0.8,0.4,1.0"/>
                                                                                <SplineDoubleKeyFrame KeyTime="0:0:0.90" Value="1.0" KeySpline="0.6,0.0,0.8,0.2"/>
                                                                                <LinearDoubleKeyFrame KeyTime="0:0:1.8" Value="1.0"/>
                                                                            </DoubleAnimationUsingKeyFrames>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </DataTrigger.EnterActions>
                                                                <DataTrigger.ExitActions>
                                                                    <StopStoryboard BeginStoryboardName="BoosterBumpStoryboard"/>
                                                                </DataTrigger.ExitActions>
                                                            </DataTrigger>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding AreAllDriversInstalled}" Value="True"/>
                                                                    <Condition Binding="{Binding Path=IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter TargetName="BoosterBtnBorder" Property="Background" Value="#E2FF4A"/>
                                                            </MultiDataTrigger>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding AreAllDriversInstalled}" Value="True"/>
                                                                    <Condition Binding="{Binding Path=IsPressed, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter TargetName="BoosterBtnBorder" Property="Background" Value="#B8E619"/>
                                                            </MultiDataTrigger>

                                                            <DataTrigger Binding="{Binding IsDownloadingDriverBooster}" Value="True">
                                                                <Setter TargetName="BoosterBtnBorder" Property="Background" Value="#17181C"/>
                                                                <Setter TargetName="BoosterBtnBorder" Property="BorderBrush" Value="#272930"/>
                                                                <Setter TargetName="BoosterBtnBorder" Property="BorderThickness" Value="1"/>
                                                                <Setter TargetName="BoosterBtnText" Property="Foreground" Value="#A1A1AA"/>
                                                                <Setter TargetName="BoosterBtnText" Property="FontWeight" Value="SemiBold"/>
                                                                <Setter Property="IsEnabled" Value="False"/>
                                                                <DataTrigger.EnterActions>
                                                                    <StopStoryboard BeginStoryboardName="BoosterBumpStoryboard"/>
                                                                </DataTrigger.EnterActions>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsDriverBoosterDownloaded}" Value="True">
                                                                <Setter TargetName="BoosterBtnBorder" Property="Background" Value="#FFFFFF"/>
                                                                <Setter TargetName="BoosterBtnBorder" Property="BorderThickness" Value="0"/>
                                                                <Setter TargetName="BoosterBtnText" Property="Foreground" Value="#000000"/>
                                                                <Setter TargetName="BoosterBtnText" Property="FontWeight" Value="SemiBold"/>
                                                                <DataTrigger.EnterActions>
                                                                    <StopStoryboard BeginStoryboardName="BoosterBumpStoryboard"/>
                                                                </DataTrigger.EnterActions>
                                                            </DataTrigger>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsDriverBoosterDownloaded}" Value="True"/>
                                                                    <Condition Binding="{Binding Path=IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter TargetName="BoosterBtnBorder" Property="Background" Value="#E5E5E5"/>
                                                            </MultiDataTrigger>
                                                            <DataTrigger Binding="{Binding IsDriverBoosterInstalled}" Value="True">
                                                                <Setter TargetName="BoosterBtnBorder" Property="Background" Value="#18191D"/>
                                                                <Setter TargetName="BoosterBtnBorder" Property="BorderBrush" Value="#25262C"/>
                                                                <Setter TargetName="BoosterBtnBorder" Property="BorderThickness" Value="1"/>
                                                                <Setter TargetName="BoosterBtnText" Property="Foreground" Value="#71717A"/>
                                                                <Setter TargetName="BoosterBtnText" Property="FontWeight" Value="SemiBold"/>
                                                                <Setter Property="IsEnabled" Value="False"/>
                                                                <DataTrigger.EnterActions>
                                                                    <StopStoryboard BeginStoryboardName="BoosterBumpStoryboard"/>
                                                                </DataTrigger.EnterActions>
                                                            </DataTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Border>



                        <!-- Drivers List -->

                        <ItemsControl ItemsSource="{Binding DriverItems}">

                            <ItemsControl.ItemTemplate>

                                <DataTemplate>
                                    <Border x:Name="CardBorder" Background="#17181C" BorderBrush="#272930" BorderThickness="1"
                                            CornerRadius="16" Padding="20,16" Margin="0,0,0,10"
                                            ClipToBounds="True">

                                        <Grid>
                                            <!-- 1. Real Driver Content -->
                                            <Grid x:Name="RealDriverContent" Visibility="Visible" RenderTransformOrigin="0.5,0.5">
                                                <Grid.RenderTransform>
                                                    <TranslateTransform x:Name="RealContentTrans" X="0" Y="0"/>
                                                </Grid.RenderTransform>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>



                                            <StackPanel>

                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">

                                                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"

                                                               Foreground="#F4F4F5" FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"/>

                                                </StackPanel>



                                                <Border Background="#202227" BorderBrush="#2C2F38" BorderThickness="1"
                                                        CornerRadius="7" Padding="8,3" Margin="0,0,0,8" HorizontalAlignment="Left"
                                                        ToolTip="{Binding CurrentSpec}">

                                                    <TextBlock Text="{Binding CurrentSpec}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="#D1FE29" FontFamily="Consolas, Segoe UI, monospace"
                                                               TextWrapping="NoWrap" MaxWidth="520"/>

                                                </Border>

                                                <TextBlock Text="{Binding Description}" FontSize="12" LineHeight="16"
                                                           Foreground="#8E8E93" TextWrapping="Wrap" Margin="0,0,0,4"/>

                                            </StackPanel>

                                            <!-- Driver Actions -->

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">

                                                <Button Command="{Binding SecondaryCommand}"
                                                        Content="{Binding SecondaryButtonText}"
                                                        Cursor="Hand" VerticalAlignment="Center"
                                                        Height="36" Padding="14,0" Margin="0,0,8,0" MinWidth="90"
                                                        FocusVisualStyle="{x:Null}">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="SecBtnBorder"
                                                                                Background="#202227"
                                                                                BorderBrush="#2C2F38"
                                                                                BorderThickness="1"
                                                                                CornerRadius="10"
                                                                                Padding="{TemplateBinding Padding}">
                                                                            <TextBlock Text="{TemplateBinding Content}"
                                                                                       FontSize="12" FontWeight="SemiBold"
                                                                                       FontFamily="pack://application:,,,/Fonts/#Poppins, Segoe UI Variable Display, Segoe UI, sans-serif"
                                                                                       Foreground="#D4D4D8"
                                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="SecBtnBorder" Property="Background" Value="#292C34"/>
                                                                                <Setter TargetName="SecBtnBorder" Property="BorderBrush" Value="#3D414E"/>
                                                                            </Trigger>
                                                                            <Trigger Property="IsPressed" Value="True">
                                                                                <Setter TargetName="SecBtnBorder" Property="Background" Value="#1A1B20"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>

                                                <Button Command="{Binding PrimaryCommand}"
                                                        Cursor="Hand" VerticalAlignment="Center"
                                                        Width="158" Height="36" FocusVisualStyle="{x:Null}">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="DriverBtnBorder"
                                                                                Background="#D1FE29"
                                                                                BorderBrush="Transparent"
                                                                                BorderThickness="0"
                                                                                CornerRadius="10"
                                                                                ClipToBounds="True"
                                                                                Width="158" Height="36">
                                                                            <Border.Clip>
                                                                                <RectangleGeometry RadiusX="10" RadiusY="10" Rect="0,0,158,36"/>
                                                                            </Border.Clip>
                                                                            <Grid>
                                                                                <!-- 1. Base downloading state: 3 bouncing black dots (#121410) on lime background -->
                                                                                <StackPanel x:Name="DlDotsLoader"
                                                                                            Orientation="Horizontal"
                                                                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                            Visibility="Collapsed">
                                                                                    <Border Width="6" Height="6" CornerRadius="3" Background="#121410" Margin="0,0,5,0">
                                                                                        <Border.RenderTransform>
                                                                                            <TranslateTransform x:Name="DlDot1" Y="0"/>
                                                                                        </Border.RenderTransform>
                                                                                    </Border>
                                                                                    <Border Width="6" Height="6" CornerRadius="3" Background="#121410" Margin="0,0,5,0">
                                                                                        <Border.RenderTransform>
                                                                                            <TranslateTransform x:Name="DlDot2" Y="0"/>
                                                                                        </Border.RenderTransform>
                                                                                    </Border>
                                                                                    <Border Width="6" Height="6" CornerRadius="3" Background="#121410">
                                                                                        <Border.RenderTransform>
                                                                                            <TranslateTransform x:Name="DlDot3" Y="0"/>
                                                                                        </Border.RenderTransform>
                                                                                    </Border>
                                                                                </StackPanel>

                                                                                <!-- 2. Black progress fill sweeping from Left to Right with inverted green dots -->
                                                                                <Border x:Name="DownloadFillBorder"
                                                                                        Background="#121410"
                                                                                        HorizontalAlignment="Left"
                                                                                        VerticalAlignment="Stretch"
                                                                                        Margin="-15,-2,0,-2"
                                                                                        Width="{Binding DownloadProgressFillWidth}"
                                                                                        CornerRadius="0,10,10,0"
                                                                                        ClipToBounds="True"
                                                                                        Visibility="Collapsed">
                                                                                    <Grid Width="158" HorizontalAlignment="Left" Margin="15,2,0,2">
                                                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                                            <Border Width="6" Height="6" CornerRadius="3" Background="#D1FE29" Margin="0,0,5,0">
                                                                                                <Border.RenderTransform>
                                                                                                    <TranslateTransform x:Name="DlDot1Invert" Y="0"/>
                                                                                                </Border.RenderTransform>
                                                                                            </Border>
                                                                                            <Border Width="6" Height="6" CornerRadius="3" Background="#D1FE29" Margin="0,0,5,0">
                                                                                                <Border.RenderTransform>
                                                                                                    <TranslateTransform x:Name="DlDot2Invert" Y="0"/>
                                                                                                </Border.RenderTransform>
                                                                                            </Border>
                                                                                            <Border Width="6" Height="6" CornerRadius="3" Background="#D1FE29">
                                                                                                <Border.RenderTransform>
                                                                                                    <TranslateTransform x:Name="DlDot3Invert" Y="0"/>
                                                                                                </Border.RenderTransform>
                                                                                            </Border>
                                                                                        </StackPanel>
                                                                                    </Grid>
                                                                                </Border>

                                                                                <!-- 3. Idle text ("Download", "Install", "Installed") -->
                                                                                <TextBlock x:Name="DriverBtnText"
                                                                                           Text="{Binding PrimaryButtonText, FallbackValue='Download'}"
                                                                                           FontSize="12.5" FontWeight="SemiBold"
                                                                                           FontFamily="pack://application:,,,/Fonts/#Poppins, Segoe UI Variable Display, Segoe UI, sans-serif"
                                                                                           Foreground="#121410"
                                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                                                                <!-- 4. Installing state: 3 bouncing green dots (#D1FE29) on black background -->
                                                                                <StackPanel x:Name="InstDotsLoader"
                                                                                            Orientation="Horizontal"
                                                                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                            Visibility="Collapsed">
                                                                                    <Border Width="6" Height="6" CornerRadius="3" Background="#D1FE29" Margin="0,0,5,0">
                                                                                        <Border.RenderTransform>
                                                                                            <TranslateTransform x:Name="InstDot1" Y="0"/>
                                                                                        </Border.RenderTransform>
                                                                                    </Border>
                                                                                    <Border Width="6" Height="6" CornerRadius="3" Background="#D1FE29" Margin="0,0,5,0">
                                                                                        <Border.RenderTransform>
                                                                                            <TranslateTransform x:Name="InstDot2" Y="0"/>
                                                                                        </Border.RenderTransform>
                                                                                    </Border>
                                                                                    <Border Width="6" Height="6" CornerRadius="3" Background="#D1FE29">
                                                                                        <Border.RenderTransform>
                                                                                            <TranslateTransform x:Name="InstDot3" Y="0"/>
                                                                                        </Border.RenderTransform>
                                                                                    </Border>
                                                                                </StackPanel>
                                                                            </Grid>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="DriverBtnBorder" Property="Background" Value="#E2FF4A"/>
                                                                            </Trigger>
                                                                            <Trigger Property="IsPressed" Value="True">
                                                                                <Setter TargetName="DriverBtnBorder" Property="Background" Value="#B8E619"/>
                                                                            </Trigger>

                                                                            <!-- Downloading state -->
                                                                            <DataTrigger Binding="{Binding IsDownloading}" Value="True">
                                                                                <Setter TargetName="DownloadFillBorder" Property="Visibility" Value="Visible"/>
                                                                                <Setter TargetName="DlDotsLoader" Property="Visibility" Value="Visible"/>
                                                                                <Setter TargetName="DriverBtnText" Property="Visibility" Value="Collapsed"/>
                                                                                <Setter TargetName="DriverBtnBorder" Property="Background" Value="#D1FE29"/>
                                                                                <Setter Property="IsEnabled" Value="False"/>
                                                                                <DataTrigger.EnterActions>
                                                                                    <BeginStoryboard x:Name="DlDotsStoryboard">
                                                                                        <Storyboard RepeatBehavior="Forever">
                                                                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="DlDot1" Storyboard.TargetProperty="Y" Duration="0:0:0.7">
                                                                                                <SplineDoubleKeyFrame KeyTime="0:0:0.00" Value="0"/>
                                                                                                <SplineDoubleKeyFrame KeyTime="0:0:0.18" Value="-6" KeySpline="0.25,0.1,0.25,1.0"/>
                                                                                                <SplineDoubleKeyFrame KeyTime="0:0:0.36" Value="0" KeySpline="0.25,0.1,0.25,1.0"/>
                                                                                                <SplineDoubleKeyFrame KeyTime="0:0:0.70" Value="0"/>
                                                                                            </DoubleAnimationUsingKeyFrames>
                                                                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="DlDot1Invert" Storyboard.TargetProperty="Y" Duration="0:0:0.7">
                                                                                                <SplineDoubleKeyFrame KeyTime="0:0:0.00" Value="0"/>
                                                                                                <SplineDoubleKeyFrame KeyTime="0:0:0.18" Value="-6" KeySpline="0.25,0.1,0.25,1.0"/>
                                                                                                <SplineDoubleKeyFrame KeyTime="0:0:0.36" Value="0" KeySpline="0.25,0.1,0.25,1.0"/>
                                                                                                <SplineDoubleKeyFrame KeyTime="0:0:0.70" Value="0"/>
                                                                                            </DoubleAnimationUsingKeyFrames>
                                                                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="DlDot2" Storyboard.TargetProperty="Y" Duration="0:0:0.7">
                                                                                                <SplineDoubleKeyFrame KeyTime="0:0:0.00" Value="0"/>
                                                                                                <SplineDoubleKeyFrame KeyTime="0:0:0.12" Value="0"/>
                                                                                                <SplineDoubleKeyFrame KeyTime="0:0:0.30" Value="-6" KeySpline="0.25,0.1,0.25,1.0"/>
                                                                                                <SplineDoubleKeyFrame KeyTime="0:0:0.48" Value="0" KeySpline="0.25,0.1,0.25,1.0"/>
                                                                                                <SplineDoubleKeyFrame KeyTime="0:0:0.70" Value="0"/>
                                                                                            </DoubleAnimationUsingKeyFrames>
                                                                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="DlDot2Invert" Storyboard.TargetProperty="Y" Duration="0:0:0.7">
                                                                                                <SplineDoubleKeyFrame KeyTime="0:0:0.00" Value="0"/>
                                                                                                <SplineDoubleKeyFrame KeyTime="0:0:0.12" Value="0"/>
                                                                                                <SplineDoubleKeyFrame KeyTime="0:0:0.30" Value="-6" KeySpline="0.25,0.1,0.25,1.0"/>
                                                                                                <SplineDoubleKeyFrame KeyTime="0:0:0.48" Value="0" KeySpline="0.25,0.1,0.25,1.0"/>
                                                                                                <SplineDoubleKeyFrame KeyTime="0:0:0.70" Value="0"/>
                                                                                            </DoubleAnimationUsingKeyFrames>
                                                                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="DlDot3" Storyboard.TargetProperty="Y" Duration="0:0:0.7">
                                                                                                <SplineDoubleKeyFrame KeyTime="0:0:0.00" Value="0"/>
                                                                                                <SplineDoubleKeyFrame KeyTime="0:0:0.24" Value="0"/>
                                                                                                <SplineDoubleKeyFrame KeyTime="0:0:0.42" Value="-6" KeySpline="0.25,0.1,0.25,1.0"/>
                                                                                                <SplineDoubleKeyFrame KeyTime="0:0:0.60" Value="0" KeySpline="0.25,0.1,0.25,1.0"/>
                                                                                                <SplineDoubleKeyFrame KeyTime="0:0:0.70" Value="0"/>
                                                                                            </DoubleAnimationUsingKeyFrames>
                                                                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="DlDot3Invert" Storyboard.TargetProperty="Y" Duration="0:0:0.7">
                                                                                                <SplineDoubleKeyFrame KeyTime="0:0:0.00" Value="0"/>
                                                                                                <SplineDoubleKeyFrame KeyTime="0:0:0.24" Value="0"/>
                                                                                                <SplineDoubleKeyFrame KeyTime="0:0:0.42" Value="-6" KeySpline="0.25,0.1,0.25,1.0"/>
                                                                                                <SplineDoubleKeyFrame KeyTime="0:0:0.60" Value="0" KeySpline="0.25,0.1,0.25,1.0"/>
