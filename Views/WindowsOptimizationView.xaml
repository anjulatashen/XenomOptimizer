                                                                                                <SplineDoubleKeyFrame KeyTime="0:0:0.12" Value="0"/>
                                                                                            <SplineDoubleKeyFrame KeyTime="0:0:0.30" Value="-6" KeySpline="0.25,0.1,0.25,1.0"/>
                                                                                            <SplineDoubleKeyFrame KeyTime="0:0:0.48" Value="0" KeySpline="0.25,0.1,0.25,1.0"/>
                                                                                            <SplineDoubleKeyFrame KeyTime="0:0:0.70" Value="0"/>
                                                                                            </DoubleAnimationUsingKeyFrames>
                                                                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="InstDot3" Storyboard.TargetProperty="Y" Duration="0:0:0.7">
                                                                                                <SplineDoubleKeyFrame KeyTime="0:0:0.00" Value="0"/>
                                                                                            <SplineDoubleKeyFrame KeyTime="0:0:0.24" Value="0"/>
                                                                                            <SplineDoubleKeyFrame KeyTime="0:0:0.42" Value="-6" KeySpline="0.25,0.1,0.25,1.0"/>
                                                                                            <SplineDoubleKeyFrame KeyTime="0:0:0.60" Value="0" KeySpline="0.25,0.1,0.25,1.0"/>
                                                                                            <SplineDoubleKeyFrame KeyTime="0:0:0.70" Value="0"/>
