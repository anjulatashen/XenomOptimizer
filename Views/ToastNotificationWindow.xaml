<Window x:Class="XenomOptimizer.Views.ToastNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notification"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        ResizeMode="NoResize"
        Width="382"
        SizeToContent="Height"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <!-- Close Button Style -->
        <Style x:Key="ToastCloseBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Width="22" Height="22">
                            <TextBlock Text="✕" Foreground="#656C80" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#25FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer transparent padding allows DropShadow to render with zero clipping -->
    <Border Background="Transparent" Padding="16">
        <Border x:Name="CardBorder"
                Background="#13161F"
                BorderBrush="#252B3A"
                BorderThickness="1"
                CornerRadius="12"
                Width="350"
                Cursor="Hand"
                MouseLeftButtonUp="CardBorder_MouseLeftButtonUp"
                MouseEnter="CardBorder_MouseEnter"
                MouseLeave="CardBorder_MouseLeave"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TransformGroup>
                    <TranslateTransform x:Name="CardTranslate" Y="0" />
                    <ScaleTransform x:Name="CardScale" ScaleX="1.0" ScaleY="1.0" />
                </TransformGroup>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="0" Color="#000000" Opacity="0.85" />
            </Border.Effect>

            <Grid Margin="13,11,13,11">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Xenom Logo Badge -->
                <Border Grid.Column="0"
                        Width="44"
                        Height="44"
                        Background="#191D28"
                        BorderBrush="#00E5FF33"
                        BorderThickness="1"
                        CornerRadius="10"
                        VerticalAlignment="Center">
                    <Grid>
                        <!-- Subtle cyan backlight glow -->
                        <Ellipse Width="32" Height="32" Fill="#00E5FF" Opacity="0.12">
                            <Ellipse.Effect>
                                <BlurEffect Radius="10" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <!-- Authentic Xenom Logo Image -->
                        <Image x:Name="ImgLogo"
                               Width="30"
                               Height="30"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>
                </Border>

                <!-- Center: Text Content -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,8,0">
                    <DockPanel LastChildFill="True">
                        <TextBlock x:Name="TxtTitle"
                                   Text="LAG Killer by XENOM"
                                   Foreground="#FFFFFF"
                                   FontFamily="Segoe UI"
                                   FontWeight="SemiBold"
                                   FontSize="12.5" />
                    </DockPanel>

                    <TextBlock x:Name="TxtMessage"
                               Text="Standby RAM purged! Freed 61 MB physical memory."
                               Foreground="#A5ACB9"
                               FontFamily="Segoe UI"
                               FontSize="11"
                               TextWrapping="Wrap"
                               LineHeight="15"
                               Margin="0,3,0,0" />
                </StackPanel>

                <!-- Right: Close Button -->
                <Button Grid.Column="2"
                        Style="{StaticResource ToastCloseBtnStyle}"
                        VerticalAlignment="Top"
                        Margin="0,-2,-3,0"
                        Click="BtnClose_Click" />
            </Grid>
        </Border>
    </Border>
</Window>
