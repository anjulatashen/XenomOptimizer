<UserControl x:Class="XenomOptimizer.Views.KeyMappingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:XenomOptimizer.Converters"
             xmlns:System="clr-namespace:System;assembly=mscorlib">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,0,24,32">
        <StackPanel MaxWidth="1200">

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- HEADER SECTION WITH STATUS BADGE                            -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <Grid Height="64" Margin="0,26,0,26">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="GameLoop KeyMapping Suite" FontSize="28" FontWeight="Bold"
                               Foreground="#FFFFFF" FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif" Margin="0,0,0,4"/>
                    <TextBlock Text="Smart resolution calibration, key rebinding &amp; mouse sensitivity engine for Global (64/32-bit) &amp; Chinese GameLoop"
                               Foreground="#9E9EA4" FontSize="13" FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"/>
                </StackPanel>

                <!-- Status Pill on Right -->
                <Border Grid.Column="1" Background="#11141E" BorderBrush="#202738" BorderThickness="1" CornerRadius="16" Padding="14,8" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Margin="0,0,8,0" Fill="#10B981"/>
                        <TextBlock Text="{Binding DetectedEditionText}" FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- TOP CONFIGURATION CARDS: 2 COLUMNS                          -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Column 0: GameLoop Edition & Resolution Mode -->
                <Border Grid.Column="0" Background="#0C0E14" BorderBrush="#1E2333" BorderThickness="1" CornerRadius="16" Padding="20">
                    <StackPanel>
                        <!-- Edition Selection -->
                        <TextBlock Text="GameLoop Edition" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,4"/>
                        <TextBlock Text="Select target GameLoop installation format" FontSize="11" Foreground="#64748B" Margin="0,0,0,12"/>
                        
                        <UniformGrid Rows="1" Columns="3" Margin="0,0,0,20">
                            <!-- Global 64-bit -->
                            <Button Command="{Binding SelectEditionCommand}" CommandParameter="0" Height="36" Margin="0,0,4,0" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#131722"/>
                                        <Setter Property="BorderBrush" Value="#1E2538"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="EdBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                                                        <TextBlock x:Name="EdText" Text="Global 64-bit" FontSize="11.5" FontWeight="SemiBold" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedEditionIndex}" Value="0">
                                                            <Setter TargetName="EdBorder" Property="Background" Value="#1C2E4A"/>
                                                            <Setter TargetName="EdBorder" Property="BorderBrush" Value="#38BDF8"/>
                                                            <Setter TargetName="EdText" Property="Foreground" Value="#38BDF8"/>
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Global 32-bit -->
                            <Button Command="{Binding SelectEditionCommand}" CommandParameter="1" Height="36" Margin="2,0,2,0" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#131722"/>
                                        <Setter Property="BorderBrush" Value="#1E2538"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="EdBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                                                        <TextBlock x:Name="EdText" Text="Global 32-bit" FontSize="11.5" FontWeight="SemiBold" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedEditionIndex}" Value="1">
                                                            <Setter TargetName="EdBorder" Property="Background" Value="#1C2E4A"/>
                                                            <Setter TargetName="EdBorder" Property="BorderBrush" Value="#38BDF8"/>
                                                            <Setter TargetName="EdText" Property="Foreground" Value="#38BDF8"/>
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Chinese -->
                            <Button Command="{Binding SelectEditionCommand}" CommandParameter="2" Height="36" Margin="4,0,0,0" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#131722"/>
                                        <Setter Property="BorderBrush" Value="#1E2538"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="EdBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                                                        <TextBlock x:Name="EdText" Text="Chinese (腾讯)" FontSize="11.5" FontWeight="SemiBold" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedEditionIndex}" Value="2">
                                                            <Setter TargetName="EdBorder" Property="Background" Value="#1C2E4A"/>
                                                            <Setter TargetName="EdBorder" Property="BorderBrush" Value="#38BDF8"/>
                                                            <Setter TargetName="EdText" Property="Foreground" Value="#38BDF8"/>
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </UniformGrid>

                        <!-- KeyMapping Mode Selector -->
                        <TextBlock Text="KeyMapping Mode (Resolution Calibration)" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,4"/>
                        <TextBlock Text="Align coordinate precision to emulator rendering resolution" FontSize="11" Foreground="#64748B" Margin="0,0,0,12"/>

                        <UniformGrid Rows="2" Columns="2">
                            <!-- Normal 720P -->
                            <Button Command="{Binding SwitchKeyMapModeCommand}" CommandParameter="1" Height="46" Margin="0,0,4,8" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#131722"/>
                                        <Setter Property="BorderBrush" Value="#1E2538"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="ModeBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="12,0">
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock x:Name="ModeTitle" Text="Normal 720P" FontSize="12" FontWeight="Bold" Foreground="#94A3B8"/>
                                                            <TextBlock Text="Static standard layout" FontSize="9.5" Foreground="#64748B"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedKeyMapModeId}" Value="1">
                                                            <Setter TargetName="ModeBorder" Property="Background" Value="#132B25"/>
                                                            <Setter TargetName="ModeBorder" Property="BorderBrush" Value="#10B981"/>
                                                            <Setter TargetName="ModeTitle" Property="Foreground" Value="#10B981"/>
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Smart 720P -->
                            <Button Command="{Binding SwitchKeyMapModeCommand}" CommandParameter="2" Height="46" Margin="4,0,0,8" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#131722"/>
                                        <Setter Property="BorderBrush" Value="#1E2538"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="ModeBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="12,0">
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock x:Name="ModeTitle" Text="Smart 720P" FontSize="12" FontWeight="Bold" Foreground="#94A3B8"/>
                                                            <TextBlock Text="Dynamic smart looting" FontSize="9.5" Foreground="#64748B"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedKeyMapModeId}" Value="2">
                                                            <Setter TargetName="ModeBorder" Property="Background" Value="#132B25"/>
                                                            <Setter TargetName="ModeBorder" Property="BorderBrush" Value="#10B981"/>
                                                            <Setter TargetName="ModeTitle" Property="Foreground" Value="#10B981"/>
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Smart 1080P -->
                            <Button Command="{Binding SwitchKeyMapModeCommand}" CommandParameter="3" Height="46" Margin="0,0,4,0" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#131722"/>
                                        <Setter Property="BorderBrush" Value="#1E2538"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="ModeBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="12,0">
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock x:Name="ModeTitle" Text="Smart 1080P" FontSize="12" FontWeight="Bold" Foreground="#94A3B8"/>
                                                            <TextBlock Text="Full HD calibrated" FontSize="9.5" Foreground="#64748B"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedKeyMapModeId}" Value="3">
                                                            <Setter TargetName="ModeBorder" Property="Background" Value="#132B25"/>
                                                            <Setter TargetName="ModeBorder" Property="BorderBrush" Value="#10B981"/>
                                                            <Setter TargetName="ModeTitle" Property="Foreground" Value="#10B981"/>
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Smart 2K -->
                            <Button Command="{Binding SwitchKeyMapModeCommand}" CommandParameter="4" Height="46" Margin="4,0,0,0" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#131722"/>
                                        <Setter Property="BorderBrush" Value="#1E2538"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="ModeBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="12,0">
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock x:Name="ModeTitle" Text="Smart 2K" FontSize="12" FontWeight="Bold" Foreground="#94A3B8"/>
                                                            <TextBlock Text="Ultra HD 1440P high-DPI" FontSize="9.5" Foreground="#64748B"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedKeyMapModeId}" Value="4">
                                                            <Setter TargetName="ModeBorder" Property="Background" Value="#132B25"/>
                                                            <Setter TargetName="ModeBorder" Property="BorderBrush" Value="#10B981"/>
                                                            <Setter TargetName="ModeTitle" Property="Foreground" Value="#10B981"/>
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- Column 2: Secondary Settings & Mouse Settings -->
                <Border Grid.Column="2" Background="#0C0E14" BorderBrush="#1E2333" BorderThickness="1" CornerRadius="16" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Secondary Settings &amp; Mouse Engine" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,4"/>
                        <TextBlock Text="Overlay reminders, auto mode detection and mouse sensitivity" FontSize="11" Foreground="#64748B" Margin="0,0,0,14"/>

                        <!-- Checkbox 1: Display Key Mapping Tips (F1) -->
                        <CheckBox IsChecked="{Binding EnableKeyTips}" Margin="0,0,0,10" Cursor="Hand">
                            <TextBlock Text="Display key mapping tips (F1)" FontSize="12" Foreground="#CBD5E1"/>
                        </CheckBox>

                        <!-- Checkbox 2: Auto Switch Mode Based on Screen Res -->
                        <CheckBox IsChecked="{Binding AutoSwitchResolution}" Margin="0,0,0,10" Cursor="Hand">
                            <TextBlock Text="Auto switch mode based on screen resolution" FontSize="12" Foreground="#CBD5E1"/>
                        </CheckBox>

                        <!-- Checkbox 3: Hold Shift to Run -->
                        <CheckBox IsChecked="{Binding HoldShiftToRun}" Margin="0,0,0,14" Cursor="Hand">
                            <TextBlock Text="Hold Shift to run (Instant sprint toggle)" FontSize="12" Foreground="#CBD5E1"/>
                        </CheckBox>

                        <!-- Brightness Slider -->
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Tips Overlay Brightness" FontSize="11" Foreground="#94A3B8"/>
                            <TextBlock Text="{Binding KeyTipsBrightness, StringFormat={}{0:F0}%}" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Right"/>
                        </Grid>
                        <Slider Minimum="0" Maximum="100" Value="{Binding KeyTipsBrightness}" Margin="0,0,0,12" Height="20"/>

                        <!-- Horizontal Sensitivity -->
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Horizontal Mouse Sensitivity" FontSize="11" Foreground="#94A3B8"/>
                            <TextBlock Text="{Binding HorizontalSensitivity, StringFormat={}{0:F0}%}" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Right"/>
                        </Grid>
                        <Slider Minimum="10" Maximum="200" Value="{Binding HorizontalSensitivity}" Margin="0,0,0,12" Height="20"/>

                        <!-- Vertical Sensitivity -->
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Vertical Mouse Sensitivity" FontSize="11" Foreground="#94A3B8"/>
                            <TextBlock Text="{Binding VerticalSensitivity, StringFormat={}{0:F0}%}" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Right"/>
                        </Grid>
                        <Slider Minimum="10" Maximum="200" Value="{Binding VerticalSensitivity}" Height="20"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- KEY REBINDING SECTION                                       -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <Border Background="#0C0E14" BorderBrush="#1E2333" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <!-- Header with Category Filter Pills -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Interactive Key Controls" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC"/>
                            <TextBlock Text="Click any key badge below to rebind directly from your keyboard or mouse buttons" FontSize="11" Foreground="#64748B"/>
                        </StackPanel>

                        <!-- Category Filter Pills -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Command="{Binding FilterKeyCategoryCommand}" CommandParameter="All" Content="All Keys" Height="28" Padding="12,0" Margin="0,0,4,0" Cursor="Hand" Style="{StaticResource SecondaryButton}"/>
                            <Button Command="{Binding FilterKeyCategoryCommand}" CommandParameter="Movement" Content="🏃 Movement" Height="28" Padding="12,0" Margin="0,0,4,0" Cursor="Hand" Style="{StaticResource SecondaryButton}"/>
                            <Button Command="{Binding FilterKeyCategoryCommand}" CommandParameter="Combat" Content="🎯 Combat" Height="28" Padding="12,0" Margin="0,0,4,0" Cursor="Hand" Style="{StaticResource SecondaryButton}"/>
                            <Button Command="{Binding FilterKeyCategoryCommand}" CommandParameter="Grenades &amp; Meds" Content="💣 Grenades &amp; Meds" Height="28" Padding="12,0" Margin="0,0,4,0" Cursor="Hand" Style="{StaticResource SecondaryButton}"/>
                            <Button Command="{Binding FilterKeyCategoryCommand}" CommandParameter="Interaction" Content="🚗 Interaction" Height="28" Padding="12,0" Cursor="Hand" Style="{StaticResource SecondaryButton}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Rebind Listening Banner (Shows when waiting for a key press) -->
                    <Border Background="#1C2E4A" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,0,16"
                            Visibility="{Binding ListeningKeyItem, Converter={StaticResource NotNullToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="⌨️ LISTENING FOR REBIND:" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding ListeningKeyItem.DisplayName}" FontSize="12" FontWeight="Bold" Foreground="#F8FAFC"/>
                                </StackPanel>
                                <TextBlock Text="Press any key on your keyboard now, or click one of the quick mouse buttons on the right:" FontSize="11" Foreground="#94A3B8"/>
                            </StackPanel>

                            <!-- Mouse Shortcut Rebind Pills -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Command="{Binding ApplyMouseRebindCommand}" CommandParameter="Left Click" Content="Left Click" Height="30" Padding="10,0" Margin="0,0,6,0" Cursor="Hand" Style="{StaticResource SecondaryButton}"/>
                                <Button Command="{Binding ApplyMouseRebindCommand}" CommandParameter="Right Click" Content="Right Click" Height="30" Padding="10,0" Margin="0,0,6,0" Cursor="Hand" Style="{StaticResource SecondaryButton}"/>
                                <Button Command="{Binding ApplyMouseRebindCommand}" CommandParameter="Middle Click" Content="Middle Click" Height="30" Padding="10,0" Margin="0,0,6,0" Cursor="Hand" Style="{StaticResource SecondaryButton}"/>
                                <Button Command="{Binding CancelRebindKeyCommand}" Content="Cancel" Height="30" Padding="12,0" Cursor="Hand" Background="#331A1D" Foreground="#F87171" BorderBrush="#7F1D1D" BorderThickness="1"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Key Item Cards (2 Columns) -->
                    <ItemsControl ItemsSource="{Binding DisplayedKeyItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#10131B" BorderBrush="#1C2333" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="4,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Key Name & Category -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold" Foreground="#F1F5F9" Margin="0,0,8,0"/>
                                                <Border Background="#161B26" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Category}" FontSize="9" Foreground="#64748B"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" FontSize="10" Foreground="#64748B" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- Interactive Key Badge Button -->
                                        <Button Grid.Column="1" Command="{Binding DataContext.StartRebindKeyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                MinWidth="48" Height="32" Padding="10,0" Cursor="Hand">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="#171D2A"/>
                                                    <Setter Property="BorderBrush" Value="#2A354D"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="KeyCap" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                                                    <TextBlock x:Name="KeyText" Text="{Binding CurrentKey}" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <DataTrigger Binding="{Binding IsListeningForRebind}" Value="True">
                                                                        <Setter TargetName="KeyCap" Property="Background" Value="#1E3A8A"/>
                                                                        <Setter TargetName="KeyCap" Property="BorderBrush" Value="#60A5FA"/>
                                                                        <Setter TargetName="KeyText" Property="Text" Value="[ PRESS ]"/>
                                                                        <Setter TargetName="KeyText" Property="Foreground" Value="#FDE047"/>
                                                                    </DataTrigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- ACTION FOOTER: RESET DEFAULTS & SAVE TO GAMELOOP            -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <Border Background="#0C0E14" BorderBrush="#1E2333" BorderThickness="1" CornerRadius="16" Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Status Message -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding KeyMappingStatusMessage}" FontSize="12.5" FontWeight="SemiBold" Foreground="#10B981" Visibility="{Binding KeyMappingStatusMessage, Converter={StaticResource StringToVis}}"/>
                    </StackPanel>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding ResetKeyMappingDefaultsCommand}" Style="{StaticResource SecondaryButton}" Height="40" Padding="18,0" Margin="0,0,12,0" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔄" FontSize="12" Margin="0,0,8,0"/>
                                <TextBlock Text="Reset Defaults" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding SaveKeyMappingCommand}" Style="{StaticResource PrimaryButton}" Height="40" Padding="24,0" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💾" FontSize="12" Margin="0,0,8,0"/>
                                <TextBlock Text="Apply &amp; Save KeyMapping" FontSize="13" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
