<UserControl x:Class="XenomOptimizer.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,24">
        <StackPanel MaxWidth="800">
            <TextBlock Text="Settings" FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
            <TextBlock Text="Application configuration"
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,24"/>

            <TextBlock Text="{Binding StatusMessage}" FontSize="12"
                       Foreground="{StaticResource AccentGreenBrush}" Margin="0,0,0,12"
                       Visibility="{Binding StatusMessage, Converter={StaticResource StringToVis}}"/>

            <!-- General Settings -->
            <TextBlock Text="GENERAL" FontSize="11" FontWeight="SemiBold"
                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12"/>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <CheckBox Content="Minimize to system tray"
                              IsChecked="{Binding MinimizeToTray}" Margin="0,0,0,12"/>

                    <CheckBox Content="Automatic backup before every optimization (Recommended)"
                              IsChecked="{Binding AutoBackup}" Margin="0,0,0,12"/>
                </StackPanel>
            </Border>

            <!-- Appearance -->
            <TextBlock Text="APPEARANCE" FontSize="11" FontWeight="SemiBold"
                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12"/>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Theme" Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Dark (Default)" FontSize="13"
                                   Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Accent Color" Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Cyan" FontSize="13"
                                   Foreground="{StaticResource AccentCyanBrush}" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Directories -->
            <TextBlock Text="DATA DIRECTORIES" FontSize="11" FontWeight="SemiBold"
                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12"/>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Log Directory" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                            <TextBlock Text="{Binding LogDirectory}" FontSize="11"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                                Content="Open" Command="{Binding OpenLogFolderCommand}" Padding="12,6"
                                VerticalAlignment="Center"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Backup Directory" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                            <TextBlock Text="{Binding BackupDirectory}" FontSize="11"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                                Content="Open" Command="{Binding OpenBackupFolderCommand}" Padding="12,6"
                                VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Save -->
            <Button Style="{StaticResource PrimaryButton}" Content="💾 Save Settings"
                    Command="{Binding SaveSettingsCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/>

            <!-- Version info -->
            <Border Style="{StaticResource CardBorder}" Margin="0,24,0,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock FontSize="14" FontWeight="Bold" HorizontalAlignment="Center">
                        <Run Text="LAG Killer by " Foreground="{StaticResource TextPrimaryBrush}"/>
                        <Run Text="XENOM" Foreground="{StaticResource AccentElectricBlueBrush}" FontWeight="ExtraBold"/>
                    </TextBlock>
                    <TextBlock Text="Version 1.0.0" FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
