<UserControl x:Class="XenomOptimizer.Views.RegistryOptimizationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:XenomOptimizer.ViewModels"
             xmlns:conv="clr-namespace:XenomOptimizer.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:RegistryOptimizationViewModel}"
             Background="#0B0C10">

    <Grid Background="Transparent">
        <!-- ── 1. SCROLLABLE CONTENT (NATURAL SCROLLING MATCHING ADVANCE TAB) ── -->
        <ScrollViewer x:Name="MainContentScrollViewer"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="28,0,28,85"
                      SnapsToDevicePixels="True" UseLayoutRounding="True">
            <ScrollViewer.Resources>
                <!-- Isolated Original ScrollBar matching Driver Hub & Advance Tab -->
                <Style TargetType="ScrollBar">
                    <Setter Property="conv:ScrollBarAutoHideHelper.AutoHide" Value="True"/>
                    <Setter Property="SnapsToDevicePixels" Value="True"/>
                    <Setter Property="OverridesDefaultStyle" Value="True"/>
                    <Setter Property="Width" Value="12"/>
                    <Setter Property="Margin" Value="0,0,6,0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource VerticalScrollBarThumbStyle}"/>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ScrollViewer.Resources>
            <ScrollViewer.OpacityMask>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FFFFFFFF" Offset="0.0"/>
                    <GradientStop Color="#FFFFFFFF" Offset="0.88"/>
                    <GradientStop Color="#D5FFFFFF" Offset="0.93"/>
                    <GradientStop Color="#80FFFFFF" Offset="0.965"/>
                    <GradientStop Color="#00FFFFFF" Offset="1.0"/>
                </LinearGradientBrush>
            </ScrollViewer.OpacityMask>

            <StackPanel MaxWidth="1100">

                <!-- ═══════════════════════════════════════════════════════════ -->
                <!-- 1. TOP HEADER SECTION (Title, Status Badge, Quick Actions)   -->
                <!-- ═══════════════════════════════════════════════════════════ -->
                <Grid Height="64" Margin="0,26,0,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Title & Subtitle -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="GameLoop Installer &amp; Uninstaller" FontSize="26" FontWeight="Bold" Foreground="#FFFFFF"
                                   FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif" Margin="0,0,0,4"/>
                        <TextBlock Text="Official multi-version GameLoop installer hub &amp; 7-step nuclear uninstaller with residual cache purge"
                                   FontSize="12.5" Foreground="#9E9EA4"
                                   FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"/>
                    </StackPanel>

                    <!-- Right: Status Pill & Actions -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Status Badge -->
                        <Border Background="#121216" BorderBrush="#202128" BorderThickness="1" CornerRadius="16" Padding="14,7" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Margin="0,0,8,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#10B981"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsGameLoopInstalled}" Value="False">
                                                    <Setter Property="Fill" Value="#EF4444"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="GameLoop: Ready" FontSize="11.5" FontWeight="SemiBold" Foreground="#F8FAFC">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsGameLoopInstalled}" Value="False">
                                                    <Setter Property="Text" Value="GameLoop: Not Found"/>
                                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Close Emulator Pill Button -->
                        <Button Command="{Binding SafeCloseGameLoopCommand}" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="b" Background="#181A22" BorderBrush="#262A38" BorderThickness="1" CornerRadius="16" Padding="14,7">
                                        <TextBlock Text="✕ Close GameLoop" FontSize="11.5" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="#252A38"/>
                                            <Setter TargetName="b" Property="BorderBrush" Value="#EF4444"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Status Banner (if any) -->
                <Border Background="#141824" BorderBrush="#252E45" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,0,18"
                        Visibility="{Binding StatusMessage, Converter={StaticResource StringToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="ℹ" FontSize="13" Foreground="#38BDF8" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#E2E8F0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- ═══════════════════════════════════════════════════════════ -->
                <!-- SLIDE: GAMELOOP UNINSTALLER (STEP 1 & STEP 2)               -->
                <!-- ═══════════════════════════════════════════════════════════ -->
                <StackPanel Visibility="{Binding IsUninstallerVisible, Converter={StaticResource BoolToVis}}">

                    <!-- UNINSTALLER HEADER BANNER -->
                    <Border Background="#161215" BorderBrush="#351B22" BorderThickness="1" CornerRadius="14" Padding="18,14" Margin="0,0,0,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10" Background="#261215" BorderBrush="#EF4444" BorderThickness="1" Margin="0,0,14,0" VerticalAlignment="Center">
                                <TextBlock Text="🗑️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <TextBlock Text="GameLoop Uninstaller Suite" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    <Border Background="#2B1418" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="6" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="CLEAN REMOVAL" FontSize="9.5" FontWeight="Bold" Foreground="#EF4444"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Perform a 2-stage uninstallation: launch Tencent's official uninstaller wizard followed by a deep nuclear wipe of locked registry hives, drivers, and temp data."
                                           FontSize="11.5" Foreground="#94A3B8" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- CARD 1: OFFICIAL GAMELOOP UNINSTALLER (STEP 1) -->
                    <Border Background="#121216" BorderBrush="#261A1E" BorderThickness="1.2" CornerRadius="18" Padding="24,20" Margin="0,0,0,18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Top Row: Icon, Titles, Step Badge -->
                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="46" Height="46" CornerRadius="12" Background="#261215" BorderBrush="#EF4444" BorderThickness="1" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Text="🗑️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                        <TextBlock Text="Step 1 — Official GameLoop Uninstaller" FontSize="17" FontWeight="Bold" Foreground="#FFFFFF"/>
                                        <Border Background="#2B1418" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="UNINSTALL WIZARD" FontSize="10" FontWeight="Bold" Foreground="#EF4444"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Launch the official Tencent uninstaller (TUninstall.exe) to cleanly remove emulator components and games."
                                               FontSize="12" Foreground="#8E95A5"/>
                                </StackPanel>
                            </Grid>

                            <!-- Divider -->
                            <Border Grid.Row="1" Height="1" Background="#1E1C22" Margin="0,0,0,14"/>

                            <!-- Details / Explanations -->
                            <Grid Grid.Row="2" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="#16171E" BorderBrush="#222430" BorderThickness="1" CornerRadius="10" Padding="14,10">
                                    <StackPanel>
                                        <TextBlock Text="🔍 Smart Auto-Detection" FontSize="11.5" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,3"/>
                                        <TextBlock Text="Scans Windows Registry and all fixed drives (C:, D:, E:) to locate the official uninstaller executable and launches it with full administrative permissions." FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Background="#16171E" BorderBrush="#222430" BorderThickness="1" CornerRadius="10" Padding="14,10">
                                    <StackPanel>
                                        <TextBlock Text="🛡️ Safe Package Deregistration" FontSize="11.5" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,3"/>
                                        <TextBlock Text="Allows Tencent's official uninstaller to unregister all emulator drivers and components properly before executing the deep nuclear wipe in Step 2." FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Action Button & Status -->
                            <Grid Grid.Row="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding UninstallStatusText}" FontSize="11.5" Foreground="#EF4444" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                </StackPanel>

                                <Button Grid.Column="1" Command="{Binding UninstallGameLoopCommand}" Cursor="Hand" Height="40">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="BtnU" Background="#261215" BorderBrush="#EF4444" BorderThickness="1.2" CornerRadius="8" Padding="22,0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="🗑️" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Uninstall GameLoop" FontSize="12.5" FontWeight="Bold" Foreground="#EF4444" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="BtnU" Property="Background" Value="#38151A"/>
                                                    <Setter TargetName="BtnU" Property="BorderBrush" Value="#F87171"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- CARD 2: 7-STEP NUCLEAR CACHE, REGISTRY & TEMP WIPER (STEP 2) -->
                    <Border Background="#121216" BorderBrush="#251A36" BorderThickness="1.2" CornerRadius="18" Padding="24,20" Margin="0,0,0,18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Top Row: Icon, Titles, Step Badge -->
                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="46" Height="46" CornerRadius="12" Background="#201533" BorderBrush="#8B5CF6" BorderThickness="1" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Text="🧹" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                        <TextBlock Text="Step 2 — Nuclear Clean (Registry, Cache &amp; Temp Wiper)" FontSize="17" FontWeight="Bold" Foreground="#FFFFFF"/>
                                        <Border Background="#251640" BorderBrush="#8B5CF6" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="DEEP SYSTEM WIPE" FontSize="10" FontWeight="Bold" Foreground="#A78BFA"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Completely purges all residual Tencent cache files, locked registry hives, drivers, and temp data across all drives."
                                               FontSize="12" Foreground="#8E95A5"/>
                                </StackPanel>
                            </Grid>

                            <!-- Divider -->
                            <Border Grid.Row="1" Height="1" Background="#1E1C22" Margin="0,0,0,14"/>

                            <!-- 7-Step Sequence Grid -->
                            <UniformGrid Grid.Row="2" Columns="2" Rows="4" Margin="0,0,0,16">
                                <Border Background="#16171E" BorderBrush="#222430" BorderThickness="1" CornerRadius="8" Padding="12,7" Margin="0,0,6,6">
                                    <TextBlock Text="1️⃣ Terminate all Tencent &amp; ADB processes" FontSize="11" Foreground="#E2E8F0"/>
                                </Border>
                                <Border Background="#16171E" BorderBrush="#222430" BorderThickness="1" CornerRadius="8" Padding="12,7" Margin="6,0,0,6">
                                    <TextBlock Text="2️⃣ Delete QMEmulatorService &amp; aow_drv drivers" FontSize="11" Foreground="#E2E8F0"/>
                                </Border>
                                <Border Background="#16171E" BorderBrush="#222430" BorderThickness="1" CornerRadius="8" Padding="12,7" Margin="0,0,6,6">
                                    <TextBlock Text="3️⃣ Unload locked QMConfig registry hives" FontSize="11" Foreground="#E2E8F0"/>
                                </Border>
                                <Border Background="#16171E" BorderBrush="#222430" BorderThickness="1" CornerRadius="8" Padding="12,7" Margin="6,0,0,6">
                                    <TextBlock Text="4️⃣ Delete HKCU &amp; HKLM Tencent registry trees" FontSize="11" Foreground="#E2E8F0"/>
                                </Border>
                                <Border Background="#16171E" BorderBrush="#222430" BorderThickness="1" CornerRadius="8" Padding="12,7" Margin="0,0,6,6">
                                    <TextBlock Text="5️⃣ Delete TxGameAssistant on all drives (C:, D:, E:)" FontSize="11" Foreground="#E2E8F0"/>
                                </Border>
                                <Border Background="#16171E" BorderBrush="#222430" BorderThickness="1" CornerRadius="8" Padding="12,7" Margin="6,0,0,6">
                                    <TextBlock Text="6️⃣ Clear AppData, LocalAppData &amp; ProgramData" FontSize="11" Foreground="#E2E8F0"/>
                                </Border>
                                <Border Background="#16171E" BorderBrush="#222430" BorderThickness="1" CornerRadius="8" Padding="12,7" Margin="0,0,6,0">
                                    <TextBlock Text="7️⃣ Flush TxGameDownload &amp; DirectX Shader caches" FontSize="11" Foreground="#E2E8F0"/>
                                </Border>
                                <Border Background="#16171E" BorderBrush="#222430" BorderThickness="1" CornerRadius="8" Padding="12,7" Margin="6,0,0,0">
                                    <TextBlock Text="✨ Remove all Desktop &amp; Start Menu shortcuts" FontSize="11" Foreground="#E2E8F0"/>
                                </Border>
                            </UniformGrid>

                            <!-- Action Button & Status -->
                            <Grid Grid.Row="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding CleanerStatusText}" FontSize="11.5" Foreground="#38BDF8" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                </StackPanel>

                                <Button Grid.Column="1" Command="{Binding NuclearCleanCommand}" Cursor="Hand" Height="42">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="BtnN" Background="#201533" BorderBrush="#8B5CF6" BorderThickness="1.2" CornerRadius="8" Padding="24,0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="🧹" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Nuclear Clean (Registry, Cache &amp; Temp)" FontSize="12.5" FontWeight="Bold" Foreground="#A78BFA" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="BtnN" Property="Background" Value="#301B52"/>
                                                    <Setter TargetName="BtnN" Property="BorderBrush" Value="#A78BFA"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- CARD 3: QUICK MAINTENANCE -->
                    <Border Background="#121216" BorderBrush="#202128" BorderThickness="1" CornerRadius="16" Padding="20,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="⚡ Quick Maintenance Utilities" FontSize="14.5" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,2"/>
                                <TextBlock Text="Terminate background telemetry processes or flush compiled DirectX/OpenGL shaders without running a full wipe." FontSize="11.5" Foreground="#8E95A5"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Command="{Binding KillTelemetryCommand}" Cursor="Hand" Height="36" Margin="0,0,10,0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="b1" Background="#171822" BorderBrush="#282A3A" BorderThickness="1" CornerRadius="8" Padding="16,0">
                                                <TextBlock Text="Kill Telemetry" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b1" Property="Background" Value="#252838"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button Command="{Binding PurgeShaderCacheCommand}" Cursor="Hand" Height="36">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="b2" Background="#171822" BorderBrush="#282A3A" BorderThickness="1" CornerRadius="8" Padding="16,0">
                                                <TextBlock Text="Purge Shader Cache" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b2" Property="Background" Value="#252838"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                </StackPanel>

                <!-- ═══════════════════════════════════════════════════════════ -->
                <!-- SLIDE: GAMELOOP MULTI-VERSION INSTALLER HUB (PAGE B)        -->
                <!-- ═══════════════════════════════════════════════════════════ -->
                <StackPanel Visibility="{Binding IsInstallerVisible, Converter={StaticResource BoolToVis}}">

                    <!-- INSTALLER BANNER -->
                    <Border Background="#0C1420" BorderBrush="#1B2E48" BorderThickness="1" CornerRadius="14" Padding="18,14" Margin="0,0,0,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10" Background="#13273E" BorderBrush="#38BDF8" BorderThickness="1" Margin="0,0,14,0" VerticalAlignment="Center">
                                <TextBlock Text="⬇" FontSize="20" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <TextBlock Text="Official GameLoop Multi-Version Installer Hub" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    <Border Background="#16382F" BorderBrush="#34D399" BorderThickness="1" CornerRadius="6" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="DIRECT FAST CDN" FontSize="9.5" FontWeight="Bold" Foreground="#34D399"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Download verified GameLoop builds directly from official Tencent global and domestic distribution networks with no third-party adware."
                                           FontSize="11.5" Foreground="#94A3B8" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- CARD 1: GAMELOOP GLOBAL (INTERNATIONAL EDITION) -->
                    <Border Background="#12141C" BorderBrush="#1F283A" BorderThickness="1.2" CornerRadius="18" Padding="24,20" Margin="0,0,0,18">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12" Background="#172236" BorderBrush="#38BDF8" BorderThickness="1" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <TextBlock Text="🌐" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                        <TextBlock Text="GameLoop Global (International Edition)" FontSize="16.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                        <Border Background="#1A2D45" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="WORLDWIDE OFFICIAL" FontSize="10" FontWeight="Bold" Foreground="#38BDF8"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Official worldwide release supporting English/multilingual UI, Google Play Services, and PUBG Mobile Global/KR/VN."
                                               FontSize="11.5" Foreground="#8E95A5"/>
                                </StackPanel>
                            </Grid>

                            <Border Height="1" Background="#1D2434" Margin="0,0,0,16"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Global 32-Bit -->
                                <Border Grid.Column="0" Background="#161822" BorderBrush="#252A3C" BorderThickness="1" CornerRadius="12" Padding="18,16">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="32-Bit Standard" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
