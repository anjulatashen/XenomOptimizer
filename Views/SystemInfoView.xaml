<UserControl x:Class="XenomOptimizer.Views.SystemInfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,24">
        <StackPanel MaxWidth="1100">
            <TextBlock Text="System Information" FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
            <TextBlock Text="System diagnostic check — factual information about your hardware and software"
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,24"/>

            <TextBlock Text="⏳ Running diagnostics..." Foreground="{StaticResource TextMutedBrush}"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>

            <ItemsControl ItemsSource="{Binding Checks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{Binding Icon}" FontSize="20" VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding Label}" FontSize="12"
                                               Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding Value}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Note}" FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Visibility="{Binding Note, Converter={StaticResource StringToVis}}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Status Badge (Image 2 style) -->
                                <Border Grid.Column="2" CornerRadius="6" Padding="10,4"
                                        BorderThickness="1"
                                        VerticalAlignment="Center">
                                    <Border.BorderBrush>
                                        <SolidColorBrush Color="{Binding StatusColor}" Opacity="0.35"/>
                                    </Border.BorderBrush>
                                    <Border.Background>
                                        <SolidColorBrush Color="{Binding StatusColor}" Opacity="0.15"/>
                                    </Border.Background>
                                    <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{Binding StatusColor, Converter={StaticResource StringToColorBrush}}"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
