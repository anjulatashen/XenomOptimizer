<UserControl x:Class="XenomOptimizer.Views.CleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,24">
        <StackPanel MaxWidth="1100">
            <TextBlock Text="Cleanup" FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
            <TextBlock Text="Scan and clean temporary files, caches, and logs. Never deletes personal files."
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,24"/>

            <!-- Status -->
            <TextBlock Text="{Binding StatusMessage}" FontSize="12"
                       Foreground="{StaticResource AccentGreenBrush}" Margin="0,0,0,12"
                       Visibility="{Binding StatusMessage, Converter={StaticResource StringToVis}}"
                       TextWrapping="Wrap"/>

            <!-- Scan Button -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <Button Style="{StaticResource PrimaryButton}" Content="🔍 Scan for Cleanable Files"
                        Command="{Binding ScanCommand}" IsEnabled="{Binding IsScanning, Converter={StaticResource InvBoolToVis}}"
                        Padding="24,10"/>
                <Button Style="{StaticResource DangerButton}" Content="🗑 Clean Selected"
                        Command="{Binding CleanSelectedCommand}" Margin="12,0,0,0"
                        Padding="24,10"
                        Visibility="{Binding HasScanned, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>

            <!-- Scanning indicator -->
            <TextBlock Text="⏳ Scanning directories..." Foreground="{StaticResource TextMutedBrush}"
                       Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12"/>

            <!-- Total size -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16"
                    Visibility="{Binding HasScanned, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Total Cleanable: " FontSize="16" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding TotalSize}" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource AccentCyanBrush}"/>
                </StackPanel>
            </Border>

            <!-- Cleanup Items -->
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox IsChecked="{Binding IsSelected}" Margin="0,0,12,0"
                                          VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding Description}" FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                    <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"
                                               FontFamily="{StaticResource MonoFont}">
                                        <Run Text="{Binding FileCount}"/> files
                                    </TextBlock>
                                </StackPanel>

                                <TextBlock Grid.Column="2" Text="{Binding FormattedSize}"
                                           FontSize="18" FontWeight="Bold" VerticalAlignment="Center"
                                           Foreground="{StaticResource AccentCyanBrush}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
