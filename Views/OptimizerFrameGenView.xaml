<UserControl x:Class="XenomOptimizer.Views.OptimizerFrameGenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:XenomOptimizer.ViewModels"
             xmlns:conv="clr-namespace:XenomOptimizer.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:OptimizerFrameGenViewModel}"
             Background="Transparent">

    <UserControl.Resources>
        <!-- Custom Slider Style for Framerate.mp4 match -->
        <Style x:Key="FramerateTrackSliderStyle" TargetType="Slider">
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb" Focusable="False" Width="20" Height="20" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid>
                                                    <Ellipse Width="20" Height="20" Fill="#FFFFFF">
                                                        <Ellipse.Effect>
                                                            <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="1" Opacity="0.5"/>
                                                        </Ellipse.Effect>
                                                    </Ellipse>
                                                    <Ellipse Width="8" Height="8" Fill="#0F172A"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Number Param Slider Style (Brightness & Non-Standard Screen) -->
        <Style x:Key="ParamSliderStyle" TargetType="Slider">
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="6" CornerRadius="3" Background="#1E2330"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb" Focusable="False" Width="18" Height="18" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="18" Height="18" Fill="#38BDF8" Stroke="#FFFFFF" StrokeThickness="1.5">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect Color="#38BDF8" BlurRadius="6" ShadowDepth="0" Opacity="0.4"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <!-- ── 1. SCROLLABLE CONTENT (NATURAL SCROLLING MATCHING ADVANCE TAB) ── -->
        <ScrollViewer x:Name="MainContentScrollViewer"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="32,24,32,85"
                      SnapsToDevicePixels="True" UseLayoutRounding="True">
            <ScrollViewer.Resources>
                <!-- Isolated Original ScrollBar matching Driver Hub -->
                <Style TargetType="ScrollBar">
                    <Setter Property="conv:ScrollBarAutoHideHelper.AutoHide" Value="True"/>
                    <Setter Property="SnapsToDevicePixels" Value="True"/>
                    <Setter Property="OverridesDefaultStyle" Value="True"/>
                    <Setter Property="Width" Value="12"/>
                    <Setter Property="Margin" Value="0,0,6,0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource VerticalScrollBarThumbStyle}"/>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ScrollViewer.Resources>
            <ScrollViewer.OpacityMask>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FFFFFFFF" Offset="0.0"/>
                    <GradientStop Color="#FFFFFFFF" Offset="0.88"/>
                    <GradientStop Color="#D5FFFFFF" Offset="0.93"/>
                    <GradientStop Color="#80FFFFFF" Offset="0.965"/>
                    <GradientStop Color="#00FFFFFF" Offset="1.0"/>
                </LinearGradientBrush>
            </ScrollViewer.OpacityMask>

            <StackPanel MaxWidth="1100">

                <!-- ═══════════════════════════════════════════════════════════ -->
                <!-- 1. HEADER SECTION (CLEAN, NO DOTS AT TOP)                   -->
                <!-- ═══════════════════════════════════════════════════════════ -->
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Optimizer &amp; Frame Gen" FontSize="26" FontWeight="Bold" Foreground="#FFFFFF"
                                   FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"/>
                        <TextBlock Text="GameLoop engine settings center, in-game unlocker, latency tweaks &amp; hardware frame gen"
                                   FontSize="12.5" Foreground="#8E95A5" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Status Badge -->
                    <Border Grid.Column="1" Background="#14151D" BorderBrush="#252838" BorderThickness="1"
                            CornerRadius="16" Padding="14,6" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="#10B981" Margin="0,0,8,0"/>
                            <TextBlock Text="System: Ready" FontSize="11" FontWeight="SemiBold" Foreground="#E2E8F0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ═══════════════════════════════════════════════════════════ -->
                <!-- 2. SLIDE 0: GAMELOOP ENGINE (FIRST PAGE)                    -->
                <!-- ═══════════════════════════════════════════════════════════ -->
                <StackPanel Visibility="{Binding IsPage1Active, Converter={StaticResource BoolToVis}}">

                    <!-- Engine Master Header Banner -->
                    <Border Background="#0C121E" BorderBrush="#1C2D48" BorderThickness="1.5" CornerRadius="16" Padding="24,20" Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="⚙️ GameLoop Engine (Settings Center)" FontSize="16.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    <Border Background="#16382F" BorderBrush="#34D399" BorderThickness="1" CornerRadius="8" Padding="8,2" Margin="12,0,0,0">
                                        <TextBlock Text="HARDWARE ALLOCATOR" FontSize="10" FontWeight="Bold" Foreground="#34D399"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Directly adjust GameLoop's core engine parameters: graphics backend, RAM allocation, CPU cores, display resolution, DPI, and device model spoofing."
                                           FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding EngineStatusMessage}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="#38BDF8" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- Auto-Detect Specs Button -->
                            <Button Grid.Column="1" Command="{Binding AutoDetectEngineSettingsCommand}" Cursor="Hand" Height="44" VerticalAlignment="Center">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="adBtn" Background="#141E30" BorderBrush="#253A5A" BorderThickness="1" CornerRadius="10" Padding="18,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="✨" FontSize="13" Foreground="#38BDF8" Margin="0,0,8,0"/>
                                                <TextBlock Text="Auto-Detect Best Specs" FontSize="12.5" FontWeight="SemiBold" Foreground="#CBD5E1"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="adBtn" Property="Background" Value="#1C2D4A"/>
                                                <Setter TargetName="adBtn" Property="BorderBrush" Value="#38BDF8"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- 2-COLUMN GRID: ENGINE CONTROLS -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT COLUMN: GRAPHICS & DISPLAY -->
                        <Border Grid.Column="0" Background="#0E1017" BorderBrush="#1C212E" BorderThickness="1.2" CornerRadius="16" Padding="22,20">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <TextBlock Text="🎮 Graphics &amp; Display Backend" FontSize="14.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                </StackPanel>

                                <!-- 1. Rendering Backend Engine -->
                                <TextBlock Text="Rendering Engine" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,6"/>
                                <ComboBox ItemsSource="{Binding EngineOptions}"
                                          SelectedIndex="{Binding SelectedEngineIndex}"
                                          Margin="0,0,0,14" Height="36"/>

                                <!-- 2. Resolution Preset -->
                                <TextBlock Text="Display Resolution" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,6"/>
                                <ComboBox ItemsSource="{Binding ResolutionOptions}"
                                          SelectedIndex="{Binding SelectedResolutionIndex}"
                                          Margin="0,0,0,14" Height="36"/>

                                <!-- 3. Screen DPI -->
                                <TextBlock Text="Screen DPI (Pixel Density)" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,6"/>
                                <ComboBox ItemsSource="{Binding DpiOptions}"
                                          SelectedIndex="{Binding SelectedDpiIndex}"
                                          Margin="0,0,0,16" Height="36"/>

                                <Border Height="1" Background="#1C2230" Margin="0,0,0,14"/>

                                <!-- Engine Graphics Toggles -->
                                <TextBlock Text="Advanced Rendering Optimizations" FontSize="12.5" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,10"/>

                                <CheckBox IsChecked="{Binding IsRenderCacheEnabled}" Content="Enable Render Cache (Smooth Texture Streaming)"
                                          Foreground="#CBD5E1" FontSize="11.5" Margin="0,0,0,8" Cursor="Hand"/>

                                <CheckBox IsChecked="{Binding IsDiscreteGpuEnforced}" Content="Enforce Dedicated GPU (Force High Performance GPU)"
                                          Foreground="#CBD5E1" FontSize="11.5" Margin="0,0,0,8" Cursor="Hand"/>

                                <CheckBox IsChecked="{Binding IsRenderOptimizationEnabled}" Content="Rendering Optimization (Eliminates Frame Pacing Stutters)"
                                          Foreground="#CBD5E1" FontSize="11.5" Margin="0,0,0,8" Cursor="Hand"/>

                                <CheckBox IsChecked="{Binding IsVsyncDisabled}" Content="Disable V-Sync in Emulator (Unlock Pure 120 FPS)"
                                          Foreground="#CBD5E1" FontSize="11.5" Cursor="Hand"/>
                            </StackPanel>
                        </Border>

                        <!-- RIGHT COLUMN: CPU, RAM & DEVICE MODEL -->
                        <Border Grid.Column="2" Background="#0E1017" BorderBrush="#1C212E" BorderThickness="1.2" CornerRadius="16" Padding="22,20">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <TextBlock Text="⚡ Hardware Resources &amp; Device Spoofing" FontSize="14.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                </StackPanel>

                                <!-- 1. Processor / CPU Cores -->
                                <TextBlock Text="Processor (CPU Cores Allocation)" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,6"/>
                                <ComboBox ItemsSource="{Binding CoreOptions}"
                                          SelectedIndex="{Binding SelectedCoresIndex}"
                                          Margin="0,0,0,14" Height="36"/>

                                <!-- 2. Memory / RAM Allocation -->
                                <TextBlock Text="Memory (RAM Allocation)" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,6"/>
                                <ComboBox ItemsSource="{Binding RamOptions}"
                                          SelectedIndex="{Binding SelectedRamIndex}"
                                          Margin="0,0,0,14" Height="36"/>

                                <!-- 3. Device Model Profile -->
                                <TextBlock Text="Device Model (120 FPS Whitelist Spoofing)" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,6"/>
                                <ComboBox ItemsSource="{Binding DeviceProfileOptions}"
                                          SelectedIndex="{Binding SelectedDeviceProfileIndex}"
                                          Margin="0,0,0,18" Height="36"/>

                                <Border Height="1" Background="#1C2230" Margin="0,0,0,14"/>

                                <Border Background="#131722" BorderBrush="#20283C" BorderThickness="1" CornerRadius="10" Padding="14,12">
                                    <StackPanel>
                                        <TextBlock Text="💡 Recommended Configuration Tips:" FontSize="11.5" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,4"/>
                                        <TextBlock Text="• For 8-core CPUs (e.g. i7 / Ryzen 7): Select 4 Cores &amp; 8192 MB RAM." FontSize="11" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                        <TextBlock Text="• Keep SM-X910 selected to unlock PUBG Mobile's 120 FPS Extreme frame rate setting." FontSize="11" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                        <TextBlock Text="• iPad View (1440x1080) offers stretched pro player field-of-view with maximum FPS." FontSize="11" Foreground="#94A3B8"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- MASTER APPLY ENGINE SETTINGS BUTTON -->
                    <Border Background="#101520" BorderBrush="#1C273C" BorderThickness="1" CornerRadius="14" Padding="20,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                    <TextBlock Text="⚡ Save &amp; Apply Engine Configuration" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    <Border Background="#162E25" CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                                        <TextBlock Text="SYNC TO REGISTRY &amp; INI" FontSize="9.5" FontWeight="Bold" Foreground="#34D399"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Writes resolution, memory size, CPU cores, render engine, and spoofed device profile to GameLoop configuration files and Windows Registry."
                                           FontSize="11.5" Foreground="#94A3B8" TextWrapping="Wrap"/>
                            </StackPanel>

                            <Button Grid.Column="1" Command="{Binding SaveFullEngineSettingsCommand}" Cursor="Hand" Height="44" VerticalAlignment="Center">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="applyBox" Background="#147EEE" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="10" Padding="24,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="⚡" FontSize="13" Foreground="#FFFFFF" Margin="0,0,8,0"/>
                                                <TextBlock Text="Apply Engine Settings" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="applyBox" Property="Background" Value="#0284C7"/>
                                                <Setter TargetName="applyBox" Property="BorderBrush" Value="#7DD3FC"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                </StackPanel>

                <!-- ═══════════════════════════════════════════════════════════ -->
                <!-- 3. SLIDE 1: IN-GAME UNLOCKER (SECOND PAGE)                  -->
                <!-- ═══════════════════════════════════════════════════════════ -->
                <StackPanel Visibility="{Binding IsPage2Active, Converter={StaticResource BoolToVis}}">

                    <Border Background="#0B0C10" BorderBrush="#1C202C" BorderThickness="1" CornerRadius="14" Padding="22,18" Margin="0,0,0,20">
                        <StackPanel>
                            <!-- Header Title matching GameLoop in-game styling -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                        <TextBlock Text="🎮 PUBG Mobile Active.sav &amp; In-Game Graphics" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF"/>
                                        <Border Background="#162E25" BorderBrush="#255A43" BorderThickness="1" CornerRadius="6" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="ACTIVE.SAV ENGINE" FontSize="9.5" FontWeight="Bold" Foreground="#34D399"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Configure in-game render quality, 120 FPS unlocker, styles, advanced shadows and patch binary Active.sav."
                                               FontSize="11.5" Foreground="#64748B"/>
                                </StackPanel>

                                <!-- In-game Status Pill -->
                                <Border Grid.Column="1" Background="#141824" BorderBrush="#242B3C" BorderThickness="1" CornerRadius="12" Padding="12,5" VerticalAlignment="Center">
                                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8">
                                        <Run Text="{Binding ActiveSavFrameRate}"/> FPS • <Run Text="{Binding ActiveSavQuality}"/> • <Run Text="{Binding ActiveSavStyle}"/>
                                    </TextBlock>
                                </Border>
                            </Grid>

                            <!-- ── 1. GRAPHIC QUALITY TABS (MATCHING IMAGE 1) ── -->
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="Graphic Quality" FontSize="13" FontWeight="Bold" Foreground="#CBD5E1" Margin="0,0,0,8"/>

                                <Border Background="#11131A" BorderBrush="#1F2432" BorderThickness="1" CornerRadius="8" Padding="2">
                                    <UniformGrid Columns="6" Height="36">

                                        <!-- Super Smooth -->
                                        <Button Command="{Binding SelectQualityCommand}" CommandParameter="Super Smooth" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="tabBorder" Background="Transparent" BorderBrush="#242B3C" BorderThickness="0,0,1,0">
                                                        <Grid>
                                                            <TextBlock x:Name="tabTxt" Text="Super Smooth" FontSize="11.5" FontWeight="SemiBold"
                                                                       Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            <Border x:Name="blueLine" Height="3" Background="Transparent" VerticalAlignment="Bottom"/>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="tabTxt" Property="Foreground" Value="#FFFFFF"/>
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsQualitySuperSmooth}" Value="True">
                                                            <Setter TargetName="tabBorder" Property="Background" Value="#CBD5E1"/>
                                                            <Setter TargetName="tabTxt" Property="Foreground" Value="#0F172A"/>
                                                            <Setter TargetName="tabTxt" Property="FontWeight" Value="Bold"/>
                                                            <Setter TargetName="blueLine" Property="Background" Value="#147EEE"/>
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <!-- Smooth -->
                                        <Button Command="{Binding SelectQualityCommand}" CommandParameter="Smooth" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="tabBorder" Background="Transparent" BorderBrush="#242B3C" BorderThickness="0,0,1,0">
                                                        <Grid>
                                                            <TextBlock x:Name="tabTxt" Text="Smooth" FontSize="11.5" FontWeight="SemiBold"
                                                                       Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            <Border x:Name="blueLine" Height="3" Background="Transparent" VerticalAlignment="Bottom"/>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="tabTxt" Property="Foreground" Value="#FFFFFF"/>
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsQualitySmooth}" Value="True">
                                                            <Setter TargetName="tabBorder" Property="Background" Value="#CBD5E1"/>
                                                            <Setter TargetName="tabTxt" Property="Foreground" Value="#0F172A"/>
                                                            <Setter TargetName="tabTxt" Property="FontWeight" Value="Bold"/>
                                                            <Setter TargetName="blueLine" Property="Background" Value="#147EEE"/>
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <!-- Balanced -->
                                        <Button Command="{Binding SelectQualityCommand}" CommandParameter="Balanced" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="tabBorder" Background="Transparent" BorderBrush="#242B3C" BorderThickness="0,0,1,0">
                                                        <Grid>
                                                            <TextBlock x:Name="tabTxt" Text="Balanced" FontSize="11.5" FontWeight="SemiBold"
                                                                       Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            <Border x:Name="blueLine" Height="3" Background="Transparent" VerticalAlignment="Bottom"/>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="tabTxt" Property="Foreground" Value="#FFFFFF"/>
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsQualityBalanced}" Value="True">
                                                            <Setter TargetName="tabBorder" Property="Background" Value="#CBD5E1"/>
                                                            <Setter TargetName="tabTxt" Property="Foreground" Value="#0F172A"/>
                                                            <Setter TargetName="tabTxt" Property="FontWeight" Value="Bold"/>
                                                            <Setter TargetName="blueLine" Property="Background" Value="#147EEE"/>
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <!-- HD -->
                                        <Button Command="{Binding SelectQualityCommand}" CommandParameter="HD" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="tabBorder" Background="Transparent" BorderBrush="#242B3C" BorderThickness="0,0,1,0">
                                                        <Grid>
                                                            <TextBlock x:Name="tabTxt" Text="HD" FontSize="11.5" FontWeight="SemiBold"
                                                                       Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            <Border x:Name="blueLine" Height="3" Background="Transparent" VerticalAlignment="Bottom"/>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="tabTxt" Property="Foreground" Value="#FFFFFF"/>
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsQualityHd}" Value="True">
                                                            <Setter TargetName="tabBorder" Property="Background" Value="#CBD5E1"/>
                                                            <Setter TargetName="tabTxt" Property="Foreground" Value="#0F172A"/>
                                                            <Setter TargetName="tabTxt" Property="FontWeight" Value="Bold"/>
                                                            <Setter TargetName="blueLine" Property="Background" Value="#147EEE"/>
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <!-- HDR -->
                                        <Button Command="{Binding SelectQualityCommand}" CommandParameter="HDR" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="tabBorder" Background="Transparent" BorderBrush="#242B3C" BorderThickness="0,0,1,0">
                                                        <Grid>
                                                            <TextBlock x:Name="tabTxt" Text="HDR" FontSize="11.5" FontWeight="SemiBold"
                                                                       Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            <Border x:Name="blueLine" Height="3" Background="Transparent" VerticalAlignment="Bottom"/>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
