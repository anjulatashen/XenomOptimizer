                                                            <TextBlock FontSize="10" Foreground="#38BDF8" FontFamily="Consolas, monospace">
                                                                <Run Text="{Binding KeyName}"/> = <Run Text="{Binding FormattedValue}"/>
                                                            </TextBlock>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Description}" FontSize="10.5" Foreground="#8E95A5" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>

                                                <ToggleButton Grid.Column="1"
                                                              IsChecked="{Binding IsApplied, Mode=TwoWay}"
                                                              Command="{Binding DataContext.ToggleRegistryItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              CommandParameter="{Binding}"
                                                              Cursor="Hand" VerticalAlignment="Center">
                                                    <ToggleButton.Template>
                                                        <ControlTemplate TargetType="ToggleButton">
                                                            <Border x:Name="pillTrack" Width="44" Height="24" CornerRadius="12"
                                                                    Background="#1E2330" BorderBrush="#2F3648" BorderThickness="1">
                                                                <Canvas Width="44" Height="24">
                                                                    <Ellipse x:Name="pillThumb" Width="18" Height="18" Fill="#64748B"
                                                                             Canvas.Left="3" Canvas.Top="2">
                                                                        <Ellipse.Effect>
                                                                            <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="1" Opacity="0.4"/>
                                                                        </Ellipse.Effect>
                                                                    </Ellipse>
                                                                </Canvas>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter TargetName="pillTrack" Property="Background" Value="#A3E635"/>
                                                                    <Setter TargetName="pillTrack" Property="BorderBrush" Value="#BEF264"/>
                                                                    <Setter TargetName="pillThumb" Property="Fill" Value="#0F172A"/>
                                                                    <Setter TargetName="pillThumb" Property="Canvas.Left" Value="21"/>
                                                                </Trigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="pillTrack" Property="BorderBrush" Value="#38BDF8"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </ToggleButton.Template>
                                                </ToggleButton>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- 2-COLUMN GRID FOR DEBLOATER & PROCESS SUSPENDER -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- COLUMN 1: Debloater & Cache Purge -->
                        <Border Grid.Column="0" Background="#0A0A0A" BorderBrush="#262626" BorderThickness="1" CornerRadius="12" Padding="20">
                            <StackPanel>
                                <TextBlock Text="GameLoop Debloater &amp; Cache Purge" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <TextBlock Text="Forcibly terminate background telemetry and deep-purge shader caches."
                                           FontSize="11.5" Foreground="#8E95A5" Margin="0,3,0,12"/>

                                <Border Height="1" Background="#171717" Margin="0,0,0,14"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Button 1: Kill Telemetry -->
                                    <Button Grid.Column="0" Command="{Binding KillTelemetryCommand}" Cursor="Hand" Height="36">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="KillBox" Background="#171717" BorderBrush="#262626" BorderThickness="1" CornerRadius="8">
                                                    <TextBlock Text="Kill Telemetry" FontSize="11" FontWeight="Bold"
                                                               Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="KillBox" Property="Background" Value="#262626"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <!-- Button 2: Deep Cache Purge -->
                                    <Button Grid.Column="2" Command="{Binding PurgeCacheCommand}" Cursor="Hand" Height="36">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="PurgeBox" Background="#171717" BorderBrush="#262626" BorderThickness="1" CornerRadius="8">
                                                    <TextBlock Text="Deep Cache Purge" FontSize="11" FontWeight="Bold"
                                                               Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="PurgeBox" Property="Background" Value="#262626"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>

                                <TextBlock Text="{Binding CleanerStatusText}" FontSize="11" Foreground="#52525B"/>
                            </StackPanel>
                        </Border>

                        <!-- COLUMN 2: Process Suspender & GPU Router -->
                        <Border Grid.Column="2" Background="#0A0A0A" BorderBrush="#262626" BorderThickness="1" CornerRadius="12" Padding="20">
                            <StackPanel>
                                <TextBlock Text="Smart Process Suspender &amp; GPU Router" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <TextBlock Text="Temporarily freezes background apps and routes dedicated GPU."
                                           FontSize="11.5" Foreground="#8E95A5" Margin="0,3,0,12"/>

                                <Border Height="1" Background="#171717" Margin="0,0,0,14"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Button 1: Suspend Background Apps -->
                                    <Button Grid.Column="0" Command="{Binding ToggleProcessSuspenderCommand}" Cursor="Hand" Height="36">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="SusBox" CornerRadius="8">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#171717"/>
                                                            <Setter Property="BorderBrush" Value="#262626"/>
                                                            <Setter Property="BorderThickness" Value="1"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsProcessSuspendActive}" Value="True">
                                                                    <Setter Property="Background" Value="#10B981"/>
                                                                    <Setter Property="BorderBrush" Value="#10B981"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="Suspend Apps"/>
                                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsProcessSuspendActive}" Value="True">
                                                                        <Setter Property="Text" Value="Resume Apps"/>
                                                                        <Setter Property="Foreground" Value="#000000"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="SusBox" Property="Opacity" Value="0.85"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <!-- Button 2: Force Dedicated GPU -->
                                    <Button Grid.Column="2" Command="{Binding ForceDedicatedGpuCommand}" Cursor="Hand" Height="36">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="GpuBox" Background="#171717" BorderBrush="#262626" BorderThickness="1" CornerRadius="8">
                                                    <TextBlock Text="Force GPU Route" FontSize="11" FontWeight="Bold"
                                                               Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="GpuBox" Property="Background" Value="#262626"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>

                                <TextBlock Text="{Binding SuspendedStatusText}" FontSize="11" Foreground="#52525B"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- ── 2. PINNED BOTTOM GRADIENT FADE OVERLAY (CONTENT SCROLLS BEHIND THIS) ── -->
        <Border VerticalAlignment="Bottom" Height="85" IsHitTestVisible="False" Panel.ZIndex="90">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#000B0C0E" Offset="0.0"/>
                    <GradientStop Color="#200B0C0E" Offset="0.25"/>
                    <GradientStop Color="#650B0C0E" Offset="0.5"/>
                    <GradientStop Color="#B50B0C0E" Offset="0.75"/>
                    <GradientStop Color="#FF0B0C0E" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- ── 3. PINNED BOTTOM CAROUSEL DOTS (MOUSE WHEEL SWITCHING MATCHING ADVANCE TAB) ── -->
        <Border x:Name="BottomPaginationDotsBorder" Panel.ZIndex="100" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Width="320" Height="46" Margin="0,0,90,0" Background="Transparent" BorderThickness="0"
                PreviewMouseWheel="PaginationBar_PreviewMouseWheel"
                FocusVisualStyle="{x:Null}" ClipToBounds="False">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Dot 0: GameLoop Engine (Slide 0) -->
                <Button Command="{Binding SelectSlideCommand}" CommandParameter="0"
                        Cursor="Hand" Background="Transparent" BorderThickness="0"
                        FocusVisualStyle="{x:Null}" IsTabStop="False" Padding="4,8" Margin="0,0,6,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="ToolTip" Value="GameLoop Engine (Click or scroll to switch)"/>
                        </Style>
                    </Button.Style>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent" Cursor="Hand" FocusVisualStyle="{x:Null}">
                                <Border x:Name="DotPill" Height="10" Width="10" CornerRadius="5"
                                        Background="#4A5568" SnapsToDevicePixels="True" UseLayoutRounding="True"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsPage1Active}" Value="True">
                                    <Setter TargetName="DotPill" Property="Background" Value="#CBD5E1"/>
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="DotPill"
                                                                 Storyboard.TargetProperty="Width"
                                                                 To="42" Duration="0:0:0.32">
                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="DotPill"
                                                                 Storyboard.TargetProperty="Width"
                                                                 To="10" Duration="0:0:0.32">
                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsPage1Active}" Value="False"/>
                                        <Condition Binding="{Binding Path=IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="DotPill" Property="Background" Value="#94A3B8"/>
                                </MultiDataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Dot 1: In-Game Unlocker (Slide 1) -->
                <Button Command="{Binding SelectSlideCommand}" CommandParameter="1"
                        Cursor="Hand" Background="Transparent" BorderThickness="0"
                        FocusVisualStyle="{x:Null}" IsTabStop="False" Padding="4,8" Margin="0,0,6,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="ToolTip" Value="In-Game Unlocker (Click or scroll to switch)"/>
                        </Style>
                    </Button.Style>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent" Cursor="Hand" FocusVisualStyle="{x:Null}">
                                <Border x:Name="DotPill" Height="10" Width="10" CornerRadius="5"
                                        Background="#4A5568" SnapsToDevicePixels="True" UseLayoutRounding="True"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsPage2Active}" Value="True">
                                    <Setter TargetName="DotPill" Property="Background" Value="#CBD5E1"/>
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="DotPill"
                                                                 Storyboard.TargetProperty="Width"
                                                                 To="42" Duration="0:0:0.32">
                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="DotPill"
                                                                 Storyboard.TargetProperty="Width"
                                                                 To="10" Duration="0:0:0.32">
                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsPage2Active}" Value="False"/>
                                        <Condition Binding="{Binding Path=IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="DotPill" Property="Background" Value="#94A3B8"/>
                                </MultiDataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Dot 2: GameLoop Optimizer (Slide 2) -->
                <Button Command="{Binding SelectSlideCommand}" CommandParameter="2"
                        Cursor="Hand" Background="Transparent" BorderThickness="0"
                        FocusVisualStyle="{x:Null}" IsTabStop="False" Padding="4,8" Margin="0,0,0,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="ToolTip" Value="GameLoop Optimizer (Click or scroll to switch)"/>
                        </Style>
                    </Button.Style>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent" Cursor="Hand" FocusVisualStyle="{x:Null}">
                                <Border x:Name="DotPill" Height="10" Width="10" CornerRadius="5"
                                        Background="#4A5568" SnapsToDevicePixels="True" UseLayoutRounding="True"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsPage3Active}" Value="True">
                                    <Setter TargetName="DotPill" Property="Background" Value="#CBD5E1"/>
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="DotPill"
                                                                 Storyboard.TargetProperty="Width"
                                                                 To="42" Duration="0:0:0.32">
                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="DotPill"
                                                                 Storyboard.TargetProperty="Width"
                                                                 To="10" Duration="0:0:0.32">
                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsPage3Active}" Value="False"/>
                                        <Condition Binding="{Binding Path=IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="DotPill" Property="Background" Value="#94A3B8"/>
                                </MultiDataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
