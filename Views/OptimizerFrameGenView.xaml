<UserControl x:Class="XenomOptimizer.Views.OptimizerFrameGenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:XenomOptimizer.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:OptimizerFrameGenViewModel}"
             Background="#000000">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32,24,32,32">
        <StackPanel MaxWidth="1100">

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- HEADER SECTION (Flat, Minimalist, No Icons)                  -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Optimizer &amp; Frame Gen" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <TextBlock Text="Hardware frame generation, background app suspension &amp; deep GameLoop debloater"
                               FontSize="12.5" Foreground="#8E95A5" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Status Badge -->
                <Border Grid.Column="1" Background="#171717" BorderBrush="#262626" BorderThickness="1"
                        CornerRadius="8" Padding="14,6" VerticalAlignment="Center">
                    <TextBlock Text="System: Optimized" FontSize="11" FontWeight="SemiBold" Foreground="#8E95A5"/>
                </Border>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- 2-COLUMN FLAT CARD GRID                                     -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ── COLUMN 1 ── -->
                <StackPanel Grid.Column="0">

                    <!-- CARD 1: Frame Generation Engine -->
                    <Border Background="#0A0A0A" BorderBrush="#262626" BorderThickness="1" CornerRadius="12"
                            Padding="20" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Frame Generation Engine" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock Text="Hardware accelerated frame interpolation and background limiter."
                                       FontSize="11.5" Foreground="#8E95A5" Margin="0,3,0,12"/>

                            <!-- Thin Divider -->
                            <Border Height="1" Background="#171717" Margin="0,0,0,14"/>

                            <!-- Target FPS Row -->
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Target Framerate" FontSize="12" Foreground="#8E95A5" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TargetFps, StringFormat='{}{0:0}'}" FontSize="16" FontWeight="Bold" Foreground="#147EEE"/>
                                    <TextBlock Text=" FPS" FontSize="12" FontWeight="SemiBold" Foreground="#8E95A5" VerticalAlignment="Bottom" Margin="2,0,0,1"/>
                                </StackPanel>
                            </Grid>

                            <!-- Slider (60 to 120 FPS) -->
                            <Slider Minimum="60" Maximum="120" Value="{Binding TargetFps}"
                                    IsSnapToTickEnabled="True" TickFrequency="5"
                                    Height="24" Margin="0,0,0,16"/>

                            <!-- Flat Toggle Button (Capsule, No Glow, No Icons) -->
                            <Button Command="{Binding ToggleFrameGenCommand}" Cursor="Hand" Height="38">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="BtnBox" CornerRadius="8" BorderThickness="1"
                                                Background="{Binding IsFrameGenActive, Converter={StaticResource BoolToVis}}"
                                                HorizontalAlignment="Stretch">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#171717"/>
                                                    <Setter Property="BorderBrush" Value="#262626"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFrameGenActive}" Value="True">
                                                            <Setter Property="Background" Value="#147EEE"/>
                                                            <Setter Property="BorderBrush" Value="#147EEE"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding FrameGenToggleText}" FontSize="12" FontWeight="Bold"
                                                       Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="BtnBox" Property="Background" Value="#262626"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- CARD 2: GameLoop Debloater & Smart Cleaner -->
                    <Border Background="#0A0A0A" BorderBrush="#262626" BorderThickness="1" CornerRadius="12"
                            Padding="20" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="GameLoop Debloater &amp; Cache Purge" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock Text="Forcibly terminate background telemetry and deep-purge shader caches."
                                       FontSize="11.5" Foreground="#8E95A5" Margin="0,3,0,12"/>

                            <!-- Thin Divider -->
                            <Border Height="1" Background="#171717" Margin="0,0,0,14"/>

                            <!-- Buttons Row -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Button 1: Kill Telemetry -->
                                <Button Grid.Column="0" Command="{Binding KillTelemetryCommand}" Cursor="Hand" Height="36">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Box1" Background="#171717" BorderBrush="#262626" BorderThickness="1" CornerRadius="8">
                                                <TextBlock Text="Kill Telemetry" FontSize="11.5" FontWeight="Bold"
                                                           Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Box1" Property="Background" Value="#262626"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- Button 2: Deep Cache Purge -->
                                <Button Grid.Column="2" Command="{Binding PurgeCacheCommand}" Cursor="Hand" Height="36">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Box2" Background="#171717" BorderBrush="#262626" BorderThickness="1" CornerRadius="8">
                                                <TextBlock Text="Deep Cache Purge" FontSize="11.5" FontWeight="Bold"
                                                           Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Box2" Property="Background" Value="#262626"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>

                            <!-- Status Text -->
                            <TextBlock Text="{Binding CleanerStatusText}" FontSize="11" Foreground="#52525B"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ── COLUMN 2 ── -->
                <StackPanel Grid.Column="2">

                    <!-- CARD 3: GameLoop Config Tweaker -->
                    <Border Background="#0A0A0A" BorderBrush="#262626" BorderThickness="1" CornerRadius="12"
                            Padding="20" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="GameLoop Config Tweaker" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock Text="Modify display resolution presets and rendering graphics pipeline."
                                       FontSize="11.5" Foreground="#8E95A5" Margin="0,3,0,12"/>

                            <!-- Thin Divider -->
                            <Border Height="1" Background="#171717" Margin="0,0,0,14"/>

                            <!-- Resolution Preset Dropdown -->
                            <TextBlock Text="Resolution Preset" FontSize="11.5" Foreground="#8E95A5" Margin="0,0,0,6"/>
                            <ComboBox ItemsSource="{Binding ResolutionOptions}"
                                      SelectedIndex="{Binding SelectedResolutionIndex}"
                                      Height="34" Margin="0,0,0,14" Background="#171717" Foreground="#FFFFFF"
                                      BorderBrush="#262626"/>

                            <!-- Engine Preset Dropdown -->
                            <TextBlock Text="Rendering Backend Engine" FontSize="11.5" Foreground="#8E95A5" Margin="0,0,0,6"/>
                            <ComboBox ItemsSource="{Binding EngineOptions}"
                                      SelectedIndex="{Binding SelectedEngineIndex}"
                                      Height="34" Margin="0,0,0,16" Background="#171717" Foreground="#FFFFFF"
                                      BorderBrush="#262626"/>

                            <!-- Save Settings Button -->
                            <Button Command="{Binding SaveEngineSettingsCommand}" Cursor="Hand" Height="36">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="SaveBox" Background="#171717" BorderBrush="#262626" BorderThickness="1" CornerRadius="8">
                                            <TextBlock Text="Save Engine Settings" FontSize="11.5" FontWeight="Bold"
                                                       Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="SaveBox" Property="Background" Value="#262626"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- CARD 4: Smart Process Suspender & GPU Router -->
                    <Border Background="#0A0A0A" BorderBrush="#262626" BorderThickness="1" CornerRadius="12"
                            Padding="20" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Smart Process Suspender &amp; GPU Router" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock Text="Temporarily freezes background apps and routes dedicated GPU."
                                       FontSize="11.5" Foreground="#8E95A5" Margin="0,3,0,12"/>

                            <!-- Thin Divider -->
                            <Border Height="1" Background="#171717" Margin="0,0,0,14"/>

                            <!-- Buttons Row -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Button 1: Toggle Suspend -->
                                <Button Grid.Column="0" Command="{Binding ToggleProcessSuspenderCommand}" Cursor="Hand" Height="36">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="SusBox" BorderThickness="1" CornerRadius="8">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#171717"/>
                                                        <Setter Property="BorderBrush" Value="#262626"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsProcessSuspendActive}" Value="True">
                                                                <Setter Property="Background" Value="#D1FE29"/>
                                                                <Setter Property="BorderBrush" Value="#D1FE29"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="Suspend Apps"/>
                                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsProcessSuspendActive}" Value="True">
                                                                    <Setter Property="Text" Value="Resume Apps"/>
                                                                    <Setter Property="Foreground" Value="#000000"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="SusBox" Property="Opacity" Value="0.85"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- Button 2: Force Dedicated GPU -->
                                <Button Grid.Column="2" Command="{Binding ForceDedicatedGpuCommand}" Cursor="Hand" Height="36">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="GpuBox" Background="#171717" BorderBrush="#262626" BorderThickness="1" CornerRadius="8">
                                                <TextBlock Text="Force GPU Route" FontSize="11" FontWeight="Bold"
                                                           Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="GpuBox" Property="Background" Value="#262626"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>

                            <!-- Status text -->
                            <TextBlock Text="{Binding SuspendedStatusText}" FontSize="11" Foreground="#52525B"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
