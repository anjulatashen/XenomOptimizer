<UserControl x:Class="XenomOptimizer.Views.DriverBoosterPromptModalControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             IsVisibleChanged="OnIsVisibleChanged">

    <Grid>
        <!-- Full-window Dark Dimming Backdrop (Dismiss on click outside) -->
        <Border x:Name="BackdropBorder" Background="#D8000000"
                MouseLeftButtonDown="Backdrop_MouseLeftButtonDown"/>

        <!-- ═══ FIXED-SIZE DRIVER BOOSTER STEP 2 MODAL CARD (Dark AAA Pass Palette) ═══ -->
        <Border x:Name="ModalCard" Width="440" Height="440" CornerRadius="26" Padding="24,22"
                Background="#0A0A0A" BorderBrush="#262626" BorderThickness="1.2"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                RenderTransformOrigin="0.5,0.5">

            <Border.Effect>
                <DropShadowEffect BlurRadius="45" ShadowDepth="10" Opacity="0.95" Color="#000000"/>
            </Border.Effect>

            <Border.RenderTransform>
                <TranslateTransform x:Name="ModalCardTranslate" Y="0"/>
            </Border.RenderTransform>

            <Grid>
                <Grid.RowDefinitions>
                    <!-- Row 0: Top Header (Step badge + Close Button) -->
                    <RowDefinition Height="Auto"/>
                    <!-- Row 1: Content Area -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ── CARD HEADER: Step 2 Pill + Close Button ── -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#1C2818" CornerRadius="6" Padding="9,3">
                            <TextBlock Text="STEP 2 • RECOMMENDED" FontSize="9.5" FontWeight="Bold"
                                       Foreground="#A3E635"/>
                        </Border>
                    </StackPanel>

                    <!-- Close Button -->
                    <Button Grid.Column="1" Command="{Binding DismissDriverBoosterPromptCommand}"
                            Cursor="Hand" Width="32" Height="26" VerticalAlignment="Center"
                            ToolTip="Close (Esc)">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="CloseBox" Width="32" Height="26" CornerRadius="8"
                                        Background="Transparent" BorderThickness="0">
                                    <TextBlock x:Name="CloseIcon" Text="&#xE711;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="10.5" Foreground="#94A3B8"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="CloseBox" Property="Background" Value="#EF4444"/>
                                        <Setter TargetName="CloseIcon" Property="Foreground" Value="#FFFFFF"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="CloseBox" Property="Background" Value="#DC2626"/>
                                        <Setter TargetName="CloseIcon" Property="Foreground" Value="#FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- ── CARD BODY ── -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <!-- 1. Success Checkmark & Announcement -->
                    <Border Width="56" Height="56" CornerRadius="28"
                            Background="#162E1A" BorderBrush="#22C55E" BorderThickness="1.5"
                            HorizontalAlignment="Center" Margin="0,0,0,10">
                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                                   Foreground="#4ADE80" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="Primary Drivers Installed!" FontSize="19" FontWeight="Bold"
                               Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,4"/>

                    <TextBlock Text="All core PC drivers have been successfully installed &amp; verified."
                               FontSize="12" Foreground="#A3A3A3" HorizontalAlignment="Center"
                               TextAlignment="Center" Margin="0,0,0,16"/>

                    <!-- 2. Driver Booster Action Item Card (Matches Download Modal Card Style) -->
                    <Border Background="#171717" BorderBrush="#262626" BorderThickness="1.2"
                            CornerRadius="16" Padding="14,12" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Circular Icon Container -->
                            <Border Grid.Column="0" Width="46" Height="46" CornerRadius="23"
                                    Background="#262626" BorderBrush="#373737" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <TextBlock Text="&#xE74C;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="20" Foreground="#D1FE29"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- Title & Description -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,10,0">
                                <TextBlock Text="Driver Booster 12" FontSize="14.5" FontWeight="Bold"
                                           Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="Update all remaining PC drivers" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="#737373" Margin="0,3,0,0"/>
                            </StackPanel>

                            <!-- Right: Ready Text -->
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="Ready"
                                       FontSize="13" FontWeight="Bold" Foreground="#A3E635"
                                       Margin="0,0,8,0"/>
                        </Grid>
                    </Border>

                    <!-- 3. Primary Action: BUMPING Install Button -->
                    <Button Command="{Binding InstallDriverBoosterFromPromptCommand}"
                            Cursor="Hand" Margin="0,0,0,10" Height="44">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="PromptInstallPill" Height="44" CornerRadius="22"
                                        Background="#A3E635" SnapsToDevicePixels="True">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="PromptInstallBtnTrans" Y="0"/>
                                    </Border.RenderTransform>
                                    <Border.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PromptInstallBtnTrans"
                                                                                   Storyboard.TargetProperty="Y"
                                                                                   Duration="0:0:1.6">
                                                        <LinearDoubleKeyFrame KeyTime="0:0:0.0" Value="0"/>
                                                        <SplineDoubleKeyFrame KeyTime="0:0:0.24" Value="-4.5" KeySpline="0.2,0.8,0.4,1.0"/>
                                                        <SplineDoubleKeyFrame KeyTime="0:0:0.48" Value="0" KeySpline="0.6,0.0,0.8,0.2"/>
                                                        <SplineDoubleKeyFrame KeyTime="0:0:0.64" Value="-2.0" KeySpline="0.2,0.8,0.4,1.0"/>
                                                        <SplineDoubleKeyFrame KeyTime="0:0:0.80" Value="0" KeySpline="0.6,0.0,0.8,0.2"/>
                                                        <LinearDoubleKeyFrame KeyTime="0:0:1.6" Value="0"/>
                                                    </DoubleAnimationUsingKeyFrames>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Border.Triggers>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                   Foreground="#0A0A0A" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Install Driver Booster" FontSize="13.5" FontWeight="Bold"
                                                   Foreground="#0A0A0A" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="PromptInstallPill" Property="Background" Value="#BEF264"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="PromptInstallPill" Property="Background" Value="#84CC16"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- 4. Secondary Action: Done / Later Button -->
                    <Button Command="{Binding DismissDriverBoosterPromptCommand}"
                            Cursor="Hand" Height="38">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="LaterBox" Height="38" CornerRadius="12"
                                        Background="#171717" BorderBrush="#262626" BorderThickness="1.2">
                                    <TextBlock x:Name="LaterText" Text="Done / Later" FontSize="12"
                                               FontWeight="SemiBold" Foreground="#A3A3A3"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="LaterBox" Property="Background" Value="#262626"/>
                                        <Setter TargetName="LaterText" Property="Foreground" Value="#FFFFFF"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="LaterBox" Property="Background" Value="#1F1F1F"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
