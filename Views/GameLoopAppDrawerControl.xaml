<UserControl x:Class="XenomOptimizer.Views.GameLoopAppDrawerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1340">

    <UserControl.Resources>
        <!-- Modern Floating Context Menu (Photo 3 Style matching TrayMenu) -->
        <Style x:Key="AppDrawerContextMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <!-- Outer transparent padding prevents shadow clipping and eliminates square edge bugs -->
                        <Border Background="Transparent" Padding="12">
                            <Border Background="#1C1C1E"
                                    BorderBrush="#333338"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    MinWidth="168"
                                    Padding="4,5,4,5">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="0" Color="#000000" Opacity="0.65"/>
                                </Border.Effect>
                                <StackPanel IsItemsHost="True"/>
                            </Border>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Centered Clean 1px Separator Style (Photo 3 Exact Match) -->
        <Style x:Key="AppDrawerSeparatorStyle" TargetType="Separator">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="#2C2C30" Margin="8,0" HorizontalAlignment="Stretch" SnapsToDevicePixels="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AppDrawerMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#DCDCDC"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="4" Padding="10,0">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" ContentSource="Icon" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2D2D32"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AppDrawerMenuItemDestructive" TargetType="MenuItem" BasedOn="{StaticResource AppDrawerMenuItem}">
            <Setter Property="Foreground" Value="#FA5050"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="4" Padding="10,0">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" ContentSource="Icon" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#342022"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Three Dots Button Style: Solid Dark Container, Pure Black on Hover with Crisp White Dots -->
        <Style x:Key="AppDotsButtonStyle" TargetType="Button">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="DotBg" Width="26" Height="26" CornerRadius="13"
                                Background="#1A1C23" BorderBrush="#333338" BorderThickness="1">
                            <TextBlock x:Name="DotText" Text="···" FontSize="15" FontWeight="Bold" Foreground="#94A3B8"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-4,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DotBg" Property="Background" Value="#000000"/>
                                <Setter TargetName="DotBg" Property="BorderBrush" Value="#555866"/>
                                <Setter TargetName="DotText" Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding ContextMenu.IsOpen, RelativeSource={RelativeSource Self}}" Value="True">
                                <Setter TargetName="DotBg" Property="Background" Value="#000000"/>
                                <Setter TargetName="DotBg" Property="BorderBrush" Value="#555866"/>
                                <Setter TargetName="DotText" Property="Foreground" Value="#FFFFFF"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border, AncestorLevel=1}}" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ContextMenu.IsOpen, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Apple Dynamic Island Style 3-Stop Mode Slider Style (Photo 4) -->
        <Style x:Key="DynamicIslandSliderStyle" TargetType="Slider">
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <!-- Base Track Bar (Rounded Capsule) -->
                            <Border Height="7" CornerRadius="3.5" Background="#161820" BorderBrush="#252A36" BorderThickness="1" Margin="10,0"/>

                            <!-- Interactive Track with Decrease / Increase RepeatButtons and Thumb -->
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                        <RepeatButton.Style>
                                            <Style TargetType="RepeatButton">
                                                <Setter Property="OverridesDefaultStyle" Value="True"/>
                                                <Setter Property="IsTabStop" Value="False"/>
                                                <Setter Property="Focusable" Value="False"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="RepeatButton">
                                                            <Border Height="7" CornerRadius="3.5,0,0,3.5" Margin="10,0,0,0">
                                                                <Border.Background>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                        <GradientStop Color="#059669" Offset="0"/>
                                                                        <GradientStop Color="#10B981" Offset="1"/>
                                                                    </LinearGradientBrush>
                                                                </Border.Background>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </RepeatButton.Style>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                        <RepeatButton.Style>
                                            <Style TargetType="RepeatButton">
                                                <Setter Property="OverridesDefaultStyle" Value="True"/>
                                                <Setter Property="IsTabStop" Value="False"/>
                                                <Setter Property="Focusable" Value="False"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="RepeatButton">
                                                            <Rectangle Fill="Transparent"/>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </RepeatButton.Style>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="24" Height="24" Cursor="Hand">
                                        <Thumb.Style>
                                            <Style TargetType="Thumb">
                                                <Setter Property="OverridesDefaultStyle" Value="True"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Grid>
                                                                <!-- Glowing Outer Ring (Photo 4 Style) -->
                                                                <Ellipse Width="22" Height="22" Fill="#3310B981" Stroke="#10B981" StrokeThickness="1.5">
                                                                    <Ellipse.Effect>
                                                                        <DropShadowEffect Color="#10B981" BlurRadius="8" ShadowDepth="0" Opacity="0.85"/>
                                                                    </Ellipse.Effect>
                                                                </Ellipse>
                                                                <!-- White Solid Core -->
                                                                <Ellipse Width="9" Height="9" Fill="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Thumb.Style>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Dim Backdrop Overlay (Covers the entire window & sidebar with AAA Deep Dim) -->
    <Grid Background="#D8000000" MouseLeftButtonDown="Backdrop_MouseLeftButtonDown">
        <!-- Top Sheet / Drawer with razor-thin 3px left/right margins and top-to-bottom layout -->
        <Border x:Name="DrawerPanel"
                VerticalAlignment="Top"
                Height="740"
                Margin="3,0,3,0"
                Background="Transparent"
                BorderThickness="0"
                CornerRadius="0,0,24,24"
                MouseLeftButtonDown="DrawerPanel_MouseLeftButtonDown">

            <Border.RenderTransform>
                <TranslateTransform x:Name="DrawerTranslate" Y="0"/>
            </Border.RenderTransform>

            <Border.Effect>
                <DropShadowEffect BlurRadius="45" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.95"/>
            </Border.Effect>

            <Grid>
                <!-- Clean Dark Background (#0A0A0A) with Curved Bottom Corners (No Stroke / Border) -->
                <Border x:Name="DrawerInnerBackground"
                        Background="#0A0A0A"
                        BorderThickness="0"
                        CornerRadius="0,0,24,24"/>

                <!-- ═══ DRAWER CONTENT ═══ -->
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Row 0: Top Draggable Title Bar (Window controls, Left model badge, Centered App Title) -->
                        <RowDefinition Height="46"/>
                        <!-- Row 1: Top Header (Library Title, Back, Search, Controls) -->
                        <RowDefinition Height="Auto"/>
                        <!-- Row 2: Library App Tiles (Image 4 Style, Only Installed + Settings + Add APK) -->
                        <RowDefinition Height="*"/>
                        <!-- Row 3: Centered Enlarged Clickable Bottom Pull Handle -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ═══ ROW 0: TOP TITLE BAR (Draggable, Inset Divider Line) ═══ -->
                    <Border x:Name="DrawerTitleBar" Grid.Row="0" Height="46" Background="Transparent"
                            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <Grid>
                            <!-- Left: Beta Label Only (Windows & GameLoop badge removed per request) -->
                            <StackPanel HorizontalAlignment="Left" Orientation="Horizontal" Margin="24,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Beta" FontFamily="{StaticResource PrimaryFont}"
                                           FontSize="10.5" FontWeight="SemiBold" Foreground="#38BDF8"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Center: LAG KILLER BY XENOM (Centered across the ENTIRE window width!) -->
                            <TextBlock x:Name="CenterAppTitle" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontFamily="{StaticResource PrimaryFont}" FontSize="13" FontWeight="Bold">
                                <Run Text="LAG KILLER BY " Foreground="{StaticResource TextPrimaryBrush}"/>
                                <Run Text="XENOM" Foreground="{StaticResource AccentElectricBlueBrush}" FontWeight="ExtraBold"/>
                            </TextBlock>

                            <!-- Right: Window Controls (Minimize & Close) -->
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                                <Button Content="─" Click="Minimize_Click" Style="{StaticResource TitleBarButton}" ToolTip="Minimize"/>
                                <Button Content="✕" Click="Close_Click" Style="{StaticResource TitleBarCloseButton}" ToolTip="Close"/>
                            </StackPanel>

                            <!-- Inset Divider Line (Matches Main Title Bar) -->
                            <Border Height="1" VerticalAlignment="Bottom" Margin="22,0,22,0" Background="#1E202A"/>
                        </Grid>
                    </Border>

                    <!-- ═══ ROW 1: TOP HEADER & CONTROLS (Back Button Removed, Library Left-Aligned) ═══ -->
                    <Grid Grid.Row="1" Margin="24,14,24,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Library Title & Subtitle (At Far Left) -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Library" FontFamily="{StaticResource PrimaryFont}" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock Text="From GameLoop's own app list. Refresh while GameLoop runs to add versions and running status."
                                       FontSize="11.5" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Right: Status Badge, Search Box, Refresh & Uninstall Mode -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- GameLoop Version & Running Status Badge (Orange Blinking Idle / Green Solid Running) -->
                            <Border x:Name="StatusBadgeBorder" Background="#1C1E22" BorderBrush="#282B33" BorderThickness="1" CornerRadius="12" Padding="12,6" Margin="0,0,12,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse x:Name="StatusDot" Width="6.5" Height="6.5" Fill="#F59E0B" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="StatusText" Text="Detecting GameLoop..." FontFamily="{StaticResource PrimaryFont}" FontSize="11" FontWeight="SemiBold" Foreground="#FDBA74" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Modern Minimalist Search Bar (Matching Reference Photo with / Shortcut Badge) -->
                            <Border x:Name="SearchBorder" Width="184" Height="34"
                                    Background="#0E0E10"
                                    BorderBrush="#26262B"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Margin="0,0,10,0"
                                    Padding="10,0,8,0"
                                    Cursor="IBeam"
                                    MouseLeftButtonDown="SearchBorder_MouseLeftButtonDown">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Left: Search Magnifying Glass Icon -->
                                    <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="12.5" Foreground="#71717A" Margin="0,0,8,0" VerticalAlignment="Center"/>

                                    <!-- Center: TextBox & Search Placeholder -->
                                    <Grid Grid.Column="1" VerticalAlignment="Center">
                                        <TextBox x:Name="SearchBox"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Foreground="#FFFFFF"
                                                 FontSize="12"
                                                 FontFamily="{StaticResource PrimaryFont}"
                                                 VerticalAlignment="Center"
                                                 CaretBrush="#FFFFFF"
                                                 GotFocus="SearchBox_GotFocus"
                                                 LostFocus="SearchBox_LostFocus"
                                                 TextChanged="SearchBox_TextChanged"/>
                                        <TextBlock x:Name="SearchPlaceholder"
                                                   Text="Search"
                                                   FontSize="12"
                                                   FontFamily="{StaticResource PrimaryFont}"
                                                   Foreground="#71717A"
                                                   VerticalAlignment="Center"
                                                   IsHitTestVisible="False"/>
                                    </Grid>

                                    <!-- Right: Keyboard Shortcut Badge [ / ] -->
                                    <Border x:Name="SearchSlashBadge" Grid.Column="2" Width="19" Height="19" CornerRadius="4.5" Background="#222226" VerticalAlignment="Center" Margin="4,0,0,0">
                                        <TextBlock Text="/" FontSize="11" FontWeight="SemiBold" Foreground="#8E8E93" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Refresh Button (↻) with Spin Animation -->
                            <Button x:Name="RefreshBtn" Click="RefreshBtn_Click"
                                    Width="34" Height="34"
                                    Background="#1C1E22"
                                    BorderBrush="#282B33"
                                    BorderThickness="1"
                                    Margin="0,0,8,0"
                                    Cursor="Hand"
                                    ToolTip="Refresh GameLoop &amp; App Status">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                                        <TextBlock x:Name="RefreshIconText" Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                                            <TextBlock.RenderTransform>
                                                                <RotateTransform x:Name="RefreshRotate" Angle="0"/>
                                                            </TextBlock.RenderTransform>
                                                        </TextBlock>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#242832"/>
                                                            <Setter Property="BorderBrush" Value="#00D4FF"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Delete / Uninstall Mode Toggle Button (Red Styled, Full Red on Hover) -->
                            <Button x:Name="DeleteModeBtn" Click="DeleteModeBtn_Click"
                                    Width="34" Height="34"
                                    Cursor="Hand"
                                    ToolTip="Uninstall Mode">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#1C1E22"/>
                                        <Setter Property="BorderBrush" Value="#282B33"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                                        <TextBlock x:Name="TrashIcon" Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="#EF4444" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="BtnBorder" Property="Background" Value="#EF4444"/>
                                                            <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#EF4444"/>
                                                            <Setter TargetName="TrashIcon" Property="Foreground" Value="#FFFFFF"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- ═══ ROW 2: LIBRARY APP ICONS & SKELETON REFRESH SHIMMER ═══ -->
                    <Grid Grid.Row="2">
                        <!-- Real App Tiles -->
                        <ScrollViewer x:Name="RealAppsScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,0,24,16">
                            <WrapPanel Orientation="Horizontal">

                            <!-- ═══ APP 1: Play Store (First in Order) ═══ -->
                            <Border x:Name="PlayStoreTile" Width="110" Height="136" Margin="0,0,16,16" Background="Transparent" CornerRadius="14" Cursor="Hand" MouseLeftButtonDown="PlayStore_Click">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#1A1E2B"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <!-- App Icon: White authentic squircle card with filled Google Play logo -->
                                        <Grid Width="72" Height="72">
                                            <Path Width="72" Height="72"
                                                  Data="M 36,0 C 64.8,0 72,7.2 72,36 C 72,64.8 64.8,72 36,72 C 7.2,72 0,64.8 0,36 C 0,7.2 7.2,0 36,0 Z"
                                                  Fill="#FFFFFF">
                                                <Path.Effect>
                                                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.4"/>
                                                </Path.Effect>
                                            </Path>
                                            <Image Source="/Assets/playstore_icon.png" Stretch="Uniform" Margin="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                        <TextBlock Text="Play Store" FontFamily="{StaticResource PrimaryFont}" FontSize="12" FontWeight="Bold" Foreground="#F1F5F9" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                    </StackPanel>

                                    <!-- Delete Mode Badge (Visible in Uninstall Mode) -->
                                    <Border x:Name="PlayStoreDeleteBadge" Visibility="Collapsed" Background="#EF4444" CornerRadius="6" Padding="6,3" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0">
                                        <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="#FFFFFF"/>
                                    </Border>

                                    <!-- Hidden Badge (Shown only when F9 reveals hidden apps) -->
                                    <Border x:Name="PlayStoreHiddenBadge" Visibility="Collapsed" Background="#D97706" CornerRadius="6" Padding="5,2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-4,-4,0,0">
                                        <TextBlock Text="Hidden" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    </Border>

                                    <!-- Three dots button (Hover Only) -->
                                    <Button x:Name="PlayStoreDotsBtn" Click="DotsButton_Click" MouseEnter="DotsButton_MouseEnter" MouseLeave="DotsButton_MouseLeave" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0" Style="{StaticResource AppDotsButtonStyle}">
                                        <Button.ContextMenu>
                                            <ContextMenu Style="{StaticResource AppDrawerContextMenu}" MouseEnter="ContextMenu_MouseEnter" MouseLeave="ContextMenu_MouseLeave" Closed="ContextMenu_Closed">
                                                <MenuItem Header="Launch Play Store" Click="LaunchPlayStore_Click" Style="{StaticResource AppDrawerMenuItem}">
                                                    <MenuItem.Icon>
                                                        <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="#00D4FF"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="App Info" Click="AppInfo_Click" Tag="com.android.vending" Style="{StaticResource AppDrawerMenuItem}">
                                                    <MenuItem.Icon>
                                                        <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="#94A3B8"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="Force Stop" Click="ForceStop_Click" Tag="com.android.vending" Style="{StaticResource AppDrawerMenuItem}">
                                                    <MenuItem.Icon>
                                                        <TextBlock Text="&#xE71A;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="#F59E0B"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="Clear Data" Click="ClearData_Click" Tag="com.android.vending" Style="{StaticResource AppDrawerMenuItem}">
                                                    <MenuItem.Icon>
                                                        <TextBlock Text="&#xE894;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="#94A3B8"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem x:Name="MenuItemHidePlayStore" Header="Hide App" Click="HideApp_Click" Tag="PlayStore" Style="{StaticResource AppDrawerMenuItem}">
                                                    <MenuItem.Icon>
                                                        <TextBlock Text="&#xED1A;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="#38BDF8"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <Separator Style="{StaticResource AppDrawerSeparatorStyle}"/>
                                                <MenuItem Header="Uninstall" Click="Uninstall_Click" Tag="com.android.vending" Style="{StaticResource AppDrawerMenuItemDestructive}">
                                                    <MenuItem.Icon>
                                                        <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="#EF4444"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- ═══ APP 2: Settings (Second in Order) ═══ -->
                            <Border x:Name="SettingsTile" Width="110" Height="136" Margin="0,0,16,16" Background="Transparent" CornerRadius="14" Cursor="Hand" MouseLeftButtonDown="Settings_Click">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#1A1E2B"/>
                                            </Trigger>
