                    VerticalAlignment="Bottom"
                    Margin="36,0,0,44"
                    Width="430"
                    Visibility="Collapsed">

            <!-- ─── BOX 1: HARDWARE TELEMETRY SUMMARY (CPU | RAM | GPU | DISK) ─── -->
            <Border x:Name="TelemetryBox"
                    Height="42"
                    CornerRadius="14"
                    Background="#0A0A0A"
                    BorderBrush="#22242B"
                    BorderThickness="1"
                    Padding="14,0"
                    Margin="0,0,0,10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Color="#000000" Opacity="0.6"/>
                </Border.Effect>
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <!-- 1. CPU -->
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <!-- 2. RAM -->
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <!-- 3. GPU -->
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <!-- 4. Disk -->
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- CPU -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="CPU" FontFamily="{StaticResource PrimaryFont}" FontSize="11.5" FontWeight="SemiBold" Foreground="#8E8E93" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TelemetryCpuVal" Text="16%" FontFamily="{StaticResource PrimaryFont}" FontSize="12.5" FontWeight="Bold" Foreground="#FFFFFF" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Divider 1 -->
                    <Border Grid.Column="1" Width="1" Height="14" Background="#262832" VerticalAlignment="Center" Margin="2,0"/>

                    <!-- RAM -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="RAM" FontFamily="{StaticResource PrimaryFont}" FontSize="11.5" FontWeight="SemiBold" Foreground="#8E8E93" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TelemetryRamVal" Text="59%" FontFamily="{StaticResource PrimaryFont}" FontSize="12.5" FontWeight="Bold" Foreground="#FFFFFF" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Divider 2 -->
                    <Border Grid.Column="3" Width="1" Height="14" Background="#262832" VerticalAlignment="Center" Margin="2,0"/>

                    <!-- GPU -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="GPU" FontFamily="{StaticResource PrimaryFont}" FontSize="11.5" FontWeight="SemiBold" Foreground="#8E8E93" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TelemetryGpuVal" Text="24%" FontFamily="{StaticResource PrimaryFont}" FontSize="12.5" FontWeight="Bold" Foreground="#FFFFFF" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Divider 3 -->
                    <Border Grid.Column="5" Width="1" Height="14" Background="#262832" VerticalAlignment="Center" Margin="2,0"/>

                    <!-- Disk -->
                    <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Disk" FontFamily="{StaticResource PrimaryFont}" FontSize="11.5" FontWeight="SemiBold" Foreground="#8E8E93" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TelemetryDiskVal" Text="42%" FontFamily="{StaticResource PrimaryFont}" FontSize="12.5" FontWeight="Bold" Foreground="#FFFFFF" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ─── BOX 2: MODE STEPPER SLIDER (DYNAMIC ISLAND STYLE - PHOTO 4) ─── -->
            <Border x:Name="ModeBox"
                    Height="106"
                    CornerRadius="16"
                    Background="#0A0A0A"
                    BorderBrush="#22242B"
                    BorderThickness="1"
                    Padding="16,10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.65"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Row 0: Header (Icon + "Mode" Title + Status Badge) -->
                        <RowDefinition Height="Auto"/>
                        <!-- Row 1: Draggable Slider Track -->
                        <RowDefinition Height="Auto"/>
                        <!-- Row 2: Mode Labels (Normal, Gaming, Ultra Gaming) -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header Row -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Controller / Speed Icon -->
                            <TextBlock x:Name="ModeHeaderIcon" Text="&#xE7FC;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="#10B981" VerticalAlignment="Center"/>
                            <TextBlock Text="Mode" FontFamily="{StaticResource PrimaryFont}" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Status Badge (Photo 4 Style) -->
                        <Border x:Name="ModeBadgeBorder" HorizontalAlignment="Right" VerticalAlignment="Center"
                                CornerRadius="9" Background="#0E2822" BorderBrush="#10B981" BorderThickness="1" Padding="9,3">
                            <TextBlock x:Name="ModeBadgeText" Text="Active • Turbo" FontFamily="{StaticResource PrimaryFont}"
                                       FontSize="10.5" FontWeight="Bold" Foreground="#10B981"/>
                        </Border>
                    </Grid>

                    <!-- Center Row: Draggable Slider & Track -->
                    <Grid Grid.Row="1" Height="26" VerticalAlignment="Center" Margin="0,0,0,6">
                        <!-- Background Tick Dots (3 Stops: 0=Left, 1=Center, 2=Right) -->
                        <Grid Margin="12,0" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="#1E222D" HorizontalAlignment="Left"/>
                            <Ellipse Width="6" Height="6" Fill="#1E222D" HorizontalAlignment="Center"/>
                            <Ellipse Width="6" Height="6" Fill="#1E222D" HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- Draggable WPF Slider -->
                        <Slider x:Name="ModeSlider"
                                Style="{StaticResource DynamicIslandSliderStyle}"
                                Minimum="0" Maximum="2"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                Value="1"
                                ValueChanged="ModeSlider_ValueChanged"
                                VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Bottom Row: 3 Mode Labels (Clickable) -->
                    <Grid Grid.Row="2" Margin="2,0,2,0">
                        <!-- Stop 0: Normal -->
                        <TextBlock x:Name="ModeLabelNormal" Text="Normal" Tag="0"
                                   FontFamily="{StaticResource PrimaryFont}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#6B7280" HorizontalAlignment="Left" Cursor="Hand"
                                   MouseLeftButtonDown="ModeLabel_Click"/>

                        <!-- Stop 1: Gaming -->
                        <TextBlock x:Name="ModeLabelGaming" Text="Gaming" Tag="1"
                                   FontFamily="{StaticResource PrimaryFont}" FontSize="11" FontWeight="Bold"
                                   Foreground="#10B981" HorizontalAlignment="Center" Cursor="Hand"
                                   MouseLeftButtonDown="ModeLabel_Click"/>

                        <!-- Stop 2: Ultra Gaming -->
                        <TextBlock x:Name="ModeLabelUltra" Text="Ultra Gaming" Tag="2"
                                   FontFamily="{StaticResource PrimaryFont}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#6B7280" HorizontalAlignment="Right" Cursor="Hand"
                                   MouseLeftButtonDown="ModeLabel_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </StackPanel>

        <!-- ═══ FLOATING NAVIGATION BAR (SHORTCUT DOCK) ═══ -->
        <Border x:Name="FloatingNavBar"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,48"
                Width="160" Height="56"
                CornerRadius="15"
                Background="#000000"
                BorderThickness="0"
                Padding="4"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="3" Direction="270" Color="#000000" Opacity="0.7"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- 1. Home Icon Tab (&#xE80F; - Active on Home) -->
                <Border x:Name="NavTabPointer" Tag="0" MouseLeftButtonDown="NavTab_Click" MouseEnter="NavTab_MouseEnter" MouseLeave="NavTab_MouseLeave"
                        Cursor="Hand" Width="48" Height="48" CornerRadius="11" Background="#2B2B2B" ToolTip="Home / Apps">
                    <TextBlock Text="&#xE80F;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- 2. Gaming Mode Controller Tab (&#xE7FC;) -->
                <Border x:Name="NavTabPalette" Tag="1" MouseLeftButtonDown="NavTab_Click" MouseEnter="NavTab_MouseEnter" MouseLeave="NavTab_MouseLeave"
                        Cursor="Hand" Width="48" Height="48" CornerRadius="11" Background="Transparent" Margin="4,0,0,0" ToolTip="Gaming Mode &amp; Shortcuts">
                    <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource IconFont}" FontSize="19" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- 3. Smartphone Tab -->
                <Border x:Name="NavTabPhone" Tag="2" MouseLeftButtonDown="NavTab_Click" MouseEnter="NavTab_MouseEnter" MouseLeave="NavTab_MouseLeave"
                        Cursor="Hand" Width="48" Height="48" CornerRadius="11" Background="Transparent" Margin="4,0,0,0" ToolTip="Device &amp; Profiles">
                    <Image Source="/Assets/nav_phone.png" Width="18" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>