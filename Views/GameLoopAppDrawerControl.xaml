<UserControl x:Class="XenomOptimizer.Views.GameLoopAppDrawerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1340">

    <!-- Dim Backdrop Overlay (Covers the entire window & sidebar) -->
    <Grid Background="#B0000000" MouseLeftButtonDown="Backdrop_MouseLeftButtonDown">
        <!-- Bottom Sheet / Drawer (Slides up from the bottom, covers sidebar and page) -->
        <Border x:Name="DrawerPanel"
                VerticalAlignment="Bottom"
                Height="780"
                Background="#0D0F17"
                BorderBrush="#1E2436"
                BorderThickness="1,1,1,0"
                CornerRadius="24,24,0,0"
                ClipToBounds="True"
                MouseLeftButtonDown="DrawerPanel_MouseLeftButtonDown">

            <Border.Effect>
                <DropShadowEffect BlurRadius="32" ShadowDepth="0" Direction="0" Color="#000000" Opacity="0.9"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <!-- Row 0: Top Drag Handle & Back Button Header -->
                    <RowDefinition Height="Auto"/>
                    <!-- Row 1: App Market Title & Category Filters -->
                    <RowDefinition Height="Auto"/>
                    <!-- Row 2: Scrollable App Cards Grid -->
                    <RowDefinition Height="*"/>
                    <!-- Row 3: Bottom Status Bar -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Background Subtle Ambient Glow -->
                <Border Grid.RowSpan="4" IsHitTestVisible="False">
                    <Border.Background>
                        <RadialGradientBrush Center="0.5,0.0" RadiusX="0.6" RadiusY="0.4">
                            <GradientStop Color="#1200D4FF" Offset="0.0"/>
                            <GradientStop Color="#00000000" Offset="1.0"/>
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>

                <!-- ═══ ROW 0: TOP HANDLE & BACK BUTTON HEADER ═══ -->
                <Grid Grid.Row="0" Margin="24,14,24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Back Button: Closes the drawer and restores the normal left side menu -->
                    <Button Grid.Column="0"
                            Command="{Binding CloseAppDrawerCommand}"
                            Background="#161B28"
                            BorderBrush="#252F46"
                            BorderThickness="1"
                            Padding="14,8"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="10"
                                                    Padding="{TemplateBinding Padding}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE72B;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="#00D4FF" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Back to Main Menu" FontSize="12" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#1E2638"/>
                                                    <Setter Property="BorderBrush" Value="#00D4FF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Center Pill Pull-Handle (Image 2 Style) -->
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="48" Height="4" CornerRadius="2" Background="#334155" Margin="0,0,0,2"/>
                        <TextBlock Text="GAMELOOP APP DRAWER" FontSize="9.5" FontWeight="Bold" Foreground="#475569" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Right Quick Close / Status Badge -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#10251F" BorderBrush="#10B981" BorderThickness="1" CornerRadius="8" Padding="10,5" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Fill="#10B981" Margin="0,0,6,0"/>
                                <TextBlock Text="GameLoop Environment" FontSize="11" FontWeight="SemiBold" Foreground="#10B981"/>
                            </StackPanel>
                        </Border>

                        <Button Command="{Binding CloseAppDrawerCommand}"
                                Width="34" Height="34"
                                Background="#161B28"
                                BorderBrush="#252F46"
                                BorderThickness="1"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                                    <TextBlock Text="✕" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#EF4444"/>
                                                        <Setter Property="BorderBrush" Value="#EF4444"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ═══ ROW 1: TITLE & CATEGORY FILTER ═══ -->
                <Border Grid.Row="1" Margin="28,16,28,12" Background="#11141E" BorderBrush="#1C2234" BorderThickness="1" CornerRadius="14" Padding="20,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="GameLoop AppMarket &amp; Launcher" FontSize="18" FontWeight="ExtraBold" Foreground="#FFFFFF"/>
                                <Border CornerRadius="6" Background="#18233A" BorderBrush="#00D4FF" BorderThickness="1" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Instant Launcher" FontSize="10" FontWeight="Bold" Foreground="#00D4FF"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Direct access to PUBG Mobile, internal Android F9 Settings, OBB storage &amp; APK sideloading without opening menus"
                                       FontSize="12" Foreground="#94A3B8"/>
                        </StackPanel>

                        <!-- Sideload Button on Header -->
                        <Button Grid.Column="1"
                                Command="{Binding InstallApkFileCommand}"
                                Background="#10B981"
                                BorderThickness="0"
                                Padding="16,8"
                                Cursor="Hand"
                                VerticalAlignment="Center">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="&#xE898;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="#FFFFFF" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Install APK File" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#059669"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>

                <!-- ═══ ROW 2: SCROLLABLE APP CARDS ═══ -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,4,28,12">
                    <StackPanel>
                        <!-- Featured Top Hero Card: PUBG Mobile Global -->
                        <Border CornerRadius="16" Background="#131722" BorderBrush="#25324E" BorderThickness="1.5" Margin="0,0,0,16" Padding="24,20">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Color="#00D4FF" Opacity="0.15"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Game Icon Banner -->
                                <Border Grid.Column="0" Width="68" Height="68" CornerRadius="16" Background="#1E2638" BorderBrush="#00D4FF" BorderThickness="1.5" Margin="0,0,20,0" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource IconFont}" FontSize="32" Foreground="#00D4FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Info -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="PUBG Mobile (Global Edition)" FontSize="17" FontWeight="Bold" Foreground="#FFFFFF"/>
                                        <Border CornerRadius="6" Background="#152E24" BorderBrush="#10B981" BorderThickness="1" Padding="7,2" Margin="10,0,0,0">
                                            <TextBlock Text="120 FPS • Ultra HD 2K" FontSize="10" FontWeight="Bold" Foreground="#10B981"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Direct game launch into GameLoop with 120 FPS high-refresh rate unlocker, calibrated Smart 2K keymapping, and peak rendering stability."
                                               FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,16,0"/>
                                </StackPanel>

                                <!-- Launch Button -->
                                <Button Grid.Column="2"
                                        Command="{Binding LaunchPubgCommand}"
                                        Height="46" Width="170"
                                        Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="PlayBtnBorder" CornerRadius="12" Background="#00D4FF">
                                                            <Border.Effect>
                                                                <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#00D4FF" Opacity="0.5"/>
                                                            </Border.Effect>
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="#000000" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="PLAY GAME" FontSize="13" FontWeight="ExtraBold" Foreground="#000000" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="PlayBtnBorder" Property="Background" Value="#38BDF8"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Apps Grid (2 Columns, 3 Rows) -->
                        <UniformGrid Columns="2" Margin="0,0,0,8">
                            <!-- Card 1: Android System Settings (F9 Shortcut) -->
                            <Border CornerRadius="14" Background="#121520" BorderBrush="#1F2638" BorderThickness="1" Margin="0,0,8,14" Padding="18,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="12" Background="#182032" BorderBrush="#00D4FF" BorderThickness="1" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="22" Foreground="#00D4FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Android Settings" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                                            <Border CornerRadius="5" Background="#1B2B3E" BorderBrush="#38BDF8" BorderThickness="1" Padding="6,1.5" Margin="8,0,0,0">
                                                <TextBlock Text="F9 Direct" FontSize="9.5" FontWeight="Bold" Foreground="#38BDF8"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Direct access to internal Android VM settings, developer options, language &amp; app permissions."
                                                   FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <Button Grid.Column="2"
                                            Command="{Binding LaunchSettingsCommand}"
                                            Background="#1E293B"
                                            BorderBrush="#334155"
                                            BorderThickness="1"
                                            Padding="14,8"
                                            Height="38"
                                            Cursor="Hand"
                                            VerticalAlignment="Center">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                                                                <TextBlock Text="Open" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#00D4FF"/>
                                                                    <Setter Property="BorderBrush" Value="#00D4FF"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Card 2: FX File Explorer / OBB Manager -->
                            <Border CornerRadius="14" Background="#121520" BorderBrush="#1F2638" BorderThickness="1" Margin="8,0,0,14" Padding="18,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="12" Background="#241E15" BorderBrush="#F59E0B" BorderThickness="1" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xED25;" FontFamily="{StaticResource IconFont}" FontSize="22" Foreground="#F59E0B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="FX File Explorer" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                                            <Border CornerRadius="5" Background="#2C2417" BorderBrush="#F59E0B" BorderThickness="1" Padding="6,1.5" Margin="8,0,0,0">
                                                <TextBlock Text="OBB &amp; Data" FontSize="9.5" FontWeight="Bold" Foreground="#F59E0B"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Explore internal /Android/data and /obb folders to transfer custom textures, configs &amp; saves."
                                                   FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <Button Grid.Column="2"
                                            Command="{Binding LaunchFilesCommand}"
                                            Background="#1E293B"
                                            BorderBrush="#334155"
                                            BorderThickness="1"
                                            Padding="14,8"
                                            Height="38"
                                            Cursor="Hand"
                                            VerticalAlignment="Center">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                                                                <TextBlock Text="Open" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#F59E0B"/>
                                                                    <Setter Property="BorderBrush" Value="#F59E0B"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Card 3: Android Web Browser -->
                            <Border CornerRadius="14" Background="#121520" BorderBrush="#1F2638" BorderThickness="1" Margin="0,0,8,14" Padding="18,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="12" Background="#141E30" BorderBrush="#3B82F6" BorderThickness="1" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE12B;" FontFamily="{StaticResource IconFont}" FontSize="22" Foreground="#3B82F6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Android Web Browser" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                                            <Border CornerRadius="5" Background="#1A2844" BorderBrush="#3B82F6" BorderThickness="1" Padding="6,1.5" Margin="8,0,0,0">
                                                <TextBlock Text="Web &amp; DL" FontSize="9.5" FontWeight="Bold" Foreground="#3B82F6"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Browse the web inside GameLoop to download APKs, GFX tools, or updates directly."
                                                   FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <Button Grid.Column="2"
                                            Command="{Binding LaunchBrowserCommand}"
                                            Background="#1E293B"
                                            BorderBrush="#334155"
                                            BorderThickness="1"
                                            Padding="14,8"
                                            Height="38"
                                            Cursor="Hand"
                                            VerticalAlignment="Center">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                                                                <TextBlock Text="Open" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#3B82F6"/>
                                                                    <Setter Property="BorderBrush" Value="#3B82F6"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Card 4: Official Tencent AppMarket -->
                            <Border CornerRadius="14" Background="#121520" BorderBrush="#1F2638" BorderThickness="1" Margin="8,0,0,14" Padding="18,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="12" Background="#211832" BorderBrush="#8B5CF6" BorderThickness="1" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE719;" FontFamily="{StaticResource IconFont}" FontSize="22" Foreground="#8B5CF6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Tencent AppMarket" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                                            <Border CornerRadius="5" Background="#2A1E42" BorderBrush="#8B5CF6" BorderThickness="1" Padding="6,1.5" Margin="8,0,0,0">
                                                <TextBlock Text="Official Store" FontSize="9.5" FontWeight="Bold" Foreground="#8B5CF6"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Open the official GameLoop AppMarket store to browse games, update components &amp; login."
                                                   FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <Button Grid.Column="2"
                                            Command="{Binding LaunchAppMarketCommand}"
                                            Background="#1E293B"
                                            BorderBrush="#334155"
                                            BorderThickness="1"
                                            Padding="14,8"
                                            Height="38"
                                            Cursor="Hand"
                                            VerticalAlignment="Center">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                                                                <TextBlock Text="Open" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#8B5CF6"/>
                                                                    <Setter Property="BorderBrush" Value="#8B5CF6"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Card 5: Google Play Store -->
                            <Border CornerRadius="14" Background="#121520" BorderBrush="#1F2638" BorderThickness="1" Margin="0,0,8,0" Padding="18,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="12" Background="#281524" BorderBrush="#EC4899" BorderThickness="1" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="22" Foreground="#EC4899" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Google Play Store" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                                            <Border CornerRadius="5" Background="#361730" BorderBrush="#EC4899" BorderThickness="1" Padding="6,1.5" Margin="8,0,0,0">
                                                <TextBlock Text="Google Services" FontSize="9.5" FontWeight="Bold" Foreground="#EC4899"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Manage Google accounts, update Play Services, and download certified Play Store apps."
                                                   FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <Button Grid.Column="2"
                                            Command="{Binding LaunchPlayStoreCommand}"
                                            Background="#1E293B"
                                            BorderBrush="#334155"
                                            BorderThickness="1"
                                            Padding="14,8"
                                            Height="38"
                                            Cursor="Hand"
                                            VerticalAlignment="Center">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                                                                <TextBlock Text="Open" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#EC4899"/>
                                                                    <Setter Property="BorderBrush" Value="#EC4899"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Card 6: Direct Sideload APK -->
                            <Border CornerRadius="14" Background="#121520" BorderBrush="#1F2638" BorderThickness="1" Margin="8,0,0,0" Padding="18,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="12" Background="#122524" BorderBrush="#14B8A6" BorderThickness="1" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE898;" FontFamily="{StaticResource IconFont}" FontSize="22" Foreground="#14B8A6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Direct APK Sideload" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                                            <Border CornerRadius="5" Background="#152E2C" BorderBrush="#14B8A6" BorderThickness="1" Padding="6,1.5" Margin="8,0,0,0">
                                                <TextBlock Text="Local Package" FontSize="9.5" FontWeight="Bold" Foreground="#14B8A6"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Select any APK or XAPK from your PC to install directly into GameLoop without opening AppMarket."
                                                   FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <Button Grid.Column="2"
                                            Command="{Binding InstallApkFileCommand}"
                                            Background="#1E293B"
                                            BorderBrush="#334155"
                                            BorderThickness="1"
                                            Padding="14,8"
                                            Height="38"
                                            Cursor="Hand"
                                            VerticalAlignment="Center">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                                                                <TextBlock Text="Browse" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#14B8A6"/>
                                                                    <Setter Property="BorderBrush" Value="#14B8A6"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>

                <!-- ═══ ROW 3: STATUS BAR & FOOTER ═══ -->
                <Border Grid.Row="3" Background="#0A0C13" BorderBrush="#1A2030" BorderThickness="0,1,0,0" Padding="28,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE783;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="#00D4FF" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding AppDrawerStatusMessage, FallbackValue='Click any app above to launch directly inside GameLoop'}"
                                       FontSize="11.5" Foreground="#94A3B8" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Back Button Shortcut -->
                        <Button Grid.Column="1"
                                Command="{Binding CloseAppDrawerCommand}"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand">
                            <TextBlock Text="Close Drawer (Esc)" FontSize="11" Foreground="#64748B"/>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
