                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.ExitActions>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- 3. TIKTOK (Cyan #00F2FE) -> Expands left, reveals FOLLOW ME -->
                            <Button Command="{Binding OpenTikTokCommand}"
                                    Cursor="Hand" ToolTip="Follow Xenom on TikTok"
                                    Background="Transparent" BorderThickness="0" Padding="0"
                                    HorizontalAlignment="Right" Margin="0,0,0,8">
                                <Button.Template>
