                                    Background="Transparent" BorderThickness="0" Padding="0"
                                    HorizontalAlignment="Right" Margin="0,0,0,8">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="SocialBox" Height="40" Width="40" CornerRadius="20"
                                                Background="#181A22" BorderBrush="#262834" BorderThickness="1.5"
