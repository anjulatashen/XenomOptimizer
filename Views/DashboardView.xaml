<UserControl x:Class="XenomOptimizer.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:XenomOptimizer.Converters"
             xmlns:views="clr-namespace:XenomOptimizer.Views">

    <UserControl.Resources>
        <converters:MediaTypeToBrushConverter x:Key="MediaTypeToBrush"/>
        <converters:UsageToBrushConverter x:Key="UsageToBrush"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
        <converters:StringToColorBrushConverter x:Key="StringToBrush"/>
        <converters:PercentageToStrokeDashArrayConverter x:Key="PctToDash"/>
        <converters:ArcGaugeStrokeDashConverter x:Key="ArcGaugeDash"/>
        <converters:ArchPathDashConverter x:Key="ArchPathDash"/>

        <!-- ── Mini Slim ScrollBar for Storage Card (Podima podi scroll) ── -->
        <Style x:Key="MiniSlimScrollBarThumb" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="thumb" Width="3" CornerRadius="1.5" Background="#4A5568" HorizontalAlignment="Right" Margin="0,1,1,1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#38BDF8"/>
                                            <Setter Property="Width" Value="4.5"/>
                                            <Setter Property="CornerRadius" Value="2"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MiniSlimScrollBar" TargetType="ScrollBar">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource MiniSlimScrollBarThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MiniSlimScrollViewer" TargetType="ScrollViewer">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid Background="Transparent">
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                    Margin="{TemplateBinding Padding}"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}"
                                                    Content="{TemplateBinding Content}"
                                                    ContentTemplate="{TemplateBinding ContentTemplate}"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Style="{StaticResource MiniSlimScrollBar}"
                                       Orientation="Vertical"
                                       HorizontalAlignment="Right"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- STAGED HERO ANIMATIONS: Left Hero + Right Socials               -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="UserControl.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <!-- Left Hero Content glides in from top -->
                    <DoubleAnimation Storyboard.TargetName="HeroCardBox"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.6" BeginTime="0:0:0.1">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="HeroCardBox"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     From="-12" To="0" Duration="0:0:0.6" BeginTime="0:0:0.1">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>

                    <!-- Right Social Buttons glide in from right -->
                    <DoubleAnimation Storyboard.TargetName="SocialButtonsBox"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.6" BeginTime="0:0:0.25">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="SocialButtonsBox"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                     From="16" To="0" Duration="0:0:0.6" BeginTime="0:0:0.25">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <!-- NO SCROLLBAR: Content fits seamlessly with generous bezels -->
    <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" Padding="24,20,24,20">
        <StackPanel MaxWidth="1200">

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- 1. HAULIX LUXURY HERO SECTION (HORIZONTAL SPLIT BANNER)    -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <Border CornerRadius="22" BorderBrush="#20222B" BorderThickness="1.5"
                    Margin="0,12,0,14">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#16171B" Offset="0"/>
                        <GradientStop Color="#131417" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="3" Direction="270" Color="#000000" Opacity="0.5"/>
                </Border.Effect>

                <Grid>
                    <!-- ═══ TOPO ARTWORK: Seamlessly blended inside right side, clipped to border radius ═══ -->
                    <Border HorizontalAlignment="Right" Width="650"
                            CornerRadius="0,20,20,0" Margin="0,1.5,1.5,1.5"
                            Opacity="0.25" IsHitTestVisible="False">
                        <Border.Background>
                            <ImageBrush ImageSource="pack://application:,,,/Assets/topo_transparent.png"
                                        Stretch="UniformToFill"
                                        AlignmentX="Right"
                                        AlignmentY="Center"/>
                        </Border.Background>
                        <Border.OpacityMask>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00000000" Offset="0.0"/>
                                <GradientStop Color="#00000000" Offset="0.25"/>
                                <GradientStop Color="#15000000" Offset="0.45"/>
                                <GradientStop Color="#60000000" Offset="0.70"/>
                                <GradientStop Color="#FF000000" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Border.OpacityMask>
                    </Border>

                    <!-- ═══ FOREGROUND CONTENT (Margin 36,28) ═══ -->
                    <Grid x:Name="HeroContentGrid" Margin="36,28">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- ═══ LEFT COLUMN: Title, By Xenom, Description, Get Start (Vertically Centered) ═══ -->
                        <Border x:Name="HeroCardBox" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,28,0" Opacity="0">
                        <Border.RenderTransform>
                            <TranslateTransform Y="-10"/>
                        </Border.RenderTransform>
                        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">

                            <!-- Clean, High-End Title: WELCOME TO LAG KILLER (No jumping, No hover pop) -->
                            <TextBlock Text="WELCOME TO LAG KILLER"
                                       FontFamily="{StaticResource DisplayFont}"
                                       FontSize="30" FontWeight="Black"
                                       Foreground="#F3F6FA"
                                       Margin="0,0,0,10" HorizontalAlignment="Left">
                                <TextBlock.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.45"/>
                                </TextBlock.Effect>
                            </TextBlock>

                            <!-- BY XENOM -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">
                                <TextBlock Text="BY" FontFamily="{StaticResource DisplayFont}" FontSize="12" FontWeight="ExtraBold"
                                           Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="XENOM" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="Black"
                                           Foreground="{StaticResource AccentElectricBlueBrush}" VerticalAlignment="Center">
                                    <TextBlock.Effect>
                                        <DropShadowEffect BlurRadius="14" ShadowDepth="0" Color="#00D4FF" Opacity="0.5"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                            </StackPanel>

                            <!-- 2-Line Bio Description (Clean, Readable Typography) -->
                            <TextBlock FontFamily="{StaticResource PrimaryFont}" FontSize="13" Foreground="#94A3B8"
                                       LineHeight="21" Margin="0,0,0,18" HorizontalAlignment="Left">
                                <Run Text="My name is Xenom. This application is 100% free to optimize Windows &amp; GameLoop for peak FPS and zero stutter."/><LineBreak/>
                                <Run Text="Want to contact me or get support? Join our official community:" Foreground="#64748B"/>
                            </TextBlock>

                            <!-- Minimal Compact GET START Link -->
                            <Button Command="{Binding NavigateToOptimizeCommand}"
                                    Cursor="Hand" ToolTip="Open Windows &amp; GameLoop Optimization Suite"
                                    Background="Transparent" BorderThickness="0" Padding="0"
                                    HorizontalAlignment="Left">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <TextBlock x:Name="GetStartTxt" Text="GET START →"
                                                   FontFamily="{StaticResource PrimaryFont}" FontSize="12.5" FontWeight="Black"
                                                   Foreground="{StaticResource AccentElectricBlueBrush}">
                                            <TextBlock.Effect>
                                                <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#00D4FF" Opacity="0.45"/>
                                            </TextBlock.Effect>
                                        </TextBlock>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="GetStartTxt" Property="Foreground" Value="#60E8FF"/>
                                                <Setter TargetName="GetStartTxt" Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect BlurRadius="14" ShadowDepth="0" Color="#00D4FF" Opacity="0.9"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

