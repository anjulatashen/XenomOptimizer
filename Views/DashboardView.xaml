                                                                             From="0" To="1" Duration="0:0:0.18" BeginTime="0:0:0.04"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
