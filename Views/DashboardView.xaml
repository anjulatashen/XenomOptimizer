                                                          Fill="#FFFFFF" Width="17" Height="17" Stretch="Uniform" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock x:Name="SocialText" Text="FOLLOW ME"
                                                           FontFamily="{StaticResource PrimaryFont}" FontSize="11" FontWeight="Black"
