<Window x:Class="XenomOptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:XenomOptimizer.ViewModels"
        xmlns:views="clr-namespace:XenomOptimizer.Views"
        xmlns:gif="http://wpfanimatedgif.codeplex.com"
        Title="LAG KILLER BY XENOM (Beta)"
        Icon="Assets/xenom.ico"
        Height="885" Width="1340"
        WindowStartupLocation="Manual"
        Background="{StaticResource BgDarkestBrush}"
        WindowStyle="SingleBorderWindow"
        AllowsTransparency="False"
        ResizeMode="CanMinimize">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46"
                      ResizeBorderThickness="0"
                      GlassFrameThickness="1"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Page DataTemplates - maps ViewModels to Views -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:WindowsOptimizationViewModel}">
            <views:WindowsOptimizationView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OptimizerFrameGenViewModel}">
            <views:OptimizerFrameGenView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GameLoopOptimizationViewModel}">
            <views:GameLoopOptimizationView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RegistryOptimizationViewModel}">
            <views:RegistryOptimizationView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PubgOptimizationViewModel}">
            <views:PubgOptimizationView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:NetworkOptimizationViewModel}">
            <views:NetworkOptimizationView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CleanupViewModel}">
            <views:CleanupView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BackupRestoreViewModel}">
            <views:BackupRestoreView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SystemInfoViewModel}">
            <views:SystemInfoView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>
    </Window.Resources>

    <!-- Outer Window Container with native OS framing and full DWM GPU acceleration -->
    <Grid x:Name="MainRootGrid" Margin="0">
        <Border x:Name="MainAppBorder" CornerRadius="0" BorderThickness="0" ClipToBounds="True"
                Background="{StaticResource BgDarkestBrush}">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDownloadModalActive}" Value="True">
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <BlurEffect Radius="16" KernelType="Gaussian" RenderingBias="Performance"/>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsDriverBoosterPromptActive}" Value="True">
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <BlurEffect Radius="16" KernelType="Gaussian" RenderingBias="Performance"/>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsDriverWarningModalActive}" Value="True">
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <BlurEffect Radius="16" KernelType="Gaussian" RenderingBias="Performance"/>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsInstructionModalActive}" Value="True">
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <BlurEffect Radius="16" KernelType="Gaussian" RenderingBias="Performance"/>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsPasscodeModalActive}" Value="True">
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <BlurEffect Radius="16" KernelType="Gaussian" RenderingBias="Performance"/>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="46"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ═══ Title Bar (Native DWM Framing, Inset Divider Line) ═══ -->
                <Border x:Name="TitleBorder" Grid.Row="0" CornerRadius="0"
                        Background="Transparent" BorderThickness="0"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- App Title & Badges (Clean, no duplicate logo) -->
                        <StackPanel Orientation="Horizontal" Margin="24,0" VerticalAlignment="Center">
                            <!-- App Name: LAG KILLER BY XENOM with XENOM in Electric Blue -->
                            <TextBlock FontFamily="{StaticResource PrimaryFont}" FontSize="13" FontWeight="Bold"
                                       VerticalAlignment="Center">
                                <Run Text="LAG KILLER BY " Foreground="{StaticResource TextPrimaryBrush}"/>
                                <Run Text="XENOM" Foreground="{StaticResource AccentElectricBlueBrush}" FontWeight="ExtraBold"/>
                            </TextBlock>

                            <!-- Badge: Windows & GameLoop (Modern Rounded Rect with Icon) -->
                            <Border CornerRadius="7" Background="#141E2E" BorderBrush="#2A3C54" BorderThickness="1"
                                    Padding="9,3.5" Margin="14,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE770;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                               Foreground="{StaticResource AccentElectricBlueBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="Windows &amp; GameLoop" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentElectricBlueBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Beta Label (Plain text without box or glow) -->
                            <TextBlock Text="Beta" FontFamily="{StaticResource PrimaryFont}"
                                       FontSize="10.5" FontWeight="SemiBold" Foreground="#38BDF8"
                                       Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Title Bar Window Controls (Minimize, Close) with HitTestVisible -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,16,0" WindowChrome.IsHitTestVisibleInChrome="True">
                            <Button Content="─" Click="Minimize_Click" Style="{StaticResource TitleBarButton}" ToolTip="Minimize"/>
                            <Button Content="✕" Click="Close_Click" Style="{StaticResource TitleBarCloseButton}" ToolTip="Close"/>
                        </StackPanel>

                        <!-- Inset Divider Line (Does not touch outer edges) -->
                        <Border Grid.ColumnSpan="2" Height="1" VerticalAlignment="Bottom" Margin="22,0,22,0" Background="#1E202A"/>
                    </Grid>
                </Border>

                <!-- ═══ Main Content Area ═══ -->
                <Border x:Name="ContentBorder" Grid.Row="1" CornerRadius="0" Background="Transparent">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- ═══ Haulix-Style Floating Left Navigation Dock ═══ -->
                        <Border Grid.Column="0" Margin="24,12,0,12" Width="66" CornerRadius="24"
                                Background="#111215" BorderBrush="#20222B" BorderThickness="1.5"
                                ClipToBounds="False" Panel.ZIndex="100">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="3" Direction="270" Color="#000000" Opacity="0.75"/>
                            </Border.Effect>

                            <Grid Margin="0,12,0,12" ClipToBounds="False">
                                <Grid.RowDefinitions>
                                    <!-- Top Section: Logo + Divider + 6 Categories -->
                                    <RowDefinition Height="Auto"/>
                                    <!-- Middle Flexible Spacer -->
                                    <RowDefinition Height="*"/>
                                    <!-- Bottom Section: 3 Tools + Divider + Settings -->
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- ═══ TOP SECTION ═══ -->
                                <StackPanel Grid.Row="0" HorizontalAlignment="Center" ClipToBounds="False">
                                    <!-- Animated GIF User Logo (Plays in Loop, Click -> Dashboard) -->
                                    <Button x:Name="LogoBtn" Command="{Binding NavigateToCommand}" CommandParameter="Dashboard"
                                            PreviewMouseLeftButtonDown="NavButton_PreviewMouseLeftButtonDown"
                                            Cursor="Hand" ToolTip="Dashboard"
                                            Background="Transparent" BorderThickness="0" Padding="0"
                                            HorizontalAlignment="Center" Margin="0,0,0,10">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="LogoContainer" Width="44" Height="44" CornerRadius="14"
                                                        Background="#14151E" BorderBrush="#2A2D3C" BorderThickness="1.5">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="315" Color="#000000" Opacity="0.5"/>
                                                    </Border.Effect>
                                                    <Grid Margin="1.5" ClipToBounds="True">
                                                        <Border x:Name="MaskBorder" Background="Black" CornerRadius="12.5"/>
                                                        <Image Width="41" Height="41"
                                                               gif:ImageBehavior.AnimatedSource="pack://application:,,,/Assets/animated.gif"
                                                               gif:ImageBehavior.RepeatBehavior="Forever"
                                                               gif:ImageBehavior.AutoStart="True"
                                                               Stretch="UniformToFill">
                                                            <Image.OpacityMask>
                                                                <VisualBrush Visual="{Binding ElementName=MaskBorder}"/>
                                                            </Image.OpacityMask>
                                                            <Image.Clip>
                                                                <RectangleGeometry Rect="0,0,41,41" RadiusX="12.5" RadiusY="12.5"/>
                                                            </Image.Clip>
                                                        </Image>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="LogoContainer" Property="BorderBrush" Value="#00D4FF"/>
                                                        <Setter TargetName="LogoContainer" Property="Background" Value="#1C2433"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <!-- Top Thin Divider (ara podi ira) -->
                                    <Border Height="1" Width="28" Background="#23252E" Margin="0,0,0,10" HorizontalAlignment="Center"/>

                                    <!-- Top 6 Optimization Categories -->
                                    <RadioButton x:Name="NavDashboard" Style="{StaticResource HaulixSidebarButton}" Content="Dashboard" Tag="&#xE80F;"
                                                 IsChecked="{Binding IsDashboardActive, Mode=OneWay}"
                                                 PreviewMouseLeftButtonDown="NavButton_PreviewMouseLeftButtonDown"
                                                 Command="{Binding NavigateToCommand}" CommandParameter="Dashboard"/>

                                    <RadioButton x:Name="NavWindows" Style="{StaticResource HaulixSidebarButton}" Content="Windows Tweaks" Tag="&#xE770;"
                                                 IsChecked="{Binding IsWindowsActive, Mode=OneWay}"
                                                 PreviewMouseLeftButtonDown="NavButton_PreviewMouseLeftButtonDown"
                                                 Command="{Binding NavigateToCommand}" CommandParameter="Windows"/>

                                    <RadioButton x:Name="NavRegistry" Style="{StaticResource HaulixSidebarButton}" Content="GameLoop Installer &amp; Uninstaller" Tag="GAMELOOP"
                                                 IsChecked="{Binding IsRegistryActive, Mode=OneWay}"
                                                 PreviewMouseLeftButtonDown="NavButton_PreviewMouseLeftButtonDown"
                                                 Command="{Binding NavigateToCommand}" CommandParameter="Registry"/>

                                    <RadioButton x:Name="NavOptimizer" Style="{StaticResource HaulixSidebarButton}" Content="Optimizer &amp; Frame Gen" Tag="&#xE768;"
                                                 IsChecked="{Binding IsOptimizerActive, Mode=OneWay}"
                                                 PreviewMouseLeftButtonDown="NavButton_PreviewMouseLeftButtonDown"
                                                 Command="{Binding NavigateToCommand}" CommandParameter="Optimizer"/>

                                    <RadioButton x:Name="NavGameLoop" Style="{StaticResource HaulixSidebarButton}" Content="GameLoop Engine" Tag="&#xE7FC;"
                                                 IsChecked="{Binding IsGameLoopActive, Mode=OneWay}"
                                                 PreviewMouseLeftButtonDown="NavButton_PreviewMouseLeftButtonDown"
                                                 Command="{Binding NavigateToCommand}" CommandParameter="GameLoop"/>

                                    <RadioButton x:Name="NavPubg" Style="{StaticResource HaulixSidebarButton}" Content="PUBG Mobile" Tag="&#xE7F4;"
                                                 IsChecked="{Binding IsPubgActive, Mode=OneWay}"
                                                 PreviewMouseLeftButtonDown="NavButton_PreviewMouseLeftButtonDown"
                                                 Command="{Binding NavigateToCommand}" CommandParameter="PUBG"/>

                                    <RadioButton x:Name="NavNetwork" Style="{StaticResource HaulixSidebarButton}" Content="Network &amp; Latency" Tag="&#xE968;"
                                                 IsChecked="{Binding IsNetworkActive, Mode=OneWay}"
                                                 PreviewMouseLeftButtonDown="NavButton_PreviewMouseLeftButtonDown"
                                                 Command="{Binding NavigateToCommand}" CommandParameter="Network"/>
                                </StackPanel>

                                <!-- Middle Spacer (Grid.Row="1") pushes bottom items down -->

                                <!-- ═══ BOTTOM SECTION ═══ -->
                                <StackPanel Grid.Row="2" HorizontalAlignment="Center" ClipToBounds="False">
                                    <!-- 3 Tools & Diagnostics Buttons (Above Divider) -->
                                    <RadioButton x:Name="NavCleanup" Style="{StaticResource HaulixSidebarButton}" Content="Safe Junk Cleaner" Tag="&#xE74D;"
                                                 IsChecked="{Binding IsCleanupActive, Mode=OneWay}"
                                                 PreviewMouseLeftButtonDown="NavButton_PreviewMouseLeftButtonDown"
                                                 Command="{Binding NavigateToCommand}" CommandParameter="Cleanup"/>

                                    <RadioButton x:Name="NavBackup" Style="{StaticResource HaulixSidebarButton}" Content="Backup &amp; Restore" Tag="&#xE777;"
                                                 IsChecked="{Binding IsBackupActive, Mode=OneWay}"
                                                 PreviewMouseLeftButtonDown="NavButton_PreviewMouseLeftButtonDown"
                                                 Command="{Binding NavigateToCommand}" CommandParameter="Backup"/>

                                    <RadioButton x:Name="NavSystem" Style="{StaticResource HaulixSidebarButton}" Content="System Diagnostics" Tag="&#xE946;"
                                                 IsChecked="{Binding IsSystemActive, Mode=OneWay}"
                                                 PreviewMouseLeftButtonDown="NavButton_PreviewMouseLeftButtonDown"
                                                 Command="{Binding NavigateToCommand}" CommandParameter="System"/>

                                    <!-- Bottom Thin Divider (ara podi ira) -->
                                    <Border Height="1" Width="28" Background="#23252E" Margin="0,8,0,8" HorizontalAlignment="Center"/>

                                    <!-- Settings (At the Very Bottom) -->
                                    <RadioButton x:Name="NavSettings" Style="{StaticResource HaulixSidebarButton}" Content="Settings" Tag="&#xE713;"
                                                 IsChecked="{Binding IsSettingsActive, Mode=OneWay}"
                                                 PreviewMouseLeftButtonDown="NavButton_PreviewMouseLeftButtonDown"
                                                 Command="{Binding NavigateToCommand}" CommandParameter="Settings"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- ═══ Page Content Area ═══ -->
                        <Border Grid.Column="1" Background="Transparent" Margin="0">
                            <ContentControl Content="{Binding CurrentPage}" Margin="0"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ═══ FULL-WINDOW DOWNLOADS & RUNTIMES MODAL (TOP-LEVEL OVERLAY) ═══ -->
        <views:DownloadsModalControl x:Name="DownloadsModal"
                                     WindowChrome.IsHitTestVisibleInChrome="True"
                                     DataContext="{Binding WindowsVm}"
                                     Visibility="{Binding DataContext.IsDownloadModalActive, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
                                     Panel.ZIndex="1000"/>

        <!-- ═══ FULL-WINDOW DRIVER BOOSTER STEP 2 PROMPT MODAL (TOP-LEVEL OVERLAY) ═══ -->
        <views:DriverBoosterPromptModalControl x:Name="DriverBoosterPromptModal"
                                               WindowChrome.IsHitTestVisibleInChrome="True"
                                               DataContext="{Binding WindowsVm}"
                                               Visibility="{Binding DataContext.IsDriverBoosterPromptActive, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
                                               Panel.ZIndex="1001"/>

        <!-- ═══ FULL-WINDOW DRIVER BOOSTER WARNING / SEQUENCE MODAL (TOP-LEVEL OVERLAY) ═══ -->
        <views:DriverWarningModalControl x:Name="DriverWarningModal"
                                         WindowChrome.IsHitTestVisibleInChrome="True"
                                         DataContext="{Binding WindowsVm}"
                                         Visibility="{Binding DataContext.IsDriverWarningModalActive, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
                                         Panel.ZIndex="1002"/>

        <!-- ═══ FULL-WINDOW SETUP GUIDE MODAL (TOP-LEVEL OVERLAY) ═══ -->
        <views:InstructionGuideModalControl x:Name="InstructionGuideModal"
                                            WindowChrome.IsHitTestVisibleInChrome="True"
                                            DataContext="{Binding WindowsVm}"
                                            Visibility="{Binding DataContext.IsInstructionModalActive, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
                                            Panel.ZIndex="1003"/>

        <!-- ═══ FULL-WINDOW PASSCODE LOCK MODAL (RESTRICTED SECTION OVERLAY) ═══ -->
        <views:PasscodeModalControl x:Name="PasscodeModal"
                                    WindowChrome.IsHitTestVisibleInChrome="True"
                                    Visibility="{Binding IsPasscodeModalActive, Converter={StaticResource BoolToVis}}"
                                    Panel.ZIndex="1005"/>
    </Grid>
</Window>
