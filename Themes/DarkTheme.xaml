                                <TextBlock Text="{TemplateBinding Content}" FontFamily="{StaticResource PrimaryFont}"
                                           FontSize="12" FontWeight="SemiBold" Foreground="#F1F5F9"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Smooth Lock Popup Badge that slides out on locked click -->
                        <Border x:Name="LockPopup" HorizontalAlignment="Left" VerticalAlignment="Center"
                                Margin="52,0,0,0" Padding="12,8" CornerRadius="10"
                                Background="#1A0D10" BorderBrush="#EF4444" BorderThickness="1.2"
                                IsHitTestVisible="False" Panel.ZIndex="1000" Opacity="0"
                                Visibility="Collapsed">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="LockPopupSlide" X="-8"/>
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="315" Color="#000000" Opacity="0.85"/>
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="22" Height="22" CornerRadius="7" Background="#26EF4444" Margin="0,0,8,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                               Foreground="#EF4444" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Locked • Scanning Drivers" FontFamily="{StaticResource PrimaryFont}"
                                           FontSize="12" FontWeight="SemiBold" Foreground="#FCA5A5"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!-- Custom GameLoop Tag Trigger -->
                        <Trigger Property="Tag" Value="GAMELOOP">
                            <Setter TargetName="IconGlyph" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="GameLoopVector" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="FlyoutGlyph" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="FlyoutGameLoopVector" Property="Visibility" Value="Visible"/>
                        </Trigger>

                        <!-- Hover State: Pop up and slide out to the right with smooth animation -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Panel.ZIndex" Value="999"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="FlyoutEnterStory" HandoffBehavior="SnapshotAndReplace">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FlyoutPopup"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="FlyoutSlide"
                                                         Storyboard.TargetProperty="X"
                                                         To="6" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard x:Name="FlyoutExitStory" HandoffBehavior="SnapshotAndReplace">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FlyoutPopup"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseIn"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="FlyoutSlide"
                                                         Storyboard.TargetProperty="X"
                                                         To="-8" Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseIn"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <!-- Subtle hover for inactive buttons -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsChecked" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="IconBox" Property="Background" Value="#2A2D37"/>
                            <Setter TargetName="IconGlyph" Property="Foreground" Value="#FFFFFF"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

