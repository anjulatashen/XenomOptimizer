<Window x:Class="LagKillerSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LAG Killer by XENOM (Beta) — Setup"
        Icon="xenom.ico"
        Height="405" Width="590"
        WindowStartupLocation="CenterScreen"
        Background="#0C0D12"
        WindowStyle="SingleBorderWindow"
        AllowsTransparency="False"
        ResizeMode="CanMinimize">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42"
                      ResizeBorderThickness="0"
                      GlassFrameThickness="1"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Animated SwiftUI-style Rounded Square CheckBox Style matching tik.mp4 -->
        <Style x:Key="ModernRoundedCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#D4D4D8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Rounded Square Check Box Container with ScaleTransform for bounce animation -->
                        <Grid Width="19" Height="19" VerticalAlignment="Center" Margin="0,0,10,0">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="CheckScale" ScaleX="1" ScaleY="1" CenterX="9.5" CenterY="9.5"/>
                            </Grid.RenderTransform>

                            <!-- Unchecked Square Border (CornerRadius 5) -->
                            <Border x:Name="SquareBorder" Width="19" Height="19" CornerRadius="5"
                                    Background="#14161F" BorderBrush="#3B3F50" BorderThickness="1.5"/>

                            <!-- Checked Blue Filled Square (Apple System Blue #007AFF from tik.mp4) -->
                            <Border x:Name="CheckedSquare" Width="19" Height="19" CornerRadius="5"
                                    Background="#007AFF" BorderBrush="#007AFF" BorderThickness="1.5"
                                    Opacity="0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#007AFF" Opacity="0.4"/>
                                </Border.Effect>
                            </Border>

                            <!-- White Checkmark Path with its own ScaleTransform - Exactly Centered! -->
                            <Path x:Name="CheckMark" Data="M1.5,5.5 L4.5,8.8 L10.5,1.8"
                                  Width="11" Height="9" Stretch="Uniform"
                                  Stroke="#FFFFFF" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  RenderTransformOrigin="0.5,0.5"
                                  Opacity="0">
                                <Path.RenderTransform>
                                    <ScaleTransform x:Name="MarkScale" ScaleX="0" ScaleY="0"/>
                                </Path.RenderTransform>
                            </Path>
                        </Grid>

                        <!-- Text Label -->
                        <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="False"/>
                    </StackPanel>

                    <ControlTemplate.Triggers>
                        <!-- Hover Trigger -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="SquareBorder" Property="BorderBrush" Value="#007AFF"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>

                        <!-- Checked State with Bouncy Animation matching tik.mp4 -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckedSquare" Property="Opacity" Value="1"/>
                            <Setter TargetName="CheckMark" Property="Opacity" Value="1"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <!-- Square Spring Bounce: 0.86 -> 1.15 -> 0.97 -> 1.0 -->
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CheckScale" Storyboard.TargetProperty="ScaleX">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.0" Value="0.86"/>
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.10" Value="1.15"/>
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.18" Value="0.97"/>
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.25" Value="1.0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CheckScale" Storyboard.TargetProperty="ScaleY">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.0" Value="0.86"/>
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.10" Value="1.15"/>
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.18" Value="0.97"/>
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.25" Value="1.0"/>
                                        </DoubleAnimationUsingKeyFrames>

                                        <!-- Blue Background Fade-in -->
                                        <DoubleAnimation Storyboard.TargetName="CheckedSquare" Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1" Duration="0:0:0.10"/>

                                        <!-- Checkmark Spring Pop: Scale 0 -> 1.25 -> 1.0 -->
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="MarkScale" Storyboard.TargetProperty="ScaleX">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.0" Value="0"/>
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.12" Value="1.25"/>
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.22" Value="1.0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="MarkScale" Storyboard.TargetProperty="ScaleY">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.0" Value="0"/>
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.12" Value="1.25"/>
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.22" Value="1.0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="CheckMark" Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1" Duration="0:0:0.08"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="CheckedSquare" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.10"/>
                                        <DoubleAnimation Storyboard.TargetName="CheckMark" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.08"/>
                                        <DoubleAnimation Storyboard.TargetName="CheckScale" Storyboard.TargetProperty="ScaleX"
                                                         To="1.0" Duration="0:0:0.10"/>
                                        <DoubleAnimation Storyboard.TargetName="CheckScale" Storyboard.TargetProperty="ScaleY"
                                                         To="1.0" Duration="0:0:0.10"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#0C0D12">
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Border Grid.Row="0" Background="#08090C" BorderBrush="#1C1E26" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="20,0,12,0">
                <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold">
                    <Run Text="LAG Killer by " Foreground="#F4F4F5"/>
                    <Run Text="XENOM" Foreground="#00D4FF" FontWeight="Bold"/>
                    <Run Text="  —  Beta Setup Wizard" Foreground="#71717A"/>
                </TextBlock>
                <Button Content="✕" HorizontalAlignment="Right" Click="Close_Click"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        Width="32" Height="26" Background="Transparent" Foreground="#A1A1AA"
                        BorderThickness="0" Cursor="Hand" FontSize="11">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="CloseBorder" Background="Transparent" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CloseBorder" Property="Background" Value="#E81123"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- Main Body -->
        <Grid Grid.Row="1" Margin="28,14,28,18">
            <!-- State 1: Ready to Install -->
            <Grid x:Name="SetupPanel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Brand Header -->
                    <RowDefinition Height="Auto"/> <!-- Directory Input -->
                    <RowDefinition Height="Auto"/> <!-- Shortcut Options -->
                    <RowDefinition Height="*"/>    <!-- Spacer to push buttons to the bottom! -->
                    <RowDefinition Height="Auto"/> <!-- Action Buttons -->
                </Grid.RowDefinitions>

                <!-- Brand Header -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                    <Border Width="44" Height="44" CornerRadius="12" Background="#14151E"
                            BorderBrush="#2A2D3C" BorderThickness="1.5" ClipToBounds="True" Margin="0,0,14,0">
                        <Image Source="pack://application:,,,/logo.png" Stretch="Uniform" Margin="6"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontSize="15" FontWeight="Bold">
                                <Run Text="LAG Killer by " Foreground="#FFFFFF"/>
                                <Run Text="XENOM" Foreground="#00D4FF" FontWeight="Black"/>
                            </TextBlock>
                            <Border CornerRadius="5" Background="#162234" BorderBrush="#243A59" BorderThickness="1"
                                    Padding="6,1.5" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="BETA" FontSize="9.5" FontWeight="ExtraBold" Foreground="#38BDF8"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Tencent GameLoop &amp; PUBG Mobile Optimizer Suite" FontSize="11" Foreground="#71717A" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Target Directory -->
                <StackPanel Grid.Row="1" Margin="0,0,0,14">
                    <TextBlock Text="INSTALLATION DIRECTORY" FontSize="10" FontWeight="Bold" Foreground="#71717A" Margin="0,0,0,5"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" CornerRadius="8" Background="#14151C" BorderBrush="#262833" BorderThickness="1" Padding="12,7">
                            <TextBox x:Name="PathTextBox" Background="Transparent" Foreground="#F4F4F5" BorderThickness="0" FontSize="12"/>
                        </Border>
                        <Button Grid.Column="1" Content="Browse..." Click="Browse_Click"
                                Margin="8,0,0,0" Padding="15,7" Cursor="Hand" FontSize="11.5">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="BrowseBorder" Background="#1A1C24" BorderBrush="#2C2E3A"
                                            BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="BrowseBorder" Property="Background" Value="#252834"/>
                                            <Setter TargetName="BrowseBorder" Property="BorderBrush" Value="#4B5064"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="BrowseBorder" Property="Background" Value="#15171F"/>
                                            <Setter TargetName="BrowseBorder" Property="BorderBrush" Value="#00D4FF"/>
                                            <Setter Property="Foreground" Value="#00D4FF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Foreground" Value="#A1A1AA"/>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </StackPanel>

                <!-- Shortcut Options -->
                <Border Grid.Row="2" CornerRadius="10" Background="#111217" BorderBrush="#1F212A" BorderThickness="1" Padding="16,10" Margin="0,0,0,0">
                    <StackPanel>
                        <CheckBox x:Name="DesktopShortcutCheckBox" Content="Create Desktop Shortcut" IsChecked="True"
                                  Style="{StaticResource ModernRoundedCheckBoxStyle}" Margin="0,0,0,8"/>
                        <CheckBox x:Name="StartMenuShortcutCheckBox" Content="Create Start Menu Shortcut" IsChecked="True"
                                  Style="{StaticResource ModernRoundedCheckBoxStyle}" Margin="0,0,0,8"/>
                        <CheckBox x:Name="LaunchAfterCheckBox" Content="Launch LAG Killer after installation" IsChecked="True"
                                  Style="{StaticResource ModernRoundedCheckBoxStyle}"/>
                    </StackPanel>
                </Border>

                <!-- Action Buttons (Elevated with bottom margin) -->
                <Grid Grid.Row="4" VerticalAlignment="Bottom" Margin="0,0,0,12">
                    <!-- Cancel Button: No stroke/border outline on hover! -->
                    <Button Content="Cancel" Click="Close_Click" HorizontalAlignment="Left" VerticalAlignment="Center"
                            Cursor="Hand" FontSize="11.5">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="CancelBorder" Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="14,7">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="CancelBorder" Property="Background" Value="#2A1417"/>
                                        <Setter Property="Foreground" Value="#EF4444"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="CancelBorder" Property="Background" Value="#3D181D"/>
                                        <Setter Property="Foreground" Value="#F87171"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Foreground" Value="#71717A"/>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Install Now Button: Blue background with BLACK text in normal state + normal bump animation -->
                    <Button Click="Install_Click" HorizontalAlignment="Right"
                            Cursor="Hand" FontSize="13" FontWeight="Bold" FocusVisualStyle="{x:Null}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="InstallBorder" Background="#007AFF" CornerRadius="8" Padding="28,9" BorderThickness="0">
                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                        <Grid.RenderTransform>
                                            <ScaleTransform x:Name="TextScaleTransform" ScaleX="1.0" ScaleY="1.0"/>
                                        </Grid.RenderTransform>
                                        <TextBlock x:Name="InstallText" Text="Install Now" Foreground="#000000"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <!-- Normal State Looping Bump Animation on Text -->
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard x:Name="NormalBumpStoryboard">
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TextScaleTransform" Storyboard.TargetProperty="ScaleX">
                                                    <SplineDoubleKeyFrame KeyTime="0:0:0.0" Value="1.0"/>
                                                    <SplineDoubleKeyFrame KeyTime="0:0:0.18" Value="1.10"/>
                                                    <SplineDoubleKeyFrame KeyTime="0:0:0.32" Value="0.97"/>
                                                    <SplineDoubleKeyFrame KeyTime="0:0:0.45" Value="1.0"/>
                                                    <SplineDoubleKeyFrame KeyTime="0:0:1.60" Value="1.0"/>
                                                </DoubleAnimationUsingKeyFrames>
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TextScaleTransform" Storyboard.TargetProperty="ScaleY">
                                                    <SplineDoubleKeyFrame KeyTime="0:0:0.0" Value="1.0"/>
                                                    <SplineDoubleKeyFrame KeyTime="0:0:0.18" Value="1.10"/>
                                                    <SplineDoubleKeyFrame KeyTime="0:0:0.32" Value="0.97"/>
                                                    <SplineDoubleKeyFrame KeyTime="0:0:0.45" Value="1.0"/>
                                                    <SplineDoubleKeyFrame KeyTime="0:0:1.60" Value="1.0"/>
                                                </DoubleAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>

                                    <!-- Hover State: White background + Black text + Pop -->
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="InstallBorder" Property="Background" Value="#FFFFFF"/>
                                        <Setter TargetName="InstallText" Property="Foreground" Value="#000000"/>
                                        <Trigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="TextScaleTransform" Storyboard.TargetProperty="ScaleX"
                                                                     To="1.12" Duration="0:0:0.12">
                                                        <DoubleAnimation.EasingFunction>
                                                            <QuadraticEase EasingMode="EaseOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetName="TextScaleTransform" Storyboard.TargetProperty="ScaleY"
                                                                     To="1.12" Duration="0:0:0.12">
                                                        <DoubleAnimation.EasingFunction>
                                                            <QuadraticEase EasingMode="EaseOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="TextScaleTransform" Storyboard.TargetProperty="ScaleX"
                                                                     To="1.0" Duration="0:0:0.12">
                                                        <DoubleAnimation.EasingFunction>
                                                            <QuadraticEase EasingMode="EaseOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetName="TextScaleTransform" Storyboard.TargetProperty="ScaleY"
                                                                     To="1.0" Duration="0:0:0.12">
                                                        <DoubleAnimation.EasingFunction>
                                                            <QuadraticEase EasingMode="EaseOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.ExitActions>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="InstallBorder" Property="Background" Value="#E4E4E7"/>
                                        <Setter TargetName="InstallText" Property="Foreground" Value="#000000"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Grid>

            <!-- State 2: Installing Progress -->
            <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Width="470">
                <Border CornerRadius="20" Background="#111215" BorderBrush="#20222A" BorderThickness="1.5" Padding="24,18">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.75"/>
                    </Border.Effect>
                    <StackPanel>
                        <!-- Top Row: Circular Green Headphone Badge + Level Text + Right Text -->
                        <Grid Margin="0,0,0,20">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="34" Height="34" CornerRadius="17" Background="#11271D" BorderBrush="#1C4530" BorderThickness="1" Margin="0,0,12,0">
                                    <Path Data="M12,2A9,9 0 0,0 3,11V18A3,3 0 0,0 6,21H8V13H5V11A7,7 0 0,1 12,4A7,7 0 0,1 19,11V13H16V21H18A3,3 0 0,0 21,18V11A9,9 0 0,0 12,2Z"
                                          Fill="#00E599" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="ProgressTitleText" Text="Level 6" FontWeight="SemiBold" FontSize="15" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="ProgressSubText" Text="Now installing · 30 min" FontSize="12" Foreground="#8E8E93" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Bottom Row: 16 Vertical Capsule Progress Bar with Glowing Highlight Box -->
                        <Grid HorizontalAlignment="Center" Height="44">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Border x:Name="Capsule0" Width="12" Height="34" CornerRadius="6" Margin="4,0" Background="#262830"/>
                                <Border x:Name="Capsule1" Width="12" Height="34" CornerRadius="6" Margin="4,0" Background="#262830"/>
                                <Border x:Name="Capsule2" Width="12" Height="34" CornerRadius="6" Margin="4,0" Background="#262830"/>
                                <Border x:Name="Capsule3" Width="12" Height="34" CornerRadius="6" Margin="4,0" Background="#262830"/>
                                <Border x:Name="Capsule4" Width="12" Height="34" CornerRadius="6" Margin="4,0" Background="#262830"/>
                                <Border x:Name="Capsule5" Width="12" Height="34" CornerRadius="6" Margin="4,0" Background="#262830"/>
                                <Border x:Name="Capsule6" Width="12" Height="34" CornerRadius="6" Margin="4,0" Background="#262830"/>
                                <Border x:Name="Capsule7" Width="12" Height="34" CornerRadius="6" Margin="4,0" Background="#262830"/>
                                <Border x:Name="Capsule8" Width="12" Height="34" CornerRadius="6" Margin="4,0" Background="#262830"/>
                                <Border x:Name="Capsule9" Width="12" Height="34" CornerRadius="6" Margin="4,0" Background="#262830"/>
                                <Border x:Name="Capsule10" Width="12" Height="34" CornerRadius="6" Margin="4,0" Background="#262830"/>
                                <Border x:Name="Capsule11" Width="12" Height="34" CornerRadius="6" Margin="4,0" Background="#262830"/>
                                <Border x:Name="Capsule12" Width="12" Height="34" CornerRadius="6" Margin="4,0" Background="#262830"/>
                                <Border x:Name="Capsule13" Width="12" Height="34" CornerRadius="6" Margin="4,0" Background="#262830"/>
                                <Border x:Name="Capsule14" Width="12" Height="34" CornerRadius="6" Margin="4,0" Background="#262830"/>
                                <Border x:Name="Capsule15" Width="12" Height="34" CornerRadius="6" Margin="4,0" Background="#262830"/>
                            </StackPanel>

                            <!-- Active Focus/Highlight Box enclosing the active segment -->
                            <Canvas HorizontalAlignment="Center" Width="320" Height="44" IsHitTestVisible="False">
                                <Border x:Name="ActiveHighlightBox" Width="26" Height="44" CornerRadius="8"
                                        BorderBrush="#40FFFFFF" BorderThickness="1.5" Canvas.Left="0" Canvas.Top="0"
                                        Visibility="Collapsed"/>
                            </Canvas>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Extracting File Information -->
                <TextBlock x:Name="ProgressStatusText" Text="Extracting application files..."
                           FontSize="11.5" Foreground="#71717A" HorizontalAlignment="Center" Margin="0,14,0,0"
                           TextTrimming="CharacterEllipsis" MaxWidth="440"/>
            </StackPanel>

            <!-- State 3: Completed -->
            <StackPanel x:Name="CompletedPanel" Visibility="Collapsed" VerticalAlignment="Center">
                <Border Width="52" Height="52" CornerRadius="26" Background="#1400E599" BorderBrush="#3300E599"
                        BorderThickness="1.5" HorizontalAlignment="Center" Margin="0,0,0,14">
                    <TextBlock Text="✔" FontSize="24" Foreground="#00E599" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Installation Completed!" FontSize="17" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                <TextBlock Text="LAG Killer by XENOM (Beta) has been successfully installed on your computer."
                           FontSize="12" Foreground="#A1A1AA" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Close" Click="Close_Click" Padding="22,9" Cursor="Hand" Margin="0,0,12,0" FontSize="12">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="CloseBtnBorder" Background="#1A1C24" BorderBrush="#2C2E3A"
                                        BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="CloseBtnBorder" Property="Background" Value="#252834"/>
                                        <Setter TargetName="CloseBtnBorder" Property="BorderBrush" Value="#4B5064"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Foreground" Value="#D4D4D8"/>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Launch LAG Killer (Beta)" Click="Launch_Click" Padding="26,9"
                            Background="#00D4FF" Foreground="#0A0B0E" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
