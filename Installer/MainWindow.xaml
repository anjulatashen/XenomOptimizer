<Window x:Class="LagKillerSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LAG Killer by XENOM - Setup"
        Icon="xenom.ico"
        Height="460" Width="580"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize">

    <Border CornerRadius="18" Background="#0C0D12" BorderBrush="#252733" BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.8"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Background="#08090C" BorderBrush="#1C1E26" BorderThickness="0,0,0,1"
                    CornerRadius="18,18,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="18,0">
                    <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold">
                        <Run Text="LAG Killer by " Foreground="#F4F4F5"/>
                        <Run Text="XENOM" Foreground="#00D4FF" FontWeight="Bold"/>
                        <Run Text="  —  Setup Wizard" Foreground="#71717A"/>
                    </TextBlock>
                    <Button Content="✕" HorizontalAlignment="Right" Click="Close_Click"
                            Width="30" Height="26" Background="Transparent" Foreground="#A1A1AA"
                            BorderThickness="0" Cursor="Hand" FontSize="11"/>
                </Grid>
            </Border>

            <!-- Main Body -->
            <Grid Grid.Row="1" Margin="28,20">
                <!-- State 1: Ready to Install -->
                <StackPanel x:Name="SetupPanel">
                    <!-- Brand Header -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                        <Border Width="48" Height="48" CornerRadius="14" Background="#14151E"
                                BorderBrush="#2A2D3C" BorderThickness="1.5" ClipToBounds="True" Margin="0,0,14,0">
                            <Image Source="pack://application:,,,/logo.png" Stretch="Uniform" Margin="6"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontSize="16" FontWeight="Bold">
                                <Run Text="LAG Killer by " Foreground="#FFFFFF"/>
                                <Run Text="XENOM" Foreground="#00D4FF" FontWeight="Black"/>
                            </TextBlock>
                            <TextBlock Text="Tencent GameLoop &amp; PUBG Mobile Optimizer Suite" FontSize="11" Foreground="#71717A" Margin="0,3,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Target Directory -->
                    <TextBlock Text="INSTALLATION DIRECTORY" FontSize="10" FontWeight="Bold" Foreground="#71717A" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" CornerRadius="10" Background="#14151C" BorderBrush="#262833" BorderThickness="1" Padding="12,8">
                            <TextBox x:Name="PathTextBox" Background="Transparent" Foreground="#F4F4F5" BorderThickness="0" FontSize="12"/>
                        </Border>
                        <Button Grid.Column="1" Content="Browse..." Click="Browse_Click"
                                Margin="8,0,0,0" Padding="14,8" Background="#1E2028" Foreground="#A1A1AA"
                                BorderBrush="#2C2E38" BorderThickness="1" Cursor="Hand" FontSize="11"/>
                    </Grid>

                    <!-- Shortcut Options -->
                    <Border CornerRadius="12" Background="#111217" BorderBrush="#1F212A" BorderThickness="1" Padding="16,12" Margin="0,0,0,20">
                        <StackPanel>
                            <CheckBox x:Name="DesktopShortcutCheckBox" Content="Create Desktop Shortcut" IsChecked="True"
                                      Foreground="#D4D4D8" FontSize="12" Margin="0,0,0,8"/>
                            <CheckBox x:Name="StartMenuShortcutCheckBox" Content="Create Start Menu Shortcut" IsChecked="True"
                                      Foreground="#D4D4D8" FontSize="12" Margin="0,0,0,8"/>
                            <CheckBox x:Name="LaunchAfterCheckBox" Content="Launch LAG Killer after installation" IsChecked="True"
                                      Foreground="#D4D4D8" FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <!-- Action Buttons -->
                    <Grid>
                        <Button Content="Cancel" Click="Close_Click" HorizontalAlignment="Left"
                                Background="Transparent" Foreground="#71717A" BorderThickness="0" Cursor="Hand" FontSize="12"/>
                        <Button Content="🚀  Install Now" Click="Install_Click" HorizontalAlignment="Right"
                                Padding="26,10" Background="#00D4FF" Foreground="#0A0B0E" FontWeight="Bold"
                                BorderThickness="0" Cursor="Hand" FontSize="13">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="10"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </StackPanel>

                <!-- State 2: Installing Progress -->
                <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" VerticalAlignment="Center">
                    <TextBlock x:Name="ProgressStatusText" Text="Extracting application files..."
                               FontSize="14" FontWeight="SemiBold" Foreground="#F4F4F5" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <ProgressBar x:Name="InstallProgressBar" Height="8" Maximum="100" Value="10"
                                 Background="#14151C" Foreground="#00D4FF" BorderThickness="0" Margin="20,0,20,14"/>
                    <TextBlock Text="Please wait while files are installed to your system."
                               FontSize="11" Foreground="#71717A" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- State 3: Completed -->
                <StackPanel x:Name="CompletedPanel" Visibility="Collapsed" VerticalAlignment="Center">
                    <Border Width="56" Height="56" CornerRadius="28" Background="#14A3E635" BorderBrush="#33A3E635"
                            BorderThickness="1.5" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <TextBlock Text="✔" FontSize="26" Foreground="#A3E635" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Installation Completed!" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="LAG Killer by XENOM has been successfully installed on your computer."
                               FontSize="12" Foreground="#A1A1AA" HorizontalAlignment="Center" Margin="0,0,0,24"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Close" Click="Close_Click" Padding="20,10" Background="#1E2028"
                                Foreground="#D4D4D8" BorderBrush="#2E303C" BorderThickness="1" Cursor="Hand" Margin="0,0,12,0">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style>
                            </Button.Resources>
                        </Button>
                        <Button Content="⚡ Launch LAG Killer" Click="Launch_Click" Padding="26,10"
                                Background="#00D4FF" Foreground="#0A0B0E" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
