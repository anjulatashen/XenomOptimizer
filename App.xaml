<Application x:Class="XenomOptimizer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:XenomOptimizer.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/DarkTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Global Converters -->
            <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
            <conv:InverseBooleanConverter x:Key="InvBoolConverter"/>
            <conv:StringToColorBrushConverter x:Key="StringToColorBrush"/>
            <conv:StringToVisibilityConverter x:Key="StringToVis"/>
            <conv:ScrollOffsetToOpacityConverter x:Key="ScrollOffsetToOpacity"/>
            <conv:DownloadPercentToHeightConverter x:Key="DownloadPercentToHeight"/>
            <conv:IntEqualsToVisibilityConverter x:Key="IntEqualsToVis"/>
            <conv:EqualityToBooleanConverter x:Key="EqToBool"/>
            <conv:NotNullToVisibilityConverter x:Key="NotNullToVis"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
